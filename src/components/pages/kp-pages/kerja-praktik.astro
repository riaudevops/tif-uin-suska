---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Briefcase,
  FileText,

  CheckCircle2,
  Calendar,
  UserCheck,
  ArrowRight,
  Search,
  Sparkles,
  Building,
  Clock,
  BookOpen,
  ExternalLink
} from '@lucide/astro';

import { API_URL, getAssetUrl } from "../../../lib/cms";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

interface KPItem {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  thumbnail: string;
  category?: string;
}

let items: KPItem[] = [];
let fetchError = false;

try {
  const res = await fetch(`${API_URL}/items/kerja_praktik?fields=id,title,slug,excerpt,published_at,thumbnail,category&sort=-published_at`);
  if (res.ok) {
    const data = await res.json();
    items = (data.data || []).map((d: any) => ({
      id: d.id,
      title: d.title || (isEn ? 'Untitled Announcement' : 'Tanpa Judul'),
      slug: d.slug || d.id,
      excerpt: d.excerpt || '',
      date: d.published_at 
        ? new Date(d.published_at).toLocaleDateString(isEn ? 'en-US' : 'id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) 
        : '',
      thumbnail: getAssetUrl(d.thumbnail),
      category: d.category || (isEn ? 'General Info' : 'Informasi Umum')
    }));
  } else {
    fetchError = true;
  }
} catch (e) {
  console.error('Error fetching Kerja Praktik items:', e);
  fetchError = true;
}

// Default guides & procedures data for rich experience
const workflowSteps = isEn ? [
  {
    step: "01",
    title: "Application & Cover Letter",
    desc: "Preparation of academic transcripts, KP proposal, and application letter to target industry/agency.",
    icon: FileText
  },
  {
    step: "02",
    title: "Industrial Placement",
    desc: "Undergoing internship for a minimum of 30-60 work days with supervisor guidance.",
    icon: Building
  },
  {
    step: "03",
    title: "Report & Guidance",
    desc: "Drafting internship report and regular consultation with appointed faculty supervisor.",
    icon: UserCheck
  },
  {
    step: "04",
    title: "Seminar & Evaluation",
    desc: "Presenting KP results in front of examiners, company assessment, and grade submission.",
    icon: CheckCircle2
  }
] : [
  {
    step: "01",
    title: "Pengajuan & Surat Pengantar",
    desc: "Persiapan transkrip nilai, proposal KP, dan permohonan surat pengantar ke instansi/perusahaan tujuan.",
    icon: FileText
  },
  {
    step: "02",
    title: "Pelaksanaan di Industri",
    desc: "Menjalani Kerja Praktik minimal 30-60 hari kerja dengan bimbingan supervisor lapangan.",
    icon: Building
  },
  {
    step: "03",
    title: "Penyusunan Laporan & Bimbingan",
    desc: "Penyusunan naskah laporan KP dan bimbingan berkala bersama Dosen Pembimbing KP.",
    icon: UserCheck
  },
  {
    step: "04",
    title: "Seminar & Penilaian",
    desc: "Presentasi hasil KP di hadapan dosen penguji, penyerahan lembar nilai supervisor, dan penginputan nilai.",
    icon: CheckCircle2
  }
];

// Fallback items if Directus empty
const fallbackAnnouncements: KPItem[] = isEn ? [
  {
    id: 'fb-1',
    title: 'Registration & Verification Procedure for Odd Semester KP 2026',
    slug: 'prosedur-pendaftaran-kp-2026',
    excerpt: 'Complete guidelines for registering Kerja Praktik for students who have completed a minimum of 90 SKS.',
    date: '15 January 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Registration'
  },
  {
    id: 'fb-2',
    title: 'List of Recommended Partner Companies & State Agencies for KP',
    slug: 'daftar-mitra-perusahaan-kp',
    excerpt: 'Directory of industry partners accepting informatics internship placements across Riau and national locations.',
    date: '10 January 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'Partnership'
  },
  {
    id: 'fb-3',
    title: 'Seminar Schedule & Report Submission Deadline for KP Batch 1',
    slug: 'jadwal-seminar-kp-gelombang-1',
    excerpt: 'Announcement of room allocations and examiner assignments for Batch 1 Internship Seminar.',
    date: '02 January 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Schedule'
  }
] : [
  {
    id: 'fb-1',
    title: 'Prosedur Pendaftaran & Verifikasi Berkas Kerja Praktik Semester Ganjil 2026',
    slug: 'prosedur-pendaftaran-kp-2026',
    excerpt: 'Panduan lengkap alur pendaftaran dan pengajuan surat pengantar KP bagi mahasiswa yang telah menempuh minimal 90 SKS.',
    date: '15 Januari 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Pendaftaran'
  },
  {
    id: 'fb-2',
    title: 'Daftar Rekomendasi Mitra Industri & Instansi Pemerintahan Tempat KP',
    slug: 'daftar-mitra-perusahaan-kp',
    excerpt: 'Daftar perusahaan dan instansi mitra yang menerima mahasiswa Teknik Informatika untuk program Kerja Praktik.',
    date: '10 Januari 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'Kemitraan'
  },
  {
    id: 'fb-3',
    title: 'Jadwal Pelaksanaan Seminar KP & Batas Akhir Penyerahan Nilai Gelombang I',
    slug: 'jadwal-seminar-kp-gelombang-1',
    excerpt: 'Pengumuman alokasi ruangan, dosen penguji, dan tenggat waktu pengumpulan naskah akhir Kerja Praktik.',
    date: '02 Januari 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Jadwal'
  }
];

const displayItems = items.length > 0 ? items : fallbackAnnouncements;
---

<div class="font-sans bg-slate-50/60 min-h-screen">
  
  {/* Breadcrumb Navigation */}
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-slate-500 py-3 border-b border-slate-100">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center hover:text-emerald-700 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/profil', lang)} class="hover:text-emerald-700 transition-colors">
          {t("bread.profil")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="text-emerald-700 font-bold tracking-tight">
        {t("page.kp.title")}
      </li>
    </ol>
  </nav>

  {/* Hero Header Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-secondary/10 blur-3xl"></div>
      <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
            <Briefcase class="w-4 h-4 text-[#f7de8a]" />
            {isEn ? 'Academic & Internship Program' : 'Program Akademik & Kemitraan Industri'}
          </span>

          <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
            {isEn ? 'Internship & Industrial Placement Info' : 'Info Kerja Praktik (KP)'}
          </h1>
        </div>

        <div class="rounded-[24px] border border-white/10 bg-[#dcecd1]/10 p-5 backdrop-blur-sm">
          <p class="text-base leading-relaxed text-gray-100 sm:text-lg">
            {isEn
              ? 'Portal for announcements, implementation guidelines, application workflows, and official files for Informatics Engineering Kerja Praktik.'
              : 'Pusat pengumuman resmi, panduan pelaksanaan, alur pengajuan, serta unduhan berkas Kerja Praktik bagi mahasiswa Teknik Informatika UIN Suska Riau.'}
          </p>
        </div>
      </div>

      <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">SKS</p>
          <p class="mt-2 text-2xl font-black text-white">4</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Durasi</p>
          <p class="mt-2 text-2xl font-black text-white">1-2 Bulan</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Mitra</p>
          <p class="mt-2 text-2xl font-black text-white">100+</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Prasyarat</p>
          <p class="mt-2 text-2xl font-black text-white">90+ SKS</p>
        </div>
      </div>
    </div>
  </section>

  {/* Workflow & Procedures Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {isEn ? 'Step by Step Guide' : 'Tahapan & Prosedur'}
      </span>
      <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        {isEn ? 'Internship Execution Workflow' : 'Alur Pelaksanaan Kerja Praktik'}
      </h2>
      <p class="mt-2 text-sm text-slate-500">
        {isEn ? 'Follow these 4 main stages from preparation to seminar.' : 'Ikuti 4 tahapan utama mulai dari pengajuan berkas hingga seminar KP.'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {workflowSteps.map((item) => {
        const IconComponent = item.icon;
        return (
          <div class="flex flex-col justify-between rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div>
              <div class="mb-6 flex items-center justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="text-2xl font-black text-slate-200">
                  {item.step}
                </span>
              </div>
              <h3 class="mb-2 text-lg font-bold text-slate-900">
                {item.title}
              </h3>
              <p class="text-sm leading-relaxed text-slate-500">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  {/* Main Announcements Grid Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="mb-2 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? 'Announcements & Updates' : 'Pengumuman & Informasi Terbaru'}
        </span>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          {isEn ? 'Latest Internship Information' : 'Informasi & Pengumuman KP'}
        </h2>
      </div>
      <p class="max-w-sm text-sm text-slate-500">
        {isEn ? 'Stay updated with room allocations, dates, and partner listings.' : 'Dapatkan pembaharuan tenggat waktu, pengumuman mitra, dan seminar KP.'}
      </p>
    </div>

    {displayItems.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-100 shadow-sm">
        <p class="text-slate-500 text-base mb-2">
          {isEn ? 'No internship announcements available yet.' : 'Belum ada konten Kerja Praktik.'}
        </p>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          {isEn ? 'Add entries to the `kerja_praktik` collection in Directus.' : 'Tambahkan entri baru ke koleksi `kerja_praktik` pada CMS Directus.'}
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {displayItems.map((item) => (
          <article class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
            <div>
              {/* Thumbnail Image */}
              <div class="relative w-full h-48 bg-slate-100 overflow-hidden">
                <img 
                  src={item.thumbnail || '/landing-pages/gedung-faste.jpg'} 
                  alt={item.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  onError="this.onerror=null; this.src='/landing-pages/gedung-faste.jpg';"
                />
                <span class="absolute top-4 left-4 px-3 py-1 bg-slate-900/80 backdrop-blur-md text-emerald-300 text-xs font-bold rounded-full border border-emerald-500/30">
                  {item.category || (isEn ? 'Info KP' : 'Info KP')}
                </span>
              </div>

              {/* Card Body */}
              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-slate-400 mb-3">
                  <Calendar class="w-3.5 h-3.5 text-emerald-600" />
                  <span>{item.date || (isEn ? 'Recent Update' : 'Terbaru')}</span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug">
                  {item.title}
                </h3>

                <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed mb-4">
                  {item.excerpt || (isEn ? 'Click details to view the complete announcement.' : 'Klik selengkapnya untuk membaca informasi dan syarat rincinya.')}
                </p>
              </div>
            </div>

            {/* Footer Action */}
            <div class="px-6 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between">
              <a 
                href={localizePath(`/kerja-praktik/${item.slug}`, lang)} 
                class="inline-flex items-center gap-1.5 text-sm font-bold text-emerald-700 hover:text-emerald-800 group-hover:translate-x-1 transition-transform"
              >
                {t("common.detail")}
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

  </section>

</div>
