---
const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

let rawKurikulum = [];

try {
  const response = await fetch(`${API_URL}/items/kurikulum?limit=-1`);
  if (response.ok) {
    const json = await response.json();
    rawKurikulum = json.data || [];
  } else {
    console.warn("Directus API returned non-OK status.");
  }
} catch (error: any) {
  console.warn("Failed to fetch from Directus API:", error?.message || error);
}

const kurikulumList = rawKurikulum;

function parseRomanSemester(semesterStr: string): number {
  if (!semesterStr) return 1;
  const roman = semesterStr.replace(/Semester\s*/i, "").trim().toUpperCase();
  const lookup: { [key: string]: number } = { I: 1, V: 5, X: 10 };
  let total = 0;
  for (let i = 0; i < roman.length; i++) {
    const current = lookup[roman[i]] || 0;
    const next = lookup[roman[i + 1]] || 0;
    total += current < next ? -current : current;
  }
  return total || 1;
}

const curriculumVersions: { [version: string]: { [semester: number]: any[] } } = {};

kurikulumList.forEach((item: any) => {
  const v = String(item.tahun_kurikulum || "2025");
  if (!curriculumVersions[v]) curriculumVersions[v] = {};

  const sem = parseRomanSemester(item.semester);
  if (!curriculumVersions[v][sem]) curriculumVersions[v][sem] = [];

  curriculumVersions[v][sem].push({
    kode_mk: item.kode_internal || "",
    kode_resmi: item.kode_resmi || "",
    nama_mk: item.nama_matakuliah || "",
    singkatan: item.singkatan || "",
    sks: Number(item.sks) || 0,
    prasyarat: item.prasyarat || "",
  });
});

Object.keys(curriculumVersions).forEach((v) => {
  const semesters = curriculumVersions[v];
  const sortedSemesters: { [semester: number]: any[] } = {};
  Object.keys(semesters)
    .sort((a, b) => Number(a) - Number(b))
    .forEach((semKey) => {
      const sem = Number(semKey);
      sortedSemesters[sem] = semesters[sem];
    });
  curriculumVersions[v] = sortedSemesters;
});

const versions = Object.keys(curriculumVersions).sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
const activeVersion = versions[0] || "2025";
const activeCurriculum = curriculumVersions[activeVersion] || {};
const accordionVersions = versions.filter((v) => v !== activeVersion);

function romanize(num: number): string {
  const lookup: { [key: string]: number } = { M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90, L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1 };
  let roman = "";
  let i;
  for (i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman;
}

const semesterCount = Object.keys(activeCurriculum).length;
const totalSks = Object.values(activeCurriculum).reduce((sum: number, courses: any[]) => sum + courses.reduce((courseSum: number, course: any) => courseSum + Number(course.sks || 0), 0), 0);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-12">
  {versions.length === 0 && (
    <div class="rounded-[30px] border border-dashed border-slate-200 bg-slate-50 px-6 py-20 text-center text-slate-500">
      Belum ada data kurikulum yang tersedia.
    </div>
  )}
  
  <div class="mb-12">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-black tracking-tight text-[#004d2c] sm:text-3xl">
        Kurikulum {activeVersion}
      </h2>
      <div class="h-px flex-1 bg-gradient-to-r from-[#004d2c]/20 to-transparent"></div>
    </div>

    <div class="space-y-10">
      {Object.entries(activeCurriculum).map(([semester, courses]: [string, any]) => {
        const totalSKS = courses.reduce((sum: number, c: any) => sum + c.sks, 0);

        return (
          <section class="relative">
            <div class="mb-4 flex items-center justify-between rounded-[22px] border border-slate-200 bg-slate-50 px-5 py-3.5 shadow-[0_12px_30px_-25px_rgba(15,23,42,0.35)]">
              <span class="text-base font-black tracking-tight text-slate-800">
                Semester {romanize(Number(semester))}
              </span>
              <span class="text-sm font-black text-[#004d2c]">
                {totalSKS} SKS
              </span>
            </div>

            <div class="hidden overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] md:block">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="bg-[#004d2c] text-white">
                    <th class="w-16 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">No</th>
                    <th class="w-24 px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">MK</th>
                    <th class="w-36 px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">Resmi</th>
                    <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">Nama Mata Kuliah</th>
                    <th class="w-28 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">Singkatan</th>
                    <th class="w-20 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">SKS</th>
                    <th class="w-64 px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">Prasyarat</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {courses.map((c: any, index: number) => (
                    <tr class="transition-colors duration-200 hover:bg-[#f5f9f1]">
                      <td class="px-5 py-4 text-center text-sm font-semibold text-slate-400">{index + 1}</td>
                      <td class="px-5 py-4 font-mono text-sm font-semibold text-slate-500">{c.kode_mk || "-"}</td>
                      <td class="px-5 py-4 font-mono text-sm font-semibold text-slate-500">{c.kode_resmi || "-"}</td>
                      <td class="px-5 py-4 text-sm font-bold leading-snug text-slate-800">{c.nama_mk || "-"}</td>
                      <td class="px-5 py-4 text-center text-sm font-bold text-slate-500">{c.singkatan || "-"}</td>
                      <td class="px-5 py-4 text-center text-sm font-black text-[#004d2c]">{c.sks}</td>
                      <td class="px-5 py-4 text-xs text-slate-600">
                        {c.prasyarat ? (
                          <span class={`inline-flex rounded-full border px-2.5 py-1 text-[10px] font-bold ${c.prasyarat.toLowerCase() === "paket wajib" ? "border-emerald-100 bg-emerald-50 text-emerald-700" : "border-amber-100 bg-amber-50 text-amber-700"}`}>
                            {c.prasyarat}
                          </span>
                        ) : (
                          <span class="text-slate-300">-</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="space-y-3 md:hidden">
              {courses.map((c: any) => (
                <div class="rounded-[22px] border border-slate-200 bg-white p-4 shadow-[0_12px_28px_-25px_rgba(15,23,42,0.35)]">
                  <div class="flex items-center justify-between gap-3">
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-slate-500">
                      {c.kode_mk || "PILIHAN"}
                    </span>
                    <span class="text-[10px] font-mono font-bold text-slate-400">
                      {c.kode_resmi || "-"}
                    </span>
                  </div>
                  <h4 class="mt-3 text-sm font-bold leading-snug text-slate-800">
                    {c.nama_mk}
                  </h4>
                  {c.singkatan && (
                    <p class="mt-1 text-[11px] font-bold text-slate-400">Singkatan: {c.singkatan}</p>
                  )}
                  <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3 text-xs">
                    <div>
                      <span class="text-slate-400">SKS:</span>
                      <strong class="ml-1 font-black text-[#004d2c]">{c.sks} SKS</strong>
                    </div>
                    {c.prasyarat && (
                      <span class={`inline-flex rounded-full border px-2 py-0.5 text-[9px] font-bold ${c.prasyarat.toLowerCase() === "paket wajib" ? "border-emerald-100 bg-emerald-50 text-emerald-700" : "border-amber-100 bg-amber-50 text-amber-700"}`}>
                        {c.prasyarat}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>

  {accordionVersions.length > 0 && (
    <div class="mt-16 space-y-4">
      {accordionVersions.map((v) => {
        const semesterData = curriculumVersions[v] || {};
        return (
          <div class="overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-[0_20px_55px_-35px_rgba(15,23,42,0.2)]">
            <button
              class="flex w-full items-center justify-between gap-4 bg-slate-50 px-5 py-4 text-left transition-colors hover:bg-slate-100/60 sm:px-6"
              data-accordion-trigger={v}
              aria-expanded="false"
            >
              <span class="text-base font-black tracking-tight text-[#004d2c] sm:text-lg">
                Kurikulum {v}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-slate-400 transition-transform duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                data-accordion-icon
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div class="hidden space-y-10 bg-white px-4 py-6 sm:px-6" data-accordion-content={v}>
              {Object.entries(semesterData).map(([semester, courses]: [string, any]) => {
                const totalSKS = courses.reduce((sum: number, c: any) => sum + c.sks, 0);
                return (
                  <section class="relative">
                    <div class="mb-4 flex items-center justify-between rounded-[18px] border border-slate-200 bg-slate-50 px-4 py-3">
                      <span class="text-sm font-black text-slate-800">
                        Semester {romanize(Number(semester))}
                      </span>
                      <span class="text-xs font-black text-[#004d2c]">
                        {totalSKS} SKS
                      </span>
                    </div>

                    <div class="hidden overflow-hidden rounded-[20px] border border-slate-200 bg-white md:block">
                      <table class="w-full border-collapse text-left text-xs">
                        <thead>
                          <tr class="bg-slate-100 text-slate-700">
                            <th class="w-14 px-4 py-3 text-center text-[9px] font-bold uppercase tracking-[0.18em]">No</th>
                            <th class="w-20 px-4 py-3 text-[9px] font-bold uppercase tracking-[0.18em]">MK</th>
                            <th class="w-32 px-4 py-3 text-[9px] font-bold uppercase tracking-[0.18em]">Resmi</th>
                            <th class="px-4 py-3 text-[9px] font-bold uppercase tracking-[0.18em]">Nama Mata Kuliah</th>
                            <th class="w-24 px-4 py-3 text-center text-[9px] font-bold uppercase tracking-[0.18em]">Singkatan</th>
                            <th class="w-16 px-4 py-3 text-center text-[9px] font-bold uppercase tracking-[0.18em]">SKS</th>
                            <th class="w-56 px-4 py-3 text-[9px] font-bold uppercase tracking-[0.18em]">Prasyarat</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                          {courses.map((c: any, index: number) => (
                            <tr class="transition-colors hover:bg-slate-50">
                              <td class="px-4 py-3 text-center text-slate-400">{index + 1}</td>
                              <td class="px-4 py-3 font-mono text-slate-500">{c.kode_mk || "-"}</td>
                              <td class="px-4 py-3 font-mono text-slate-500">{c.kode_resmi || "-"}</td>
                              <td class="px-4 py-3 font-bold text-slate-700">{c.nama_mk || "-"}</td>
                              <td class="px-4 py-3 text-center font-bold text-slate-500">{c.singkatan || "-"}</td>
                              <td class="px-4 py-3 text-center font-black text-[#004d2c]">{c.sks}</td>
                              <td class="px-4 py-3 text-[10px] text-slate-500">
                                {c.prasyarat ? (
                                  <span class="inline-flex rounded border border-slate-200 bg-slate-100 px-2 py-0.5 text-[9px] font-bold text-slate-600">
                                    {c.prasyarat}
                                  </span>
                                ) : (
                                  <span class="text-slate-300">-</span>
                                )}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>

                    <div class="space-y-3 md:hidden">
                      {courses.map((c: any) => (
                        <div class="rounded-[18px] border border-slate-200 bg-white p-4">
                          <div class="flex items-center justify-between gap-3">
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-slate-500">
                              {c.kode_mk || "PILIHAN"}
                            </span>
                            <span class="text-[10px] font-mono font-bold text-slate-400">
                              {c.kode_resmi || "-"}
                            </span>
                          </div>
                          <h4 class="mt-3 text-xs font-bold leading-snug text-slate-700">
                            {c.nama_mk}
                          </h4>
                          <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3 text-[10px]">
                            <div>
                              <span class="text-slate-400">SKS:</span>
                              <strong class="ml-1 font-black text-[#004d2c]">{c.sks} SKS</strong>
                            </div>
                            {c.prasyarat && (
                              <span class="inline-flex rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[9px] font-semibold text-slate-600">
                                {c.prasyarat}
                              </span>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </section>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  )}
</section>

<script is:inline>
  function initAccordions() {
    const triggers = document.querySelectorAll('[data-accordion-trigger]');
    triggers.forEach((trigger) => {
      const newTrigger = trigger.cloneNode(true);
      trigger.parentNode.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener('click', () => {
        const version = newTrigger.getAttribute('data-accordion-trigger');
        const content = document.querySelector(`[data-accordion-content="${version}"]`);
        const icon = newTrigger.querySelector('[data-accordion-icon]');
        const isExpanded = newTrigger.getAttribute('aria-expanded') === 'true';

        newTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');

        if (!isExpanded) {
          content?.classList.remove('hidden');
          icon?.classList.add('rotate-180');
        } else {
          content?.classList.add('hidden');
          icon?.classList.remove('rotate-180');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initAccordions);
  document.addEventListener('astro:page-load', initAccordions);
</script>
