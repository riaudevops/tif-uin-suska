---
const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

let rawKurikulum = [];

try {
  const response = await fetch(`${API_URL}/items/kurikulum?limit=-1`);
  if (response.ok) {
    const json = await response.json();
    rawKurikulum = json.data || [];
  } else {
    console.warn("Directus API returned non-OK status.");
  }
} catch (error: any) {
  console.warn("Failed to fetch from Directus API:", error?.message || error);
}

const kurikulumList = rawKurikulum;

// Helper: ubah "Semester I" / "Semester IV" dll jadi angka (1, 4, ...)
function parseRomanSemester(semesterStr: string): number {
  if (!semesterStr) return 1;
  const roman = semesterStr.replace(/Semester\s*/i, "").trim().toUpperCase();
  const lookup: { [key: string]: number } = { I: 1, V: 5, X: 10 };
  let total = 0;
  for (let i = 0; i < roman.length; i++) {
    const current = lookup[roman[i]] || 0;
    const next = lookup[roman[i + 1]] || 0;
    total += current < next ? -current : current;
  }
  return total || 1;
}

// Group by curriculum version and semester
const curriculumVersions: { [version: string]: { [semester: number]: any[] } } = {};

kurikulumList.forEach((item: any) => {
  const v = String(item.tahun_kurikulum || "2025");
  if (!curriculumVersions[v]) curriculumVersions[v] = {};

  const sem = parseRomanSemester(item.semester);
  if (!curriculumVersions[v][sem]) curriculumVersions[v][sem] = [];

  curriculumVersions[v][sem].push({
    kode_mk: item.kode_internal || "",
    kode_resmi: item.kode_resmi || "",
    nama_mk: item.nama_matakuliah || "",
    singkatan: item.singkatan || "",
    sks: Number(item.sks) || 0,
    prasyarat: item.prasyarat || ""
  });
});

// Sort semesters within each version
Object.keys(curriculumVersions).forEach((v) => {
  const semesters = curriculumVersions[v];
  const sortedSemesters: { [semester: number]: any[] } = {};
  Object.keys(semesters).sort((a, b) => Number(a) - Number(b)).forEach((semKey) => {
    const sem = Number(semKey);
    sortedSemesters[sem] = semesters[sem];
  });
  curriculumVersions[v] = sortedSemesters;
});

// Identify active curriculum (highest numeric or default latest)
const versions = Object.keys(curriculumVersions).sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
const activeVersion = versions[0] || "2025";
const activeCurriculum = curriculumVersions[activeVersion] || {};

// Remaining versions for accordions
const accordionVersions = versions.filter(v => v !== activeVersion);

// Helper function to convert Arabic to Roman numerals
function romanize(num: number): string {
  const lookup: { [key: string]: number } = { M: 1000, CM: 900, D: 500, CD: 400, C: 100, XC: 90, L: 50, XL: 40, X: 10, IX: 9, V: 5, IV: 4, I: 1 };
  let roman = '';
  let i;
  for (i in lookup) {
    while (num >= lookup[i]) {
      roman += i;
      num -= lookup[i];
    }
  }
  return roman;
}
---

<div class="max-w-6xl mx-auto px-6 py-6 font-sans">
  {versions.length === 0 && (
  <div class="text-center py-20 text-slate-500">
    Belum ada data kurikulum yang tersedia.
  </div>
)}
  <!-- Active Curriculum Section -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="text-2xl font-black text-[#004d2c] tracking-tight uppercase font-heading">
        Kurikulum {activeVersion}
      </h2>
      <div class="h-[2px] bg-gradient-to-r from-green-700/20 to-transparent flex-1"></div>
    </div>

    <div class="space-y-12">
      {Object.entries(activeCurriculum).map(([semester, courses]: [string, any]) => {
        const totalSKS = courses.reduce((sum: number, c: any) => sum + c.sks, 0);

        return (
          <section class="relative">
            <!-- Semester Header Row matching screenshots -->
            <div class="flex justify-between items-center bg-slate-50 border border-slate-200/80 px-6 py-3.5 rounded-xl mb-4 font-bold text-slate-800 shadow-sm">
              <span class="text-base font-black tracking-tight font-heading text-slate-900">
                Semester {romanize(Number(semester))}
              </span>
              <span class="text-sm font-black text-[#004d2c] font-sans pr-14 md:pr-16">
                {totalSKS} SKS
              </span>
            </div>

            <!-- Desktop View: Grid Table -->
            <div class="hidden md:block overflow-hidden rounded-2xl border border-slate-200/70 shadow-sm bg-white">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="bg-[#004d2c] text-white">
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider text-center w-16">No</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider w-24">MK</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider w-36">Resmi</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider">Nama Mata Kuliah</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider w-28 text-center">Singkatan</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider w-20 text-center">SKS</th>
                    <th class="py-4 px-6 font-bold uppercase text-[11px] tracking-wider w-64">Prasyarat</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {courses.map((c: any, index: number) => (
                    <tr class="hover:bg-green-50/20 transition-colors duration-200">
                      <td class="py-4 px-6 text-center text-slate-400 font-medium">{c.kode_mk || c.kode_resmi || c.nama_mk ? index + 1 : ""}</td>
                      <td class="py-4 px-6 font-mono text-slate-500 font-semibold">{c.kode_mk || "-"}</td>
                      <td class="py-4 px-6 font-mono text-slate-500 font-semibold">{c.kode_resmi || "-"}</td>
                      <td class="py-4 px-6 font-bold text-slate-800 leading-snug">{c.nama_mk || "-"}</td>
                      <td class="py-4 px-6 text-center font-bold text-slate-500">{c.singkatan || "-"}</td>
                      <td class="py-4 px-6 text-center font-bold text-[#004d2c]">{c.sks}</td>
                      <td class="py-4 px-6 text-slate-600 font-medium text-xs">
                        {c.prasyarat ? (
                          <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold ${c.prasyarat.toLowerCase() === 'paket wajib' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-amber-50 text-amber-700 border border-amber-100'}`}>
                            {c.prasyarat}
                          </span>
                        ) : (
                          <span class="text-slate-300">-</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Mobile View: Cards List -->
            <div class="md:hidden space-y-3">
              {courses.map((c: any, index: number) => (
                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-3 flex flex-col justify-between">
                  <div class="flex justify-between items-start">
                    <span class="text-[10px] font-bold px-2 py-0.5 bg-slate-100 text-slate-500 rounded-full font-mono">
                      {c.kode_mk || "PILIHAN"}
                    </span>
                    <span class="text-xs font-mono font-bold text-slate-400">
                      {c.kode_resmi || "-"}
                    </span>
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-800 text-sm leading-snug">
                      {c.nama_mk}
                    </h4>
                    {c.singkatan && (
                      <p class="text-xs text-slate-400 font-bold mt-0.5">Singkatan: {c.singkatan}</p>
                    )}
                  </div>
                  <div class="pt-2 border-t border-slate-100 flex justify-between items-center text-xs">
                    <div>
                      <span class="text-slate-400">SKS:</span>
                      <strong class="text-[#004d2c] font-black ml-1 text-sm">{c.sks} SKS</strong>
                    </div>
                    {c.prasyarat && (
                      <span class={`px-2.5 py-0.5 rounded-full text-[9px] font-bold ${c.prasyarat.toLowerCase() === 'paket wajib' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-amber-50 text-amber-700 border border-amber-100'}`}>
                        {c.prasyarat}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>

  <!-- Accordion Sections for Older Curriculums -->
  {accordionVersions.length > 0 && (
    <div class="mt-20 space-y-4">
      {accordionVersions.map((v) => {
        const semesterData = curriculumVersions[v] || {};
        return (
          <div class="border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-shadow duration-300">
            <!-- Accordion Header -->
            <button
              class="w-full flex items-center justify-between px-8 py-5 text-left bg-slate-50 hover:bg-slate-100/50 transition-colors duration-300 cursor-pointer font-bold text-slate-800 border-b border-slate-200/50"
              data-accordion-trigger={v}
              aria-expanded="false"
            >
              <span class="text-base md:text-lg font-black tracking-tight font-heading text-[#004d2c] uppercase">
                Kurikulum {v}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-slate-400 transition-transform duration-300 transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                data-accordion-icon
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Accordion Content -->
            <div class="hidden px-8 py-8 space-y-12 bg-white" data-accordion-content={v}>
              {Object.entries(semesterData).map(([semester, courses]: [string, any]) => {
                const totalSKS = courses.reduce((sum: number, c: any) => sum + c.sks, 0);
                return (
                  <section class="relative font-sans">
                    <div class="flex justify-between items-center bg-slate-50 border border-slate-200/80 px-6 py-3 rounded-xl mb-4 font-bold text-slate-700 shadow-sm">
                      <span class="text-sm font-bold font-heading text-slate-800">
                        Semester {romanize(Number(semester))}
                      </span>
                      <span class="text-xs font-bold text-[#004d2c] font-sans pr-14 md:pr-16">
                        {totalSKS} SKS
                      </span>
                    </div>

                    <!-- Desktop Accordion Table -->
                    <div class="hidden md:block overflow-hidden rounded-xl border border-slate-200/70 shadow-sm bg-white">
                      <table class="w-full text-left border-collapse text-xs">
                        <thead>
                          <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider text-center w-14">No</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider w-20">MK</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider w-32">Resmi</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider">Nama Mata Kuliah</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider w-24 text-center">Singkatan</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider w-16 text-center">SKS</th>
                            <th class="py-3 px-5 font-bold uppercase text-[10px] tracking-wider w-56">Prasyarat</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                          {courses.map((c: any, index: number) => (
                            <tr class="hover:bg-slate-50 transition-colors duration-150">
                              <td class="py-3 px-5 text-center text-slate-400">{index + 1}</td>
                              <td class="py-3 px-5 font-mono text-slate-500">{c.kode_mk || "-"}</td>
                              <td class="py-3 px-5 font-mono text-slate-500">{c.kode_resmi || "-"}</td>
                              <td class="py-3 px-5 font-bold text-slate-700">{c.nama_mk || "-"}</td>
                              <td class="py-3 px-5 text-center font-bold text-slate-400">{c.singkatan || "-"}</td>
                              <td class="py-3 px-5 text-center font-bold text-[#004d2c]">{c.sks}</td>
                              <td class="py-3 px-5 text-slate-500 text-[10px]">
                                {c.prasyarat ? (
                                  <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded border border-slate-200">
                                    {c.prasyarat}
                                  </span>
                                ) : (
                                  <span class="text-slate-300">-</span>
                                )}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>

                    <!-- Mobile Accordion Card -->
                    <div class="md:hidden space-y-3">
                      {courses.map((c: any, index: number) => (
                        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-2.5">
                          <div class="flex justify-between items-center">
                            <span class="text-[9px] font-bold px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded font-mono">
                              {c.kode_mk || "PILIHAN"}
                            </span>
                            <span class="text-[10px] font-mono text-slate-400">
                              {c.kode_resmi || "-"}
                            </span>
                          </div>
                          <h4 class="font-bold text-slate-700 text-xs leading-snug">
                            {c.nama_mk}
                          </h4>
                          <div class="pt-2 border-t border-slate-100 flex justify-between items-center text-[11px]">
                            <div>
                              <span class="text-slate-400">SKS:</span>
                              <strong class="text-[#004d2c] font-black ml-1">{c.sks} SKS</strong>
                            </div>
                            {c.prasyarat && (
                              <span class="px-1.5 py-0.5 bg-slate-50 text-slate-500 rounded text-[9px] font-semibold border border-slate-100">
                                {c.prasyarat}
                              </span>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </section>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  )}
</div>

<script is:inline>
  function initAccordions() {
    const triggers = document.querySelectorAll('[data-accordion-trigger]');
    triggers.forEach(trigger => {
      // Re-bind to ensure no duplicate event listeners (important for SPAs / page-loads)
      const newTrigger = trigger.cloneNode(true);
      trigger.parentNode.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener('click', () => {
        const version = newTrigger.getAttribute('data-accordion-trigger');
        const content = document.querySelector(`[data-accordion-content="${version}"]`);
        const icon = newTrigger.querySelector('[data-accordion-icon]');
        const isExpanded = newTrigger.getAttribute('aria-expanded') === 'true';

        newTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');

        if (!isExpanded) {
          content.classList.remove('hidden');
          icon.classList.add('rotate-180');
        } else {
          content.classList.add('hidden');
          icon.classList.remove('rotate-180');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initAccordions);
  document.addEventListener('astro:page-load', initAccordions);
</script>
