---
const API_URL = import.meta.env.PUBLIC_API_URL;

const response = await fetch(`${API_URL}/items/kurikulum?sort=semester`);
const data = await response.json();
const kurikulum = data.data;

const kurikulumPerSemester = kurikulum.reduce((acc: any, item: any) => {
  if (!acc[item.semester]) acc[item.semester] = [];
  acc[item.semester].push(item);
  return acc;
}, {});
---

<Layout title="Kurikulum Teknik Informatika">
  <main class="max-w-6xl mx-auto px-6 py-16">
    
    <div class="mb-12">
      <h1 class="text-4xl font-black text-slate-900 mb-4">Kurikulum <span class="text-emerald-700">2025</span></h1>
      <p class="text-slate-600 max-w-2xl">
        Program Studi Teknik Informatika UIN Sultan Syarif Kasim Riau berfokus pada pengembangan kemampuan teknis dan kompetensi profesional dalam bidang teknologi informasi dan komunikasi.
      </p>
    </div>

    <div class="space-y-12">
      {Object.entries(kurikulumPerSemester).map(([semester, courses]: [string, any]) => (
        <section>
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-xl font-bold text-emerald-800 bg-emerald-100 px-6 py-2 rounded-full">
              Semester {semester}
            </h2>
            <div class="h-px bg-slate-200 flex-1"></div>
          </div>

          <div class="hidden md:block overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-slate-600 font-bold uppercase text-xs tracking-wider">
                <tr>
                  <th class="px-6 py-4">Kode MK</th>
                  <th class="px-6 py-4">Nama Mata Kuliah</th>
                  <th class="px-6 py-4">SKS</th>
                  <th class="px-6 py-4">Jenis</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                {courses.map((mk: any) => (
                  <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 font-mono text-slate-500">{mk.kode_mk}</td>
                    <td class="px-6 py-4 font-semibold text-slate-900">{mk.nama_mk}</td>
                    <td class="px-6 py-4 font-bold text-slate-700">{mk.sks}</td>
                    <td class="px-6 py-4">
                      <span class={`px-3 py-1 rounded-full text-[10px] font-bold ${mk.jenis === 'Wajib' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                        {mk.jenis}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="md:hidden space-y-4">
            {courses.map((mk: any) => (
              <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center">
                <div>
                  <p class="text-xs font-bold text-slate-400">{mk.kode_mk}</p>
                  <p class="font-bold text-slate-900">{mk.nama_mk}</p>
                </div>
                <div class="text-right">
                  <p class="font-bold text-emerald-700 text-lg">{mk.sks} SKS</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>