---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100 font-sans">
        <li class="flex items-center">
            <a href={localizePath("/", lang)} class="flex items-center hover:text-[#004d2c] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="hover:text-[#004d2c] cursor-pointer transition-colors">
            {t("bread.akademik")}
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-[#004d2c] font-bold tracking-tight">
            {t("bread.kurikulum")}
        </li>
    </ol>
</nav>

<section data-aos="fade-up" class="bg-gradient-to-b from-gray-50 to-white py-12 overflow-hidden font-sans">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      
      <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block font-sans">
        {t("page.kurikulum.badge")}
      </span>

      <h1 data-aos="fade-up" class="text-4xl md:text-5xl font-black text-[#004d2c] mb-6 leading-tight font-heading">
        {t("page.kurikulum.title")}
      </h1>
      
      <p class="text-lg text-gray-600 mb-8 leading-relaxed font-sans max-w-2xl mx-auto">
        {t("page.kurikulum.desc")}
      </p>

    </div>
  </div>
</section>