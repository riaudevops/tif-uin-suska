---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
            <a href="/" class="flex items-center hover:text-green-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <a href={localizePath('/profil', lang)} class="hover:text-green-600 transition-colors">
                {t("bread.profil")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
            {isEn ? "Vision, Mission, Goals & Strategy" : "Visi, Misi, Tujuan & Strategi"}
        </li>
    </ol>
</nav>

<section class="relative bg-gradient-to-br from-[#004d2c] via-green-800 to-green-700">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="relative bg-gradient-to-br from-green-700 to-[#004d2c] rounded-3xl overflow-hidden shadow-2xl">
        <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-white opacity-5 rounded-full"></div>
        <div class="absolute bottom-0 left-0 mb-[-50px] ml-[-50px] w-48 h-48 bg-yellow-400 opacity-8 rounded-full"></div>

        <div class="relative p-8 md:p-16 text-center md:text-left flex flex-col md:flex-row items-center gap-12">
            <div class="flex-shrink-0">
                <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">
                    The Vision
                </span>
                <h1 class="text-4xl md:text-5xl font-black text-white leading-tight">
                    {isEn ? "Scientific" : "Visi"} <br class="hidden md:block">{isEn ? "Vision" : "Keilmuan"}
                </h1>
            </div>

            <div class="flex-1 border-t md:border-t-0 md:border-l border-yellow-400/40 pt-8 md:pt-0 md:pl-12">
                <p class="text-green-50 text-xl md:text-2xl leading-relaxed font-light">
                    {isEn ? '"To become an Informatics Engineering study program that is ' : '"Menjadi Program Studi Teknik Informatika yang '}<span class="font-bold text-white underline decoration-yellow-400 underline-offset-4">{isEn ? "excellent" : "unggul"}</span>{isEn ? ' in the field of ' : ' dalam bidang '}<span class="font-bold text-white">{isEn ? "Data Analytics" : "Data Analytics"}</span>{isEn ? ' and ' : ' dan '}<span class="font-bold text-white">{isEn ? "Software Development" : "Software Development"}</span>{isEn ? ' integrating ' : ' yang mengintegrasikan '}<span class="italic text-green-200">{isEn ? "Informatics and Islam" : "Informatika dan Islam"}</span>{isEn ? ' in Indonesia by 2025."' : ' di Indonesia pada tahun 2025."'}
                </p>
            </div>
        </div>
    </div>
    </div>
</section>