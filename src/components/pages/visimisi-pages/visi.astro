---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import { Eye, ArrowRight, Sparkles, Target } from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href="/" class="flex items-center gap-1.5 transition-colors hover:text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t('bread.home')}
      </a>
    </li>
    <li class="text-gray-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>
    <li>
      <a href={localizePath('/profil', lang)} class="transition-colors hover:text-primary">
        {t('bread.profil')}
      </a>
    </li>
    <li class="text-gray-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>
    <li class="font-semibold text-primary">
      {isEn ? 'Vision, Mission, Goals & Strategy' : 'Visi, Misi, Tujuan & Strategi'}
    </li>
  </ol>
</nav>

<section data-aos="fade-up" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
  <div class="overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#0f7b51] shadow-[0_30px_90px_-35px_rgba(0,61,42,0.8)]">
    <div class="relative isolate px-6 py-10 sm:px-8 lg:px-12 lg:py-14">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(255,214,102,0.18),_transparent_25%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.08),_transparent_35%)]"></div>
      <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-secondary/20 blur-3xl"></div>
      <div class="absolute -left-12 bottom-0 h-44 w-44 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid items-center gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="space-y-5 text-center lg:text-left">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.24em] text-white/90 backdrop-blur-sm">
            <Eye class="h-3.5 w-3.5 text-secondary" />
            {isEn ? 'Vision' : 'Visi'}
          </span>

          <h1 class="text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
            {isEn ? 'Scientific Vision' : 'Visi Keilmuan'}
          </h1>

          <p class="max-w-md text-sm leading-relaxed text-gray-100 lg:text-base">
            {isEn
              ? 'A clear academic direction that aligns institutional excellence, human development, and the integration of science and Islamic values.'
              : 'Arah akademik yang jelas dalam menggabungkan keunggulan institusi, pengembangan manusia, serta integrasi ilmu dan nilai keislaman.'}
          </p>
        </div>

        <div class="rounded-[28px] border border-white/15 bg-white/8 p-5 shadow-[0_20px_60px_-25px_rgba(15,23,42,0.45)] backdrop-blur-sm sm:p-7">
          <div class="mb-5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 text-secondary">
              <Sparkles class="h-4 w-4" />
              <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-100">{isEn ? 'Academic Direction' : 'Arah Akademik'}</span>
            </div>
            <Target class="h-5 w-5 text-white/80" />
          </div>

          <p class="text-lg leading-relaxed text-white sm:text-xl lg:text-2xl">
            {isEn ? '“To become an Informatics Engineering study program that is excellent in Data Analytics and Software Development, integrating informatics and Islamic values in Indonesia.”' : '“Menjadi Program Studi Teknik Informatika yang unggul dalam bidang Data Analytics dan Software Development, serta mengintegrasikan informatika dan nilai keislaman di Indonesia.”'}
          </p>

          <div class="mt-6 flex items-center gap-3 text-sm text-gray-100">
            <span class="inline-flex items-center gap-2 rounded-full bg-secondary/15 px-3 py-1.5 text-secondary font-semibold">
              {isEn ? 'Institutional excellence' : 'Keunggulan institusional'}
            </span>
            <ArrowRight class="h-4 w-4 text-gray-300" />
            <span>{isEn ? '2025 outlook' : 'Capaian 2025'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>