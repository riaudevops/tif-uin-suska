---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
import { BookOpenText, Microscope, Users, Network, BriefcaseBusiness, LaptopMinimal } from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';

const strategies = isEn
  ? [
      {
        title: 'OBE and MBKM Curriculum',
        desc: 'Aligning the curriculum with outcome-based learning and student mobility pathways in Data Analytics and Software Development.',
        icon: BookOpenText,
        tint: 'emerald'
      },
      {
        title: 'Research and Innovation',
        desc: 'Increasing the quality of student and lecturer research activities to support application-based and evidence-driven innovation.',
        icon: Microscope,
        tint: 'sky'
      },
      {
        title: 'Professional Competence',
        desc: 'Developing lecturer and student competencies to meet the needs of the digital workforce and industry demands.',
        icon: BriefcaseBusiness,
        tint: 'amber'
      },
      {
        title: 'Stakeholder Collaboration',
        desc: 'Strengthening strategic cooperation with industry, government, and academic partners to keep the program relevant and applied.',
        icon: Network,
        tint: 'purple'
      },
      {
        title: 'Community Impact',
        desc: 'Utilizing technology to provide problem-solving solutions for the wider community while preserving Islamic values.',
        icon: Users,
        tint: 'rose'
      },
      {
        title: 'Modern Facilities',
        desc: 'Providing laboratory and digital infrastructure that supports data-driven research and software engineering practices.',
        icon: LaptopMinimal,
        tint: 'indigo'
      }
    ]
  : [
      {
        title: 'Kurikulum OBE dan MBKM',
        desc: 'Menyelaraskan kurikulum dengan pembelajaran berbasis capaian dan jalur mobilitas mahasiswa dalam bidang Data Analytics serta Software Development.',
        icon: BookOpenText,
        tint: 'emerald'
      },
      {
        title: 'Riset dan Inovasi',
        desc: 'Meningkatkan kualitas kegiatan riset mahasiswa dan dosen untuk mendukung inovasi berbasis aplikasi dan bukti ilmiah.',
        icon: Microscope,
        tint: 'sky'
      },
      {
        title: 'Kompetensi Profesional',
        desc: 'Mengembangkan kompetensi dosen dan mahasiswa sesuai kebutuhan dunia kerja digital dan industri masa kini.',
        icon: BriefcaseBusiness,
        tint: 'amber'
      },
      {
        title: 'Kolaborasi Stakeholder',
        desc: 'Memperkuat kerja sama strategis dengan industri, pemerintah, dan mitra akademik agar program tetap relevan dan aplikatif.',
        icon: Network,
        tint: 'purple'
      },
      {
        title: 'Dampak Sosial',
        desc: 'Menggunakan teknologi untuk memberikan solusi atas permasalahan masyarakat sambil menjaga nilai-nilai keislaman.',
        icon: Users,
        tint: 'rose'
      },
      {
        title: 'Fasilitas Modern',
        desc: 'Menyediakan infrastruktur laboratorium dan digital yang mendukung riset berbasis data serta praktik rekayasa perangkat lunak.',
        icon: LaptopMinimal,
        tint: 'indigo'
      }
    ];
---

<section data-aos="fade-up" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="mb-10 text-center">
    <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-secondary/15 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-900">
      {isEn ? 'Strategy' : 'Strategi'}
    </span>
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      {isEn ? 'Achievement Strategy' : 'Strategi Pencapaian'}
    </h2>
    <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
      {isEn
        ? 'The program implements several strategic pillars to strengthen academic quality, professional readiness, and the relevance of learning outcomes.'
        : 'Program studi menjalankan beberapa pilar strategis untuk memperkuat mutu akademik, kesiapan profesional, dan relevansi capaian pembelajaran.'}
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {strategies.map((item) => {
      const Icon = item.icon;
      const tintMap = {
        emerald: 'bg-emerald-100 text-emerald-700',
        sky: 'bg-sky-100 text-sky-700',
        amber: 'bg-amber-100 text-amber-700',
        purple: 'bg-violet-100 text-violet-700',
        rose: 'bg-rose-100 text-rose-700',
        indigo: 'bg-indigo-100 text-indigo-700'
      };

      return (
        <div class="group rounded-[26px] border border-gray-200 bg-white p-6 shadow-[0_20px_45px_-30px_rgba(15,23,42,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_20px_55px_-28px_rgba(0,61,42,0.35)]">
          <div class={`mb-5 flex h-12 w-12 items-center justify-center rounded-2xl ${tintMap[item.tint]}`}>
            <Icon class="h-5 w-5" />
          </div>
          <h3 class="mb-3 text-lg font-bold text-gray-900">{item.title}</h3>
          <p class="text-sm leading-relaxed text-gray-600">{item.desc}</p>
        </div>
      );
    })}
  </div>
</section>