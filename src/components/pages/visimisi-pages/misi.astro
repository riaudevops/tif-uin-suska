---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<section class="max-w-4xl mx-auto p-8 bg-white shadow-lg rounded-xl border border-gray-100 my-10">
    <div class="relative mb-8">
        <h1 class="text-3xl md:text-4xl font-extrabold text-[#004d2c] tracking-tight pl-6 border-l-8 border-yellow-400">
            Misi Keilmuan <span class="text-[#05673f] block text-2xl mt-1 uppercase tracking-widest">{isEn ? "Informatics Engineering Program" : "Prodi Teknik Informatika"}</span>
        </h1>
    </div>

    <p class="text-gray-600 text-lg mb-8 leading-relaxed italic">
        {isEn ? '"The Scientific Mission of the Informatics Engineering program is formulated as follows:"' : '"Adapun Misi Keilmuan Program Studi Teknik Informatika dirumuskan sebagai berikut:"'}
    </p>

    <div class="space-y-4">
        <div class="flex items-start p-5 bg-green-50 rounded-lg hover:bg-green-100 transition-colors duration-300 group">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-yellow-400 text-white rounded-full font-bold shadow-md group-hover:scale-110 transition-transform">
                1
            </span>
            <p class="ml-4 text-gray-700 leading-relaxed pt-1">
                {isEn ? 'Producing graduates who possess ' : 'Menghasilkan lulusan yang memiliki '}<span class="font-semibold text-gray-900">{isEn ? "knowledge and competencies" : "pengetahuan dan kompetensi"}</span>{isEn ? ' in the field of ' : ' di bidang '}<span class="text-[#004d2c] font-medium">Data Analytics</span>{isEn ? ' and ' : ' dan '}<span class="text-[#004d2c] font-medium">Software Development</span>{isEn ? ' to enhance graduate competitiveness at national and regional levels.' : ' dalam rangka peningkatan daya saing lulusan di tingkat nasional maupun regional.'}
            </p>
        </div>

        <div class="flex items-start p-5 bg-green-50 rounded-lg hover:bg-green-100 transition-colors duration-300 group">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-yellow-400 text-white rounded-full font-bold shadow-md group-hover:scale-110 transition-transform">
                2
            </span>
            <p class="ml-4 text-gray-700 leading-relaxed pt-1">
                {isEn ? 'Producing graduates who contribute to civilized society development by integrating ' : 'Menghasilkan lulusan yang berkontribusi dalam pembangunan masyarakat berkeadaban dengan mengintegrasikan '}<span class="font-semibold text-gray-900">{isEn ? "Informatics and Islamic values" : "Informatika dan nilai-nilai keIslaman"}</span>{isEn ? ' in the field of ' : ' di bidang '}<span class="text-[#004d2c] font-medium">Data Analytics</span>{isEn ? ' and ' : ' dan '}<span class="text-[#004d2c] font-medium">Software Development</span>.
            </p>
        </div>
    </div>
</section>