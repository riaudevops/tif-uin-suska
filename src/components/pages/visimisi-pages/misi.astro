---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
import { ArrowRight, BookOpen, Users } from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<section data-aos="fade-up" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="mb-10 text-center">
    <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-secondary/15 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-900">
      <BookOpen class="h-3.5 w-3.5 text-primary" />
      {translateInline((isEn) ? "en" : "id", "inline.mission")}
    </span>
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      {translateInline((isEn) ? "en" : "id", "inline.scientific-mission-of-the-study-program")}
    </h2>
    <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
      {translateInline((isEn) ? "en" : "id", "inline.the-program-formulates-its-mission-to-support-ac")}
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="group rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_24px_60px_-35px_rgba(15,23,42,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_24px_55px_-30px_rgba(0,61,42,0.35)] sm:p-7">
      <div class="mb-5 flex items-center justify-between">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-lg font-bold text-primary">01</span>
        <ArrowRight class="h-5 w-5 text-gray-300 transition-colors duration-300 group-hover:text-primary" />
      </div>

      <h3 class="mb-3 text-xl font-bold text-gray-900">
        {translateInline((isEn) ? "en" : "id", "inline.academic-excellence")}
      </h3>
      <p class="text-base leading-relaxed text-gray-600">
        {translateInline((isEn) ? "en" : "id", "inline.producing-graduates-with-strong-knowledge-and-co")}
      </p>
    </div>

    <div class="group rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_24px_60px_-35px_rgba(15,23,42,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_24px_55px_-30px_rgba(0,61,42,0.35)] sm:p-7">
      <div class="mb-5 flex items-center justify-between">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-secondary/15 text-lg font-bold text-gray-900">02</span>
        <Users class="h-5 w-5 text-gray-300 transition-colors duration-300 group-hover:text-primary" />
      </div>

      <h3 class="mb-3 text-xl font-bold text-gray-900">
        {translateInline((isEn) ? "en" : "id", "inline.societal-contribution")}
      </h3>
      <p class="text-base leading-relaxed text-gray-600">
        {translateInline((isEn) ? "en" : "id", "inline.developing-graduates-who-contribute-to-a-civiliz")}
      </p>
    </div>
  </div>
</section>