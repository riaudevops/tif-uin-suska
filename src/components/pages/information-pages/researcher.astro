---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
import { API_URL } from '@/lib/cms.js';
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';

let informationData: any[] = [];

try {
  const response = await fetch(`${API_URL}/items/information?limit=-1`);
  if (!response.ok) throw new Error("Gagal mengambil data information");

  const dataDirectus = await response.json();
  informationData = dataDirectus.data || [];
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching information:", message);
}
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)]">
    <div class="flex flex-col gap-3 border-b border-[#dfeadf] bg-gradient-to-r from-[#edf7ee] via-[#f7faf4] to-[#f9f2df] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d]">
          {translateInline((isEn) ? "en" : "id", "inline.research-team-2002e6f")}
        </p>
        <h2 class="mt-1 text-xl font-black tracking-tight text-slate-900 sm:text-2xl">
          {translateInline((isEn) ? "en" : "id", "inline.research-interest-bidang-riset")}
        </h2>
      </div>
      <div class="inline-flex items-center rounded-full bg-[#edf4e8] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">
        {informationData.length} {isEn ? "Data" : "Data"}
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="bg-gradient-to-r from-[#003d2a] to-[#0b5c3d] text-white">
            <th class="w-20 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">No</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{translateInline((isEn) ? "en" : "id", "inline.researcher")}</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{translateInline((isEn) ? "en" : "id", "inline.research-interest-bidang-riset")}</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          {informationData.length > 0 ? (
            informationData.map((item: any, index: number) => {
              const interests = item.research_interest
                ? item.research_interest.split(/[,;]/).map((i: string) => i.trim()).filter(Boolean)
                : [];

              return (
                <tr class="transition-colors hover:bg-[#f5f9f1]">
                  <td class="px-5 py-5 text-center text-sm font-semibold text-slate-400">{index + 1}</td>
                  <td class="px-5 py-5">
                    <div class="flex items-center gap-3">
                      <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#dfeadf] bg-[#edf5ee] text-sm font-black uppercase text-[#0b5c3d]">
                        {item.name ? item.name.charAt(0) : '?'}
                      </div>
                      <span class="text-sm font-bold text-slate-800">{item.name || 'Tanpa Nama'}</span>
                    </div>
                  </td>
                  <td class="px-5 py-5">
                    <div class="flex flex-wrap gap-2">
                      {interests.length > 0 ? (
                        interests.map((tag: string) => (
                          <span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-semibold text-slate-600">
                            {tag}
                          </span>
                        ))
                      ) : (
                        <span class="text-sm text-slate-400">-</span>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="3" class="py-12 text-center text-base font-medium text-slate-400">
                {translateInline((isEn) ? "en" : "id", "inline.no-data-found")}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="flex flex-col gap-2 border-t border-slate-100 bg-slate-50/80 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">
        Total <span class="text-[#0b5c3d]">{informationData.length}</span> {translateInline((isEn) ? "en" : "id", "inline.records")}
      </p>
      <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">
        <span class="inline-block h-2 w-2 rounded-full bg-[#0b5c3d]"></span>
        Academic DB v.2026
      </div>
    </div>
  </div>
</section>