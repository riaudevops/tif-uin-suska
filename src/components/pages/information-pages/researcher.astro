---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';

const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

let informationData: any[] = [];

try {
  const response = await fetch(`${API_URL}/items/information?limit=-1`);
  if (!response.ok) throw new Error("Gagal mengambil data information");
  
  const dataDirectus = await response.json();
  informationData = dataDirectus.data || [];
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching information:", message);
}
---

<section data-aos="fade-up" class="py-16 px-4 sm:px-6 lg:px-8 relative">
  <div class="max-w-7xl mx-auto bg-white rounded-3xl shadow-xl shadow-slate-200/50 overflow-hidden border border-slate-100">
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-[#004d2c] text-white">
            <th class="py-5 px-8 font-bold uppercase text-xs tracking-[0.2em] text-center w-24 border-b border-white/10">No</th>
            <th class="py-5 px-8 font-bold uppercase text-xs tracking-[0.2em] border-b border-white/10">{isEn ? "Researcher" : "Peneliti"}</th>
            <th class="py-5 px-8 font-bold uppercase text-xs tracking-[0.2em] border-b border-white/10">{isEn ? "Research Interest" : "Bidang Riset (Research Interest)"}</th>
          </tr>
        </thead>
        
        <tbody class="divide-y divide-slate-100">
          {informationData.length > 0 ? (
            informationData.map((item: any, index: number) => {
              // Memecah research interest jika dipisah koma agar menjadi badge yang rapi
              const interests = item.research_interest 
                ? item.research_interest.split(/[,;]/).map((i: string) => i.trim()).filter(Boolean)
                : [];

              return (
                <tr class="hover:bg-emerald-50/40 transition-all duration-200 group">
                  <td class="py-5 px-8 text-center text-slate-400 font-mono text-sm">{index + 1}</td>
                  <td class="py-5 px-8">
                    <div class="flex items-center gap-4">
                      <div class="shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-emerald-100 to-slate-100 flex items-center justify-center text-sm font-black text-emerald-700 border border-emerald-200/50 uppercase">
                        {item.name ? item.name.charAt(0) : '?'}
                      </div>
                      <p class="text-slate-800 font-bold text-base leading-tight group-hover:text-emerald-700 transition-colors">
                        {item.name || 'Tanpa Nama'}
                      </p>
                    </div>
                  </td>
                  <td class="py-5 px-8">
                    <div class="flex flex-wrap gap-2">
                      {interests.length > 0 ? (
                        interests.map((tag: string) => (
                          <span class="px-3.5 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-medium border border-slate-200">
                            {tag}
                          </span>
                        ))
                      ) : (
                        <span class="text-slate-400 text-sm">-</span>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="3" class="py-12 text-center text-slate-400 text-base font-medium">
                {isEn ? "No data found" : "Data tidak tersedia"}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    
    <div class="bg-slate-50/80 px-8 py-5 border-t border-slate-100 flex justify-between items-center">
      <p class="text-xs text-slate-500 font-bold uppercase tracking-widest">
        Total <span class="text-emerald-600">{informationData.length}</span> {isEn ? "Innovators Found" : "Inovator Ditemukan"}
      </p>
      <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z"/></svg>
        Academic DB v.2026
      </div>
    </div>
  </div>
</section>