---
const prestasiData = [
  { no: 1, nama: "Nazruddin Safaat, MT", research: "" },
  { no: 2, nama: "Rahmad Abdillah, MT", research: "" },
  { no: 3, nama: "Pizaini, ST", research: "" },

];
---

<section class="animate-fade-up overflow-hidden py-24 relative">
  <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 overflow-hidden border border-slate-100">
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-separate border-spacing-0">
        <thead>
          <tr class="bg-[#004d2c] text-white">
            <th class="py-5 px-6 font-bold uppercase text-[10px] tracking-[0.2em] text-center w-20 border-b border-white/10">No</th>
            <th class="py-5 px-6 font-bold uppercase text-[10px] tracking-[0.2em] border-b border-white/10">Peneliti</th>
            <th class="py-5 px-6 font-bold uppercase text-[10px] tracking-[0.2em] border-b border-white/10">Bidang Riset (Research Interest)</th>
          </tr>
        </thead>
        
        <tbody class="divide-y divide-slate-100">
          {prestasiData.map((item: any, index: number) => (
            <tr class="hover:bg-emerald-50/40 transition-all duration-300 group">
              <td class="py-5 px-6 text-center text-slate-400 font-mono text-xs">{index + 1}</td>
              <td class="py-5 px-6">
                <div class="flex items-center gap-4">
                  <div class="shrink-0 w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-100 to-slate-100 flex items-center justify-center text-xs font-black text-emerald-700 border border-emerald-200/50 uppercase">
                    {item.nama.charAt(0)}
                  </div>
                  <p class="text-slate-800 font-bold text-sm leading-none group-hover:text-emerald-700 transition-colors">
                    {item.nama}
                  </p>
                </div>
              </td>
              <td class="py-5 px-6">
                <div class="flex flex-wrap gap-2">
                   <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-[11px] font-medium border border-slate-200">
                     {item.research}
                   </span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    
    <div class="bg-slate-50/80 p-5 border-t border-slate-100 flex justify-between items-center">
      <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">
        Total <span class="text-emerald-600">{prestasiData.length}</span> Inovator Ditemukan
      </p>
      <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.2em] text-slate-300">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z"/></svg>
        Academic DB v.2026
      </div>
    </div>
  </div>
</section>