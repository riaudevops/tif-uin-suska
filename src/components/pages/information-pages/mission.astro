---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="mb-6 text-center">
    <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[#0b5c3d]">Pilar utama</p>
    <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
      {translateInline((isEn) ? "en" : "id", "inline.core-information-principles")}
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    <div class="group rounded-[28px] border border-[#dfeadf] bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-[#a4c6b0] hover:shadow-[0_20px_55px_-30px_rgba(11,92,61,0.35)]">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#eaf5ec] text-[#0b5c3d]">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
      <h3 class="mt-6 text-xs font-bold uppercase tracking-[0.28em] text-[#b98c2d]">Pilar 01</h3>
      <h4 class="mt-3 text-2xl font-bold text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.efficiency")}</h4>
      <p class="mt-3 text-base leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.optimizing-digital-infrastructure-to-support-fas")}</p>
    </div>

    <div class="group rounded-[28px] border border-[#dfeadf] bg-[#f2f8f1] p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-[#a4c6b0] hover:shadow-[0_20px_55px_-30px_rgba(11,92,61,0.35)]">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#eaf5ec] text-[#0b5c3d]">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      </div>
      <h3 class="mt-6 text-xs font-bold uppercase tracking-[0.28em] text-[#b98c2d]">Pilar 02</h3>
      <h4 class="mt-3 text-2xl font-bold text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.security")}</h4>
      <p class="mt-3 text-base leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.implementing-international-standard-encryption-p")}</p>
    </div>

    <div class="group rounded-[28px] border border-[#dfeadf] bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-[#a4c6b0] hover:shadow-[0_20px_55px_-30px_rgba(11,92,61,0.35)]">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#f0ead9] text-[#a1781d]">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      </div>
      <h3 class="mt-6 text-xs font-bold uppercase tracking-[0.28em] text-[#b98c2d]">Pilar 03</h3>
      <h4 class="mt-3 text-2xl font-bold text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.accessibility")}</h4>
      <p class="mt-3 text-base leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.providing-an-inclusive-digital-collaboration-pla")}</p>
    </div>
  </div>
</section>