---
import { getLocaleFromUrl, useTranslations, localizePath } from "@/lib/translations.js";
import { Home, ChevronRight, Database, ShieldCheck, MonitorCog, ArrowRight } from "@lucide/astro";

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";

const features = isEn
  ? [
      {
        icon: MonitorCog,
        title: "Digital Infrastructure",
        desc: "Supporting learning, administration, and academic services through stable and integrated systems."
      },
      {
        icon: Database,
        title: "Data Management",
        desc: "Maintaining secure and structured data flows for academic, research, and operational needs."
      },
      {
        icon: ShieldCheck,
        title: "Information Security",
        desc: "Ensuring access control, data protection, and reliability in the management of campus information."
      }
    ]
  : [
      {
        icon: MonitorCog,
        title: "Infrastruktur Digital",
        desc: "Mendukung pembelajaran, administrasi, dan layanan akademik melalui sistem yang stabil dan terintegrasi."
      },
      {
        icon: Database,
        title: "Pengelolaan Data",
        desc: "Menjaga aliran data yang aman, terstruktur, dan sesuai kebutuhan akademik serta operasional."
      },
      {
        icon: ShieldCheck,
        title: "Keamanan Informasi",
        desc: "Menjamin pengelolaan akses, perlindungan data, dan keandalan layanan informasi kampus."
      }
    ];
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath("/", lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <Home class="h-4 w-4 text-slate-400" />
        <span>{t("bread.home")}</span>
      </a>
    </li>
    <li class="text-slate-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li>
      <a href={localizePath("/profil/sejarah", lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
        {t("bread.profil")}
      </a>
    </li>
    <li class="text-slate-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li class="font-semibold text-[#0b5c3d]">
      {isEn ? "Information Technology" : "Teknologi Informasi"}
    </li>
  </ol>
</nav>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
  <div class="overflow-hidden rounded-[30px] border border-[#d8e7d7] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#d9b65d] p-6 shadow-[0_28px_90px_-32px_rgba(0,61,42,0.8)] sm:p-8 lg:p-10">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.22em] text-white/90 backdrop-blur-sm">
          {isEn ? "Academic Support Unit" : "Unit Pendukung Akademik"}
        </span>
        <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
          {isEn ? "Information" : "Teknologi"}
          <span class="mt-2 block text-[#f7d67a]">{isEn ? "Technology" : "Informasi"}</span>
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-emerald-50/90">
          {isEn
            ? "Supporting academic activities through reliable digital infrastructure, secure data services, and efficient information systems."
            : "Mendukung kegiatan akademik melalui infrastruktur digital yang handal, layanan data yang aman, dan sistem informasi yang efisien."}
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-[26px] border border-white/15 bg-white/10 p-5 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.35)] backdrop-blur-sm sm:p-6">
          <p class="text-lg leading-relaxed text-emerald-50 sm:text-xl">
            {isEn
              ? '"The role of information technology is to strengthen academic services, support research processes, and ensure information is managed securely and accessibly."'
              : '"Peran teknologi informasi adalah memperkuat layanan akademik, mendukung proses riset, dan memastikan informasi dikelola secara aman serta mudah diakses."'}
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <span class="rounded-full bg-[#f7d67a]/20 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#fef3c7]">
              {isEn ? "Digital Services" : "Layanan Digital"}
            </span>
            <span class="rounded-full bg-[#d8f0d9]/15 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#eafcf0]">
              {isEn ? "Academic Systems" : "Sistem Akademik"}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-5 md:grid-cols-3">
    {features.map(({ icon: Icon, title, desc }) => (
      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-[#bfd8c6] hover:shadow-[0_20px_55px_-30px_rgba(11,92,61,0.35)]">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf5ee] text-[#0b5c3d]">
          <Icon class="h-5 w-5" />
        </div>
        <h2 class="mt-5 text-xl font-bold text-slate-900">{title}</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">{desc}</p>
      </article>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
  <div class="rounded-[30px] border border-slate-200 bg-[#f7faf4] p-6 sm:p-8">
    <div class="flex items-center gap-3">
      <div class="h-1.5 w-10 rounded-full bg-[#0b5c3d]"></div>
      <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500">
        {isEn ? "Core Role" : "Peran Utama"}
      </span>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
      <p class="text-base leading-relaxed text-slate-700 sm:text-lg">
        {isEn
          ? "The Information Technology unit supports the academic community with reliable digital systems, structured data governance, and secure access to information needed for learning, research, and institutional operations."
          : "Unit Teknologi Informasi mendukung civitas akademika dengan sistem digital yang andal, tata kelola data yang terstruktur, serta akses informasi yang aman untuk kebutuhan pembelajaran, riset, dan operasional institusi."}
      </p>

      <div class="rounded-[24px] border border-[#dfeadf] bg-white p-5 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.24)]">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">
            {isEn ? "Priority" : "Prioritas"}
          </span>
          <ArrowRight class="h-4 w-4 text-[#0b5c3d]" />
        </div>
        <ul class="mt-4 space-y-3 text-sm text-slate-700">
          <li>• {isEn ? "Reliable academic infrastructure" : "Infrastruktur akademik yang andal"}</li>
          <li>• {isEn ? "Secure information management" : "Pengelolaan informasi yang aman"}</li>
          <li>• {isEn ? "Efficient digital collaboration" : "Kolaborasi digital yang efisien"}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
