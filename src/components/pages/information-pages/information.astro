---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
            <a href="/" class="flex items-center hover:text-green-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <a href={localizePath('/profil', lang)} class="hover:text-green-600 transition-colors">
                {t("bread.akademik")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
            Information Technology
        </li>
    </ol>
</nav>

<section class="relative py-12 overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-50 rounded-full blur-[100px] -z-10 opacity-70"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-amber-50 rounded-full blur-[120px] -z-10 opacity-60"></div>

        <div class="container mx-auto px-6 max-w-7xl">
            
            <div class="relative mb-20 animate-fade-in">
                <div class="absolute -top-4 -left-4 w-32 h-32 border-t-4 border-l-4 border-amber-400 rounded-tl-3xl z-0 hidden md:block"></div>
                <div class="absolute -bottom-4 -right-4 w-32 h-32 border-b-4 border-r-4 border-emerald-700 rounded-br-3xl z-0 hidden md:block"></div>
                
                <div class="relative overflow-hidden rounded-[2rem] shadow-2xl group">
                    <img 
                        src="/landing-pages/gedung-faste.jpg" 
                        alt="Information Technology Banner" 
                        class="w-full h-[300px] md:h-[550px] object-cover transition-transform duration-1000 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 via-transparent to-transparent"></div>
                    
                    <div class="absolute bottom-8 left-8">
                        <span class="inline-flex items-center gap-2 px-5 py-2 bg-amber-400 text-emerald-950 text-[10px] font-black uppercase tracking-[0.3em] rounded-full shadow-xl">
                            Innovation & Research Hub
                        </span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:items-center">
                <div class="lg:col-span-5 animate-fade-up delay-1">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="h-1 w-12 bg-emerald-600 rounded-full"></div>
                        <span class="text-xs font-bold tracking-[0.4em] text-emerald-700 uppercase">Department</span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-black text-slate-900 leading-[0.9] tracking-tighter uppercase mb-6">
                        Information <br/>
                        <span class="text-emerald-700 italic">Technology</span>
                    </h1>
                    <div class="flex gap-2">
                        <div class="w-16 h-2 bg-amber-400 rounded-full"></div>
                        <div class="w-4 h-2 bg-emerald-100 rounded-full"></div>
                    </div>
                </div>

                <div class="lg:col-span-7 animate-fade-up delay-2">
                    <p class="text-xl md:text-2xl text-slate-700 leading-relaxed font-light mb-8 italic">
                        {isEn ? '"Building bridges between ' : '"Membangun jembatan antara '}<span class="text-emerald-800 font-bold">{isEn ? "computational intelligence" : "kecerdasan komputasi"}</span>{isEn ? " and " : " dan "}<span class="text-emerald-800 font-bold">{isEn ? "research excellence" : "keunggulan riset"}</span>{isEn ? ' academic."' : ' akademik."'}
                    </p>
                    <p class="text-lg text-slate-600 leading-relaxed text-justify mb-0">
                        {isEn ? "The Information Technology department focuses on developing and implementing innovative technology solutions to support research and operational needs in the academic environment. We provide reliable IT infrastructure, data management services, and digital collaboration platforms that facilitate interaction between researchers, students, and staff to improve efficiency, security, and information accessibility." : "Departemen Teknologi Informasi berfokus pada pengembangan dan penerapan solusi teknologi yang inovatif untuk mendukung kebutuhan riset dan operasional di lingkungan akademik. Kami menyediakan infrastruktur TI yang handal, layanan pengelolaan data, serta platform kolaborasi digital yang memfasilitasi interaksi antara peneliti, mahasiswa, dan staf guna meningkatkan efisiensi, keamanan, dan aksesibilitas informasi."}
                    </p>
                </div>
            </div>


        </div>
    </section>