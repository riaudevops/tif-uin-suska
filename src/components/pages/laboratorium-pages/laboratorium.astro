---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const laboratories = [
  {
    id: "technopreneur",
    code: "LAB·01",
    name: "Lab Technopreneur dan Inkubator Bisnis",
    oldName: "eks. Lab Database",
    facilities: [
      {
        title: "Komputer",
        description: "Lab Technopreneur dan Inkubator Bisnis menyediakan perangkat komputer yang canggih dan berkualitas tinggi untuk mendukung dan memudahkan mahasiswa dalam mengembangkan ide-ide bisnis mereka.",
        image: "/laboratorium/technopreneur_komputer.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091459-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Lab Technopreneur dan Inkubator Bisnis memiliki meja dosen yang nyaman dan profesional untuk mendukung kegiatan belajar mengajar dan riset yang dilakukan oleh para dosen dalam bidang technopreneurship dan inkubator bisnis.",
        image: "/laboratorium/technopreneur_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091415-scaled.jpg"
      },
      {
        title: "Meja Aslab",
        description: "Lab Technopreneur dan Inkubator Bisnis memiliki meja asisten lab yang modern dan ergonomis untuk mendukung kegiatan riset dan pelatihan yang dilakukan oleh asisten lab dalam bidang technopreneurship dan inkubator bisnis.",
        image: "/laboratorium/technopreneur_mejaaslab.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091440-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Lab Technopreneur dan Inkubator Bisnis menyediakan loker barang yang aman dan berkualitas untuk menyimpan barang-barang pribadi para pengunjung lab yang digunakan dalam kegiatan riset, pengembangan, dan pelatihan dalam bidang technopreneurship dan inkubator bisnis.",
        image: "/laboratorium/technopreneur_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091427-scaled.jpg"
      }
    ]
  },
  {
    id: "datascience",
    code: "LAB·02",
    name: "Lab Riset Data Science dan Business Intelligence",
    oldName: "eks. Lab Jaringan Komputer",
    facilities: [
      {
        title: "Komputer",
        description: "Lab Data Science dan Business Intelligence menyediakan perangkat komputer yang canggih dan berkualitas tinggi untuk melakukan analisis data dan pengambilan keputusan bisnis yang akurat.",
        image: "/laboratorium/datascience_komputer.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121115-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen yang ada di Lab Data Science dan Business Intelligence di kampus sangat nyaman dan luas, sehingga dosen dapat bekerja dengan leluasa dan memantau kegiatan mahasiswa dengan mudah.",
        image: "/laboratorium/datascience_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121050-scaled.jpg"
      },
      {
        title: "Meja Aslab",
        description: "Meja asisten laboratorium yang terdapat di Laboratorium Data Science dan Business Intelligence di kampus sangat ergonomis dan dilengkapi dengan peralatan yang dibutuhkan, sehingga memudahkan asisten laboratorium dalam melakukan tugas-tugas mereka dan membantu mahasiswa dalam belajar.",
        image: "/laboratorium/datascience_mejaaslab.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121015-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Loker barang yang tersedia di Laboratorium Data Science dan Business Intelligence di kampus sangat aman dan terorganisir, sehingga memungkinkan mahasiswa untuk menyimpan peralatan dan bahan-bahan yang dibutuhkan dalam proses belajar dengan rapi dan aman.",
        image: "/laboratorium/datascience_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120120830-scaled.jpg"
      }
    ]
  },
  {
    id: "ai",
    code: "LAB·03",
    name: "Lab Riset Kecerdasan Buatan dan Sains Komputer",
    oldName: "eks. Lab Multimedia",
    facilities: [
      {
        title: "Komputer",
        description: "Lab riset kecerdasan buatan dan sains komputer menyediakan perangkat komputer yang canggih dan berkualitas tinggi untuk mendukung riset dan pengembangan dalam bidang kecerdasan buatan dan sains komputer.",
        image: "/laboratorium/ai_komputer.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118100051-scaled.jpg"
      },
      {
        title: "Samsung Flip",
        description: "Lab riset kecerdasan buatan dan sains komputer dilengkapi dengan Samsung Flip yang menggabungkan fitur-fitur whiteboard tradisional dengan teknologi digital untuk memberikan pengalaman presentasi yang lebih dinamis dan efektif.",
        image: "/laboratorium/ai_samsungflip.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230124104405-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Lab riset kecerdasan buatan dan sains komputer memiliki meja dosen yang nyaman dan profesional untuk mendukung kegiatan belajar mengajar dan riset yang dilakukan oleh para mahasiswa dan dosen.",
        image: "/laboratorium/ai_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118095421-scaled.jpg"
      },
      {
        title: "Meja Aslab",
        description: "Lab riset kecerdasan buatan dan sains komputer memiliki meja asisten lab yang modern dan ergonomis untuk mendukung kegiatan riset yang dilakukan oleh asisten lab.",
        image: "/laboratorium/ai_mejaaslab.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118100752-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Lab riset kecerdasan buatan dan sains komputer menyediakan loker barang yang aman dan berkualitas untuk menyimpan barang-barang pribadi para pengunjung lab.",
        image: "/laboratorium/ai_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118100728-scaled.jpg"
      }
    ]
  },
  {
    id: "programming",
    code: "LAB·04",
    name: "Lab Pemrograman dan Pengembangan Aplikasi",
    oldName: "eks. Lab RPL",
    facilities: [
      {
        title: "Komputer",
        description: "Komputer yang terdapat di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat canggih dan dilengkapi dengan software yang dibutuhkan untuk pemrograman dan pengembangan aplikasi, sehingga memudahkan mahasiswa dalam belajar dan mengejar cita-cita mereka dalam bidang teknologi.",
        image: "/laboratorium/programming_komputer.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230125092608-scaled.jpg"
      },
      {
        title: "Proyektor",
        description: "Proyektor yang tersedia di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat modern dan berkualitas tinggi, sehingga memungkinkan dosen untuk menyajikan materi dengan jelas dan menarik bagi mahasiswa dan memudahkan proses belajar.",
        image: "/laboratorium/programming_proyektor.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118104722-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen yang terdapat di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat ergonomis dan dilengkapi dengan peralatan teknologi terkini, sehingga dosen dapat memberikan pengajaran yang efektif dan menyenangkan bagi mahasiswa.",
        image: "/laboratorium/programming_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230126085213-scaled.jpg"
      },
      {
        title: "Meja Aslab",
        description: "Meja asisten laboratorium yang terdapat di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat ergonomis dan dilengkapi dengan peralatan yang dibutuhkan, sehingga memudahkan asisten laboratorium dalam melakukan tugas-tugas mereka dan membantu mahasiswa dalam belajar.",
        image: "/laboratorium/programming_mejaaslab.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118104607-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Loker barang yang tersedia di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat aman dan terorganisir, sehingga memungkinkan mahasiswa untuk menyimpan peralatan dan bahan-bahan yang dibutuhkan dalam proses belajar dengan rapi dan aman.",
        image: "/laboratorium/programming_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118104347-scaled.jpg"
      }
    ]
  }
];
---

<!-- Breadcrumbs -->
<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath("/", lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t("bread.home")}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li>
      <a href={localizePath("/profil", lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
        {t("bread.profil")}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">{t("bread.laboratorium")}</li>
  </ol>
</nav>

<section class="relative overflow-hidden py-16">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(217,182,93,0.18),_transparent_30%),linear-gradient(180deg,#f5faf4_0%,#ffffff_100%)]"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[30px] border border-[#dfeadf] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#d9b65d] p-6 shadow-[0_28px_80px_-32px_rgba(0,61,42,0.8)] sm:p-8 lg:p-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-white/90">
          {t("page.lab.badge")}
        </span>
        <h1 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
          {t("page.lab.title")}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
          {t("page.lab.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-6xl space-y-10 px-4 sm:px-6 lg:px-8">
    {laboratories.map((lab) => (
      <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)]">
        <div class="border-b border-slate-200 bg-[#f6faf3] px-5 py-5 sm:px-7">
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[#0b5c3d]">Ref. {lab.code}</p>
              <h2 class="mt-2 text-2xl font-black tracking-tight text-[#003d2a] sm:text-3xl">
                {lab.name}
              </h2>
            </div>
            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-dashed border-[#b9c9b1] bg-white px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {lab.oldName}
            </span>
          </div>
        </div>

        <div class="grid gap-5 p-5 md:grid-cols-2 md:p-6 lg:p-7">
          {lab.facilities.map((fac, idx) => (
            <article class="group overflow-hidden rounded-[24px] border border-slate-200 bg-[#f9faf7] transition-all duration-300 hover:-translate-y-1 hover:border-[#bfd8c6] hover:shadow-[0_20px_55px_-30px_rgba(11,92,61,0.35)]">
              <div class="flex h-full flex-col sm:flex-row">
                <div class="relative h-44 w-full overflow-hidden bg-slate-200 sm:h-auto sm:w-2/5">
                  <img
                    src={fac.image}
                    alt={fac.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                    onerror={`this.onerror=null; this.src='${fac.fallbackImage}';`}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/15 to-transparent"></div>
                </div>

                <div class="flex w-full flex-1 flex-col justify-center p-5 sm:p-6">
                  <span class="text-[10px] font-bold uppercase tracking-[0.24em] text-[#8a6a1d]">
                    Spec {String(idx + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-2 text-lg font-black leading-tight text-[#003d2a]">
                    {fac.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">
                    {fac.description}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>