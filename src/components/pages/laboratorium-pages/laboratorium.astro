        image: "/laboratorium/ai_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118100728-scaled.jpg"
      }
    ]
  },
  {
    id: "programming",
