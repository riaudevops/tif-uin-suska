        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121015-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Loker barang yang tersedia di Laboratorium Data Science dan Business Intelligence di kampus sangat aman dan terorganisir, sehingga memungkinkan mahasiswa untuk menyimpan peralatan dan bahan-bahan yang dibutuhkan dalam proses belajar dengan rapi dan aman.",
        image: "/laboratorium/datascience_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120120830-scaled.jpg"
      }
    ]
  },
  {
    id: "ai",
    code: "LAB·03",
    name: "Lab Riset Kecerdasan Buatan dan Sains Komputer",
    oldName: "eks. Lab Multimedia",
    facilities: [
      {
        title: "Komputer",
        description: "Lab riset kecerdasan buatan dan sains komputer menyediakan perangkat komputer yang canggih dan berkualitas tinggi untuk mendukung riset dan pengembangan dalam bidang kecerdasan buatan dan sains komputer.",
