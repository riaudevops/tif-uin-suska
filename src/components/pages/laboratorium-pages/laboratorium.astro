  },
  {
    id: "datascience",
    code: "LAB·02",
    name: "Lab Riset Data Science dan Business Intelligence",
    oldName: "eks. Lab Jaringan Komputer",
    facilities: [
      {
        title: "Komputer",
        description: "Lab Data Science dan Business Intelligence menyediakan perangkat komputer yang canggih dan berkualitas tinggi untuk melakukan analisis data dan pengambilan keputusan bisnis yang akurat.",
        image: "/laboratorium/datascience_komputer.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121115-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen yang ada di Lab Data Science dan Business Intelligence di kampus sangat nyaman dan luas, sehingga dosen dapat bekerja dengan leluasa dan memantau kegiatan mahasiswa dengan mudah.",
        image: "/laboratorium/datascience_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120121050-scaled.jpg"
      },
      {
