        image: "/laboratorium/programming_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230126085213-scaled.jpg"
      },
      {
        title: "Meja Aslab",
        description: "Meja asisten laboratorium yang terdapat di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat ergonomis dan dilengkapi dengan peralatan yang dibutuhkan, sehingga memudahkan asisten laboratorium dalam melakukan tugas-tugas mereka dan membantu mahasiswa dalam belajar.",
        image: "/laboratorium/programming_mejaaslab.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118104607-scaled.jpg"
      },
      {
        title: "Loker Barang",
        description: "Loker barang yang tersedia di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat aman dan terorganisir, sehingga memungkinkan mahasiswa untuk menyimpan peralatan dan bahan-bahan yang dibutuhkan dalam proses belajar dengan rapi dan aman.",
        image: "/laboratorium/programming_loker.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230118104347-scaled.jpg"
      }
    ]
  }
];
---

<!-- Breadcrumbs -->
<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100 font-sans">
        <li class="flex items-center">
            <a href={localizePath("/", lang)} class="flex items-center hover:text-[#004d2c] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <a href={localizePath("/profil", lang)} class="hover:text-[#004d2c] transition-colors">
                {t("bread.profil")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-[#004d2c] font-bold tracking-tight">
            {t("bread.laboratorium")}
        </li>
    </ol>
</nav>

<!-- Page Header -->
<section data-aos="fade-up" class="relative py-16 overflow-hidden font-sans bg-[#F7F5EF]">
  <!-- Blueprint grid backdrop -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
       style="background-image: linear-gradient(#1E3A5F 1px, transparent 1px), linear-gradient(90deg, #1E3A5F 1px, transparent 1px); background-size: 32px 32px;">
  </div>

  <div class="container mx-auto px-6 relative">
    <div class="max-w-3xl mx-auto text-center animate-fade-in">

      <span class="inline-flex items-center gap-2 px-4 py-1.5 border border-[#004d2c]/20 text-[#004d2c] rounded-full text-[11px] font-bold uppercase tracking-[0.25em] mb-6 font-mono">
        {t("page.lab.badge")}
      </span>

      <h1 data-aos="fade-up" class="text-4xl md:text-6xl font-black text-[#004d2c] mb-6 leading-[0.95] tracking-tight font-heading uppercase">
        {t("page.lab.title")}
      </h1>

      <p class="text-base md:text-lg text-slate-600 leading-relaxed font-sans max-w-xl mx-auto">
        {t("page.lab.desc")}
      </p>

    </div>
  </div>
</section>

<!-- Content Section -->
<section class="py-16 md:py-24 bg-white font-sans">
  <div class="container mx-auto px-6 max-w-6xl space-y-20 md:space-y-28">

    {laboratories.map((lab) => (
      <div class="space-y-10">

        <!-- Lab Header: blueprint-style title block -->
        <div class="border-b-2 border-[#004d2c]/10 pb-6">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
            <div>
              <span class="font-mono text-xs tracking-[0.3em] text-[#1E3A5F]/70 uppercase">
                Ref. {lab.code}
              </span>
              <h2 class="text-2xl md:text-4xl font-black text-[#004d2c] font-heading tracking-tight leading-snug uppercase mt-1">
                {lab.name}
              </h2>
            </div>
            <span class="inline-flex items-center gap-2 self-start md:self-auto px-3 py-1.5 bg-[#F7F5EF] border border-dashed border-[#1E3A5F]/30 rounded font-mono text-[10px] tracking-[0.15em] text-slate-500 uppercase whitespace-nowrap">
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {lab.oldName}
            </span>
          </div>
        </div>

        <!-- Facility Plaque Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {lab.facilities.map((fac, idx) => (
            <div class="group relative bg-[#F7F5EF] border border-[#004d2c]/10 rounded-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                 style="clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);">

              <!-- Notched corner accent -->
              <div class="absolute top-0 right-0 w-5 h-5 bg-[#D4A017]"></div>

              <div class="flex flex-col sm:flex-row">
                <!-- Image -->
                <div class="relative w-full sm:w-2/5 h-44 sm:h-auto shrink-0 overflow-hidden bg-[#0e2954]">
                  <img
                    src={fac.image}
                    alt={fac.title}
                    class="w-full h-full object-cover grayscale-[15%] group-hover:grayscale-0 transition-all duration-500"
                    onerror={`this.onerror=null; this.src='${fac.fallbackImage}';`}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0e2954]/30 to-transparent sm:hidden"></div>
                </div>

                <!-- Spec content -->
                <div class="w-full sm:w-3/5 p-6 flex flex-col justify-center relative">
                  <span class="font-mono text-[10px] tracking-[0.25em] text-[#1E3A5F] uppercase mb-2">
                    Spec {String(idx + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-black text-[#004d2c] font-heading tracking-tight mb-2 leading-tight">
                    {fac.title}
                  </h3>
                  <p class="text-xs md:text-sm text-slate-600 leading-relaxed">
                    {fac.description}
                  </p>

                  <!-- Dashed measurement line decoration -->
                  <div class="absolute bottom-3 right-4 w-10 border-t border-dashed border-[#1E3A5F]/25 hidden md:block"></div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    ))}

  </div>
</section>