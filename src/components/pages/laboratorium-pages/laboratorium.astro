    name: "Lab Pemrograman dan Pengembangan Aplikasi",
    oldName: "eks. Lab RPL",
    facilities: [
      {
        title: "Komputer",
        description: "Komputer yang terdapat di Laboratorium Pemrograman dan Pengembangan Aplikasi sangat canggih dan dilengkapi dengan software yang dibutuhkan untuk pemrograman dan pengembangan aplikasi, sehingga memudahkan mahasiswa dalam belajar dan mengejar cita-cita mereka dalam bidang teknologi.",
