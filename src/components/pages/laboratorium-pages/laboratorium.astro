        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091459-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Lab Technopreneur dan Inkubator Bisnis memiliki meja dosen yang nyaman dan profesional untuk mendukung kegiatan belajar mengajar dan riset yang dilakukan oleh para dosen dalam bidang technopreneurship dan inkubator bisnis.",
        image: "/laboratorium/technopreneur_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/01/IMG20230120091415-scaled.jpg"
      },
      {
        title: "Meja Aslab",
