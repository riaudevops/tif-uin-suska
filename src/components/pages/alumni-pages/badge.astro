---
const statistikAlumni = [
  { label: "Total Alumni", nilai: "2,500+", warna: "#0B6E4F" },
  { label: "Masa Tunggu Kerja", nilai: "< 3 Bulan", warna: "#F0B429" },
  { label: "Bekerja di Luar Negeri", nilai: "15%", warna: "#1D5FAE" },
  { label: "Wirausaha/Founder", nilai: "10%", warna: "#0B6E4F" },
];
---

<section class="relative py-16 z-10 max-w-7xl mx-auto -mt-8 md:-mt-10 px-5 md:px-8">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    {statistikAlumni.map((stat: any) => (
      <div class="bg-white rounded-2xl border border-slate-100 shadow-[0_4px_16px_rgb(0,0,0,0.06)] px-5 py-5">
        <div class="w-8 h-1 rounded-full mb-3" style={`background-color:${stat.warna}`}></div>
        <div class="text-2xl md:text-3xl font-extrabold text-[#1C1B18] mb-1">{stat.nilai}</div>
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{stat.label}</div>
      </div>
    ))}
  </div>
</section>