---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<section data-aos="fade-up" class="relative mt-4 py-2">
    <div class="relative z-20 text-center w-full">
        <h1 data-aos="fade-up" class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-emerald-900 leading-tight tracking-tight mt-4">
            {isEn ? 'Study Program' : 'Tujuan'} 
                <span class="text-yellow-400">{isEn ? 'Objectives' : 'Prodi'}</span>
            <br />
            {isEn ? 'Informatics Engineering' : 'Teknik Informatika'}
        </h1>
    </div>
</section>

<section class="max-w-7xl mx-auto px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    
        <div class="group relative bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:border-yellow-400/60 transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center gap-4 mb-4">
                <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-emerald-700 text-white font-black text-2xl shadow-lg shadow-emerald-900/20 group-hover:scale-105 transition-transform duration-300">
                    1
                </div>
                <h4 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition">
                    {isEn ? 'Superior Graduates' : 'Lulusan Unggul'}
                </h4>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
                {isEn ? 'Producing superior graduates in Informatics with Islamic morals by 2033' : 'Menghasilkan lulusan yang unggul di bidang Informatika dan memiliki akhlak yang Islami pada tahun 2033'}
            </p>
        </div>

        <div class="group relative bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:border-yellow-400/60 transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center gap-4 mb-4">
                <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-emerald-700 text-white font-black text-2xl shadow-lg shadow-emerald-900/20 group-hover:scale-105 transition-transform duration-300">
                    2
                </div>
                <h4 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition">
                    {isEn ? 'Integrative Curriculum' : 'Kurikulum Integratif'}
                </h4>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
                {isEn ? 'Producing an Informatics syllabus and curriculum that integrates Islamic values by 2033' : 'Menghasilkan silabus dan kurikulum Informatika yang mengintegrasikan keislaman pada tahun 2033'}
            </p>
        </div>

        <div class="group relative bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:border-yellow-400/60 transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center gap-4 mb-4">
                <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-emerald-700 text-white font-black text-2xl shadow-lg shadow-emerald-900/20 group-hover:scale-105 transition-transform duration-300">
                    3
                </div>
                <h4 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition">
                    {isEn ? 'Scientific Works' : 'Karya Ilmiah'}
                </h4>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
                {isEn ? 'Producing scientific works in Informatics that integrate Islamic values by 2033' : 'Menghasilkan karya-karya ilmiah di bidang Informatika yang mengintegrasikan nilai keislaman pada tahun 2033'}
            </p>
        </div>

        <div class="group relative bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:border-yellow-400/60 transition-all duration-300 transform hover:-translate-y-1">
            <div class="flex items-center gap-4 mb-4">
                <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-emerald-700 text-white font-black text-2xl shadow-lg shadow-emerald-900/20 group-hover:scale-105 transition-transform duration-300">
                    4
                </div>
                <h4 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition">
                    {isEn ? 'Innovative Contribution' : 'Kontribusi Inovatif'}
                </h4>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
                {isEn ? 'Contributing through integrative and innovative knowledge in Informatics to build the nation by 2033' : 'Berkonstribusi melalui pengetahuan integratif dan inovatif dalam kajian Informatika untuk membangun bangsa pada tahun 2033'}
            </p>
        </div>

    </div>
</section>