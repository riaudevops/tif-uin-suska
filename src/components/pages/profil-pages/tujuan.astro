---
import { getLocaleFromUrl, useTranslations } from "@/lib/translations.js";
import {
  GraduationCap,
  BookOpenCheck,
  Cpu,
  Globe2,
  Target
} from "@lucide/astro";

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";

const objectives = isEn
  ? [
      {
        num: "01",
        title: "Graduate Competence with Islamic Character",
        desc: "Producing graduates who are competent in information technology, professionally prepared, and grounded in strong Islamic values.",
        icon: GraduationCap
      },
      {
        num: "02",
        title: "Curriculum Aligned with OBE and Industry Needs",
        desc: "Developing a curriculum that follows outcomes-based learning and remains relevant to current developments in science and industry.",
        icon: BookOpenCheck
      },
      {
        num: "03",
        title: "Research and Scientific Publications",
        desc: "Encouraging research activities, applied technology development, and scholarly work that contribute to the advancement of knowledge.",
        icon: Cpu
      },
      {
        num: "04",
        title: "Contribution to Society and National Development",
        desc: "Supporting digital transformation through community engagement, applied innovation, and development that benefits society.",
        icon: Globe2
      }
    ]
  : [
      {
        num: "01",
        title: "Lulusan Kompeten Berkarakter Islami",
        desc: "Menghasilkan lulusan yang kompeten di bidang teknologi informasi, siap bekerja, dan memiliki landasan karakter Islami yang kuat.",
        icon: GraduationCap
      },
      {
        num: "02",
        title: "Kurikulum Sesuai OBE dan Kebutuhan Industri",
        desc: "Menyelenggarakan kurikulum berbasis Outcomes-Based Education yang relevan dengan perkembangan ilmu dan kebutuhan dunia kerja.",
        icon: BookOpenCheck
      },
      {
        num: "03",
        title: "Riset dan Publikasi Ilmiah",
        desc: "Mendorong kegiatan penelitian, pengembangan teknologi terapan, dan karya ilmiah yang berkontribusi pada kemajuan keilmuan.",
        icon: Cpu
      },
      {
        num: "04",
        title: "Kontribusi bagi Masyarakat dan Bangsa",
        desc: "Mendukung transformasi digital melalui pengabdian, inovasi terapan, dan pembangunan yang memberi manfaat bagi masyarakat.",
        icon: Globe2
      }
    ];
---

<section data-aos="fade-up" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
  <div class="mb-10 text-center">
    <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-secondary/15 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-900">
      <Target class="w-3.5 h-3.5 text-primary" />
      {isEn ? "Program Educational Objectives" : "Tujuan Pendidikan Program Studi"}
    </span>
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      {isEn ? "Educational Goals and Commitment" : "Tujuan Pendidikan dan Komitmen"}
    </h2>
    <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
      {isEn
        ? "The study program defines educational objectives that support graduate competence, professional readiness, and the values expected in an academic community."
        : "Program studi menetapkan tujuan pendidikan yang mendukung kompetensi lulusan, kesiapan kerja, serta nilai-nilai yang diharapkan dalam komunitas akademik."}
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
    {objectives.map((item) => {
      const IconComponent = item.icon;
      return (
        <div class="group flex h-full flex-col rounded-[26px] border border-gray-200 bg-white p-6 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_20px_45px_-22px_rgba(0,61,42,0.35)]">
          <div class="mb-5 flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-300 group-hover:bg-primary group-hover:text-white">
              <IconComponent class="h-5 w-5" />
            </div>
            <span class="font-mono text-2xl font-black text-gray-300 transition-colors duration-300 group-hover:text-secondary">
              {item.num}
            </span>
          </div>

          <h3 class="mb-3 text-lg font-bold text-gray-900 group-hover:text-primary transition-colors duration-300">
            {item.title}
          </h3>

          <p class="text-sm leading-relaxed text-gray-600">
            {item.desc}
          </p>
        </div>
      );
    })}
  </div>
</section>