---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<section data-aos="fade-up" class="relative mt-4 py-6 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0e5d3d] to-[#0e7b4d] shadow-[0_25px_80px_-28px_rgba(0,61,42,0.8)] p-7 md:p-10 lg:p-14">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(255,214,102,0.25),_transparent_26%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.10),_transparent_30%)]"></div>
            <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-secondary/15 blur-3xl"></div>
           
            <div class="relative z-10 text-white">
                <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.25em] text-white/90 backdrop-blur-sm">
                    <span class="h-2 w-2 rounded-full bg-secondary"></span>
                    {isEn ? 'Future Career Opportunities' : 'Peluang Karir Masa Depan'}
                </div>

                <h1 data-aos="fade-up" class="text-4xl md:text-5xl lg:text-6xl font-black leading-[0.95] tracking-tight">
                    {isEn ? 'Career' : 'Prospek'} <span class="text-secondary">{isEn ? 'Paths' : 'Karier'}</span>
                    <br />
                    {isEn ? 'for Informatics Graduates' : 'Lulusan Teknik Informatika'}
                </h1>

                <div class="mt-8 flex flex-wrap gap-3 text-sm text-gray-100">
                    <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1.5 backdrop-blur-sm">{isEn ? 'Software' : 'Perangkat Lunak'}</span>
                    <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1.5 backdrop-blur-sm">{isEn ? 'Data & AI' : 'Data & AI'}</span>
                    <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1.5 backdrop-blur-sm">{isEn ? 'Systems & Infrastructure' : 'Sistem & Infrastruktur'}</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 lg:pb-20">
    <div class="mb-10 text-center">
        <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-secondary/15 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-900">
            <span class="h-2 w-2 rounded-full bg-primary"></span>
            {isEn ? 'Career Pathways' : 'Jalur Karier'}
        </span>
        <h2 data-aos="fade-up" class="text-3xl md:text-4xl font-black text-emerald-900 mb-4">
            {isEn ? 'Career Opportunities in the Digital Era' : 'Peluang Karier di Era Digital'}
        </h2>
        <p class="text-slate-600 text-lg max-w-3xl mx-auto leading-relaxed">
            {isEn ? 'Graduates of the Informatics Engineering Study Program are prepared to work in software development, systems, data, infrastructure, and digital services across public and private institutions.' : 'Lulusan Program Studi Teknik Informatika dipersiapkan untuk bekerja di bidang pengembangan perangkat lunak, sistem, data, infrastruktur, serta layanan digital di lembaga pemerintah, perusahaan, dan industri teknologi.'}
        </p>
    </div>

    <!-- Grid Profesi -->
    <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
        <!-- Item -->
        <div
            class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_10px_35px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/60 hover:shadow-[0_18px_40px_-18px_rgba(0,77,44,0.35)]"
        >
            <div class="flex items-center gap-4">
                <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 transition-all duration-300 group-hover:bg-emerald-700 group-hover:text-white"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 01-1.265.633l-4-2a1 1 0 01-.633-1.265l4-12a1 1 0 011.265-.633l4 2zM4.062 14.643L9.047 5.76a.5.5 0 00-.638-.288L3.424 14.355a.5.5 0 00.638.288z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Programmer
                </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-500">
                {isEn ? 'Developing, testing, and maintaining program code.' : 'Mengembangkan, menguji, dan memelihara kode program.'}
            </p>
        </div>

        <div
            class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_10px_35px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/60 hover:shadow-[0_18px_40px_-18px_rgba(0,77,44,0.35)]"
        >
            <div class="flex items-center gap-4">
                <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 transition-all duration-300 group-hover:bg-emerald-700 group-hover:text-white"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 2a8 8 0 100 16 8 8 0 000-16zm-3 9a1 1 0 100 2h6a1 1 0 100-2H7z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Executive
                </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-500">
                {isEn ? 'Managing technology projects and IT teams.' : 'Mengelola proyek teknologi dan tim IT.'}
            </p>
        </div>

        <div
            class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_10px_35px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/60 hover:shadow-[0_18px_40px_-18px_rgba(0,77,44,0.35)]"
        >
            <div class="flex items-center gap-4">
                <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 transition-all duration-300 group-hover:bg-emerald-700 group-hover:text-white"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 00-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM16 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Administrator
                </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-500">
                {isEn ? 'Managing systems and technology infrastructure.' : 'Mengelola sistem dan infrastruktur teknologi.'}
            </p>
        </div>

        <div
            class="group rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_10px_35px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-secondary/60 hover:shadow-[0_18px_40px_-18px_rgba(0,77,44,0.35)]"
        >
            <div class="flex items-center gap-4">
                <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 transition-all duration-300 group-hover:bg-emerald-700 group-hover:text-white"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18H4a2 2 0 01-2-2v-2A6 6 0 0112 8c2.149 0 4.103.886 5.56 2.309-1.464.218-2.924.49-4.343.896C10.51 11.237 9.5 12.341 9.5 13.5v1.5a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5v-1.5a2.5 2.5 0 00-2.5-2.5H6z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Manager
                </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-500">
                {isEn ? 'Leading IT teams and overseeing technology operations.' : 'Memimpin tim IT dan mengawasi operasi teknologi.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm-3.707-8.707a1 1 0 000 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V6a1 1 0 10-2 0v5.586L7.707 9.293a1 1 0 00-1.414 0z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Project Manager
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Planning and managing IT projects from start to finish.' : 'Merencanakan dan mengelola proyek IT dari awal hingga akhir.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17.555 17.555A8.001 8.001 0 0013.92 14H12a2 2 0 01-2-2v-1.414a1 1 0 01.293-.707l2.121-2.121a1 1 0 011.414 0l2.121 2.121a1 1 0 01.293.707V12a2 2 0 01-2 2h-1.92a8.001 8.001 0 00-3.635 3.555L10 20h8a2 2 0 002-2v-1a2 2 0 00-2-2zM4 10a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Support Officer
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Providing technical support to users.' : 'Memberikan dukungan teknis kepada pengguna.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            d="M5.5 10a.5.5 0 100 1h1a.5.5 0 100-1h-1zM10.5 10a.5.5 0 100 1h1a.5.5 0 100-1h-1zM15.5 10a.5.5 0 100 1h1a.5.5 0 100-1h-1z"
                        ></path>
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm-7.707-1.707a1 1 0 011.414-1.414L10 14.586l4.293-4.293a1 1 0 111.414 1.414L11.414 16l4.293 4.293a1 1 0 01-1.414 1.414L10 17.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 16l-4.293-4.293a1 1 0 01-1.414 0z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    IT Services
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Providing various information technology services.' : 'Menyediakan berbagai layanan teknologi informasi.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    System Analyst
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Analyzing system needs and designing solutions.' : 'Menganalisis kebutuhan sistem dan merancang solusi.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M11.49 3.17c-.38-.15-.77-.32-1.18-.49L9.19 1.13A1 1 0 008 1.95V3.06c-1.35.34-2.57.94-3.67 1.77L2.45 3.37A1 1 0 00.93 4.28L4.35 7.42c-.22.84-.34 1.71-.34 2.6V15a1 1 0 001 1h10a1 1 0 001-1v-4.98c0-.88-.12-1.75-.34-2.6l3.42-3.14a1 1 0 00-1.52-.91l-2.07 1.34c-1.1-.83-2.32-1.43-3.67-1.77V1.95a1 1 0 00-1.19-.82l-.01.01zM10 10.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    System Engineer
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Designing, developing, and maintaining complex systems.' : 'Mendesain, mengembangkan, dan memelihara sistem kompleks.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M3 3a1 1 0 00-1 1v12a1 1 0 001 1h14a1 1 0 001-1V4a1 1 0 00-1-1H3zm9.383 6.002a.75.75 0 011.06 0l2.5 2.5a.75.75 0 010 1.06L13.443 15a.75.75 0 01-1.06 0l-.75-.75a.75.75 0 010-1.06L13.13 12l-1.447-1.447a.75.75 0 010-1.06zM7 8a1 1 0 00-1 1v2a1 1 0 102 0V9a1 1 0 00-1-1z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    Analyst Programmer
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Combining system analysis with program development.' : 'Menggabungkan analisis sistem dengan pengembangan program.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 12a2 2 0 100-4 2 2 0 000 4z"
                            clip-rule="evenodd"></path>
                        <path
                            fill-rule="evenodd"
                            d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    Database Administrator
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Managing, maintaining, and securing databases.' : 'Mengelola, memelihara, dan mengamankan database.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    Network Administrator
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Managing and maintaining network infrastructure.' : 'Mengatur dan memelihara infrastruktur jaringan.'}
            </p>
        </div>

        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 01-1.265.633l-4-2a1 1 0 01-.633-1.265l4-12a1 1 0 011.265-.633l4 2zM4.062 14.643L9.047 5.76a.5.5 0 00-.638-.288L3.424 14.355a.5.5 0 00.638.288z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
                >
                    Network Engineer
                </span>
            </div>
            <p class="text-sm text-slate-500 mt-3">
                {isEn ? 'Designing and implementing network solutions.' : 'Mendesain dan mengimplementasikan solusi jaringan.'}
            </p>
