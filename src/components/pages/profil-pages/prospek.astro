---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<section class="relative mt-4 py-4 lg:py-16">
    <div class="max-w-7xl mx-auto px-8">
        <div
            class="relative overflow-hidden rounded-3xl shadow-2xl bg-gradient-to-br from-emerald-900 to-green-950 min-h-[250px] flex items-center justify-center p-8 md:p-12 lg:p-16"
        >
            <div
                class="absolute inset-0 bg-[url('/landing-pages/gedung-faste.jpg')] bg-cover bg-center opacity-20"
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-br from-emerald-900/80 via-green-800/60 to-transparent z-10"
            >
            </div>

            <div class="relative z-20 text-white text-center w-full">
                <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">
                    {isEn ? 'Future Career Opportunities' : 'Peluang Karir Masa Depan'}
                </span>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight mt-4"
                >
                    {isEn ? 'Job' : 'Prospek'} <span class="text-yellow-400">{isEn ? 'Prospects' : 'Pekerjaan'}</span>
                    <br />
                    {isEn ? 'Informatics Engineering Graduates' : 'Lulusan Teknik Informatika'}
                </h1>
            </div>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto px-8">
    <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">
            {isEn ? 'Various Career Opportunities Await' : 'Beragam Kesempatan Karir Menanti'}
        </h2>
        <p class="text-slate-600 text-lg max-w-2xl mx-auto">
            {isEn ? 'Graduates of the Informatics Engineering Study Program are equipped with adaptive competencies with broad global career coverage, from cutting-edge software engineering to network architecture and governance across various modern technology sectors.' : 'Lulusan Program Studi Teknik Informatika dibekali kompetensi adaptif dengan cakupan karier global yang luas mulai dari rekayasa perangkat lunak mutakhir hingga arsitektur dan tata kelola jaringan di berbagai sektor teknologi modern.'}
        </p>
    </div>

    <!-- Grid Profesi -->
    <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
        <!-- Item -->
        <div
            class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-md hover:border-yellow-400/80 hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300"
        >
            <div class="flex items-center gap-4">
                <div
                    class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 group-hover:bg-emerald-700 group-hover:text-white transition-all duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 01-1.265.633l-4-2a1 1 0 01-.633-1.265l4-12a1 1 0 011.265-.633l4 2zM4.062 14.643L9.047 5.76a.5.5 0 00-.638-.288L3.424 14.355a.5.5 0 00.638.288z"
                            clip-rule="evenodd"></path>
                    </svg>
                </div>
                <span
                    class="font-bold text-slate-800 text-lg group-hover:text-emerald-700 transition-colors duration-300"
