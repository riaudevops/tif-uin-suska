---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Award,
  FileText,
  CheckCircle2,
  Calendar,
  DollarSign,
  ArrowRight,
  Sparkles,
  BookOpen,
  GraduationCap,
  ExternalLink,
  ShieldCheck,
  Building2
} from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
const API_URL = import.meta.env.BASE_API_URL || 'http://localhost:8055';

interface BeasiswaItem {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  thumbnail: string;
  category?: string;
  deadline?: string;
}

let items: BeasiswaItem[] = [];
let fetchError = false;

try {
  const res = await fetch(`${API_URL}/items/beasiswa?fields=id,title,slug,excerpt,published_at,thumbnail,category,deadline&sort=-published_at`);
  if (res.ok) {
    const data = await res.json();
    items = (data.data || []).map((d: any) => ({
      id: d.id,
      title: d.title || (isEn ? 'Untitled Scholarship' : 'Tanpa Judul'),
      slug: d.slug || d.id,
      excerpt: d.excerpt || '',
      date: d.published_at 
        ? new Date(d.published_at).toLocaleDateString(isEn ? 'en-US' : 'id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) 
        : '',
      thumbnail: d.thumbnail ? `${API_URL}/assets/${d.thumbnail}` : '',
      category: d.category || (isEn ? 'Scholarship Program' : 'Program Beasiswa'),
      deadline: d.deadline || ''
    }));
  } else {
    fetchError = true;
  }
} catch (e) {
  console.error('Error fetching Beasiswa items:', e);
  fetchError = true;
}

// Scholarship Categories Overview
const scholarshipCategories = isEn ? [
  {
    title: "Government & KIP-K",
    desc: "Full educational grants from KIP-Kuliah and provincial government (Pemprov Riau).",
    badge: "Government",
    icon: Building2
  },
  {
    title: "Corporate & BI (GenBI)",
    desc: "Monthly stipends and leadership training by Bank Indonesia, Djarum, BRI, and partners.",
    badge: "Corporate",
    icon: Award
  },
  {
    title: "Achievement & Tahfizh",
    desc: "Merit awards for academic excellence, competition winners, and Qur'an memorizers.",
    badge: "Merit Based",
    icon: Sparkles
  },
  {
    title: "Financial Aid & UKT Support",
    desc: "Tuition fee reduction schemes and emergency financial relief for active students.",
    badge: "Tuition Relief",
    icon: ShieldCheck
  }
] : [
  {
    title: "Beasiswa Pemerintah & KIP-K",
    desc: "Bantuan biaya pendidikan penuh dari KIP-Kuliah dan Pemerintah Provinsi Riau.",
    badge: "Pemerintah",
    icon: Building2
  },
  {
    title: "Beasiswa Mitra Bank & BUMN",
    desc: "Uang saku bulanan dan pelatihan kepemimpinan dari Bank Indonesia (GenBI), Djarum, BRI, dll.",
    badge: "Mitra Industri",
    icon: Award
  },
  {
    title: "Beasiswa Prestasi & Tahfizh",
    desc: "Apresiasi bagi mahasiswa berprestasi nasional/internasional dan penghafal Al-Qur'an.",
    badge: "Berdasarkan Prestasi",
    icon: Sparkles
  },
  {
    title: "Bantuan Keringanan UKT",
    desc: "Skema penyesuaian kelompok UKT dan bantuan finansial bagi mahasiswa membutuhkan.",
    badge: "Bantuan Finansial",
    icon: ShieldCheck
  }
];

// Workflow Steps
const applicationSteps = isEn ? [
  { step: "01", title: "Check Eligibility", desc: "Ensure GPA >= 3.00, active student status, and required certificates.", icon: CheckCircle2 },
  { step: "02", title: "Prepare Documents", desc: "Gather transcript, recommendation letter, and statement of non-receipt of other grants.", icon: FileText },
  { step: "03", title: "Online Application", desc: "Submit application form via iRaise portal or official partner link.", icon: GraduationCap },
  { step: "04", title: "Interview & Selection", desc: "Administrative verification and interview by selection board.", icon: Award }
] : [
  { step: "01", title: "Cek Kriteria & IPK", desc: "Pastikan IPK minimal 3.00, status mahasiswa aktif, dan kelengkapan berkas.", icon: CheckCircle2 },
  { step: "02", title: "Siapkan Berkas", desc: "Kumpulkan transkrip nilai, surat rekomendasi Prodi, dan surat pernyataan.", icon: FileText },
  { step: "03", title: "Pendaftaran Online", desc: "Isi formulir melalui portal iRaise atau situs resmi penyedia beasiswa.", icon: GraduationCap },
  { step: "04", title: "Seleksi & Wawancara", desc: "Verifikasi berkas administrasi dan wawancara oleh tim seleksi.", icon: Award }
];


// Fallback announcements if Directus empty
const fallbackAnnouncements: BeasiswaItem[] = isEn ? [
  {
    id: 'bs-fb-1',
    title: 'Bank Indonesia (GenBI) Scholarship Opening 2026',
    slug: 'beasiswa-bank-indonesia-genbi-2026',
    excerpt: 'Opportunity for active students in semester 4-6 to receive monthly stipends and join GenBI leadership community.',
    date: '18 January 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Bank Indonesia',
    deadline: '28 February 2026'
  },
  {
    id: 'bs-fb-2',
    title: 'KIP Kuliah & Provincial Government Educational Grant Selection',
    slug: 'pendaftaran-kip-kuliah-2026',
    excerpt: 'Registration guidelines for new and ongoing informatics students for full tuition coverage.',
    date: '10 January 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'KIP-Kuliah',
    deadline: '15 March 2026'
  },
  {
    id: 'bs-fb-3',
    title: 'Djarum Beasiswa Plus Prestasi & Leadership Development',
    slug: 'djarum-beasiswa-plus-2026',
    excerpt: 'Merit-based scholarship program offering soft skills training and financial support for semester 4 students.',
    date: '05 January 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Djarum Plus',
    deadline: '30 April 2026'
  }
] : [
  {
    id: 'bs-fb-1',
    title: 'Pembukaan Pendaftaran Beasiswa Bank Indonesia (GenBI) Tahun 2026',
    slug: 'beasiswa-bank-indonesia-genbi-2026',
    excerpt: 'Kesempatan bagi mahasiswa aktif semester 4 dan 6 untuk mendapatkan bantuan uang saku bulanan dan pelatihan leadership.',
    date: '18 Januari 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Bank Indonesia',
    deadline: '28 Februari 2026'
  },
  {
    id: 'bs-fb-2',
    title: 'Pendaftaran & Verifikasi Berkas KIP Kuliah & Beasiswa Pemprov Riau',
    slug: 'pendaftaran-kip-kuliah-2026',
    excerpt: 'Informasi dan alur verifikasi berkas bagi mahasiswa Teknik Informatika penerima bantuan biaya pendidikan penuh.',
    date: '10 Januari 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'KIP-Kuliah',
    deadline: '15 Maret 2026'
  },
  {
    id: 'bs-fb-3',
    title: 'Program Djarum Beasiswa Plus & Pelatihan Soft Skills Mahasiswa',
    slug: 'djarum-beasiswa-plus-2026',
    excerpt: 'Program beasiswa prestasi bagi mahasiswa semester 4 dengan bantuan dana serta pembekalan karakter dan kepemimpinan.',
    date: '05 Januari 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Djarum Plus',
    deadline: '30 April 2026'
  }
];

const displayItems = items.length > 0 ? items : fallbackAnnouncements;
---

<div class="font-sans bg-slate-50/60 min-h-screen">
  
  {/* Breadcrumb Navigation */}
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-4 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-slate-500 py-3 border-b border-slate-100">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center hover:text-emerald-700 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/profil', lang)} class="hover:text-emerald-700 transition-colors">
          {t("nav.akademik")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="text-emerald-700 font-bold tracking-tight">
        {t("page.beasiswa.title")}
      </li>
    </ol>
  </nav>

  {/* Hero Header Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-secondary/10 blur-3xl"></div>
      <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
            <Award class="w-4 h-4 text-[#f7de8a]" />
            {t("page.beasiswa.badge")}
          </span>

          <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
            {isEn ? 'Scholarship & Educational Grants' : 'Info & Program Beasiswa'}
          </h1>
        </div>

        <div class="rounded-[24px] border border-white/10 bg-[#dcecd1]/10 p-5 backdrop-blur-sm">
          <p class="text-base leading-relaxed text-gray-100 sm:text-lg">
            {isEn
              ? 'Official portal for government scholarships, corporate partners, academic merit awards, and tuition fee relief for Informatics Engineering students.'
              : 'Pusat informasi resmi berbagai skema beasiswa pemerintah, mitra industri, prestasi akademik, serta bantuan keringanan UKT bagi mahasiswa Teknik Informatika UIN Suska Riau.'}
          </p>
        </div>
      </div>

      <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Skema</p>
          <p class="mt-2 text-2xl font-black text-white">15+</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Biaya</p>
          <p class="mt-2 text-2xl font-black text-white">Full / Partial</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Semester</p>
          <p class="mt-2 text-2xl font-black text-white">2 - 8</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">IPK</p>
          <p class="mt-2 text-2xl font-black text-white">≥ 3.00</p>
        </div>
      </div>
    </div>
  </section>

  {/* Scholarship Categories Overview */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {isEn ? 'Scholarship Categories' : 'Kategori Beasiswa'}
      </span>
      <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        {isEn ? 'Diverse Funding Opportunities' : 'Ragam Skema & Dukungan Pembiayaan'}
      </h2>
      <p class="mt-2 text-sm text-slate-500">
        {isEn ? 'Explore available funding programs tailored to your academic profile.' : 'Jelajahi berbagai kategori beasiswa yang disesuaikan dengan kebutuhan dan prestasi mahasiswa.'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {scholarshipCategories.map((item) => {
        const IconComponent = item.icon;
        return (
          <div class="flex flex-col justify-between rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div>
              <div class="mb-6 flex items-center justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="rounded-lg bg-[#f4f0dd] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#5a4c18]">
                  {item.badge}
                </span>
              </div>
              <h3 class="mb-2 text-lg font-bold text-slate-900">
                {item.title}
              </h3>
              <p class="text-sm leading-relaxed text-slate-500">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  {/* Application Workflow Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-[30px] border border-slate-200 bg-[#f8faf3] p-6 shadow-[0_18px_45px_-35px_rgba(15,23,42,0.25)] sm:p-8 lg:p-10">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? 'Application Steps' : 'Alur Pengajuan'}
        </span>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          {isEn ? 'General Scholarship Application Process' : 'Tata Cara & Langkah Pengajuan Beasiswa'}
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {applicationSteps.map((step) => {
          const IconComp = step.icon;
          return (
            <div class="flex flex-col justify-between rounded-[24px] border border-slate-200 bg-white p-5 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)]">
              <div>
                <div class="mb-4 flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">{step.step}</span>
                  <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
                    <IconComp class="w-5 h-5" />
                  </div>
                </div>
                <h4 class="mb-2 text-base font-bold text-slate-900">{step.title}</h4>
                <p class="text-sm leading-relaxed text-slate-600">{step.desc}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>


  {/* Main Announcements Grid Section */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="mb-2 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? 'Latest Openings & News' : 'Pengumuman Beasiswa Terbuka'}
        </span>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          {isEn ? 'Active Scholarship Announcements' : 'Informasi Pengumuman Beasiswa'}
        </h2>
      </div>
      <p class="max-w-sm text-sm text-slate-500">
        {isEn ? 'Check deadlines and registration links for active scholarship programs.' : 'Cek batas waktu pendaftaran dan persyaratan rincinya.'}
      </p>
    </div>

    {displayItems.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-100 shadow-sm">
        <p class="text-slate-500 text-base mb-2">
          {t("page.beasiswa.empty")}
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {displayItems.map((item) => (
          <article class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
            <div>
              {/* Thumbnail Image */}
              <div class="relative w-full h-48 bg-slate-100 overflow-hidden">
                <img 
                  src={item.thumbnail || '/landing-pages/gedung-faste.jpg'} 
                  alt={item.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  onError="this.onerror=null; this.src='/landing-pages/gedung-faste.jpg';"
                />
                <span class="absolute top-4 left-4 px-3 py-1 bg-slate-900/80 backdrop-blur-md text-teal-300 text-xs font-bold rounded-full border border-teal-500/30">
                  {item.category || (isEn ? 'Scholarship' : 'Beasiswa')}
                </span>
              </div>

              {/* Card Body */}
              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <div class="flex items-center gap-1.5">
                    <Calendar class="w-3.5 h-3.5 text-teal-600" />
                    <span>{item.date || (isEn ? 'Recent' : 'Terbaru')}</span>
                  </div>

                  {item.deadline && (
                    <span class="px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded font-semibold text-[11px]">
                      Deadline: {item.deadline}
                    </span>
                  )}
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-teal-700 transition-colors line-clamp-2 leading-snug">
                  {item.title}
                </h3>

                <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed mb-4">
                  {item.excerpt || (isEn ? 'Click details to read complete requirements and application link.' : 'Klik selengkapnya untuk membaca kriteria dan formulir pendaftarannya.')}
                </p>
              </div>
            </div>

            {/* Footer Action */}
            <div class="px-6 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between">
              <a 
                href={localizePath(`/beasiswa/${item.slug}`, lang)} 
                class="inline-flex items-center gap-1.5 text-sm font-bold text-teal-700 hover:text-teal-800 group-hover:translate-x-1 transition-transform"
              >
                {t("common.detail")}
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

  </section>

</div>
