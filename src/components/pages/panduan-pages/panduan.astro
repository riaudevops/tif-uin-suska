---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Home,
  ChevronRight,
  BookOpen,
  Download,
  FileText,
  GraduationCap,
  ClipboardList,
  Scale,
  UserCheck,
  ShieldCheck,
  ArrowRight,
} from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const pillars = isEn
  ? [
      {
        title: 'Academic Process',
        desc: 'Sets clear procedures for learning activities, assessment, and academic administration within the study program.',
        icon: GraduationCap,
      },
      {
        title: 'Operational Standards',
        desc: 'Provides a shared reference for lecturers, staff, and students so education management remains consistent.',
        icon: ClipboardList,
      },
      {
        title: 'Integrity & Ethics',
        desc: 'Emphasizes academic honesty, professional conduct, and responsible learning practices.',
        icon: Scale,
      },
      {
        title: 'Student Readiness',
        desc: 'Supports academic preparation and adaptability to learning environments and professional demands.',
        icon: UserCheck,
      },
    ]
  : [
      {
        title: 'Proses Akademik',
        desc: 'Menetapkan prosedur yang jelas untuk pembelajaran, penilaian, dan administrasi akademik di lingkungan program studi.',
        icon: GraduationCap,
      },
      {
        title: 'Standar Operasional',
        desc: 'Menjadi acuan bersama bagi dosen, staf, dan mahasiswa agar pengelolaan pendidikan tetap konsisten.',
        icon: ClipboardList,
      },
      {
        title: 'Integritas & Etika',
        desc: 'Menegaskan kejujuran akademik, perilaku profesional, dan praktik pembelajaran yang bertanggung jawab.',
        icon: Scale,
      },
      {
        title: 'Kesiapan Mahasiswa',
        desc: 'Mendukung pembekalan akademik serta kemampuan beradaptasi terhadap lingkungan belajar dan tuntutan profesional.',
        icon: UserCheck,
      },
    ];

const highlights = isEn
  ? [
      { label: 'Document', value: 'P3' },
      { label: 'Focus', value: 'Education Management' },
      { label: 'Audience', value: 'Academic Community' },
      { label: 'Status', value: 'Official Guide' },
    ]
  : [
      { label: 'Dokumen', value: 'P3' },
      { label: 'Fokus', value: 'Pengelolaan Pendidikan' },
      { label: 'Sasaran', value: 'Civitas Akademika' },
      { label: 'Status', value: 'Panduan Resmi' },
    ];
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors hover:text-[#0b5c3d]">
        <Home class="h-4 w-4 text-slate-400" />
        {t('nav.home')}
      </a>
    </li>
    <li class="text-slate-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li>
      <a href={localizePath('/profil/sejarah', lang)} class="transition-colors hover:text-[#0b5c3d]">
        {t('nav.profil')}
      </a>
    </li>
    <li class="text-slate-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li class="font-semibold text-[#0b5c3d]">
      {translateInline((isEn) ? "en" : "id", "inline.education-management-guide")}
    </li>
  </ol>
</nav>

<section class="relative overflow-hidden bg-[#f6faf3] px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="relative mb-10 overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-32px_rgba(0,61,42,0.8)] sm:p-10 lg:p-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.06),_transparent_35%)]"></div>
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#f4d77d]/10 blur-3xl"></div>
      <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
            <BookOpen class="h-3.5 w-3.5 text-[#f7de8a]" />
            {translateInline((isEn) ? "en" : "id", "inline.official-document")}
          </span>
          <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
            {translateInline((isEn) ? "en" : "id", "inline.education-panduan")} <span class="text-[#f4d77d]">{translateInline((isEn) ? "en" : "id", "inline.management-guide")}</span>
            <span class="mt-2 block text-xl font-bold text-emerald-100/90 sm:text-2xl">(P3)</span>
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
            {translateInline((isEn) ? "en" : "id", "inline.an-official-guide-for-managing-academic-processe")}
          </p>
        </div>

        <div class="rounded-[24px] border border-white/15 bg-white/10 p-6 backdrop-blur-sm">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-[#f7de8a]">
            <FileText class="h-6 w-6" />
          </div>
          <h2 class="text-lg font-bold text-white">{translateInline((isEn) ? "en" : "id", "inline.complete-document")}</h2>
          <p class="mt-2 text-sm leading-relaxed text-emerald-50/80">
            {translateInline((isEn) ? "en" : "id", "inline.download-the-full-education-management-guide-of")}
          </p>
          <a
            href="#"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-semibold text-[#0b5c3d] transition-colors hover:bg-[#f7de8a]"
          >
            <Download class="h-4 w-4" />
            {translateInline((isEn) ? "en" : "id", "inline.download-guide")}
          </a>
        </div>
      </div>

      <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {highlights.map((item) => (
          <div class="rounded-[22px] border border-white/10 bg-white/10 p-4 backdrop-blur-sm">
            <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">{item.label}</p>
            <p class="mt-2 text-lg font-black text-white">{item.value}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mb-10 grid gap-6 lg:grid-cols-12">
      <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-8 lg:col-span-8">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {translateInline((isEn) ? "en" : "id", "inline.overview-ikhtisar")}
        </p>
        <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
          {translateInline((isEn) ? "en" : "id", "inline.purpose-of-the-education-guide")}
        </h2>
        <div class="mt-5 space-y-4 text-base leading-relaxed text-slate-600">
          <p>
            {translateInline((isEn) ? "en" : "id", "inline.this-education-management-guide-provides-a-pract")}
          </p>
          <p>
            {translateInline((isEn) ? "en" : "id", "inline.the-guide-focuses-on-academic-preparation-integr")}
          </p>
        </div>
      </div>

      <div class="rounded-[28px] border border-[#dfeadf] bg-gradient-to-br from-[#edf7ee] to-white p-6 shadow-[0_18px_45px_-30px_rgba(11,92,61,0.45)] sm:p-8 lg:col-span-4">
        <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#0b5c3d] text-white">
          <ShieldCheck class="h-5 w-5" />
        </div>
        <h3 class="text-lg font-black text-slate-900">
          {translateInline((isEn) ? "en" : "id", "inline.consistent-governance")}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          {translateInline((isEn) ? "en" : "id", "inline.p3-helps-keep-academic-services-teaching-practic")}
        </p>
        <a
          href={localizePath('/struktur/struktur', lang)}
          class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#0b5c3d] transition-colors hover:text-[#004d2c]"
        >
          {translateInline((isEn) ? "en" : "id", "inline.view-organization")}
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="mb-4">
      <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {translateInline((isEn) ? "en" : "id", "inline.guide-pillars")}
      </span>
      <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        {translateInline((isEn) ? "en" : "id", "inline.what-p3-regulates")}
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {pillars.map((item) => {
        const Icon = item.icon;
        return (
          <div class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
              <Icon class="h-6 w-6" />
            </div>
            <h3 class="mb-2 text-lg font-bold text-slate-900">{item.title}</h3>
            <p class="text-sm leading-relaxed text-slate-500">{item.desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
