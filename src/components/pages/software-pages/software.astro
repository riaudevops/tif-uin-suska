---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from "@/lib/translations.js";
import { Home, ChevronRight, Code2, Rocket, Layers3, ArrowRight } from "@lucide/astro";

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";

const features = isEn
  ? [
      {
        icon: Code2,
        title: "Software Engineering",
        desc: "Developing strong foundations in programming, systems design, and software quality."
      },
      {
        icon: Layers3,
        title: "System Thinking",
        desc: "Preparing students to design reliable digital products and application ecosystems."
      },
      {
        icon: Rocket,
        title: "Applied Development",
        desc: "Connecting academic learning with practical implementation in real projects and industry contexts."
      }
    ]
  : [
      {
        icon: Code2,
        title: "Rekayasa Perangkat Lunak",
        desc: "Membangun fondasi yang kuat dalam pemrograman, perancangan sistem, dan kualitas perangkat lunak."
      },
      {
        icon: Layers3,
        title: "Pemikiran Sistem",
        desc: "Mempersiapkan mahasiswa untuk merancang produk digital dan ekosistem aplikasi yang handal."
      },
      {
        icon: Rocket,
        title: "Pengembangan Terapan",
        desc: "Menghubungkan pembelajaran akademik dengan implementasi nyata dalam proyek dan konteks industri."
      }
    ];
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <Home class="h-4 w-4 text-gray-400" />
        <span>{t('bread.home')}</span>
      </a>
    </li>
    <li class="text-gray-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li>
      <a href={localizePath('/profil/sejarah', lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
        {t('bread.profil')}
      </a>
    </li>
    <li class="text-gray-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li class="font-semibold text-[#0b5c3d]">
      {translateInline((isEn) ? "en" : "id", "inline.software-engineering")}
    </li>
  </ol>
</nav>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
  <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
    <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#f5d76a]/10 blur-3xl"></div>
    <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

    <div class="relative z-10 grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <span class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.22em] text-white/90 backdrop-blur-sm">
          {translateInline((isEn) ? "en" : "id", "inline.study-program")}
        </span>
        <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
          {translateInline((isEn) ? "en" : "id", "inline.software-rekayasa")}
          <span class="mt-2 block text-[#f7de8a]">{translateInline((isEn) ? "en" : "id", "inline.engineering")}</span>
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-gray-100">
          {translateInline((isEn) ? "en" : "id", "inline.developing-students-competencies-in-software-sys")}
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-[24px] border border-white/10 bg-[#dcecd1]/10 p-5 backdrop-blur-sm sm:p-6">
          <p class="text-lg leading-relaxed text-gray-100 sm:text-xl">
            {translateInline((isEn) ? "en" : "id", "inline.software-engineering-education-focuses-on-buildi")}
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <span class="rounded-full bg-[#f4f0dd] px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-[#5a4c18]">
              {translateInline((isEn) ? "en" : "id", "inline.application")}
            </span>
            <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-white/90">
              {translateInline((isEn) ? "en" : "id", "inline.digital-systems")}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-5 md:grid-cols-3">
    {features.map(({ icon: Icon, title, desc }) => (
      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
          <Icon class="h-5 w-5" />
        </div>
        <h2 class="mt-5 text-xl font-bold text-slate-900">{title}</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">{desc}</p>
      </article>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
  <div class="rounded-[28px] border border-slate-200 bg-[#f8faf3] p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] sm:p-8">
    <div class="flex items-center gap-3">
      <div class="h-1.5 w-10 rounded-full bg-[#0b5c3d]"></div>
      <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
        {translateInline((isEn) ? "en" : "id", "inline.academic-direction")}
      </span>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
      <p class="text-base leading-relaxed text-slate-700 sm:text-lg">
        {translateInline((isEn) ? "en" : "id", "inline.the-software-engineering-program-helps-students")}
      </p>

      <div class="rounded-[22px] border border-[#dfeee1] bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm font-semibold uppercase tracking-[0.18em] text-[#0b5c3d]">
            {translateInline((isEn) ? "en" : "id", "inline.focus")}
          </span>
          <ArrowRight class="h-4 w-4 text-[#0b5c3d]" />
        </div>
        <ul class="mt-4 space-y-3 text-sm text-slate-700">
          <li>• {translateInline((isEn) ? "en" : "id", "inline.programming-and-system-design")}</li>
          <li>• {translateInline((isEn) ? "en" : "id", "inline.application-development")}</li>
          <li>• {translateInline((isEn) ? "en" : "id", "inline.technology-based-problem-solving")}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
