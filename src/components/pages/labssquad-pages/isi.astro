---
const squads = [
  {
    name: "Cyber-Physical Systems Lab",
    acronym: "CPS-L",
    description: "Fokus pada integrasi komputasi, jaringan, dan proses fisik melalui sistem sensor canggih.",
    lead: "Dr. Elena Volkov",
    tags: ["IoT", "Robotics", "Automation"],
    image: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=400",
  },
  {
    name: "Human-Computer Interaction",
    acronym: "HCI-Squad",
    description: "Mengkaji interaksi antara manusia dan teknologi masa depan dengan pendekatan ergonomi kognitif.",
    lead: "Prof. Adrian Marcus",
    tags: ["UX Research", "Cognitive Science", "AR/VR"],
    image: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=400",
  },
  {
    name: "Computational Linguistics",
    acronym: "CompLing",
    description: "Pemrosesan bahasa alami menggunakan model transformator untuk dialek nusantara.",
    lead: "Sarah Wijaya, Ph.D.",
    tags: ["NLP", "AI", "Linguistics"],
    image: "https://images.unsplash.com/photo-1507146426996-ef05306b995a?auto=format&fit=crop&q=80&w=400",
  }
];

const futureIdeas = [
  { title: "Interdisciplinary Grants", desc: "Pendanaan internal untuk riset gabungan antar lab." },
  { title: "Open-Access Repository", desc: "Pusat data hasil eksperimen yang dapat diakses publik." },
  { title: "Industry Fellowship", desc: "Program magang intensif bagi anggota lab di perusahaan mitra." }
];
---

<section class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mb-24">
    {squads.map((lab) => (
    <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col">
        <div class="relative h-48 overflow-hidden bg-slate-200">
        <img src={lab.image} alt={lab.name} class="w-full h-full object-cover mix-blend-multiply opacity-80" />
        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-black uppercase tracking-tighter text-slate-800 shadow-sm italic">
            {lab.acronym}
        </div>
        </div>
        
        <div class="p-6 flex-grow">
        <h3 class="text-xl font-bold text-slate-900 mb-2 leading-tight group-hover:text-blue-600">
            {lab.name}
        </h3>
        <p class="text-slate-500 text-xs mb-4">Lead: <span class="font-semibold text-slate-700">{lab.lead}</span></p>
        <p class="text-slate-600 text-sm leading-relaxed mb-6">
            {lab.description}
        </p>
        <div class="flex flex-wrap gap-2">
            {lab.tags.map(tag => (
            <span class="text-[10px] font-medium px-2 py-1 bg-slate-100 text-slate-500 rounded border border-slate-200 uppercase tracking-wide">
                {tag}
            </span>
            ))}
        </div>
        </div>
        
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50">
        <a href="#" class="text-sm font-bold text-blue-600 hover:text-blue-800 flex items-center">
            View Research Portfolio <span class="ml-2">→</span>
        </a>
        </div>
    </article>
    ))}
</section>

<section class="max-w-5xl mx-auto bg-slate-900 rounded-[2.5rem] p-10 md:p-16 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 blur-[100px]"></div>
    
    <div class="relative z-10">
    <h2 class="text-3xl font-bold mb-10 flex items-center">
        <span class="w-8 h-[2px] bg-blue-500 mr-4"></span>
        Future Roadmap & Ideas
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {futureIdeas.map((idea) => (
        <div class="group">
            <h4 class="text-blue-400 font-bold mb-2 group-hover:translate-x-1 transition-transform inline-block underline decoration-blue-800 underline-offset-4">
            {idea.title}
            </h4>
            <p class="text-slate-400 text-sm leading-relaxed">
            {idea.desc}
            </p>
        </div>
        ))}
    </div>
    </div>
</section>