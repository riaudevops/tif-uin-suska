---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<section data-aos="fade-up" class="py-16">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-emerald-900 via-emerald-700 to-[#0b4d2c] p-10 md:p-16 shadow-2xl shadow-emerald-900/20 border border-white/5 group">
      
      <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-yellow-400/10 rounded-full blur-[100px] transition-transform duration-700 group-hover:scale-110"></div>
      <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-emerald-400/8 rounded-full blur-[100px]"></div>
      
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12">
        
        <div class="text-center lg:text-left max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-full mb-8 backdrop-blur-sm">
            <span class="relative flex h-2.5 w-2.5">

              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-yellow-400"></span>
            </span>
            <span class="text-[10px] font-bold tracking-[0.2em] text-yellow-200 uppercase">Open Collaboration</span>
          </div>
          
          <h2 data-aos="fade-up" class="text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
            {isEn ? <>Let's Build <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-yellow-200">
              The Future of Research.
            </span></> : <>Mari Membangun <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-yellow-200">
              Masa Depan Riset.
            </span></>}
          </h2>
          
          <p class="text-emerald-100/90 text-lg leading-relaxed font-medium">
            {isEn ? "LabsSquad invites researchers, developers, and visionaries to collaborate on global-scale innovation projects." : "LabsSquad mengundang peneliti, pengembang, dan visioner untuk berkolaborasi dalam proyek inovasi berskala global."}
          </p>
        </div>

        <div class="flex flex-col w-full sm:w-auto min-w-[280px] gap-4 shrink-0">
          <a href="mailto:contact@labssquad.com" class="group/btn relative flex items-center justify-center px-8 py-4 font-bold text-emerald-900 bg-yellow-400 rounded-2xl hover:bg-yellow-300 hover:shadow-[0_0_30px_rgba(250,204,21,0.3)] transition-all duration-300 overflow-hidden">
            <span class="relative z-10 flex items-center gap-2 uppercase tracking-widest text-xs">
              {t("common.contact")}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </a>
          
          <button class="group/link flex items-center justify-center px-8 py-4 font-bold text-white bg-white/5 border border-white/10 rounded-2xl backdrop-blur-sm hover:bg-white/10 transition-all duration-300">
            <span class="uppercase tracking-widest text-xs">
              {isEn ? "Contribution Guidelines" : "Guideline Kontribusi"}
            </span>
          </button>
        </div>

      </div>
    </div>
  </div>
</section>