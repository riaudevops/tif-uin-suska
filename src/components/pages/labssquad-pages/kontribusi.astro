---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<section data-aos="fade-up" class="py-16">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="relative overflow-hidden rounded-[32px] border border-slate-200 bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.75)] sm:p-10 lg:p-14">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.14),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.06),_transparent_35%)]"></div>
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#f5d76a]/10 blur-3xl"></div>
      <div class="absolute -bottom-12 left-0 h-52 w-52 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 flex flex-col items-center justify-between gap-10 lg:flex-row">
        <div class="max-w-2xl text-center lg:text-left">
          <span class="mb-6 inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#f7de8a] backdrop-blur-sm">
            {isEn ? "Open Collaboration" : "Kolaborasi Terbuka"}
          </span>

          <h2 data-aos="fade-up" class="mb-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
            {isEn ? "Build research capacity together." : "Bangun kapasitas riset bersama."}
          </h2>

          <p class="text-base leading-relaxed text-emerald-50/90 sm:text-lg">
            {isEn ? "LabsSquad invites researchers, developers, and practitioners to collaborate on applied research and technology development projects." : "LabsSquad mengundang peneliti, pengembang, dan praktisi untuk berkolaborasi dalam proyek riset terapan dan pengembangan teknologi."}
          </p>
        </div>

        <div class="flex w-full max-w-sm flex-col gap-4 sm:w-auto">
          <a href="mailto:contact@labssquad.com" class="group/btn flex items-center justify-center rounded-2xl bg-[#f5d76a] px-8 py-4 font-bold text-[#003d2a] transition-all duration-300 hover:bg-[#f7de8a] hover:shadow-[0_18px_35px_-18px_rgba(245,215,106,0.8)]">
            <span class="flex items-center gap-2 text-xs uppercase tracking-[0.2em]">
              {t("common.contact")}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </a>

          <button class="flex items-center justify-center rounded-2xl border border-white/15 bg-white/5 px-8 py-4 font-bold text-white transition-all duration-300 hover:bg-white/10">
            <span class="text-xs uppercase tracking-[0.2em]">
              {isEn ? "Contribution Guidelines" : "Guideline Kontribusi"}
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>