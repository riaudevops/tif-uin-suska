---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
        <li class="flex items-center">
            <a href={localizePath('/', lang)} class="flex items-center transition-colors hover:text-[#0b5c3d]">
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <a href={localizePath('/profil/sejarah', lang)} class="transition-colors hover:text-[#0b5c3d]">
                {t("bread.akademik")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="font-bold tracking-tight text-[#0b5c3d]">
            {t("bread.labssquad")}
        </li>
    </ol>
</nav>

<section data-aos="fade-up" class="mx-auto mb-20 mt-12 max-w-7xl px-5 md:px-8">
    <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="mb-4 inline-flex rounded-full bg-[#edf4e8] px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
            {translateInline((isEn) ? "en" : "id", "inline.research-and-development-division")}
        </span>

        <h1 data-aos="fade-up" class="mb-6 text-4xl font-black tracking-tight text-[#003d2a] md:text-6xl">
            Labs<span class="text-[#0b5c3d] italic">Squad</span>
        </h1>

        <p class="text-lg leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.a-collaborative-student-ecosystem-at-uin-suska-r")}
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="group flex flex-col rounded-[28px] border border-slate-200 bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div class="mb-auto">
                <span class="mb-4 inline-block rounded-xl bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">Cloud & Server</span>
                <h3 class="mb-3 text-2xl font-bold text-slate-900">Riau DevOps (RDO)</h3>
                <p class="mb-6 text-sm leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.focused-on-collaboration-culture-between-softwar")}</p>
            </div>

            <a href="https://instagram.com/riaudevops" class="inline-flex items-center text-sm font-bold text-[#0b5c3d] transition-colors hover:text-[#003d2a]">
                {t("common.viewall")} <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>

        <div class="group flex flex-col rounded-[28px] border border-slate-200 bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div class="mb-auto">
                <span class="mb-4 inline-block rounded-xl bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">Cyber Security</span>
                <h3 class="mb-3 text-2xl font-bold text-slate-900">Aliansi Siber (ALISI)</h3>
                <p class="mb-6 text-sm leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.studying-network-security-techniques-system-pene")}</p>
            </div>

            <a href="https://instagram.com/alisi.usr" class="inline-flex items-center text-sm font-bold text-[#0b5c3d] transition-colors hover:text-[#003d2a]">
                {t("common.viewall")} <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>

        <div class="group flex flex-col rounded-[28px] border border-slate-200 bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div class="mb-auto">
                <span class="mb-4 inline-block rounded-xl bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">UI/UX Design</span>
                <h3 class="mb-3 text-2xl font-bold text-slate-900">Figma Squad</h3>
                <p class="mb-6 text-sm leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.a-creative-platform-for-ui-and-ux-designers-to-c")}</p>
            </div>

            <a href="https://instagram.com/figmasquad" class="inline-flex items-center text-sm font-bold text-[#0b5c3d] transition-colors hover:text-[#003d2a]">
                {t("common.viewall")} <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>

        <div class="group flex flex-col rounded-[28px] border border-slate-200 bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
            <div class="mb-auto">
                <span class="mb-4 inline-block rounded-xl bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">AI & Internet of Things</span>
                <h3 class="mb-3 text-2xl font-bold text-slate-900">AIOT</h3>
                <p class="mb-6 text-sm leading-relaxed text-slate-600">{translateInline((isEn) ? "en" : "id", "inline.research-and-development-of-ai-and-iot-based-sys")}</p>
            </div>

            <a href="https://instagram.com/aiot_research" class="inline-flex items-center text-sm font-bold text-[#0b5c3d] transition-colors hover:text-[#003d2a]">
                {t("common.viewall")} <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>
    </div>
</section>