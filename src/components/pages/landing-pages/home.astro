---
---
<div class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#edf4ee] px-6">
  <img
    src="/landing-pages/gedung-faste.jpg"
    alt="Gedung FASTE"
    class="absolute inset-0 h-full w-full object-cover opacity-35"
  />

  <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(236,245,238,0.9),rgba(236,245,238,0.75),rgba(236,245,238,0.8))]"></div>

  <div class="relative z-10 max-w-4xl text-center">
    <span class="inline-block rounded-lg border border-[#0d3c2f] bg-white/80 px-5 py-1.5 text-sm font-semibold tracking-wide text-[#0d3c2f] shadow-sm">
      Program Studi Teknik Informatika
    </span>

    <h1 class="mt-6 text-3xl font-bold leading-tight text-[#0d3c2f] md:text-5xl">
      Selamat Datang di
      <span class="mt-1 block text-[#0f5d44]">
        Teknik Informatika UIN Suska Riau
      </span>
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-slate-700 md:text-lg">
      Program Studi Teknik Informatika UIN Sultan Syarif Kasim Riau berkomitmen
      menghasilkan lulusan yang unggul, berakhlak, dan kompeten di bidang
      teknologi informasi melalui pendidikan, penelitian, dan pengabdian
      kepada masyarakat.
    </p>

    <div class="mt-10 flex justify-center gap-4">
      <a
        href="/profil-pages/sejarah"
        class="rounded-lg bg-[#0d3c2f] px-8 py-3 text-sm font-semibold text-white transition hover:bg-[#0f503f]"
      >
        Profil Prodi
      </a>

      <a
        href="/akademik"
        class="rounded-lg border border-[#0d3c2f] bg-white/70 px-8 py-3 text-sm font-semibold text-[#0d3c2f] transition hover:bg-white"
      >
        Informasi Akademik
      </a>
    </div>
  </div>
</div>
