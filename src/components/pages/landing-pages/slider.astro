---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { fetchWithCache } from "../../../lib/cachedFetch";
import { API_BASE_URL, ASSET_URL, getAssetUrl } from "../../../lib/cms";
// Import CSS bawaan Swiper langsung di frontmatter
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;

const normalizeLink = (value) => {
  if (!value) return '#';
  if (value.startsWith('/')) return localizePath(value, lang);
  if (/^https?:\/\//i.test(value)) return value;
  if (/^[a-z0-9.-]+\.[a-z]{2,}/i.test(value)) return `https://${value}`;
  return `/${value.replace(/^\//, '')}`;
};

let slides = [];

try {
  const json = await fetchWithCache(
    `${API_BASE_URL}/hero_slider?fields=id,title,subtittle,image,button_link,button_text,status,sort&filter[status][_in]=published,Published&sort=sort`,
    {
      headers: {
        "Content-Type": "application/json",
        ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
      }
    },
    60000
  );
  slides = json.data || [];
} catch (error) {
  console.warn("Gagal mengambil hero slider:", error);
}
---

<section class="relative w-full overflow-hidden bg-[#022c22] min-h-[460px] sm:min-h-[520px] md:min-h-[580px] lg:h-[calc(100vh-80px)] lg:max-h-[760px] flex flex-col justify-center pt-16 sm:pt-20 lg:pt-0">
  {slides.length === 0 ? (
    <div class="flex h-full min-h-[400px] items-center justify-center text-gray-400">
      <p>Slider belum tersedia.</p>
    </div>
  ) : (
    <div class="swiper hero-swiper h-full w-full flex-grow">
      <div class="swiper-wrapper h-full">
        {slides.map((slide: any, slideIndex: number) => {
          const template = Number(slide.template ?? 1) || 1;
          const buttonUrl = normalizeLink(slide.button_link);
          const subtitleText = slide.subtittle || slide.subtitle;

          return (
            <div class="swiper-slide relative h-full w-full min-h-[440px] sm:min-h-[500px]">
              <img
                src={getAssetUrl(slide.image)}
                alt={slide.title}
                loading={slideIndex === 0 ? "eager" : "lazy"}
                fetchpriority={slideIndex === 0 ? "high" : "auto"}
                class="absolute inset-0 z-0 h-full w-full object-cover"
              />

              <div class={`absolute inset-0 z-10 ${template === 2 ? 'bg-gradient-to-r from-slate-950/85 via-slate-900/60 to-slate-900/30' : template === 3 ? 'bg-gradient-to-t from-slate-950/85 via-slate-900/45 to-transparent' : template === 4 ? 'bg-gradient-to-br from-emerald-950/85 via-slate-900/50 to-yellow-900/40' : 'bg-black/55'}`} />

              <div class={`relative z-20 flex h-full items-center ${template === 2 ? 'justify-start px-6 sm:pl-12 md:pl-16 lg:pl-24' : template === 3 ? 'items-end justify-start pb-10 sm:pb-14 px-6 sm:pl-12 md:pl-16 lg:pl-24' : template === 4 ? 'justify-center px-4 sm:px-8 py-8' : 'justify-center px-4 sm:px-8 py-8'}`}>
                <div class={`${template === 2 ? 'max-w-xl' : template === 4 ? 'max-w-3xl text-center' : 'max-w-5xl text-center'} ${template === 3 ? 'max-w-2xl text-left' : ''}`}>
                  {template === 4 && (
                    <span class="mb-2 sm:mb-4 inline-flex rounded-full border border-white/30 bg-white/10 px-3 sm:px-4 py-1 sm:py-2 text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.24em] text-emerald-100 backdrop-blur-sm">
                      Program Studi
                    </span>
                  )}

                  <h1 class={`font-black text-white drop-shadow-md leading-tight tracking-tight ${template === 2 ? 'text-2xl sm:text-4xl md:text-5xl' : template === 3 ? 'text-2xl sm:text-4xl md:text-5xl' : template === 4 ? 'text-2xl sm:text-4xl md:text-5xl lg:text-6xl' : 'text-2xl sm:text-4xl md:text-5xl lg:text-6xl'}`}>
                    {slide.title}
                  </h1>

                  {subtitleText && (
                    <p class={`mt-2 sm:mt-4 text-xs sm:text-base md:text-xl text-gray-200 drop-shadow line-clamp-3 sm:line-clamp-none ${template === 2 ? 'max-w-lg' : template === 4 ? 'mx-auto max-w-2xl' : 'mx-auto max-w-3xl'}`}>
                      {subtitleText}
                    </p>
                  )}

                  {slide.button_link && (
                    <a
                      href={buttonUrl}
                      class={`mt-4 sm:mt-8 inline-flex items-center justify-center rounded-lg px-5 py-2.5 sm:px-7 sm:py-3 text-xs sm:text-base font-bold transition-all duration-300 ${template === 2 ? 'bg-yellow-400 text-emerald-900 hover:bg-yellow-300' : template === 4 ? 'bg-white text-emerald-900 hover:bg-emerald-50' : 'bg-yellow-400 text-emerald-900 hover:bg-yellow-300 hover:scale-105'}`}
                    >
                      {slide.button_text || 'Selengkapnya'}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

     <div class="swiper-pagination"></div>
    </div>
  )}
</section>

<!-- Script inisialisasi Swiper di sisi Klien -->
<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  function initSwiper() {
    const swiperEl = document.querySelector('.hero-swiper');
    if (!swiperEl || swiperEl.classList.contains('swiper-initialized')) return;

    const hasMultipleSlides = swiperEl.querySelectorAll('.swiper-slide').length > 1;

    new Swiper('.hero-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: hasMultipleSlides,
      autoplay: hasMultipleSlides ? {
        delay: 5000,
        disableOnInteraction: false,
      } : false,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    swiperEl.classList.add('swiper-initialized');
  }

  document.addEventListener('DOMContentLoaded', initSwiper);
  document.addEventListener('astro:page-load', initSwiper);
</script>

<style>
  /* Menyesuaikan warna titik pagination Swiper agar lebih nyambung dengan tema */
  :global(.swiper-pagination-bullet) {
    background-color: #cbd5e1; /* abu-abu terang */
    opacity: 0.6;
  }
  :global(.swiper-pagination-bullet-active) {
    background-color: #facc15; /* warna kuning sesuai tema tombol Anda */
    opacity: 1;
  }
</style>