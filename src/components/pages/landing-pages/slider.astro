---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { fetchWithCache } from "../../../lib/cachedFetch";
import { API_BASE_URL, ASSET_URL, getImageUrl } from "../../../lib/cms";
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;
const HERO_SLIDER_FIELDS = "*,translations.*";

const normalizeLink = (value) => {
  if (!value) return '#';
  if (value.startsWith('/')) return localizePath(value, lang);
  if (/^https?:\/\//i.test(value)) return value;
  if (/^[a-z0-9.-]+\.[a-z]{2,}/i.test(value)) return `https://${value}`;
  return `/${value.replace(/^\//, '')}`;
};

let slides = [];

try {
  const json = await fetchWithCache(
    `${API_BASE_URL}/hero_slider?fields=${HERO_SLIDER_FIELDS}&filter[status][_in]=published,Published&sort=sort`,
    {
      headers: {
        "Content-Type": "application/json",
        ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
      }
    },
    60000
  );
  slides = json.data || [];
} catch (error) {
  console.warn("Gagal mengambil hero slider:", error);
}
---

<section
  id="hero-slider"
  class="
    relative w-full overflow-hidden bg-[#022c22]
  "
>
  {slides.length === 0 ? (
    <div class="flex h-full items-center justify-center text-gray-400 px-4 text-center">
      <p>Slider belum tersedia.</p>
    </div>
  ) : (
    <div class="swiper hero-swiper absolute inset-0 select-none group/swiper">
      <div class="swiper-wrapper h-full">
        {slides.map((slide: any, slideIndex: number) => {
          const buttonUrl = normalizeLink(slide.button_link);
          const translations = Array.isArray(slide.translations)
            ? slide.translations.filter(
                (translation: any) =>
                  translation && typeof translation === "object",
              )
            : [];
          const currentTranslation = translations.find(
            (translation: any) =>
              String(translation.languages_code || "").toLowerCase() ===
              String(lang || "id").toLowerCase(),
          );
          const fallbackTranslation =
            translations.find(
              (translation: any) =>
                String(translation.languages_code || "").toLowerCase() ===
                "id",
            ) ||
            translations[0] ||
            {};
          const title =
            currentTranslation?.title_translate ||
            fallbackTranslation.title_translate ||
            slide.title;
          const subtitleText =
            currentTranslation?.subtitle_translate ||
            fallbackTranslation.subtitle_translate ||
            slide.subtittle ||
            slide.subtitle;
          const buttonText =
            currentTranslation?.button_text_translate ||
            fallbackTranslation.button_text_translate ||
            slide.button_text;

          // `text_position` is optional in the CMS; default to center so
          // existing slides keep their current layout.
          const rawPosition = String(slide.text_position || "").toLowerCase();
          const textPosition = ["center", "left", "right"].includes(rawPosition)
            ? rawPosition
            : "center";
          const isLeft = textPosition === "left";
          const isRight = textPosition === "right";

          // Mobile stays centered for readability; the chosen side applies
          // from `sm` upwards.
          const alignment = isLeft
            ? "items-center text-center mx-auto sm:items-start sm:text-left sm:mx-0 sm:mr-auto"
            : isRight
              ? "items-center text-center mx-auto sm:items-end sm:text-right sm:mx-0 sm:ml-auto"
              : "items-center text-center mx-auto";
          const blockWidth =
            textPosition === "center" ? "max-w-3xl lg:max-w-4xl" : "max-w-2xl";
          const overlay = isLeft
            ? "bg-gradient-to-r from-black/80 via-black/45 to-transparent"
            : isRight
              ? "bg-gradient-to-l from-black/80 via-black/45 to-transparent"
              : "bg-gradient-to-b from-black/55 via-black/35 to-black/65";
          const ctaAlign = isLeft
            ? "justify-center sm:justify-start"
            : isRight
              ? "justify-center sm:justify-end"
              : "justify-center";

          const imageUrl = getImageUrl(slide.image, { width: 1920, quality: 78 });
          const imageSrcSet = imageUrl
            ? [
                `${getImageUrl(slide.image, { width: 1280, quality: 78 })} 1280w`,
                `${getImageUrl(slide.image, { width: 1920, quality: 78 })} 1920w`,
                `${getImageUrl(slide.image, { width: 2560, quality: 78 })} 2560w`,
              ].join(", ")
            : "";
          // Portrait crop for phones: a 16:9 image loses ~59% of its width
          // when `object-cover` fills a 390x540 hero.
          const mobileImageUrl = imageUrl
            ? getImageUrl(slide.image, {
                width: 1080,
                height: 1350,
                fit: "cover",
                quality: 78,
              })
            : "";

          return (
            <div class="swiper-slide relative h-full w-full">

              {/* ── Background ── */}
              {imageUrl ? (
                <picture class="absolute inset-0 z-0">
                  <source media="(max-width: 639px)" srcset={mobileImageUrl} />
                  <img
                    src={imageUrl}
                    srcset={imageSrcSet}
                    sizes="100vw"
                    alt={title}
                    width="1920"
                    height="1080"
                    loading={slideIndex === 0 ? "eager" : "lazy"}
                    fetchpriority={slideIndex === 0 ? "high" : "auto"}
                    decoding="async"
                    class="h-full w-full object-cover object-center"
                  />
                </picture>
              ) : (
                <div class="absolute inset-0 z-0 bg-gradient-to-br from-[#003820] via-[#022c22] to-[#011a14]">
                  <div class="absolute inset-0 bg-[radial-gradient(#10b981_1.5px,transparent_1.5px)] [background-size:28px_28px] opacity-20"></div>
                </div>
              )}

              {/* ── Overlay Gradient ── */}
              {/* Arah gradient mengikuti posisi teks agar sisi gambar yang
                  tidak bertulisan tetap terlihat. */}
              <div class={`absolute inset-0 z-10 ${overlay}`} />

              {/* ── Inner wrapper untuk centering ── */}
              {/* Menggunakan absolute inset-0 agar tidak dipengaruhi Swiper display:block override */}
              <div class="
                absolute inset-0 z-20
                flex flex-col items-center justify-center
                px-4 sm:px-6 lg:px-8
                pt-28 pb-6 sm:pt-32 sm:pb-8 md:pt-36 md:pb-10 lg:pt-32 lg:pb-10
              ">
                <div class="mx-auto w-full max-w-7xl">
                  <div class={`
                    w-full flex flex-col gap-4 sm:gap-5
                    ${blockWidth}
                    ${alignment}
                  `}>

                  {/* Judul */}
                  <h1 class="
                    font-black text-white
                    [text-shadow:0_2px_16px_rgba(0,0,0,0.9),0_1px_4px_rgba(0,0,0,0.8)]
                    text-[1.75rem] leading-[1.2]
                    sm:text-4xl sm:leading-[1.15]
                    md:text-5xl
                    lg:text-6xl
                    xl:text-[64px]
                    2xl:text-7xl
                    tracking-tight [text-wrap:balance]
                  ">
                    {title}
                  </h1>

                  {/* Subtitle */}
                  {subtitleText && (
                    <p class="
                      font-normal leading-relaxed
                      [text-shadow:0_1px_8px_rgba(0,0,0,0.9)]
                      text-white/95
                      text-sm
                      sm:text-base
                      md:text-lg
                      lg:text-xl
                      xl:text-2xl
                      max-w-2xl [text-wrap:pretty]
                    ">
                      {subtitleText}
                    </p>
                  )}

                  {/* Tombol CTA */}
                  {slide.button_link && (
                    <div class={`mt-2 sm:mt-3 flex flex-wrap items-center gap-3 ${ctaAlign}`}>
                      <a
                        href={buttonUrl}
                        class="inline-flex items-center justify-center gap-2.5 rounded-xl px-6 sm:px-8 py-2.5 sm:py-3.5 text-sm sm:text-base font-bold transition-all duration-300 bg-yellow-400 text-emerald-950 hover:bg-yellow-300 hover:scale-[1.03] active:scale-[0.98] shadow-xl shadow-yellow-500/25 ring-2 ring-yellow-400/30 group/btn"
                      >
                        <span>{buttonText || 'Lihat Detail'}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right preview-icon">
                          <path d="M7 7h10v10"/>
                          <path d="M7 17 17 7"/>
                          </svg>
                      </a>
                    </div>
                  )}

                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Navigasi Panah (Tablet & Desktop) -->
      <button
        type="button"
        aria-label="Previous slide"
        class="swiper-hero-prev hidden md:flex absolute left-4 lg:left-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 lg:w-12 lg:h-12 items-center justify-center rounded-full bg-black/30 hover:bg-[#004d2c] text-white border border-white/20 backdrop-blur-md transition-all duration-200 opacity-0 group-hover/swiper:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100"
      >
        <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        type="button"
        aria-label="Next slide"
        class="swiper-hero-next hidden md:flex absolute right-4 lg:right-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 lg:w-12 lg:h-12 items-center justify-center rounded-full bg-black/30 hover:bg-[#004d2c] text-white border border-white/20 backdrop-blur-md transition-all duration-200 opacity-0 group-hover/swiper:opacity-100 hover:scale-105 active:scale-95 focus:opacity-100"
      >
        <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Pagination Bullets -->
      {/* <div class="swiper-pagination !bottom-5 sm:!bottom-7 md:!bottom-9"></div> */}
    </div>
  )}
</section>

<!-- Script inisialisasi Swiper -->
<script>
  import "../../../scripts/hero-slider.js";
</script>

<style>
  /*
   * Tinggi hero slider.
   *
   * Sebelumnya `lg:h-screen` membuat hero setinggi 100vh, sehingga navbar
   * (fixed, ~118px) menutupi hero dan seluruh layar pertama habis — konten di
   * bawahnya tidak terlihat. Nilai `clamp()` menjaga tinggi tetap proporsional
   * namun dibatasi agar konten (judul + subjudul + CTA) tidak terpotong;
   * tinggi minimum yang dibutuhkan konten adalah ~412px (320px wide) sampai
   * ~576px (>=1280px wide).
   */
  #hero-slider {
    height: clamp(440px, 68vh, 540px);
  }

  /* `svh` mengikuti viewport terkecil sehingga hero tidak terpotong URL bar. */
  @supports (height: 1svh) {
    #hero-slider {
      height: clamp(440px, 68svh, 540px);
    }
  }

  @media (min-width: 640px) {
    #hero-slider {
      height: clamp(480px, 64vh, 600px);
    }
  }

  @media (min-width: 768px) {
    #hero-slider {
      height: clamp(540px, 62vh, 640px);
    }
  }

  @media (min-width: 1024px) {
    #hero-slider {
      height: clamp(560px, 64vh, 620px);
    }
  }

  /* Pastikan swiper dan wrapper fill penuh */
  .hero-swiper,
  :global(.hero-swiper .swiper-wrapper),
  :global(.hero-swiper .swiper-slide) {
    height: 100% !important;
  }

  :global(.swiper-pagination-bullet) {
    background-color: #ffffff;
    opacity: 0.45;
    width: 8px;
    height: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (min-width: 640px) {
    :global(.swiper-pagination-bullet) {
      width: 10px;
      height: 10px;
    }
  }
  :global(.swiper-pagination-bullet-active) {
    background-color: #facc15;
    opacity: 1;
    width: 26px;
    border-radius: 9999px;
  }
</style>