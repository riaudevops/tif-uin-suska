---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<section class="relative aspect-[16/9] min-h-[460px] w-full overflow-hidden bg-[#edf4ee] lg:min-h-[540px] xl:min-h-[610px]">
  <div id="slides" class="flex h-full w-full transition-transform duration-700 ease-in-out">

    <div class="relative min-w-full overflow-hidden">
      <img src="/landing-pages/gedung-faste.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(7,20,15,0.7),rgba(13,61,47,0.58),rgba(13,61,47,0.22))]"></div>

      <div class="relative z-10 flex h-full items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <span class="inline-flex items-center rounded-lg border border-[#f5d78e] bg-[#f8f3df] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d] sm:px-4 sm:text-[10px]">
              {t("hero.badge")}
            </span>

            <h1 class="mt-4 text-[2.2rem] font-black leading-[0.96] tracking-[-0.06em] text-white sm:text-[2.7rem] lg:text-[4rem] xl:text-[4.9rem]">
              {lang === 'en' ? 'Welcome to' : 'Selamat Datang di'}
              <span class="mt-2 block text-yellow-300">
                {lang === 'en' ? 'Informatics Engineering UIN Suska Riau' : 'Teknik Informatika UIN Suska Riau'}
              </span>
            </h1>

            <p class="mt-4 max-w-xl text-sm leading-relaxed text-emerald-50/90 sm:text-base lg:text-lg">
              {t("hero.desc1")}
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a href={localizePath("/profil/sejarah", lang)} class="inline-flex items-center justify-center rounded-lg bg-[#f3c75d] px-5 py-2.5 text-xs font-bold text-[#0d3c2f] transition hover:bg-[#e9b94d] sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.profil")}
              </a>
              <a href={localizePath("/kurikulum/kurikulum", lang)} class="inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/8 px-5 py-2.5 text-xs font-semibold text-white transition hover:bg-white/14 sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.akademik")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative min-w-full overflow-hidden">
      <img src="/landing-pages/gedung.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(7,20,15,0.7),rgba(13,61,47,0.58),rgba(13,61,47,0.24))]"></div>

      <div class="relative z-10 flex h-full items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <span class="inline-flex items-center rounded-lg border border-[#f5d78e] bg-[#f8f3df] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d] sm:px-4 sm:text-[10px]">
              {t("hero.badge")}
            </span>

            <h1 class="mt-4 text-[2.2rem] font-black leading-[0.96] tracking-[-0.06em] text-white sm:text-[2.7rem] lg:text-[3.8rem] xl:text-[4.5rem]">
              {lang === 'en' ? 'Welcome to' : 'Selamat Datang di'}
              <span class="mt-2 block text-yellow-300">
                {lang === 'en' ? 'Faculty of Science and Technology UIN Suska Riau' : 'Fakultas Sains dan Teknologi UIN Suska Riau'}
              </span>
            </h1>

            <div class="mt-4 h-1 w-20 rounded-lg bg-yellow-300"></div>

            <p class="mt-4 max-w-lg text-sm leading-relaxed text-emerald-50/90 sm:text-base lg:text-lg">
              {t("hero.desc2")}
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <a href="https://fst.uin-suska.ac.id/" target="_blank" class="inline-flex items-center justify-center rounded-lg bg-[#f3c75d] px-5 py-2.5 text-xs font-bold text-[#0d3c2f] transition hover:bg-[#e9b94d] sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.fakultas")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative min-w-full overflow-hidden">
      <img src="/dosen-pages/dosen2.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(2,16,13,0.82),rgba(8,80,58,0.7),rgba(8,80,58,0.24))]"></div>

      <div class="relative z-10 flex h-full items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <span class="inline-flex items-center rounded-lg border border-[#f5d78e] bg-[#f8f3df] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d] sm:px-4 sm:text-[10px]">
              {t("hero.badge")}
            </span>

            <h1 class="mt-4 text-[2.2rem] font-black leading-[0.96] tracking-[-0.06em] text-white sm:text-[2.7rem] lg:text-[3.8rem] xl:text-[4.5rem]">
              {lang === 'en' ? 'Our Qualified' : 'Dosen dan Staf Pengajar'}
              <span class="mt-2 block text-yellow-300">
                {lang === 'en' ? 'Lecturers and Teaching Staff' : 'Berkualitas'}
              </span>
            </h1>

            <p class="mt-4 max-w-xl text-sm leading-relaxed text-emerald-50/90 sm:text-base lg:text-lg">
              {t("hero.desc3")}
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
              <a href={localizePath("/dosen/dosen", lang)} class="inline-flex items-center justify-center rounded-lg bg-[#f3c75d] px-5 py-2.5 text-xs font-bold text-[#0d3c2f] transition hover:bg-[#e9b94d] sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.dosen")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative min-w-full overflow-hidden">
      <img src="/landing-pages/gedung-faste.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(6,20,15,0.72),rgba(13,61,47,0.6),rgba(13,61,47,0.38))]"></div>

      <div class="relative z-10 flex h-full items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-4xl text-center">
            <span class="inline-flex items-center rounded-lg border border-[#f5d78e] bg-[#f8f3df] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d] sm:px-4 sm:text-[10px]">
              {t("hero.badge")}
            </span>

            <h1 class="mt-4 text-[2.2rem] font-black leading-[0.96] tracking-[-0.06em] text-white sm:text-[2.7rem] lg:text-[3.8rem] xl:text-[4.5rem]">
              {lang === 'en' ? 'Vision, Mission, and Goals' : 'Visi, Misi, dan Tujuan'}
              <span class="mt-2 block text-yellow-300">
                {lang === 'en' ? 'of the Informatics Engineering Program' : 'Prodi Teknik Informatika UIN Suska Riau'}
              </span>
            </h1>

            <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-emerald-50/90 sm:text-base lg:text-lg">
              {t("hero.desc4")}
            </p>

            <div class="mt-6 flex justify-center">
              <a href={localizePath("/visi-misi/visimisi", lang)} class="inline-flex items-center justify-center rounded-lg border border-white/50 bg-white/8 px-5 py-2.5 text-xs font-semibold text-white transition hover:bg-white/14 sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.visimisi")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative min-w-full overflow-hidden">
      <img src="/landing-pages/gedung-faste.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(6,20,15,0.72),rgba(13,61,47,0.65),rgba(13,61,47,0.45))]"></div>

      <div class="relative z-10 flex h-full items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="ml-auto max-w-xl text-left sm:text-left lg:text-left">
            <div class="mb-4 flex items-center gap-3">
              <span class="inline-flex items-center rounded-lg border border-[#f5d78e] bg-[#f8f3df] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d] sm:px-4 sm:text-[10px]">
                {t("hero.badge")}
              </span>
              <span class="text-3xl font-black text-yellow-300/75">★</span>
            </div>

            <h1 class="text-[2.1rem] font-black leading-[0.96] tracking-[-0.06em] text-white sm:text-[2.7rem] lg:text-[3.8rem] xl:text-[4.3rem]">
              {lang === 'en' ? 'Achievements of' : 'Prestasi Mahasiswa'}
              <span class="mt-2 block text-yellow-300">
                {lang === 'en' ? 'Informatics Engineering Students' : 'Teknik Informatika'}
              </span>
            </h1>

            <p class="mt-4 max-w-lg text-sm leading-relaxed text-emerald-50/90 sm:text-base lg:text-lg">
              {t("hero.desc5")}
            </p>

            <div class="mt-6 flex">
              <a href={localizePath("/prestasi/prestasi", lang)} class="inline-flex items-center justify-center rounded-lg border border-white/50 bg-white/8 px-5 py-2.5 text-xs font-semibold text-white transition hover:bg-white/14 sm:px-6 sm:py-3 sm:text-sm">
                {t("hero.cta.prestasi")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <button id="prev" class="absolute left-3 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-lg border border-white/25 bg-white/10 text-white transition hover:bg-white/20 sm:left-6" aria-label="Previous Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button id="next" class="absolute right-3 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-lg border border-white/25 bg-white/10 text-white transition hover:bg-white/20 sm:right-6" aria-label="Next Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div id="indicators" class="absolute bottom-6 left-1/2 z-30 flex -translate-x-1/2 items-center gap-2.5"></div>
</section>

<script is:inline>
function initSlider() {
  const slider = document.getElementById('slides');
  if (!slider) return;

  const slides = slider.children;
  const total = slides.length;
  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const indicators = document.getElementById('indicators');
  if (!prevBtn || !nextBtn || !indicators) return;

  indicators.innerHTML = '';

  let index = 0;
  let interval;

  if (window.homeSliderInterval) {
    clearInterval(window.homeSliderInterval);
  }

  for (let i = 0; i < total; i++) {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.className = 'h-2.5 w-2.5 rounded-lg bg-white/40 transition-all duration-300 hover:bg-white';
    dot.dataset.index = String(i);
    dot.addEventListener('click', () => {
      index = i;
      update();
      restartAutoSlide();
    });
    indicators.appendChild(dot);
  }

  const dots = indicators.children;

  function update() {
    slider.style.transform = `translateX(-${index * 100}%)`;

    [...dots].forEach((dot, i) => {
      dot.classList.toggle('bg-white', i === index);
      dot.classList.toggle('w-7', i === index);
      dot.classList.toggle('bg-white/40', i !== index);
      dot.classList.toggle('w-2.5', i !== index);
      dot.classList.toggle('opacity-100', i === index);
      dot.classList.toggle('opacity-70', i !== index);
    });
  }

  prevBtn.addEventListener('click', () => {
    index = (index - 1 + total) % total;
    update();
    restartAutoSlide();
  });

  nextBtn.addEventListener('click', () => {
    index = (index + 1) % total;
    update();
    restartAutoSlide();
  });

  function startAutoSlide() {
    interval = setInterval(() => {
      index = (index + 1) % total;
      update();
    }, 7000);
    window.homeSliderInterval = interval;
  }

  function restartAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  update();
  startAutoSlide();
}

document.addEventListener('DOMContentLoaded', initSlider);
document.addEventListener('astro:page-load', initSlider);
</script>