</div>

<!-- Tombol Prev -->
<button id="prev"
    class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
    aria-label="Previous Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
</button>

<!-- Tombol Next -->
<button id="next"
    class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
    aria-label="Next Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
</button>

  <!-- INDICATORS -->
  <div id="indicators"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex gap-3">
  </div>
</section>

<script is:inline>
function initSlider() {
  const slider = document.getElementById('slides');
  if (!slider) return;

  const slides = slider.children;
  const total = slides.length;

  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const indicators = document.getElementById('indicators');
  if (!prevBtn || !nextBtn || !indicators) return;

  // Clear indicators from any previous renders (to avoid doubling them during transitions)
  indicators.innerHTML = '';

  let index = 0;
  let interval;

  // Clear any existing active interval to prevent leaks
  if (window.homeSliderInterval) {
    clearInterval(window.homeSliderInterval);
  }

  for (let i = 0; i < total; i++) {
    const dot = document.createElement('button');
    dot.className =
      'w-3 h-3 rounded-full bg-white/40 hover:bg-white transition';
    dot.dataset.index = i;

    dot.addEventListener('click', () => {
      index = i;
      update();
      restartAutoSlide();
    });

    indicators.appendChild(dot);
  }

  const dots = indicators.children;

  function update() {
    slider.style.transform = `translateX(-${index * 100}%)`;

    for (let i = 0; i < dots.length; i++) {
      dots[i].classList.remove('bg-white');
      dots[i].classList.add('bg-white/40');
    }
    if (dots[index]) {
      dots[index].classList.add('bg-white');
    }
  }

  nextBtn.addEventListener('click', () => {
    index = (index + 1) % total;
    update();
    restartAutoSlide();
  });

  prevBtn.addEventListener('click', () => {
    index = (index - 1 + total) % total;
    update();
    restartAutoSlide();
  });

  function startAutoSlide() {
    interval = setInterval(() => {
      index = (index + 1) % total;
      update();
    }, 7000); 
    window.homeSliderInterval = interval;
  }

  function restartAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  update();
  startAutoSlide();
}

document.addEventListener('DOMContentLoaded', initSlider);
document.addEventListener('astro:page-load', initSlider);
</script>

