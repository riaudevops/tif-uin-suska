---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---
<section class="relative h-screen w-full pt-[115px] overflow-hidden">
  <div id="slides" class="flex h-full w-full transition-transform duration-700 ease-in-out">

    <!-- SLIDE 1: CENTERED CLASSIC -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/landing-pages/gedung-faste.jpg" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
      <div class="slide-content relative z-20 max-w-4xl text-center px-6">
        <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
          {t("hero.badge")}
        </span>

        <h1 class="mt-4 sm:mt-6 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white">
          {lang === 'en' ? "Welcome to" : "Selamat Datang di"}
          <span class="block text-yellow-400 mt-2">
            {lang === 'en' ? "Informatics Engineering UIN Suska Riau" : "Teknik Informatika UIN Suska Riau"}
          </span>
        </h1>

        <p class="mt-4 sm:mt-6 text-gray-100 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed">
          {t("hero.desc1")}
        </p>

        <div class="mt-6 sm:mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4">
          <a href={localizePath("/profil-pages/sejarah", lang)}
            class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg text-center whitespace-nowrap">
            {t("hero.cta.profil")}
          </a>

          <a href={localizePath("/akademik", lang)} class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition text-center whitespace-nowrap">
            {t("hero.cta.akademik")}
          </a>
        </div>
      </div>
    </div>

    <!-- SLIDE 2: SPLIT LEFT-ALIGNED -->
    <div class="min-w-full h-full relative flex items-center">
      <img src="/landing-pages/gedung.jpg" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-green-900/85 via-green-800/60 to-transparent z-10"></div>
      <div class="slide-content relative z-20 w-full max-w-7xl mx-auto px-6 sm:px-10">
        <div class="max-w-xl text-left">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            {t("hero.badge")}
          </span>

          <h1 class="mt-3 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
            {lang === 'en' ? "Welcome to" : "Selamat Datang di"}
            <span class="block text-yellow-400">
              {lang === 'en' ? "Faculty of Science and Technology UIN Suska Riau" : "Fakultas Sains dan Teknologi UIN Suska Riau"}
            </span>
          </h1>

          <div class="mt-2 h-1 w-20 bg-yellow-400 rounded-full"></div>

          <p class="mt-2 text-gray-100 text-base sm:text-lg leading-relaxed">
            {t("hero.desc2")}
          </p>

          <div class="mt-2 flex gap-3 sm:gap-4">
            <a href="https://fst.uin-suska.ac.id/" target="_blank"
              class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg text-center whitespace-nowrap">
              {t("hero.cta.fakultas")}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- SLIDE 3: MINIMAL BOTTOM-ANCHORED -->
    <div class="min-w-full h-full relative flex items-end justify-start">
      <img src="/dosen-pages/dosen.jpg" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-green-950/90 via-green-900/40 to-transparent z-10"></div>
      <div class="slide-content relative z-20 w-full px-6 sm:px-10 pb-16 sm:pb-24">
        <div class="max-w-3xl">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            {t("hero.badge")}
          </span>

          <h1 class="mt-4 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
            {lang === 'en' ? "Our Qualified" : "Dosen dan Staf Pengajar"}
            <span class="block text-yellow-400 mt-1">
              {lang === 'en' ? "Lecturers and Teaching Staff" : "Berkualitas"}
            </span>
          </h1>

          <p class="mt-4 text-gray-100 text-base sm:text-lg leading-relaxed">
            {t("hero.desc3")}
          </p>

          <div class="mt-8 flex gap-4 items-center">
            <a href={localizePath("/dosen-pages/dosen", lang)}
              class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg text-center whitespace-nowrap">
              {t("hero.cta.dosen")}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- SLIDE 4: FRAMED CARD CENTERED -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/landing-pages/gedung-faste.jpg" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-green-900/60 z-10"></div>
      <div class="slide-content relative z-20 max-w-3xl mx-6 px-8 sm:px-14 py-12 border border-yellow-400/40 rounded-3xl bg-white/10 backdrop-blur-sm text-center">
        <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
          {t("hero.badge")}
        </span>

        <h1 class="mt-5 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
          {lang === 'en' ? "Vision, Mission, and Goals" : "Visi, Misi, dan Tujuan"}
          <span class="block text-yellow-400 mt-2">
            {lang === 'en' ? "of the Informatics Engineering Program" : "Prodi Teknik Informatika UIN Suska Riau"}
          </span>
        </h1>

        <p class="mt-5 text-gray-100 text-base sm:text-lg leading-relaxed">
          {t("hero.desc4")}
        </p>

        <div class="mt-8 flex justify-center">
          <a href={localizePath("/visimisi-pages/visimisi", lang)} class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition text-center whitespace-nowrap">
            {t("hero.cta.visimisi")}
          </a>
        </div>
      </div>
    </div>

    <!-- SLIDE 5: RIGHT-ALIGNED WITH ACCENT NUMBER -->
    <div class="min-w-full h-full relative flex items-center justify-end">
      <img src="/landing-pages/gedung-faste.jpg" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-l from-green-900/85 via-green-800/50 to-transparent z-10"></div>
      <div class="slide-content relative z-20 w-full max-w-7xl mx-auto px-6 sm:px-10">
        <div class="max-w-xl ml-auto text-right">
          <span class="inline-flex items-center gap-3 justify-end">
            <span class="px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
              {t("hero.badge")}
            </span>
            <span class="text-5xl font-black text-yellow-400/40">★</span>
          </span>

          <h1 class="mt-5 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
            {lang === 'en' ? "Achievements of" : "Prestasi Mahasiswa"}
            <span class="block text-yellow-400 mt-2">
              {lang === 'en' ? "Informatics Engineering Students" : "Teknik Informatika"}
            </span>
          </h1>

          <p class="mt-6 text-gray-100 text-base sm:text-lg leading-relaxed">
            {t("hero.desc5")}
          </p>

          <div class="mt-8 flex justify-end gap-3 sm:gap-4">
            <a href={localizePath("/prestasi-pages/prestasi", lang)}
              class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition text-center whitespace-nowrap"
            >
              {t("hero.cta.prestasi")}
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Tombol Prev -->
  <button id="prev"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
      aria-label="Previous Slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
  </button>

  <!-- Tombol Next -->
  <button id="next"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
      aria-label="Next Slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
  </button>

  <!-- INDICATORS -->
  <div id="indicators"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex gap-3">
  </div>
</section>

<script is:inline>
function initSlider() {
  const slider = document.getElementById('slides');
  if (!slider) return;

  const slides = slider.children;
  const total = slides.length;

  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const indicators = document.getElementById('indicators');
  if (!prevBtn || !nextBtn || !indicators) return;

  indicators.innerHTML = '';

  let index = 0;
  let interval;

  if (window.homeSliderInterval) {
    clearInterval(window.homeSliderInterval);
  }

  for (let i = 0; i < total; i++) {
    const dot = document.createElement('button');
    dot.className =
      'w-3 h-3 rounded-full bg-white/40 hover:bg-white transition';
    dot.dataset.index = i;

    dot.addEventListener('click', () => {
      index = i;
      update();
      restartAutoSlide();
    });

    indicators.appendChild(dot);
  }

  const dots = indicators.children;

  function update() {
    slider.style.transform = `translateX(-${index * 100}%)`;

    for (let i = 0; i < dots.length; i++) {
      dots[i].classList.remove('bg-white');
      dots[i].classList.add('bg-white/40');
    }
    if (dots[index]) {
      dots[index].classList.add('bg-white');
    }
  }

  nextBtn.addEventListener('click', () => {
    index = (index + 1) % total;
    update();
    restartAutoSlide();
  });

  prevBtn.addEventListener('click', () => {
    index = (index - 1 + total) % total;
    update();
    restartAutoSlide();
  });

  function startAutoSlide() {
    interval = setInterval(() => {
      index = (index + 1) % total;
      update();
    }, 7000);
    window.homeSliderInterval = interval;
  }

  function restartAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  update();
  startAutoSlide();
}

document.addEventListener('DOMContentLoaded', initSlider);
document.addEventListener('astro:page-load', initSlider);
</script>