---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { fetchWithCache } from "../../../lib/cachedFetch";
import { API_BASE_URL, ASSET_URL, getAssetUrl } from "../../../lib/cms";
// Import CSS bawaan Swiper langsung di frontmatter
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;

const normalizeLink = (value) => {
  if (!value) return '#';
  if (value.startsWith('/')) return localizePath(value, lang);
  if (/^https?:\/\//i.test(value)) return value;
  if (/^[a-z0-9.-]+\.[a-z]{2,}/i.test(value)) return `https://${value}`;
  return `/${value.replace(/^\//, '')}`;
};

let slides = [];

try {
  const json = await fetchWithCache(
    `${API_BASE_URL}/hero_slider?fields=id,title,subtittle,image,button_link,button_text,status,sort&filter[status][_in]=published,Published&sort=sort`,
    {
      headers: {
        "Content-Type": "application/json",
        ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
      }
    },
    60000
  );
  slides = json.data || [];
} catch (error) {
  console.warn("Gagal mengambil hero slider:", error);
}
---

<section class="relative w-full overflow-hidden bg-[#022c22] min-h-[500px] sm:min-h-[540px] md:min-h-[580px] lg:h-[calc(100vh-80px)] lg:max-h-[760px] flex flex-col justify-center pt-20 sm:pt-24 lg:pt-0">
  {slides.length === 0 ? (
    <div class="flex h-full min-h-[420px] items-center justify-center text-gray-400 px-4 text-center">
      <p>Slider belum tersedia.</p>
    </div>
  ) : (
    <div class="swiper hero-swiper h-full w-full flex-grow relative select-none">
      <div class="swiper-wrapper h-full">
        {slides.map((slide: any, slideIndex: number) => {
          const template = Number(slide.template ?? 1) || 1;
          const buttonUrl = normalizeLink(slide.button_link);
          const subtitleText = slide.subtittle || slide.subtitle;
          const imageUrl = getAssetUrl(slide.image);

          return (
            <div class="swiper-slide relative h-full w-full min-h-[440px] sm:min-h-[500px] flex items-center">
              {/* Background Image / Fallback Gradient */}
              {imageUrl ? (
                <img
                  src={imageUrl}
                  alt={slide.title}
                  loading={slideIndex === 0 ? "eager" : "lazy"}
                  fetchpriority={slideIndex === 0 ? "high" : "auto"}
                  class="absolute inset-0 z-0 h-full w-full object-cover object-center"
                />
              ) : (
                <div class="absolute inset-0 z-0 h-full w-full bg-gradient-to-br from-[#003820] via-[#022c22] to-[#011a14] opacity-95">
                  <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:24px_24px] opacity-15"></div>
                </div>
              )}

              {/* Contrast Overlays for Mobile readability */}
              <div class={`absolute inset-0 z-10 ${
                template === 2 
                  ? 'bg-gradient-to-r from-slate-950/95 via-slate-900/75 to-slate-900/40' 
                  : template === 3 
                  ? 'bg-gradient-to-t from-slate-950/95 via-slate-900/60 to-slate-900/30' 
                  : template === 4 
                  ? 'bg-gradient-to-br from-emerald-950/90 via-slate-900/60 to-yellow-900/40' 
                  : 'bg-black/60 sm:bg-black/55'
              }`} />

              {/* Slide Content */}
              <div class="relative z-20 w-full container mx-auto px-5 sm:px-8 md:px-12 py-10 sm:py-14 flex items-center justify-center">
                <div class={`w-full ${
                  template === 2 
                    ? 'max-w-2xl text-left' 
                    : template === 3 
                    ? 'max-w-2xl text-left' 
                    : 'max-w-4xl text-center'
                }`}>
                  {template === 4 && (
                    <span class="mb-2 sm:mb-4 inline-flex rounded-full border border-emerald-400/40 bg-emerald-500/10 px-3 sm:px-4 py-1 sm:py-1.5 text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-emerald-200 backdrop-blur-sm">
                      Program Studi
                    </span>
                  )}

                  <h1 class="font-extrabold text-white drop-shadow-md text-2xl sm:text-3xl md:text-5xl lg:text-6xl leading-tight tracking-tight">
                    {slide.title}
                  </h1>

                  {subtitleText && (
                    <p class="mt-2.5 sm:mt-4 text-sm sm:text-base md:text-xl text-gray-200/90 drop-shadow line-clamp-3 sm:line-clamp-none max-w-2xl mx-auto leading-relaxed">
                      {subtitleText}
                    </p>
                  )}

                  {slide.button_link && (
                    <div class="mt-5 sm:mt-8 flex flex-wrap items-center gap-3 justify-center">
                      <a
                        href={buttonUrl}
                        class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-xs sm:text-sm md:text-base font-bold transition-all duration-200 bg-yellow-400 text-emerald-950 hover:bg-yellow-300 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-yellow-500/20"
                      >
                        <span>{slide.button_text || 'Lihat Detail'}</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Pagination bullets with touch padding -->
      <div class="swiper-pagination !bottom-4 sm:!bottom-6"></div>
    </div>
  )}
</section>

<!-- Script inisialisasi Swiper di sisi Klien -->
<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  let heroSwiperInstance: any = null;

  function initSwiper() {
    const swiperEl = document.querySelector('.hero-swiper') as HTMLElement | null;
    if (!swiperEl) return;

    if (heroSwiperInstance) {
      heroSwiperInstance.destroy(true, true);
      heroSwiperInstance = null;
    }

    const slidesCount = swiperEl.querySelectorAll('.swiper-slide').length;
    const hasMultipleSlides = slidesCount > 1;

    heroSwiperInstance = new Swiper('.hero-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: hasMultipleSlides,
      speed: 600,
      grabCursor: true,
      touchRatio: 1,
      resistanceRatio: 0.85,
      autoplay: hasMultipleSlides ? {
        delay: 5500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      } : false,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
        dynamicBullets: hasMultipleSlides && slidesCount > 5,
      },
    });
  }

  document.addEventListener('DOMContentLoaded', initSwiper);
  document.addEventListener('astro:page-load', initSwiper);
</script>

<style>
  :global(.swiper-pagination-bullet) {
    background-color: #ffffff;
    opacity: 0.45;
    width: 8px;
    height: 8px;
    transition: all 0.3s ease;
  }
  @media (min-width: 640px) {
    :global(.swiper-pagination-bullet) {
      width: 10px;
      height: 10px;
    }
  }
  :global(.swiper-pagination-bullet-active) {
    background-color: #facc15;
    opacity: 1;
    width: 24px;
    border-radius: 9999px;
  }
</style>