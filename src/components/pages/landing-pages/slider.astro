---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { fetchWithCache } from "../../../lib/cachedFetch";
// Import CSS bawaan Swiper langsung di frontmatter
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const rawBaseUrl = (import.meta.env.BASE_API_URL || "http://localhost:8055").replace(/\/+$/, "");
const API_BASE_URL = rawBaseUrl.endsWith("/items") ? rawBaseUrl : `${rawBaseUrl}/items`;
const ASSET_URL = `${rawBaseUrl.replace(/\/items$/, "")}/assets/`;

const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;

const normalizeLink = (value) => {
  if (!value) return '#';
  if (value.startsWith('/')) return localizePath(value, lang);
  if (/^https?:\/\//i.test(value)) return value;
  if (/^[a-z0-9.-]+\.[a-z]{2,}/i.test(value)) return `https://${value}`;
  return `/${value.replace(/^\//, '')}`;
};

let slides = [];

try {
  const json = await fetchWithCache(
    `${API_BASE_URL}/hero_slider?fields=id,title,subtitle,image,button_link,button_text,status,sort&filter[status][_in]=published,Published&sort=sort`,
    {
      headers: {
        "Content-Type": "application/json",
        ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
      }
    },
    60000
  );
  slides = json.data || [];
} catch (error) {
  console.warn("Gagal mengambil hero slider:", error);
}
---

<section class="relative w-full overflow-hidden bg-[#022c22]" style="aspect-ratio: 1920 / 1080; max-height: 1080px;">
  {slides.length === 0 ? (
    <div class="flex h-full items-center justify-center text-gray-400">
      <p>Slider belum tersedia.</p>
    </div>
  ) : (
    <div class="swiper hero-swiper h-full w-full">
      <div class="swiper-wrapper h-full">
        {slides.map((slide: any, slideIndex: number) => {
          const template = Number(slide.template ?? 1) || 1;
          const buttonUrl = normalizeLink(slide.button_link);

          return (
            <div class="swiper-slide relative h-full w-full">
              <img
                src={`${ASSET_URL}${slide.image}`}
                alt={slide.title}
                loading={slideIndex === 0 ? "eager" : "lazy"}
                fetchpriority={slideIndex === 0 ? "high" : "auto"}
                class="absolute inset-0 z-0 h-full w-full object-cover"
              />

              <div class={`absolute inset-0 z-10 ${template === 2 ? 'bg-gradient-to-r from-slate-950/80 via-slate-900/55 to-slate-900/25' : template === 3 ? 'bg-gradient-to-t from-slate-950/80 via-slate-900/35 to-transparent' : template === 4 ? 'bg-gradient-to-br from-emerald-950/80 via-slate-900/40 to-yellow-900/30' : 'bg-black/50'}`} />

              <div class={`relative z-20 flex h-full ${template === 2 ? 'items-center justify-start pl-6 md:pl-16 lg:pl-24' : template === 3 ? 'items-end justify-start pb-10 pl-6 md:pl-16 lg:pl-24' : template === 4 ? 'items-center justify-center p-6' : 'items-center justify-center'}`}>
                <div class={`${template === 2 ? 'max-w-xl' : template === 4 ? 'max-w-3xl text-center' : 'max-w-5xl text-center'} ${template === 3 ? 'max-w-2xl' : ''}`}>
                  {template === 4 && (
                    <span class="mb-4 inline-flex rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.24em] text-emerald-100 backdrop-blur-sm">
                      Program Studi
                    </span>
                  )}

                  <h1 class={`font-bold text-white drop-shadow-md ${template === 2 ? 'text-3xl md:text-5xl' : template === 3 ? 'text-3xl md:text-5xl' : template === 4 ? 'text-3xl md:text-6xl' : 'text-4xl md:text-6xl'} `}>
                    {slide.title}
                  </h1>

                  {slide.subtitle && (
                    <p class={`mt-4 text-base md:text-xl text-gray-200 drop-shadow ${template === 2 ? 'max-w-lg' : template === 4 ? 'mx-auto max-w-2xl' : 'mx-auto max-w-3xl'}`}>
                      {slide.subtitle}
                    </p>
                  )}

                  {slide.button_link && (
                    <a
                      href={buttonUrl}
                      class={`mt-8 inline-flex items-center justify-center rounded-lg px-7 py-3 font-bold transition-all duration-300 ${template === 2 ? 'bg-yellow-400 text-emerald-900 hover:bg-yellow-300' : template === 4 ? 'bg-white text-emerald-900 hover:bg-emerald-50' : 'bg-yellow-400 text-emerald-900 hover:bg-yellow-300 hover:scale-105'}`}
                    >
                      {slide.button_text || 'Selengkapnya'}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

     <div class="swiper-pagination"></div>
    </div>
  )}
</section>

<!-- Script inisialisasi Swiper di sisi Klien -->
<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  function initSwiper() {
    const swiperEl = document.querySelector('.hero-swiper');
    if (!swiperEl || swiperEl.classList.contains('swiper-initialized')) return;

    const hasMultipleSlides = swiperEl.querySelectorAll('.swiper-slide').length > 1;

    new Swiper('.hero-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: hasMultipleSlides,
      autoplay: hasMultipleSlides ? {
        delay: 5000,
        disableOnInteraction: false,
      } : false,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    swiperEl.classList.add('swiper-initialized');
  }

  document.addEventListener('DOMContentLoaded', initSwiper);
  document.addEventListener('astro:page-load', initSwiper);
</script>

<style>
  /* Menyesuaikan warna titik pagination Swiper agar lebih nyambung dengan tema */
  :global(.swiper-pagination-bullet) {
    background-color: #cbd5e1; /* abu-abu terang */
    opacity: 0.6;
  }
  :global(.swiper-pagination-bullet-active) {
    background-color: #facc15; /* warna kuning sesuai tema tombol Anda */
    opacity: 1;
  }
</style>