---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";
---
<section class="relative w-full">
    <div class="relative z-40 max-w-7xl mx-auto px-4 sm:px-6 -mt-8 sm:-mt-14 md:-mt-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- 1. Counter Dosen -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400 group">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-green-900"><span class="counter" data-target="30">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.dosen")}</p>
          </div>
        </div>
      </div>

      <!-- 2. Counter Mahasiswa -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h6m-6 4h8" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="1000">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.mahasiswa")}</p>
          </div>
        </div>
      </div>

      <!-- 3. Counter Alumni -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 1.567-3 3.5S10.343 15 12 15s3-1.567 3-3.5S13.657 8 12 8z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20c0-3.314-3.134-6-7-6s-7 2.686-7 6" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="20">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.alumni")}</p>
          </div>
        </div>
      </div>

      <!-- 4. Counter Ruang Perkuliahan -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 10L12 4l10 6-10 6L2 10z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 12v5c0 .5.5 1 1 1h10c.5 0 1-.5 1-1v-5" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="20">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.ruang")}</p>
          </div>
        </div>
      </div>
    </div>

  <div data-aos="fade-up" class="mt-12 grid overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_70px_-35px_rgba(15,23,42,0.4)] lg:grid-cols-[1.15fr_0.85fr]">
    <div data-aos="fade-right" class="relative aspect-[16/9] bg-emerald-950 lg:aspect-auto lg:min-h-[440px]">
      <img
        src="/dosen-pages/dosen2.jpg"
        alt={translateInline((lang === "en") ? "en" : "id", "inline.group-photo-in-front-of-a-campus-building")}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/75 via-transparent to-transparent"></div>
      <div class="absolute bottom-5 left-5 right-5 rounded-2xl border border-white/20 bg-emerald-950/45 p-4 text-white backdrop-blur-sm sm:bottom-7 sm:left-7 sm:right-7">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">
          {lang === "en" ? "UIN Sultan Syarif Kasim Riau" : "UIN Sultan Syarif Kasim Riau"}
        </p>
        <p class="mt-1 text-sm font-semibold sm:text-base">
          {translateInline((lang === "en") ? "en" : "id", "inline.faculty-of-science-and-technology")}
        </p>
      </div>
    </div>

    <div data-aos="fade-left" class="flex flex-col justify-center px-6 py-9 sm:px-10 sm:py-12 lg:px-14">
      <p class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-emerald-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-emerald-800">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        {t("about.univ")}
      </p>
      <h3 class="max-w-xl text-3xl font-black leading-tight tracking-tight text-slate-950 sm:text-4xl">
        {t("about.title")}
      </h3>
      <p class="mt-5 max-w-xl text-base leading-7 text-slate-600">
        {t("about.desc")}
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {[t("about.focus.computing"), t("about.focus.solutions"), t("about.focus.ethics")].map((focus) => (
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700">{focus}</span>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={localizePath("/profil/sejarah", lang)}
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800"
        >
          {t("about.profile")}
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={localizePath("/kurikulum/kurikulum", lang)}
          class="inline-flex items-center rounded-xl border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-emerald-800 hover:text-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800"
        >
          {t("about.curriculum")}
        </a>
      </div>
    </div>
  </div>

  <div class="mt-12 sm:mt-16">
    <div class="mb-6 sm:mb-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">{t("sistem.tif.title")}</p>
      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">{t("sistem.cards.title")}</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">{t("sistem.cards.desc")}</p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 sm:gap-5">
      <a
        href="https://dashboard.tif.uin-suska.ac.id/"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex min-h-[250px] flex-col overflow-hidden rounded-2xl border border-amber-300 bg-gradient-to-br from-amber-50 via-white to-white p-5 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.45)] transition duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_22px_40px_-24px_rgba(180,120,15,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 sm:p-6"
      >
        <span class="absolute right-0 top-0 rounded-bl-xl bg-amber-400 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-emerald-950">{t("sistem.featured")}</span>
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-800 ring-1 ring-amber-200">
          <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="1.8" />
            <path d="M3 9h18M7 6.5h.01M10 6.5h.01M8 13h3v3H8zM14 13h3M14 16h3" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">{isEn ? "Dashboard TIF" : "Dashboard TIF"}</h3>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{t("sistem.dashboard.desc")}</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-800 transition group-hover:gap-3">
          {t("sistem.open")} <span aria-hidden="true">→</span>
        </span>
      </a>

      <a
        href="https://play.google.com/store/apps/details?id=uinsuska.tif.dashboard.student&pcampaignid=web_share"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex min-h-[250px] flex-col overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-white p-5 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.45)] transition duration-300 hover:-translate-y-1 hover:border-emerald-400 hover:shadow-[0_22px_40px_-24px_rgba(0,77,44,0.28)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:p-6"
      >
        <span class="absolute right-0 top-0 rounded-bl-xl bg-emerald-100 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-emerald-900">{t("sistem.featured")}</span>
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 ring-1 ring-emerald-200">
          <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M4 2.5v19l10-9.5z" />
            <path fill="#34A853" d="m4 2.5 15.8 8.2-5.4 1.3z" />
            <path fill="#FBBC04" d="m4 21.5 15.8-8.2-5.4-1.3z" />
            <path fill="#EA4335" d="M19.8 10.7c1.5.8 1.5 1.8 0 2.6L15 15.8l-3-3.8 3-3.8z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.integratif-student")}</h3>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{t("sistem.integratif.mhs.desc")}</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-800 transition group-hover:gap-3">
          {t("sistem.open")} <span aria-hidden="true">→</span>
        </span>
      </a>

      <a
        href="https://play.google.com/store/apps/details?id=uinsuska.tif.dashboard.staff&pcampaignid=web_share"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex min-h-[250px] flex-col overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-white p-5 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.45)] transition duration-300 hover:-translate-y-1 hover:border-emerald-400 hover:shadow-[0_22px_40px_-24px_rgba(0,77,44,0.28)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:p-6"
      >
        <span class="absolute right-0 top-0 rounded-bl-xl bg-emerald-100 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-emerald-900">{t("sistem.featured")}</span>
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 ring-1 ring-emerald-200">
          <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M4 2.5v19l10-9.5z" />
            <path fill="#34A853" d="m4 2.5 15.8 8.2-5.4 1.3z" />
            <path fill="#FBBC04" d="m4 21.5 15.8-8.2-5.4-1.3z" />
            <path fill="#EA4335" d="M19.8 10.7c1.5.8 1.5 1.8 0 2.6L15 15.8l-3-3.8 3-3.8z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.integratif-lecturer")}</h3>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{t("sistem.integratif.dosen.desc")}</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-800 transition group-hover:gap-3">
          {t("sistem.open")} <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
  </div>
</section>

<script>
  function initCounters() {
    const counters = document.querySelectorAll(".counter");

    const startCounting = (counter) => {
      const target = Number(counter.getAttribute("data-target") || 0);
      if (!target) {
        counter.innerText = "0";
        return;
      }

      const duration = 700;
      const startTime = performance.now();

      const updateCounter = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const currentValue = Math.round(target * easedProgress);

        counter.innerText = currentValue;

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        } else {
          counter.innerText = target;
        }
      };

      requestAnimationFrame(updateCounter);
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          startCounting(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
    });

    counters.forEach((counter) => observer.observe(counter));
  }

  document.addEventListener("DOMContentLoaded", initCounters);
  document.addEventListener("astro:page-load", initCounters);
</script>