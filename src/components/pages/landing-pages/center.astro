---
import { getLocaleFromUrl, useTranslations } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---
<section class="relative w-full">
    <div class="relative z-40 max-w-7xl mx-auto px-4 sm:px-6 -mt-8 sm:-mt-14 md:-mt-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- 1. Counter Dosen -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400 group">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-green-900"><span class="counter" data-target="30">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.dosen")}</p>
          </div>
        </div>
      </div>

      <!-- 2. Counter Mahasiswa -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h6m-6 4h8" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="1000">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.mahasiswa")}</p>
          </div>
        </div>
      </div>

      <!-- 3. Counter Alumni -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 1.567-3 3.5S10.343 15 12 15s3-1.567 3-3.5S13.657 8 12 8z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20c0-3.314-3.134-6-7-6s-7 2.686-7 6" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="20">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.alumni")}</p>
          </div>
        </div>
      </div>

      <!-- 4. Counter Ruang Perkuliahan -->
      <div data-aos="fade-up" class="bg-white p-5 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-200 hover:border-yellow-400">
        <div class="flex items-center gap-4">
          <div class="bg-green-50 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 10L12 4l10 6-10 6L2 10z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 12v5c0 .5.5 1 1 1h10c.5 0 1-.5 1-1v-5" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900"><span class="counter" data-target="20">0</span>+</p>
            <p class="text-gray-600 font-medium">{t("stats.ruang")}</p>
          </div>
        </div>
      </div>
    </div>

  <div data-aos="fade-up" class="mt-12 relative rounded-[32px] overflow-hidden shadow-2xl">
    <div class="absolute inset-0 bg-gradient-to-br from-green-900 via-emerald-800 to-green-700"></div>
    <div class="absolute inset-0 bg-[url('/landing-pages/gedung.jpg')] bg-cover bg-center opacity-15"></div>

    <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 items-center gap-8 p-8 md:p-12">
      <div data-aos="fade-right" class="relative flex items-center justify-center">
        <div class="absolute w-48 h-48 bg-yellow-400/20 rounded-lg blur-3xl"></div>
          <img src="/dosen-pages/dosen2.jpg" alt="Lingkungan Akademik Teknik Informatika" class="relative z-10 w-full h-[400px] object-contain drop-shadow-2xl"/>
      </div>

      <div data-aos="fade-left" class="text-white">
        <p class="font-extrabold uppercase tracking-[0.2em] text-xs mb-4 text-yellow-300">
          {t("about.univ")}
        </p>
        <h3 class="text-3xl font-bold mb-6 leading-snug">
          {t("about.title")}
        </h3>
        <p class="text-emerald-100 leading-relaxed max-w-xl">
          {t("about.desc")}
        </p>
      </div>
    </div>
  </div>
  </div>
</section>

<section class="py-20 overflow-hidden ">
  <div class="max-w-7xl mx-auto mt-10 px-4 sm:px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 h-full items-center gap-16">  
      <img src="/landing-pages/Pertemuan.png" alt="Minggu Perkuliahan" class="w-full h-full object-contain"/>
      <img src="/dosen-pages/dosen2.jpg" alt="Minggu Perkuliahan" class="w-full h-full object-contain"/>
    </div>  
  </div>
</section>

<script>
  function initCounters() {
    const counters = document.querySelectorAll(".counter");

    const startCounting = (counter) => {
      const target = Number(counter.getAttribute("data-target") || 0);
      if (!target) {
        counter.innerText = "0";
        return;
      }

      const duration = 700;
      const startTime = performance.now();

      const updateCounter = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const currentValue = Math.round(target * easedProgress);

        counter.innerText = currentValue;

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        } else {
          counter.innerText = target;
        }
      };

      requestAnimationFrame(updateCounter);
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          startCounting(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
    });

    counters.forEach((counter) => observer.observe(counter));
  }

  document.addEventListener("DOMContentLoaded", initCounters);
  document.addEventListener("astro:page-load", initCounters);
</script>