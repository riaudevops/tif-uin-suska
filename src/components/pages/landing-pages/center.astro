---

---

<section class="bg-gray-50 py-20">
  <div class="container mx-auto px-5">
    
    <div class="text-center mb-16" data-aos="fade-up" >
      <h1 class="text-4xl font-bold text-green-800 mb-4">
        Teknik Informatika
      </h1>
      <p class="mt-3 text-gray-600">
        Fakultas Sains dan Teknologi - UIN Suska Riau
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-100">
        <div class="flex items-center gap-4">
          <div class="bg-green-100 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900">30+</p>
            <p class="text-gray-600 font-medium">Dosen</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-100">
        <div class="flex items-center gap-4">
          <div class="bg-green-100 text-green-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h6m-6 4h8" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900">1000+</p>
            <p class="text-gray-600 font-medium">Mahasiswa</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-100">
        <div class="flex items-center gap-4">
          <div class="bg-purple-100 text-purple-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 1.567-3 3.5S10.343 15 12 15s3-1.567 3-3.5S13.657 8 12 8z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20c0-3.314-3.134-6-7-6s-7 2.686-7 6" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900">20+</p>
            <p class="text-gray-600 font-medium">Alumni</p>
          </div>
        </div>
      </div>
      
      <div class="bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition border border-gray-100">
        <div class="flex items-center gap-4">
          <div class="bg-purple-100 text-purple-700 p-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 10L12 4l10 6-10 6L2 10z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 12v5c0 .5.5 1 1 1h10c.5 0 1-.5 1-1v-5" />
            </svg>
          </div>

          <div>
            <p class="text-3xl font-bold text-gray-900">20+</p>
            <p class="text-gray-600 font-medium">Ruang Perkuliahan</p>
          </div>
        </div>
      </div>

    </div>

    <div class="max-w-7xl mx-auto mt-32 grid grid-cols-1 md:grid-cols-2 gap-16 px-6 items-center">

    <img src="/aidil1.png"
         alt="Lingkungan Akademik Teknik Informatika"
         class="max-h-[380px] mx-auto object-contain opacity-95"/>

    <div>
      <p class="text-sm text-gray-500 mb-3">
        Universitas Islam Negeri Sultan Syarif Kasim Riau
      </p>

      <h3 class="text-3xl font-bold text-green-800 mb-6 leading-snug">
        Pendidikan Teknologi Berbasis<br/>
        Keilmuan dan Nilai Keislaman
      </h3>

      <p class="text-gray-700 leading-relaxed">
        Program Studi Teknik Informatika berkomitmen menghasilkan lulusan yang
        kompeten secara akademik, profesional dalam praktik, serta berlandaskan
        nilai etika dan keislaman.
      </p>
    </div>
  </div>

    <div class="max-w-7xl mx-auto mt-32 px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 h-full items-center gap-16">
    
    <img
      src="/landing-pages/Pertemuan.png"
      alt="Minggu Perkuliahan"
      class="w-full h-full object-contain"
    />

    <img
    src="/public/aidil22.png"
      alt="Minggu Perkuliahan"
      class="w-full h-full object-contain"
    />

  </div>  
  
  </div>
</section>
