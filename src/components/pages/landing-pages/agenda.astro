---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { API_BASE_URL, getAssetUrl } from "../../../lib/cms";
import { AGENDA_FIELDS, normalizeAgenda } from "../../../lib/agenda";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

let posts = [];

try {
  const fetchUrl = `${API_BASE_URL}/agenda?fields=${AGENDA_FIELDS}&limit=3&sort=-tanggal_pelaksanaan`;
  const response = await fetch(fetchUrl, { cache: "no-store" });

  if (!response.ok) throw new Error(`Gagal mengambil data dari Directus (status: ${response.status})`);

  const dataDirectus = await response.json();
  const items = Array.isArray(dataDirectus.data) ? dataDirectus.data : [];

  posts = items.map((item: any) => {
    const agenda = normalizeAgenda(item, lang);
    const dateObj = agenda?.date ? new Date(agenda.date) : new Date();

    const formattedDate = dateObj.toLocaleDateString(lang === 'en' ? 'en-US' : 'id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });

    return {
      id: agenda?.id,
      title: agenda?.title || "Agenda Tanpa Judul",
      date: formattedDate,
      content: agenda?.description || "Tidak ada deskripsi untuk agenda ini.",
      thumbnailUrl: getAssetUrl(agenda?.image, '/landing-pages/gedung.jpg')
    };
  });
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error Fetching Agenda untuk Beranda:", message);
}
---

<section class="relative overflow-hidden bg-white px-4 py-16 sm:px-6 sm:py-24">
  <div class="absolute inset-0 bg-[url('/landing-pages/gedung.jpg')] bg-cover bg-center opacity-[0.03]"></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div data-aos="fade-right" class="mb-8 border-l-4 border-[#d7a62b] pl-4 sm:mb-12 sm:pl-6">
      <h2 class="text-3xl font-bold tracking-tight text-[#0d3c2f] sm:text-4xl">
        TIF <span class="text-[#d7a62b]">Agenda</span>
      </h2>
      <p class="mt-2 max-w-2xl text-slate-600">
        {t("agenda.desc")}
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="rounded-2xl border border-slate-200 bg-white py-10 text-center shadow-sm">
        <p class="text-slate-600">{t("agenda.empty")}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 sm:gap-8">
        {posts.map((post: any, i: number) => (
          <article data-aos="fade-up" data-aos-delay={i * 50} class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_30px_-26px_rgba(15,23,42,0.35)] transition duration-300 hover:border-[#d7a62b]">
            <div class="h-52 overflow-hidden">
              <img 
                src={post.thumbnailUrl}
                alt={post.title} 
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" 
              />
            </div>

            <div class="flex flex-grow flex-col p-6">
              <div class="mb-3 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">
                  {post.date}
                </span>
              </div>

              <h3 class="mb-3 text-xl font-bold text-gray-900 transition-colors group-hover:text-emerald-700 line-clamp-2">
                {post.title}
              </h3>

              <p class="mb-6 text-sm text-gray-600 line-clamp-3">
                {post.content.replace(/<[^>]+>/g, "").slice(0, 100)}...
              </p>

              <div class="mt-auto pt-2">
                <a
                  href={localizePath(`/agenda/agenda?id=${post.id}`, lang)}
                  class="inline-flex items-center rounded-full text-sm font-semibold text-[#0d3c2f] transition-colors hover:text-[#d7a62b]"
                >
                  {translateInline((lang === 'en') ? "en" : "id", "inline.view-detail")}
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-16 text-center">
      <a href={localizePath("/agenda/agenda", lang)} class="inline-flex items-center justify-center rounded-full border border-[#0d3c2f] px-7 py-3 font-semibold text-[#0d3c2f] transition-all hover:bg-[#0d3c2f] hover:text-white">
        {t("agenda.viewall")}
      </a>
    </div>
  </div>
</section>