---
import { getLocaleFromUrl, useTranslations } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<section class="py-12 sm:py-20 bg-gray-50 px-4 sm:px-6">
    <div data-aos="fade-up" class="max-w-4xl mx-auto px-6">
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
            <div class="grid grid-cols-1 md:grid-cols-3">
                
                <div data-aos="fade-right" class="bg-green-600 p-8 md:p-12 text-white">
                    <h2 class="text-3xl font-bold mb-4">{t("page.newsletter.title")}</h2>
                    <p class="text-green-50 mb-8 leading-relaxed">
                        {t("page.newsletter.desc")}
                    </p>
                    <div class="flex items-center gap-3 text-sm text-green-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04 Pelajari lebih lanjut" />
                        </svg>
                        {t("page.newsletter.anon")}
                    </div>
                </div>

                <div data-aos="fade-left" class="md:col-span-2 p-8 md:p-12">
                    <form action="#" method="POST" class="space-y-5">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">{t("page.newsletter.topic")}</label>
                            <select class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:bg-white outline-none transition-all">
                                <option>{t("page.newsletter.opt1")}</option>
                                <option>{t("page.newsletter.opt2")}</option>
                                <option>{t("page.newsletter.opt3")}</option>
                                <option>{t("page.newsletter.opt4")}</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">{t("page.newsletter.msg")}</label>
                            <textarea 
                                rows="4" 
                                placeholder={t("page.newsletter.placeholder")}
                                class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:bg-white outline-none transition-all resize-none"
                            ></textarea>
                        </div>

                        <button 
                            type="submit" 
                            class="w-full md:w-auto px-10 py-3 bg-green-600 text-white font-bold rounded-xl hover:bg-green-700 active:scale-95 transition-all shadow-lg shadow-green-200"
                        >
                            {t("page.newsletter.submit")}
                        </button>
                    </form>
                </div>
                
            </div>
        </div>
    </div>
</section>