---
import {
  Facebook,
  Instagram,
  Github,
  Mail,
  Youtube,
} from '@lucide/astro';
---

<footer class="relative bg-slate-900 text-slate-300 pt-20">
   <div class="absolute inset-0 bg-[url('/landing-pages/gedung-faste.jpg')] bg-cover bg-center opacity-5"></div>
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <div class="lg:col-span-5 flex flex-col gap-8">
      <div class="flex items-center gap-6">
        <div class="flex flex-col items-center border-r border-slate-700 pr-6">
          <img src="/logo/uin.png" alt="Logo UIN Suska" class="h-20 w-auto">
          <span class="text-[10px] font-bold text-blue-400 mt-2 uppercase tracking-tighter text-center">
            UIN Suska Riau
          </span>
        </div>
        <div class="flex flex-col">
          <h1 class="text-2xl md:text-3xl font-bold tracking-wide text-white leading-tight uppercase">
            Teknik <span class="text-[#004d2c]">Informatika</span>
          </h1>
          <h2 class="text-lg md:text-xl font-light text-slate-400 leading-tight uppercase">
            Fakultas Sains dan Teknologi
          </h2>
        </div>
      </div>

      <div class="space-y-6">
        <p class="text-sm leading-relaxed text-slate-400 max-w-md">
          Program Studi Teknik Informatika UIN Sultan Syarif Kasim Riau resmi memperoleh 
          <strong class="text-slate-200">Akreditasi Unggul</strong> dari LAM INFOKOM (2025). 
          Fokus pada integrasi teknologi informasi dengan nilai-nilai Keislaman.
        </p>

        <div class="flex flex-wrap items-center gap-6 pt-2">
          <img src="/logo/uin.png" alt="UIN Suska" class="h-8 opacity-50 hover:opacity-100 transition grayscale hover:grayscale-0"/>
          <img src="/logo/unggul.png" alt="Akreditasi Unggul" class="h-7 opacity-50 hover:opacity-100 transition grayscale hover:grayscale-0"/>
          <img src="/logo/blu.png" alt="BLU" class="h-6 opacity-50 hover:opacity-100 transition grayscale hover:grayscale-0"/>
          <img src="/logo/kemenag.png" alt="Kemenag" class="h-7 opacity-50 hover:opacity-100 transition grayscale hover:grayscale-0"/>
        </div>
      </div>
    </div>

    <div class="lg:col-span-3">
      <h3 class="text-lg font-semibold text-white mb-6 border-b border-slate-800 pb-2">Kontak</h3>
      <div class="space-y-4 text-sm opacity-90">
        <p class="leading-relaxed">
          Jl. HR. Soebrantas No.155 KM 18<br />
          Simpang Baru Panam, Pekanbaru 28293
        </p>
        <a href="mailto:tif@uin-suska.ac.id" class="flex items-center gap-3 hover:text-blue-400 transition group">
          <div class="p-2 bg-slate-800 rounded-lg group-hover:bg-slate-700">
            <Mail size={16}/>
          </div>
          tif@uin-suska.ac.id
        </a>
        <div class="flex gap-4 mt-6">
          <a href="https://facebook.com/tifuinsuska" class="p-2 bg-slate-800 rounded-lg hover:bg-blue-600 hover:text-white transition"><Facebook size={18}/></a>
          <a href="https://instagram.com/tifuinsuska" class="p-2 bg-slate-800 rounded-lg hover:bg-pink-600 hover:text-white transition"><Instagram size={18}/></a>
          <a href="https://github.com/tifuinsuska" class="p-2 bg-slate-800 rounded-lg hover:bg-slate-700 hover:text-white transition"><Github size={18}/></a>
          <a href="https://youtube.com/tifuinsuska" class="p-2 bg-slate-800 rounded-lg hover:bg-red-600 hover:text-white transition"><Youtube size={18}/></a>
        </div>
      </div>
    </div>
    
    <div class="lg:col-span-2 text-sm">
      <h3 class="text-lg font-semibold text-white mb-6 border-b border-slate-800 pb-2">Layanan</h3>
      <ul class="space-y-3">
        <li><a href="https://sireg.uin-suska.ac.id/beranda-sireg-uin-suska-riau.html" class="hover:text-blue-400 transition">SIREG</a></li>
        <li><a href="https://iraisenew.uin-suska.ac.id" class="hover:text-blue-400 transition">IRaise</a></li>
        <li><a href="https://elearning.uin-suska.ac.id/login/index.php" class="hover:text-blue-400 transition">E-Learning</a></li>
        <li><a href="https://dashboard.tif.uin-suska.ac.id/" class="hover:text-blue-400 transition">Dashboard TIF</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2 text-sm font-medium">
      <h3 class="text-lg font-semibold text-white mb-6 border-b border-slate-800 pb-2">LabsSquad</h3>
      <ul class="space-y-3">
        <li><a href="https://riaudevops.id/" class="hover:text-emerald-400 transition">Riau DevOps</a></li>
        <li><a href="https://www.instagram.com/alisi.usr/" class="hover:text-emerald-400 transition">Aliansi Siber</a></li>
        <li><a href="#" class="hover:text-emerald-400 transition">Figma Squad</a></li>
        <li><a href="#" class="hover:text-emerald-400 transition">AIOT</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-10 border-t border-slate-800/50">
    <div class="flex flex-col md:flex-row justify-center gap-12 lg:gap-24 items-start">
      <div class="flex flex-col items-center">
        <h3 class="text-xs uppercase tracking-widest font-bold text-slate-500 mb-4 text-center">Lokasi Kampus</h3>
        <div class="w-[280px] h-[150px] rounded-xl overflow-hidden border border-slate-700 grayscale hover:grayscale-0 transition duration-500">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3205.0309365499875!2d101.35441385085029!3d0.4656198166098458!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31d5ac01177a52af%3A0xbb3c60772e1579a!2sUniversitas%20Islam%20Negeri%20Sultan%20Syarif%20Kasim!5e0!3m2!1sid!2sid!4v1769956666957!5m2!1sid!2sid"
            class="w-full h-full"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="flex flex-col items-center text-center">
        <h3 class="text-xs uppercase tracking-widest font-bold text-slate-500 mb-4">Layanan Administrasi</h3>
        <div class="bg-white p-2 rounded-lg w-[120px]">
          <img src="/qr/qrcode-tif-e1732246849890.png" alt="QR Administrasi" class="w-full h-auto" />
        </div>
        <p class="text-[10px] mt-3 text-slate-500 max-w-[150px]">Scan QR untuk akses cepat layanan administrasi akademik</p>
      </div>
    </div>
  </div>

  <div class="mt-20 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row justify-between items-center text-[11px] md:text-xs tracking-wide">
      <p class="text-slate-500 text-center md:text-left">
        &copy; 2025 <span class="text-slate-300 font-medium">Teknik Informatika UIN Suska Riau</span>. All rights reserved.
      </p>
      
      <div class="flex gap-6 mt-4 md:mt-0 text-slate-500">
        <a href="#" class="hover:text-white transition">Privacy Policy</a>
        <a href="#" class="hover:text-white transition">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>