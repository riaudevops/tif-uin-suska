    <div class="relative z-10 max-w-7xl mx-auto px-8 py-14 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <div class="flex flex-col gap-10">

        <!-- LOGO + TITLE -->
        <div class="flex items-center gap-6">
          <div class="flex flex-col items-center border-r border-white/20 pr-6">
            <img src="/logo/uin.png" alt="Logo UIN Suska" class="h-20 w-auto">
            <span class="mt-2 text-[10px] font-bold text-yellow-300 uppercase tracking-widest text-center">
              UIN Suska Riau
            </span>
          </div>

          <div>
            <h1 class="text-2xl md:text-3xl font-bold uppercase tracking-wide text-white leading-tight">
              Teknik Informatika
            </h1>
            <h2 class="text-lg md:text-xl font-light text-yellow-500 uppercase">
              Fakultas Sains dan Teknologi
            </h2>
          </div>
        </div>

        <!-- AKREDITASI -->
        <div class="flex items-center gap-3">
          <img src="/logo/unggul.png" alt="Akreditasi Unggul" class="h-12 w-auto"/>
          <img src="/logo/blu.png" alt="BLU" class="h-12 w-auto"/>
          <img src="/logo/kemenag.png" alt="Kemenag" class="h-12 w-auto"/>
        </div>

      </div>

      <!-- RIGHT : DESKRIPSI -->
      <div class="text-white max-w-xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.25em] text-yellow-300">
          Informasi Program Studi
        </p>

        <h3 class="text-3xl font-bold leading-snug">
          Teknik Informatika
        </h3>

        <p class="text-white-400 leading-relaxed">
          Program Studi Teknik Informatika UIN Sultan Syarif Kasim Riau
          mengintegrasikan keilmuan teknologi informasi dengan nilai-nilai keislaman.
          Fokus kami adalah mencetak lulusan yang unggul secara akademik, adaptif
          terhadap perkembangan teknologi, serta beretika dan berintegritas.
        </p>
        <button class="mt-6 px-6 py-3 bg-yellow-400 text-green-900 font-semibold rounded-full shadow-lg shadow-yellow-900/30 hover:bg-yellow-500 hover:shadow-xl hover:shadow-yellow-900/40 transition-all duration-300">
          Learn More
        </button>
      </div>

    </div>
  </div>
</section>

