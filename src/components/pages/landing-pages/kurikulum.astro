---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div data-aos="fade-right" class="order-2 lg:order-1">
                <span class="inline-block px-3 py-1 mb-4 text-sm font-semibold text-yellow-700 bg-yellow-100 rounded-lg">
                    {t("kurikulum.badge")}
                </span>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-8">
                    {lang === 'en' ? <>Competency-Based <span class="text-green-900">Curriculum</span></> : <>Kurikulum Berbasis <span class="text-green-900">Kompetensi</span></>}
                </h2>
                <div class="space-y-6">
                    <p class="text-slate-600 text-lg leading-relaxed">
                        {t("kurikulum.desc")}
                    </p>
                    <p class="text-slate-600 text-lg leading-relaxed border-l-4 border-green-900 pl-6 italic">
                        "{t("kurikulum.quote")}"
                    </p>
                </div>
                <div class="mt-10">
                    <a href={localizePath("/kurikulum/kurikulum", lang)} class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-green-900 hover:bg-green-700 transition duration-300 shadow-lg">
                        {t("kurikulum.cta")}
                    </a>
                </div>
            </div>

            <div data-aos="fade-left" class="order-1 lg:order-2">
                <div class="relative group">
                    <div class="absolute -inset-2 bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
                    
                    <div class="relative overflow-hidden rounded-2xl shadow-2xl bg-black aspect-video">
                        <iframe
                            class="absolute inset-0 w-full h-full"
                            data-deferred-src="https://www.youtube.com/embed/v9_-HQSWvi4"
                            title="Informatics Engineering curriculum overview"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            loading="lazy"
                            allowfullscreen
                        ></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>