---
import { useTranslation } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
console.log("Bahasa saat ini:", lang);
const lang = Astro.currentLocale as 'id' | 'en' || 'id';
const { translate } = useTranslation(lang);
---

<section class="relative h-screen w-full pt-[115px] overflow-hidden">
  <div id="slides" class="flex h-full w-full transition-transform duration-700 ease-in-out">
 
    <!-- SLIDE 1 -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img href={getRelativeLocaleUrl(lang, '/landing-pages/gedung.jpg')} class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
          <div class="slide-content relative z-20 max-w-4xl text-center px-6">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            {translate('btn.badge')}
          </span>
    
          <h1 class="mt-6 text-3xl md:text-5xl font-bold text-white">
            {translate('hero.welcome')}
            <span class="block text-yellow-400 mt-2">
              {translate('hero.sub_welcome')}
            </span>
          </h1>
    
          <p class="mt-6 text-gray-100 text-lg max-w-3xl mx-auto leading-relaxed">
            {translate('btn.tif')}
          </p>
    
          <div class="mt-10 flex justify-center gap-4">
            <a href="/profil-pages/sejarah" 
              class="px-8 py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg">
              {translate('badge.tif')}
            </a>
    
            <a href="/akademik" class="px-8 py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition">
              {translate('badge.akademik')}
            </a>
          </div>
        </div>
    </div>
    
    <!-- SLIDE 2 -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/landing-pages/gedung.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
          <div class="slide-content relative z-20 max-w-4xl text-center px-6">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            {translate('btn.tif')}
          </span>
    
          <h1 class="mt-6 text-3xl md:text-5xl font-bold text-white">
            {translate('hero.welcome')}
            <span class="block text-yellow-400 mt-2">
              {translate('hero.sub_welcome')}
            </span>
          </h1>
    
          <p class="mt-6 text-gray-100 text-lg max-w-3xl mx-auto leading-relaxed">
            {translate('btn.fst')}
          </p>
    
          <div class="mt-10 flex justify-center gap-4">
            <a href="https://fst.uin-suska.ac.id/" 
              class="px-8 py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg">
              {translate('profile.fst')}
            </a>
          </div>
        </div>
    </div>
    
    <!-- SLIDE 3 -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/dosen-pages/dosen.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
          <div class="slide-content relative z-20 max-w-4xl text-center px-6">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            {translate('btn.tif')}
          </span>
    
          <h1 class="mt-6 text-3xl md:text-5xl font-bold text-white">
            {translate('hero.welcome')}
            <span class="block text-yellow-400 mt-2">
              Quality Lecturers and Teaching Staff
            </span>
          </h1>
    
          <p class="mt-6 text-gray-100 text-lg max-w-3xl mx-auto leading-relaxed">
            Lecturers and teaching staff in the Informatics Engineering Study Program at UIN Suska Riau
            consist of experts in the field of information technology who are highly dedicated
            to supporting the learning process and research development.
          </p>
    
          <div class="mt-10 flex justify-center gap-4">
            <a href="/dosen-pages/dosen" 
              class="px-8 py-3 rounded-full bg-yellow-500 text-green-900 hover:bg-yellow-400 font-bold transition shadow-lg">
              Profile Lecturers
            </a>
          </div>
        </div>
    </div>
    
    <!-- SLIDE 4 -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/landing-pages/gedung-faste.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
          <div class="slide-content relative z-20 max-w-4xl text-center px-6">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            Informatics Engineering Study Program
          </span>
    
          <h1 class="mt-6 text-3xl md:text-5xl font-bold text-white">
            Welcome to
            <span class="block text-yellow-400 mt-2">
              Vision, Mission, and Goals of the Informatics Engineering Study Program at UIN Suska Riau
            </span>
          </h1>
    
          <p class="mt-6 text-gray-100 text-lg max-w-3xl mx-auto leading-relaxed">
            Vision of the Informatics Engineering Study Program at UIN Suska Riau is to become a
            leading study program in the field of information technology based on Islamic values
            and able to compete globally by 2030.
          </p>
    
          <div class="mt-10 flex justify-center gap-4">
  
            <a href="/visimisi-pages/visimisi" class="px-8 py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition">
              Learn More
            </a>
          </div>
        </div>
    </div>
    
    <!-- SLIDE 5 -->
    <div class="min-w-full h-full relative flex items-center justify-center">
      <img src="/landing-pages/gedung-faste.jpg" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-green-900/80 via-green-800/60 to-transparent z-10"></div>
          <div class="slide-content relative z-20 max-w-4xl text-center px-6">
          <span class="inline-block px-5 py-1.5 rounded-full bg-yellow-100 text-yellow-800 border border-yellow-300 text-sm font-semibold">
            Informatics Engineering Study Program
          </span>
    
          <h1 class="mt-6 text-3xl md:text-5xl font-bold text-white">
            Welcome to
            <span class="block text-yellow-400 mt-2">
              Achievements of Informatics Engineering Students
            </span>
          </h1>
    
          <p class="mt-6 text-gray-100 text-lg max-w-3xl mx-auto leading-relaxed">
            Students of the Informatics Engineering Study Program at UIN Suska Riau have achieved many
            accomplishments at both national and international levels, demonstrating high competence and
            dedication in the field of information technology.
          </p>
    
          <div class="mt-10 flex justify-center gap-4">
            <a href="/prestasi-pages/prestasi"
              class="px-8 py-3 rounded-full border-2 border-white text-white hover:bg-white hover:text-green-900 font-medium transition"
            >
              Learn More
            </a>
          </div>
        </div>
    </div>
</div>

<!-- Tombol Prev -->
<button id="prev"
    class="absolute left-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-12 h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
    aria-label="Previous Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
</button>

<!-- Tombol Next -->
<button id="next"
    class="absolute right-6 top-1/2 -translate-y-1/2 z-30 group flex items-center justify-center w-12 h-12 bg-white/20 hover:bg-white/90 border border-white/30 text-white hover:text-green-800 rounded-full backdrop-blur-md transition-all duration-300 shadow-lg active:scale-90"
    aria-label="Next Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
</button>

  <!-- INDICATORS -->
  <div id="indicators"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex gap-3">
  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const slider = document.getElementById('slides');
  const slides = slider.children;
  const total = slides.length;

  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const indicators = document.getElementById('indicators');

  let index = 0;
  let interval;

  /* ====== CREATE DOTS ====== */
  for (let i = 0; i < total; i++) {
    const dot = document.createElement('button');
    dot.className =
      'w-3 h-3 rounded-full bg-white/40 hover:bg-white transition';
    dot.dataset.index = i;

    dot.addEventListener('click', () => {
      index = i;
      update();
      restartAutoSlide();
    });

    indicators.appendChild(dot);
  }

  const dots = indicators.children;

  /* ====== UPDATE SLIDE ====== */
  function update() {
    slider.style.transform = `translateX(-${index * 100}%)`;

    for (let i = 0; i < dots.length; i++) {
      dots[i].classList.remove('bg-white');
      dots[i].classList.add('bg-white/40');
    }
    dots[index].classList.add('bg-white');
  }

  /* ====== NAV BUTTONS ====== */
  nextBtn.addEventListener('click', () => {
    index = (index + 1) % total;
    update();
    restartAutoSlide();
  });

  prevBtn.addEventListener('click', () => {
    index = (index - 1 + total) % total;
    update();
    restartAutoSlide();
  });

  /* ====== AUTO SLIDE ====== */
  function startAutoSlide() {
    interval = setInterval(() => {
      index = (index + 1) % total;
      update();
    }, 7000); // 7 detik (akademik safe)
  }

  function restartAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  /* INIT */
  update();
  startAutoSlide();
});
</script>
