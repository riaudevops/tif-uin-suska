---

---

<div class="min-h-screen py-16 px-6 bg-[#004d2c]">

  {/* HEADER */}
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Prestasi Mahasiswa Teknik Informatika</h1>
    <p class="mt-3 text-gray-700 max-w-xl mx-auto">
      Mewadahi talenta unggul dan menghasilkan prestasi gemilang
    </p>
  </div>

  {/* GRID PRESTASI */}
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">

    {prestasiData.map((item, index) => (
      <div
        key={index}
        class="bg-white rounded-2xl shadow-lg overflow-hidden hover:scale-105 transition-transform duration-300 relative"
      >

        {/* IMAGE */}
        <div class="relative">
          <img
            src={item.gambar}
            alt={item.title}
            class="w-full h-64 object-cover"
          />
          {/* Overlay tulisan "CONGRATS" */}
          <div class="absolute inset-0 flex items-center justify-center opacity-20 bg-black">
            <h1 class="text-[70px] font-extrabold text-white tracking-widest">
              CONGRATS
            </h1>
          </div>
        </div>

        {/* CONTENT */}
        <div class="p-6 space-y-2">
          <p class="text-green-700 text-sm font-semibold">{item.nama}</p>
          <h2 class="text-lg font-bold text-gray-900 leading-snug">{item.title}</h2>
          {item.lokasi && (
            <p class="text-gray-600 text-sm mt-1">{item.lokasi}</p>
          )}
        </div>

        {/* Aksen hijau di bawah card */}
        <div class="h-1 bg-green-500 w-full"></div>
      </div>
    ))}

  </div>
</div>

