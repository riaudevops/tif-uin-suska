---

// Data berita — bisa nanti diganti dynamic API, database, dll.
const posts = [
  {
    title: "Penerimaan Mahasiswa Baru 2024/2025 Telah Dibuka!", // Judul berita
    date: "26/11/2025", // Format: dd/mm/yyyy
    image: "/news-pages/tes.jpg", // URL gambar masukin kedalam databasenya(sejauh ini masih belum dibuaut masih ancang ancang)
    slug: "penerimaan-mahasiswa-baru-2024-2025", // untuk link dinamis
    desc: "Penerimaan mahasiswa baru untuk tahun akademik 2024/2025 telah resmi dibuka...", // deskripsi singkat
  },
  {
    title: "Seminar Nasional Teknologi Informasi",
    date: "11/11/2025",
    image: "/news-pages/tes.jpg",
    slug: "seminar-nasional-teknologi-informasi",
    desc: "Kegiatan Seminar Nasional Teknik Informatika dengan fokus AI dan Keamanan Siber...",
  },
  {
    title: "Workshop AI untuk Mahasiswa",
    date: "11/11/2025",
    image: "/news-pages/tes.jpg",
    slug: "workshop-ai-mahasiswa",
    desc: "Workshop penggunaan AI generatif untuk mendukung penelitian di bidang Informatika...",
  },
];
---

  <section class="
      py-20 px-6
      bg-gradient-to-br from-green-900 via-emerald-800 to-green-700
  ">
  
  <div class="relative z-10">

    <div class="max-w-4xl mx-auto text-center mb-14">
      <h1 class="text-4xl font-bold text-white tracking-tight after:w-16 after:h-1 after:bg-lime-300 after:block after:mx-auto after:mt-4">
        TIF News
      </h1>
      <p class="text-white leading-relaxed">
        Informasi terbaru seputar kegiatan akademik, seminar,
        dan pengembangan keilmuan di Program Studi Teknik Informatika.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-7 max-w-7xl mx-auto">
      {posts.map((post) => (
        <div
          class="bg-white border border-gray-200 rounded-2xl overflow-hidden
                 hover:border-yellow-400 hover:shadow-xl transition group">

          <img
            src={post.image}
            alt={post.title}
            class="w-full h-52 object-cover" />

          <div class="p-6">
            <span class="text-lime-600 font-medium text-yellow-600">
              {post.date}
            </span>

            <h2
              class="mt-2 text-lg font-semibold text-green-900 leading-snug
                     group-hover:underline underline-offset-4
                     decoration-yellow-400">
              {post.title}
            </h2>

            <p class="text-gray-600 text-sm mt-3">
              {post.desc}
            </p>

            <a
              href={`/berita/${post.slug}`}
              class="inline-flex items-center gap-2 mt-5
                    px-5 py-2.5
                    text-sm font-medium text-white
                    bg-emerald-700
                    rounded-lg
                    shadow-md shadow-emerald-900/20
                    hover:bg-emerald-800
                    hover:shadow-lg hover:shadow-emerald-900/30
                    transition-all duration-300"
            >
              Baca Selengkapnya
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>