---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { fetchWithCache } from "../../../lib/cachedFetch";
import { API_BASE_URL, ASSET_URL, getAssetUrl } from "../../../lib/cms";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

// Ambil token dari environment variables
const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;

let posts = [];

try {
  // Menyesuaikan query fields dengan variabel yang ada di database dan HTML
  const json = await fetchWithCache(
    `${API_BASE_URL}/berita?fields=id,title,slug,featured_image,date,date_created,excerpt&sort=-date&limit=3`,
    { 
      headers: {
        "Content-Type": "application/json",
        ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
      }
    },
    60000
  );

  posts = json.data || [];
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.warn("Gagal mengambil berita beranda:", message);
}

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return "Tanggal tidak tersedia";
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return "Tanggal tidak tersedia";
    return d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
  } catch {
    return "Tanggal tidak tersedia";
  }
}
---

<section class="relative py-16 sm:py-24 px-4 sm:px-6 overflow-hidden bg-[#022c22]">
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-black-800 rounded-lg blur-[120px]"></div>
  <div class="absolute inset-0 bg-[url('/landing-pages/gedung.jpg')] bg-cover bg-center opacity-15"></div> 
  <div class="relative z-10 max-w-7xl mx-auto">
    <div data-aos="fade-right" class="mb-8 sm:mb-12 border-l-4 border-yellow-400 pl-4 sm:pl-6">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        TIF <span class="text-yellow-400">News</span>
      </h2>
      <p class="text-gray-300 mt-2 max-w-2xl">
        {t("news.desc")}
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-10 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
        <p class="text-gray-300">{t("news.empty")}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {posts.map((post: any, i: number) => (
        <div data-aos="fade-up" data-aos-delay={i * 40} class="flex flex-col bg-white rounded-2xl overflow-hidden shadow-lg hover:-translate-y-2 transition-all duration-300 group">
          
          <div class="overflow-hidden h-52">
            <img 
              src={getAssetUrl(post.featured_image || post.images, "/default-thumbnail.jpg")}
              alt={post.title} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
          </div>

          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-2 h-2 bg-yellow-400 rounded-lg"></span>
              <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">
                {formatDate(post.date || post.date_created)}
              </span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-emerald-700 transition-colors line-clamp-2">
              {post.title}
            </h3>

            <p class="text-gray-600 text-sm mb-6 line-clamp-3">
              {(post.excerpt || "").replace(/<[^>]+>/g, "").slice(0, 100)}...
            </p>

            <div class="mt-auto">
              <a
                href={localizePath(`/berita/${post.slug || post.id}`, lang)}
                class="inline-flex items-center font-bold rounded-lg text-sm text-emerald-800 hover:text-yellow-600 transition-colors group/link"
              >
                {t("common.readmore")}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    )}

    <div class="mt-16 text-center">
      <a href={localizePath("/berita", lang)} class="px-8 py-3 bg-transparent border-2 border-white text-white rounded-lg font-semibold hover:bg-white hover:text-[#0B2C24] transition-all">
        {t("news.viewall")}
      </a>
    </div>

  </div>
</section>