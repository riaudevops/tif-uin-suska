---

<!-- Breadcrumbs -->
<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100 font-sans">
        <li class="flex items-center">
            <a href="/" class="flex items-center hover:text-[#004d2c] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Beranda
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="hover:text-[#004d2c] cursor-pointer transition-colors">
            Profil
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-[#004d2c] font-bold tracking-tight">
            Ruang Kelas
        </li>
    </ol>
</nav>

<!-- Page Header Banner -->
<section class="bg-gradient-to-b from-gray-50 to-white py-12 overflow-hidden font-sans">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center animate-fade-in">
      
      <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block font-sans">
        Fasilitas
      </span>

      <h1 class="text-4xl md:text-5xl font-black text-[#004d2c] mb-6 leading-tight font-heading">
        Ruang Kelas
      </h1>
      
      <p class="text-lg text-gray-600 mb-8 leading-relaxed font-sans max-w-2xl mx-auto">
        Program studi Teknik Informatika UIN SUSKA Riau menyediakan ruang kelas yang memadai, modern, dan nyaman guna mendukung perkuliahan teoritis maupun diskusi kelompok yang dinamis.
      </p>

    </div>
  </div>
</section>

<!-- Content Section -->
<section class="py-12 bg-slate-50 min-h-screen font-sans">
  <div class="container mx-auto px-6 max-w-6xl space-y-24">
    
    {classrooms.map((room) => (
      <div class="space-y-8">
        <!-- Room Title & Description -->
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-black text-[#004d2c] font-heading tracking-tight leading-snug uppercase">
            {room.name}
          </h2>
          <p class="text-sm text-slate-500 mt-2 font-sans max-w-xl mx-auto">
            {room.description}
          </p>
          <div class="w-16 h-1 bg-yellow-500 mx-auto mt-4 rounded-full"></div>
        </div>

        <!-- Interactive Custom Slider -->
        <div class="relative w-full max-w-5xl mx-auto" data-slider-container>
          <!-- Desktop Navigation Arrows overlay inside -->
          <button 
            class="absolute left-4 top-1/2 -translate-y-1/2 z-30 text-white/50 hover:text-white hover:scale-110 transition duration-300 cursor-pointer hidden md:block bg-black/20 hover:bg-black/40 p-2 rounded-full" 
            data-slider-prev
            aria-label="Previous Facility"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button 
            class="absolute right-4 top-1/2 -translate-y-1/2 z-30 text-white/50 hover:text-white hover:scale-110 transition duration-300 cursor-pointer hidden md:block bg-black/20 hover:bg-black/40 p-2 rounded-full" 
            data-slider-next
            aria-label="Next Facility"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Slider Frame -->
          <div class="overflow-hidden rounded-2xl shadow-2xl relative w-full h-[520px] md:h-[350px] flex flex-col md:flex-row bg-[#081730]">
            
            {room.facilities.map((fac, idx) => (
              <div 
                class={`absolute inset-0 flex flex-col md:flex-row w-full h-full transition-all duration-500 ease-in-out ${idx === 0 ? 'opacity-100 z-10 scale-100' : 'opacity-0 z-0 scale-95 pointer-events-none'}`} 
                data-slide-item
              >
                
                <!-- Left Side: Image container with offset border background -->
                <div class="relative w-full md:w-[45%] h-52 md:h-full p-6 md:p-8 flex items-center justify-center shrink-0 z-10">
                  <!-- Decorative Offset Background Box -->
                  <div class="absolute inset-0 m-6 md:m-8 translate-x-[-10px] translate-y-[-10px] bg-[#008dc7] rounded-xl z-0 shadow-inner"></div>
                  
                  <!-- Main Facility Image with live fallback -->
                  <img 
                    src={fac.image} 
                    alt={fac.title} 
                    class="relative z-10 w-full h-full object-cover rounded-xl shadow-lg border border-white/20 aspect-video md:aspect-auto"
                    onerror={`this.onerror=null; this.src='${fac.fallbackImage}';`}
                  />
                </div>

                <!-- Right Side: Content Box with dark background -->
                <div class="w-full md:w-[55%] h-auto md:h-full p-8 md:p-12 flex flex-col justify-center text-white bg-gradient-to-br from-[#081730] via-[#0b2042] to-[#0e2954] relative overflow-hidden">
                  
                  <!-- Subtle Background Path decoration -->
                  <div class="absolute inset-0 opacity-[0.03] pointer-events-none">
                    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0,80 Q100,20 200,80 T400,80 T600,80" fill="none" stroke="currentColor" stroke-width="2" />
                    </svg>
                  </div>

                  <h3 class="text-2xl md:text-3xl font-black mb-3 font-heading tracking-tight leading-tight text-white drop-shadow-sm">
                    {fac.title}
                  </h3>
                  <p class="text-sm md:text-base text-blue-100/80 leading-relaxed font-sans font-medium">
                    {fac.description}
                  </p>
                </div>

              </div>
            ))}

          </div>

          <!-- Mobile Swipe/Nav Buttons (shows on mobile only) -->
          <div class="flex justify-between w-full mt-4 md:hidden px-2">
            <button 
              class="px-4 py-2 bg-white border border-slate-200 hover:bg-[#004d2c] hover:text-white text-slate-700 rounded-xl transition shadow-sm font-bold flex items-center gap-1.5 text-xs cursor-pointer" 
              data-slider-prev-mobile
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Sebelumnya
            </button>
            <button 
              class="px-4 py-2 bg-white border border-slate-200 hover:bg-[#004d2c] hover:text-white text-slate-700 rounded-xl transition shadow-sm font-bold flex items-center gap-1.5 text-xs cursor-pointer" 
              data-slider-next-mobile
            >
              Berikutnya
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Dot Indicators -->
          <div class="flex justify-center items-center gap-2 mt-6" data-slider-dots>
            {room.facilities.map((_, idx) => (
              <button 
                class={`w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? 'bg-[#008dc7] w-6' : 'bg-slate-300 hover:bg-slate-400'}`} 
                data-slider-dot={idx}
                aria-label={`Lihat fasilitas ke-${idx + 1}`}
              ></button>
            ))}
          </div>

        </div>
      </div>
    ))}

  </div>
</section>

<script is:inline>
  function initClassroomSliders() {
    const containers = document.querySelectorAll('[data-slider-container]');
    containers.forEach(container => {
      const slides = container.querySelectorAll('[data-slide-item]');
      const dots = container.querySelectorAll('[data-slider-dots] button');
      const prevBtn = container.querySelector('[data-slider-prev]');
      const nextBtn = container.querySelector('[data-slider-next]');
      const prevBtnMobile = container.querySelector('[data-slider-prev-mobile]');
      const nextBtnMobile = container.querySelector('[data-slider-next-mobile]');

      let currentIndex = 0;
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      function showSlide(index) {
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;

        currentIndex = index;

        // Toggle slides with transitions
        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0', 'scale-95');
            slide.classList.add('opacity-100', 'z-10', 'scale-100');
          } else {
            slide.classList.remove('opacity-100', 'z-10', 'scale-100');
            slide.classList.add('opacity-0', 'pointer-events-none', 'z-0', 'scale-95');
          }
        });

        // Toggle dot indicator sizes and styles
        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.classList.remove('bg-slate-300', 'w-2.5');
            dot.classList.add('bg-[#008dc7]', 'w-6');
          } else {
            dot.classList.remove('bg-[#008dc7]', 'w-6');
            dot.classList.add('bg-slate-300', 'w-2.5');
          }
        });
      }

      // Add desktop controls click events
      if (prevBtn) prevBtn.addEventListener('click', () => showSlide(currentIndex - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showSlide(currentIndex + 1));

      // Add mobile controls click events
      if (prevBtnMobile) prevBtnMobile.addEventListener('click', () => showSlide(currentIndex - 1));
      if (nextBtnMobile) nextBtnMobile.addEventListener('click', () => showSlide(currentIndex + 1));

      // Add dot click events
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => showSlide(idx));
      });

      // Swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      container.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      container.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });

      function handleSwipe() {
        const swipeThreshold = 50;
        if (touchEndX < touchStartX - swipeThreshold) {
          showSlide(currentIndex + 1);
          resetAutoPlay();
        } else if (touchEndX > touchStartX + swipeThreshold) {
          showSlide(currentIndex - 1);
          resetAutoPlay();
        }
      }

      // Auto play (rotates slide every 8 seconds)
      let autoPlayInterval = setInterval(() => {
        showSlide(currentIndex + 1);
      }, 8000);

      // Reset auto-play timer on interaction to prevent interruption right after manual click
      function resetAutoPlay() {
        clearInterval(autoPlayInterval);
        autoPlayInterval = setInterval(() => {
          showSlide(currentIndex + 1);
        }, 8000);
      }

      const allControls = [prevBtn, nextBtn, prevBtnMobile, nextBtnMobile];
      allControls.forEach(btn => {
        if (btn) btn.addEventListener('click', resetAutoPlay);
      });
      dots.forEach(dot => dot.addEventListener('click', resetAutoPlay));
    });
  }

  document.addEventListener('DOMContentLoaded', initClassroomSliders);
  document.addEventListener('astro:page-load', initClassroomSliders);
</script>
