---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
const API_URL = import.meta.env.BASE_API_URL || 'http://localhost:8055';
let items = [];
try {
  const res = await fetch(`${API_URL}/items/tugas_akhir?fields=id,title,slug,excerpt,published_at,thumbnail`);
  if (res.ok) {
    const data = await res.json();
    items = data.data.map((d: any) => ({
      id: d.id,
      title: d.title || 'Tanpa Judul',
      slug: d.slug || d.id,
      excerpt: d.excerpt || '',
      date: d.published_at ? new Date(d.published_at).toLocaleDateString('id-ID') : '' ,
      thumbnail: d.thumbnail || ''
    }));
  } else {
    console.error('Gagal memuat data Tugas Akhir', res.status);
  }
} catch (e) {
  console.error('Error fetch tugas akhir', e);
}
---

<Layout title="Info Tugas Akhir (TA)">
  <nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center space-x-2 text-slate-500">
      <li><a href={localizePath('/', lang)} class="hover:text-emerald-700">{t("bread.home")}</a></li>
      <li class="text-slate-300">/</li>
      <li><a href={localizePath('/profil', lang)} class="hover:text-emerald-700">{t("bread.profil")}</a></li>
      <li class="text-slate-300">/</li>
      <li class="text-emerald-800 font-semibold italic">{t("bread.ta")}</li>
    </ol>
  </nav>

  <section data-aos="fade-up" class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest inline-block">{t("common.program")}</span>
      <h1 data-aos="fade-up" class="text-4xl font-black text-[#004d2c] mt-4">{t("bread.ta")}</h1>
      <p class="text-slate-600 mt-3">{isEn ? "Collection of announcements, guides, and final project reports. Content managed through Directus." : "Kumpulan pengumuman, panduan, dan laporan tugas akhir mahasiswa. Konten dikelola melalui Directus."}</p>
    </div>

    {items.length === 0 ? (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border border-slate-100">
        <p class="text-slate-500">{isEn ? "No final project content yet. Add entries to the tugas_akhir collection in Directus." : "Belum ada konten tugas akhir. Tambahkan entri ke koleksi tugas_akhir di Directus."}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map(item => (
          <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100">
            {item.thumbnail && <img src={item.thumbnail} alt={item.title} class="w-full h-44 object-cover" />}
            <div class="p-6">
              <h3 class="text-lg font-bold text-slate-800 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-500 mb-4 line-clamp-2">{item.excerpt}</p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-400">{item.date}</span>
                <a class="text-sm font-semibold text-[#004d2c]" href={localizePath(`/tugas-akhir/${item.slug}`, lang)}>{t("common.detail")}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

  </section>
</Layout>
