---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  GraduationCap,
  FileText,

  CheckCircle2,
  Calendar,
  BookOpen,
  ArrowRight,
  Sparkles,
  Award,
  Users,
  Search,
  FileCheck,
  School
} from '@lucide/astro';

import { API_URL, getAssetUrl } from "../../../lib/cms";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

interface TugasAkhirItem {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  thumbnail: string;
  category?: string;
}

let items: TugasAkhirItem[] = [];
let fetchError = false;

try {
  const params = new URLSearchParams({
    fields: 'id,title,slug,excerpt,published_at,thumbnail,category',
    sort: '-published_at',
    limit: '50',
  });

  const res = await fetch(`${API_URL}/items/tugas_akhir?${params.toString()}`);

  if (res.ok) {
    const data = await res.json();
    items = (data?.data ?? []).map((d: any) => ({
      id: d.id,
      title: d.title || (isEn ? 'Untitled Announcement' : 'Tanpa Judul'),
      slug: d.slug || d.id,
      excerpt: d.excerpt || '',
      date: d.published_at
        ? new Date(d.published_at).toLocaleDateString(isEn ? 'en-US' : 'id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        : '',
      thumbnail: getAssetUrl(d.thumbnail),
      category: d.category || (isEn ? 'Thesis Info' : 'Informasi TA')
    }));
  } else {
    fetchError = true;
  }
} catch (e) {
  console.error('Error fetching Tugas Akhir items:', e);
  fetchError = true;
}

// Milestone & Process Steps Data
const milestoneSteps = isEn ? [
  {
    step: "01",
    title: "Topic & Proposal Submission",
    desc: "Submission of research topic to Final Project Coordinator and assignment of main faculty advisors.",
    icon: FileText
  },
  {
    step: "02",
    title: "Proposal Defense (Sempro)",
    desc: "Presenting research methodology and proposal to examiners for feasibility verification and inputs.",
    icon: Users
  },
  {
    step: "03",
    title: "Research & Development",
    desc: "Conducting system implementation, experiments, testing, and regular progress guidance.",
    icon: BookOpen
  },
  {
    step: "04",
    title: "Final Thesis Defense (Munaqasyah)",
    desc: "Defending thesis before faculty examiners, scientific paper publication, and graduation clearance.",
    icon: GraduationCap
  }
] : [
  {
    step: "01",
    title: "Pengajuan Judul & Proposal",
    desc: "Pengajuan topik dan draf proposal ke Koordinator TA serta penetapan Dosen Pembimbing Utama & Pendamping.",
    icon: FileText
  },
  {
    step: "02",
    title: "Seminar Proposal (Sempro)",
    desc: "Ujian kelayakan proposal riset di hadapan penguji untuk mendapatkan persetujuan dan masukan perbaikan.",
    icon: Users
  },
  {
    step: "03",
    title: "Pelaksanaan Riset & Bimbingan",
    desc: "Implementasi perangkat lunak/algoritma, pengujian data, serta bimbingan berkala penulisan skripsi.",
    icon: BookOpen
  },
  {
    step: "04",
    title: "Sidang Munaqasyah & Skripsi",
    desc: "Ujian lisan akhir skripsi, syarat publikasi artikel ilmiah, perbaikan revisi, dan penyerahan naskah.",
    icon: GraduationCap
  }
];

// Fallback announcements if Directus empty
const fallbackAnnouncements: TugasAkhirItem[] = isEn ? [
  {
    id: 'ta-fb-1',
    title: 'Registration & Schedule for Even Semester Proposal Defense 2026',
    slug: 'pendaftaran-jadwal-sempro-2026',
    excerpt: 'Detailed schedule and guidelines for registering for Proposal Defense in Informatics Engineering.',
    date: '20 January 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Sempro'
  },
  {
    id: 'ta-fb-2',
    title: 'Scientific Journal Publication Guidelines for Graduating Students',
    slug: 'panduan-publikasi-jurnal-coreit',
    excerpt: 'Mandatory journal article submission requirement for final project approval and graduation clearance.',
    date: '12 January 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'Publication'
  },
  {
    id: 'ta-fb-3',
    title: 'Final Thesis Defense (Munaqasyah) Period & Examiner List Batch 2',
    slug: 'jadwal-sidang-munaqasyah-batch-2',
    excerpt: 'Announcement of room assignments, time slots, and board of examiners for Munaqasyah thesis defense.',
    date: '05 January 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Munaqasyah'
  }
] : [
  {
    id: 'ta-fb-1',
    title: 'Pendaftaran & Pembagian Jadwal Seminar Proposal Semester Genap 2026',
    slug: 'pendaftaran-jadwal-sempro-2026',
    excerpt: 'Informasi lengkap persetujuan berkas, syarat bebas SKS, dan pembagian ruang ujian Seminar Proposal.',
    date: '20 Januari 2026',
    thumbnail: '/landing-pages/gedung-faste.jpg',
    category: 'Sempro'
  },
  {
    id: 'ta-fb-2',
    title: 'Panduan Kewajiban Publikasi Artikel Ilmiah sebagai Syarat Kelulusan TA',
    slug: 'panduan-publikasi-jurnal-coreit',
    excerpt: 'Petunjuk penyusunan artikel ringkas sesuai format Jurnal CoreIT / Jurnal terakreditasi Sinta.',
    date: '12 Januari 2026',
    thumbnail: '/dosen-pages/dosen.jpg',
    category: 'Publikasi'
  },
  {
    id: 'ta-fb-3',
    title: 'Jadwal Pelaksanaan Sidang Munaqasyah & Dewan Penguji Gelombang II',
    slug: 'jadwal-sidang-munaqasyah-batch-2',
    excerpt: 'Pengumuman jadwal majelis sidang skripsi, alokasi dosen penguji, dan tata tertib ujian munaqasyah.',
    date: '05 Januari 2026',
    thumbnail: '/ruang-kelas/fst_mejadosen.jpg',
    category: 'Munaqasyah'
  }
];

const displayItems = items.length > 0 ? items : fallbackAnnouncements;
---

<div class="min-h-screen bg-[#f5f8f4] text-slate-800">
  <nav class="mx-auto max-w-7xl px-4 pb-4 pt-28 text-sm sm:px-6 lg:px-8 sm:pt-32" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-200 py-3 text-sm text-slate-500">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t('bread.home')}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/profil', lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
          {t('bread.profil')}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="font-semibold text-[#0b5c3d]">
        {t('bread.ta')}
      </li>
    </ol>
  </nav>

  <section class="mx-auto max-w-7xl px-4 pb-8 pt-2 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#053d2d] via-[#0b5c3d] to-[#d8b65b] p-6 text-white shadow-[0_30px_80px_-35px_rgba(4,61,45,0.8)] sm:p-8 lg:p-10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(244,215,125,0.16),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.08),transparent_30%)]"></div>
      <div class="absolute -bottom-10 -left-10 h-52 w-52 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.22em] text-emerald-50">
            <GraduationCap class="h-4 w-4 text-[#f4d77d]" />
            {isEn ? 'Curriculum & Final Milestone' : 'Kurikulum & Kelulusan Mahasiswa'}
          </span>

          <h1 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
            {isEn ? 'Final Project' : 'Tugas Akhir'} <span class="text-[#f4d77d]">{isEn ? 'Portal' : 'Program Studi'}</span>
          </h1>

          <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
            {isEn
              ? 'Information on thesis procedures, proposal defense stages, final assignment requirements, and academic schedules for students.'
              : 'Informasi mengenai prosedur tugas akhir, tahap seminar proposal, persyaratan sidang akhir, dan jadwal akademik mahasiswa.'}
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-2">
          <div class="rounded-[22px] border border-white/15 bg-white/8 p-4 backdrop-blur-sm">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-100/80">{isEn ? 'Credits' : 'Bobot'}</p>
            <p class="mt-3 text-2xl font-black text-white">6 SKS</p>
          </div>
          <div class="rounded-[22px] border border-white/15 bg-white/8 p-4 backdrop-blur-sm">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-100/80">{isEn ? 'Advisors' : 'Pembimbing'}</p>
            <p class="mt-3 text-2xl font-black text-white">2 Dosen</p>
          </div>
          <div class="rounded-[22px] border border-white/15 bg-white/8 p-4 backdrop-blur-sm">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-100/80">{isEn ? 'Research' : 'Riset'}</p>
            <p class="mt-3 text-2xl font-black text-white">5 Bidang</p>
          </div>
          <div class="rounded-[22px] border border-[#f4d77d]/30 bg-[#f4d77d]/10 p-4 backdrop-blur-sm">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#fce9a0]">{isEn ? 'Publication' : 'Publikasi'}</p>
            <p class="mt-3 text-2xl font-black text-white">CoreIT</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div class="mb-8 text-center">
      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">{isEn ? 'Milestone' : 'Tahapan'}</p>
      <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
        {isEn ? 'Final Project Completion Stages' : 'Tahapan Proses Tugas Akhir'}
      </h2>
      <p class="mt-3 text-sm text-slate-600">
        {isEn ? 'Four key stages from proposal to final defense.' : 'Empat tahap utama dari pengajuan proposal hingga sidang akhir.'}
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {milestoneSteps.map((item) => {
        const IconComponent = item.icon;

        return (
          <article class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)] transition-all duration-200 hover:-translate-y-1 hover:border-[#dfeadf] hover:shadow-[0_20px_60px_-30px_rgba(11,92,61,0.45)]">
            <div class="mb-5 flex items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf5ee] text-[#0b5c3d]">
                <IconComponent class="h-6 w-6" />
              </div>
              <span class="text-2xl font-black text-slate-200">{item.step}</span>
            </div>

            <h3 class="text-lg font-black text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 pt-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">{isEn ? 'Announcements' : 'Pengumuman'}</p>
        <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
          {isEn ? 'Latest Final Project Information' : 'Informasi Tugas Akhir Terbaru'}
        </h2>
      </div>
      <p class="max-w-md text-sm text-slate-600">
        {isEn ? 'Updated schedules, proposal regulations, and final defense information.' : 'Jadwal terupdate, panduan proposal, dan informasi sidang akhir mahasiswa.'}
      </p>
    </div>

    {displayItems.length === 0 ? (
      <div class="rounded-[28px] border border-slate-200 bg-white py-16 text-center shadow-[0_18px_45px_-30px_rgba(15,23,42,0.25)]">
        <p class="text-base text-slate-600">{isEn ? 'No final project announcements available yet.' : 'Belum ada konten Tugas Akhir.'}</p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {displayItems.map((item) => (
          <article class="group flex min-h-full flex-col overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_18px_45px_-32px_rgba(15,23,42,0.25)] transition-all duration-200 hover:-translate-y-1 hover:border-[#dfeadf] hover:shadow-[0_26px_70px_-36px_rgba(11,92,61,0.45)]">
            <div class="relative h-52 overflow-hidden bg-slate-100">
              <img
                src={item.thumbnail || '/landing-pages/gedung-faste.jpg'}
                alt={item.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                onError="this.onerror=null; this.src='/landing-pages/gedung-faste.jpg';"
              />
              <span class="absolute left-4 top-4 rounded-full border border-emerald-500/30 bg-slate-900/80 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#dff7db]">
                {item.category || 'TA'}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex items-center gap-2 text-[11px] font-medium text-slate-500">
                <Calendar class="h-3.5 w-3.5 text-[#0b5c3d]" />
                <span>{item.date || (isEn ? 'Recent Update' : 'Terbaru')}</span>
              </div>

              <h3 class="text-lg font-black leading-snug text-slate-900">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">
                {item.excerpt || (isEn ? 'View the complete details to read the full announcement.' : 'Baca selengkapnya untuk melihat informasi dan persyaratan lengkap.')}
              </p>

              <a
                href={localizePath(`/tugas-akhir/${item.slug}`, lang)}
                class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-[#0b5c3d] transition-colors duration-200 hover:text-[#083f2d]"
              >
                {t('common.detail')}
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</div>