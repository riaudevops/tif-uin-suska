---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath("/", lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        {t("bread.home")}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">{t("bread.prestasi")}</li>
  </ol>
</nav>

<section class="relative overflow-hidden py-12 sm:py-14">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(217,182,93,0.18),_transparent_30%),linear-gradient(180deg,#f5faf4_0%,#ffffff_100%)]"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[30px] border border-[#dfeadf] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#d9b65d] p-6 shadow-[0_28px_80px_-32px_rgba(0,61,42,0.8)] sm:p-8 lg:p-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-white/90">
          {t("page.prestasi.badge")}
        </span>
        <h1 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
          {t("page.prestasi.title")}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
          {t("page.prestasi.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
      <div class="inline-flex rounded-full bg-[#edf4e8] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {isEn ? "Academic Achievements" : "Prestasi Akademik"}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
        {isEn
          ? "Student and faculty performance reflected in competitions, publications, and industry-relevant innovation."
          : "Kinerja mahasiswa dan dosen yang ditunjukkan melalui capaian kompetisi, publikasi, dan inovasi berbasis kebutuhan industri."}
      </p>
    </div>

    <div class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
      <div class="inline-flex rounded-full bg-[#f4f0dd] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#5a4c18]">
        {isEn ? "Innovation and Research" : "Inovasi dan Riset"}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
        {isEn
          ? "Developing ideas, work, and digital solutions that connect education, research, and community service."
          : "Pengembangan ide, karya, dan solusi digital yang menjembatani pendidikan, riset, dan pengabdian masyarakat."}
      </p>
    </div>

    <div class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
      <div class="inline-flex rounded-full bg-[#eef5f3] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#1d4d42]">
        {isEn ? "Competitions and Collaboration" : "Kompetisi dan Kolaborasi"}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
        {isEn
          ? "Strategic collaboration among the academic community, partners, and communities to deliver meaningful work."
          : "Kolaborasi strategis antara civitas akademika, mitra, dan komunitas untuk menghadirkan karya yang berdampak nyata."}
      </p>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white p-3 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-4">
    <div class="overflow-hidden rounded-[24px] border border-slate-100 bg-slate-50">
      <img
        src="/prestasi-pages/prestasi.jpg"
        alt={isEn ? "Informatics Engineering achievements" : "Prestasi Teknik Informatika"}
        class="h-[420px] w-full object-cover object-center sm:h-[520px] lg:h-[620px]"
      />
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-6 md:pt-8">
  <div class="rounded-[30px] border border-slate-200 bg-[#f8faf3] p-6 shadow-[0_18px_45px_-35px_rgba(15,23,42,0.25)] sm:p-8 lg:p-10">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500">{isEn ? "Highlights" : "Sorotan"}</p>
        <h2 class="mt-2 text-2xl font-black tracking-tight text-[#004d2c] sm:text-3xl">
          {isEn ? "Notable Achievements" : "Capaian yang membanggakan"}
        </h2>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="rounded-[24px] border border-[#dfe7d7] bg-white p-5">
        <div class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? "Academic" : "Akademik"}
        </div>
        <p class="text-base leading-relaxed text-slate-600">
          {isEn
            ? "The Informatics Engineering Study Program is committed to producing capable, innovative graduates prepared for the challenges of the digital workplace."
            : "Program Studi Teknik Informatika terus menampilkan komitmen kuat dalam menghasilkan lulusan yang kompeten, inovatif, dan siap menghadapi tantangan dunia kerja digital."}
        </p>
      </div>

      <div class="rounded-[24px] border border-[#e8dca0] bg-[#f4f0dd] p-5">
        <div class="mb-3 inline-flex rounded-full bg-[#efe4b5] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#5a4c18]">
          {isEn ? "Innovation" : "Inovasi"}
        </div>
        <p class="text-base leading-relaxed text-slate-700">
          {isEn
            ? "The work, programs, and competitions our community takes part in demonstrate its continued commitment to quality, creativity, and social impact."
            : "Berbagai karya, program, dan kompetisi yang diikuti menjadi bukti nyata bahwa civitas akademika prodi terus mendorong kualitas, kreativitas, dan dampak sosial."}
        </p>
      </div>
    </div>
  </div>
</section>