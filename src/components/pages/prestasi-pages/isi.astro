---
const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

let prestasiData = [];

try {
  const response = await fetch(`${API_URL}/items/prestasi?sort=-tahun`);
  
  if (!response.ok) {
    const errorDetails = await response.json();
    console.error("ERROR DIRECTUS:", JSON.stringify(errorDetails, null, 2));
    throw new Error(`Gagal (Status: ${response.status})`);
  }
  
  const dataDirectus = await response.json();

  prestasiData = dataDirectus.data.map((item: any) => {
    return {
      kegiatan: item.nama_kegiatan || 'Tanpa Nama',
      nama: item.mahasiswa || 'Anonim',
      tahun: item.tahun || '-',
      tingkat: item.tingkat || 'Lokal',
      prestasi: item.pencapaian || 'Finalis'
    };
  });
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching prestasi:", message);
}

const getPrestasiColor = (prestasi: string) => {
  const p = (prestasi || '').toLowerCase();
  
  if (p.includes('juara 1') || p.includes('pertama') || p.includes('emas')) {
    return 'bg-yellow-100 text-yellow-700 border-yellow-200';
  }
  if (p.includes('juara 2') || p.includes('kedua') || p.includes('perak')) {
    return 'bg-slate-100 text-slate-700 border-slate-300';
  }
  if (p.includes('juara 3') || p.includes('ketiga') || p.includes('perunggu')) {
    return 'bg-orange-100 text-orange-700 border-orange-200';
  }
  return 'bg-blue-50 text-blue-600 border-blue-100';
};
---
 
<section class="py-20 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-6">
      
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">
            Excellence & Achievements
        </span>
        <h1 class="text-3xl md:text-4xl font-black text-slate-800 mb-4 tracking-tight uppercase">
          Prestasi <span class="text-[#004d2c]">Mahasiswa</span>
        </h1>
        <p class="text-slate-600 leading-relaxed">
          Daftar pencapaian mahasiswa Teknik Informatika UIN Suska Riau dalam berbagai kompetisi tingkat lokal, nasional, hingga internasional.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 overflow-hidden border border-slate-100">
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-[#004d2c] text-white">
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider text-center w-16">No</th>
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Nama Kegiatan</th>
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Mahasiswa</th>
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider text-center">Tahun</th>
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Tingkat</th>
                      <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Pencapaian</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100" id="prestasi-tbody">
                    {prestasiData.length === 0 ? (
                      <tr>
                        <td colspan="6" class="py-10 text-center text-slate-400 font-medium text-sm">
                          Belum ada data prestasi yang tersedia.
                        </td>
                      </tr>
                    ) : (
                      prestasiData.map((item: any, index: number) => (
                        <tr class={`prestasi-row hover:bg-green-50/50 transition-colors group ${index >= 15 ? 'hidden' : ''}`}>
                          <td class="py-5 px-6 text-center text-slate-400 font-medium text-sm">{index + 1}</td>
                          <td class="py-5 px-6">
                            <p class="text-slate-800 font-bold text-sm leading-snug group-hover:text-[#004d2c] transition-colors">{item.kegiatan}</p>
                          </td>
                          <td class="py-5 px-6">
                            <div class="flex items-center gap-3">
                              <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-500 border border-slate-200 uppercase">
                                {item.nama.charAt(0)}
                              </div>
                              <span class="text-slate-600 text-sm font-medium">{item.nama}</span>
                            </div>
                          </td>
                          <td class="py-5 px-6 text-center">
                            <span class="text-slate-500 text-sm">{item.tahun}</span>
                          </td>
                          <td class="py-5 px-6">
                            <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-[10px] font-bold uppercase tracking-wide">
                              {item.tingkat}
                            </span>
                          </td>
                          <td class="py-5 px-6">
                            <span class={`px-4 py-1.5 rounded-lg text-xs font-black border ${getPrestasiColor(item.prestasi)}`}>
                              {item.prestasi}
                            </span>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
        
        <div class="bg-slate-50/50 p-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p id="pagination-info" class="text-xs text-slate-400 font-medium font-mono uppercase tracking-tighter">
            Menampilkan data...
          </p>
          <div class="flex gap-2">
            <button id="btn-prev" class="px-4 py-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:text-[#004d2c] disabled:opacity-50 disabled:cursor-not-allowed transition-all">
              &larr; Sebelumnya
            </button>
            <span id="page-number" class="px-4 py-2 text-xs font-bold text-[#004d2c] bg-green-50 border border-green-200 rounded-lg">
              1
            </span>
            <button id="btn-next" class="px-4 py-2 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:text-[#004d2c] disabled:opacity-50 disabled:cursor-not-allowed transition-all">
              Selanjutnya &rarr;
            </button>
          </div>
    </div>
    </div>
    </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rows = document.querySelectorAll('.prestasi-row');
    const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement | null;
    const pageInfo = document.getElementById('pagination-info') as HTMLElement | null;
    const pageNumber = document.getElementById('page-number') as HTMLElement | null;

    const rowsPerPage = 15;
    let currentPage = 1;
    const totalPages = Math.ceil(rows.length / rowsPerPage);

    function updateTable() {
      const start = (currentPage - 1) * rowsPerPage;
      const end = start + rowsPerPage;

      rows.forEach((row, index) => {
        if (index >= start && index < end) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });

      const currentEnd = Math.min(end, rows.length);
      const currentStart = rows.length === 0 ? 0 : start + 1;
      
      if (pageInfo) {
        pageInfo.textContent = `Menampilkan ${currentStart} - ${currentEnd} dari total ${rows.length} Records`;
      }
      
      if (pageNumber) {
        pageNumber.textContent = `${currentPage} / ${totalPages || 1}`;
      }

      if (btnPrev) btnPrev.disabled = currentPage === 1;
      if (btnNext) btnNext.disabled = currentPage === totalPages || totalPages === 0;
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          updateTable();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          updateTable();
        }
      });
    }

    updateTable();
  });
</script>