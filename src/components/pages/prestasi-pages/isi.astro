---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

let prestasiData = [];

try {
  const response = await fetch(`${API_URL}/items/prestasi?sort=-waktu_penyelenggaraan`);
  if (!response.ok) {
    const errorDetails = await response.json();
    console.error("ERROR DIRECTUS:", JSON.stringify(errorDetails, null, 2));
    throw new Error(`Gagal (Status: ${response.status})`);
  }

  const dataDirectus = await response.json();
  prestasiData = dataDirectus.data.map((item: any) => {
    let year = "-";
    if (item.waktu_penyelenggaraan) {
      if (!isNaN(item.waktu_penyelenggaraan)) {
        year = String(item.waktu_penyelenggaraan);
      } else {
        const parsedDate = new Date(item.waktu_penyelenggaraan);
        year = !isNaN(parsedDate.getTime()) ? parsedDate.getFullYear().toString() : String(item.waktu_penyelenggaraan);
      }
    }

    const hasilPrestasi = item.prestasi && item.prestasi.trim() !== "" ? item.prestasi : "-";

    return {
      kegiatan: item.nama_kegiatan || "Tanpa Nama",
      nama: item.mahasiswa || "Anonim",
      tahun: year,
      tingkat: item.tingkat || "Lokal",
      prestasi: hasilPrestasi,
    };
  });
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching prestasi:", message);
}

const getPrestasiColor = (prestasi: string) => {
  const p = (prestasi || "").toLowerCase();

  if (p.includes("juara 1") || p.includes("pertama") || p.includes("emas")) {
    return "bg-yellow-100 text-yellow-700 border-yellow-200";
  }
  if (p.includes("juara 2") || p.includes("kedua") || p.includes("perak")) {
    return "bg-slate-100 text-slate-700 border-slate-300";
  }
  if (p.includes("juara 3") || p.includes("ketiga") || p.includes("perunggu")) {
    return "bg-orange-100 text-orange-700 border-orange-200";
  }
  return "bg-[#edf4f7] text-[#1c4b66] border-[#dfeaf0]";
};

const totalRecords = prestasiData.length;
const latestYear = prestasiData.length
  ? Math.max(...prestasiData.map((item) => Number(item.tahun) || 0)).toString()
  : "-";
const topLevel = prestasiData.length
  ? [...new Set(prestasiData.map((item) => item.tingkat))].slice(0, 2).join(" / ")
  : "-";
---

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 md:py-12">
  <div class="mb-6 grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="rounded-[30px] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-7">
      <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-slate-500">Daftar pencapaian</p>
      <h2 class="mt-3 text-2xl font-black tracking-tight text-[#004d2c] sm:text-3xl">
        {t("page.prestasi.title")}
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-600">
        Rekapitulasi pencapaian mahasiswa dalam berbagai aktivitas akademik dan kompetisi yang telah didokumentasikan.
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
      <div class="rounded-[24px] border border-slate-200 bg-[#f8faf3] p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Total</p>
        <p class="mt-3 text-2xl font-black text-[#003d2a]">{totalRecords}</p>
      </div>
      <div class="rounded-[24px] border border-slate-200 bg-[#f8faf3] p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Tahun</p>
        <p class="mt-3 text-2xl font-black text-[#003d2a]">{latestYear}</p>
      </div>
      <div class="rounded-[24px] border border-slate-200 bg-[#f8faf3] p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Tingkat</p>
        <p class="mt-3 text-xl font-black text-[#003d2a]">{topLevel}</p>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)]">
    <div class="flex flex-col gap-3 border-b border-slate-200 bg-[#f6faf2] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-[#0b5c3d]"></span>
        {t("page.prestasi.title")}
      </div>
      <div class="inline-flex w-fit items-center rounded-full bg-[#edf4e8] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {totalRecords} data
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[860px] border-collapse text-left">
        <thead>
          <tr class="bg-[#003d2a] text-white">
            <th class="w-16 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.no")}</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.nama")}</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.mhs")}</th>
            <th class="px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.tahun")}</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.tingkat")}</th>
            <th class="px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{t("page.prestasi.th.capai")}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="prestasi-tbody">
          {prestasiData.length === 0 ? (
            <tr>
              <td colspan="6" class="py-12 text-center text-sm font-medium text-slate-400">
                {t("page.prestasi.empty")}
              </td>
            </tr>
          ) : (
            prestasiData.map((item: any, index: number) => (
              <tr class={`prestasi-row transition-colors hover:bg-[#f5f9f1] ${index >= 15 ? "hidden" : ""}`}>
                <td class="px-5 py-5 text-center text-sm font-semibold text-slate-400">{index + 1}</td>
                <td class="px-5 py-5">
                  <p class="text-sm font-bold leading-snug text-slate-800">{item.kegiatan}</p>
                </td>
                <td class="px-5 py-5">
                  <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-slate-100 text-[10px] font-bold uppercase text-slate-500">
                      {item.nama.charAt(0)}
                    </div>
                    <span class="text-sm font-medium text-slate-600">{item.nama}</span>
                  </div>
                </td>
                <td class="px-5 py-5 text-center">
                  <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-600">
                    {item.tahun}
                  </span>
                </td>
                <td class="px-5 py-5">
                  <span class="inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#0b5c3d]">
                    {item.tingkat}
                  </span>
                </td>
                <td class="px-5 py-5">
                  <span class={`inline-flex rounded-full border px-3.5 py-1.5 text-[11px] font-bold ${getPrestasiColor(item.prestasi)}`}>
                    {item.prestasi}
                  </span>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <div class="flex flex-col gap-4 border-t border-slate-100 bg-slate-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p id="pagination-info" class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400" data-text-show={t("page.prestasi.show")}>
        {t("page.prestasi.show")}
      </p>
      <div class="flex items-center gap-2">
        <button id="btn-prev" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-600 transition-all hover:bg-slate-50 hover:text-[#0b5c3d] disabled:cursor-not-allowed disabled:opacity-50">
          &larr; {t("common.prev")}
        </button>
        <span id="page-number" class="inline-flex min-w-[72px] justify-center rounded-lg border border-[#dfe9d5] bg-[#edf4e8] px-3 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#0b5c3d]">
          1
        </span>
        <button id="btn-next" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-600 transition-all hover:bg-slate-50 hover:text-[#0b5c3d] disabled:cursor-not-allowed disabled:opacity-50">
          {t("common.next")} &rarr;
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initPrestasi() {
    const rows = document.querySelectorAll('.prestasi-row');
    const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement | null;
    const pageInfo = document.getElementById('pagination-info') as HTMLElement | null;
    const pageNumber = document.getElementById('page-number') as HTMLElement | null;

    const rowsPerPage = 15;
    let currentPage = 1;
    const totalPages = Math.max(1, Math.ceil(rows.length / rowsPerPage));

    function updateTable() {
      const start = (currentPage - 1) * rowsPerPage;
      const end = start + rowsPerPage;

      rows.forEach((row, index) => {
        if (index >= start && index < end) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });

      const currentEnd = Math.min(end, rows.length);
      const currentStart = rows.length === 0 ? 0 : start + 1;

      if (pageInfo) {
        const textShow = pageInfo.getAttribute('data-text-show') || "Menampilkan";
        pageInfo.textContent = `${textShow} ${currentStart} - ${currentEnd} dari total ${rows.length} Records`;
      }

      if (pageNumber) {
        pageNumber.textContent = `${currentPage} / ${totalPages}`;
      }

      if (btnPrev) btnPrev.disabled = currentPage === 1;
      if (btnNext) btnNext.disabled = currentPage === totalPages || totalPages === 0;
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage -= 1;
          updateTable();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage += 1;
          updateTable();
        }
      });
    }

    updateTable();
  }

  document.addEventListener('DOMContentLoaded', initPrestasi);
  document.addEventListener('astro:page-load', initPrestasi);
</script>
