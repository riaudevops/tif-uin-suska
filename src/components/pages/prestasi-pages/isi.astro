// Fungsi warna badge berdasarkan prestasi
const getPrestasiColor = (status) => {
  if (status.includes("Juara 1")) return "bg-yellow-100 text-yellow-700 border-yellow-200";
  if (status.includes("Juara 2")) return "bg-slate-100 text-slate-700 border-slate-200";
  if (status.includes("Juara 3")) return "bg-orange-100 text-orange-700 border-orange-200";
  return "bg-blue-50 text-blue-700 border-blue-100";
};
---

  <section class="py-20 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-6">
      
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">
            Excellence & Achievements
        </span>
        <h1 class="text-3xl md:text-4xl font-black text-slate-800 mb-4 tracking-tight uppercase">
          Prestasi <span class="text-[#004d2c]">Mahasiswa</span>
        </h1>
        <p class="text-slate-600 leading-relaxed">
          Daftar pencapaian mahasiswa Teknik Informatika UIN Suska Riau dalam berbagai kompetisi tingkat lokal, nasional, hingga internasional.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 overflow-hidden border border-slate-100">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-[#004d2c] text-white">
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider text-center w-16">No</th>
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Nama Kegiatan</th>
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Mahasiswa</th>
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider text-center">Tahun</th>
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Tingkat</th>
                <th class="py-5 px-6 font-bold uppercase text-[11px] tracking-wider">Pencapaian</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {prestasiData.map((item, index) => (
                <tr class="hover:bg-green-50/50 transition-colors group">
                  <td class="py-5 px-6 text-center text-slate-400 font-medium text-sm">{index + 1}</td>
                  <td class="py-5 px-6">
                    <p class="text-slate-800 font-bold text-sm leading-snug group-hover:text-[#004d2c] transition-colors">{item.kegiatan}</p>
                  </td>
                  <td class="py-5 px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-500 border border-slate-200 uppercase">
                        {item.nama.charAt(0)}
                      </div>
                      <span class="text-slate-600 text-sm font-medium">{item.nama}</span>
                    </div>
                  </td>
                  <td class="py-5 px-6 text-center">
                    <span class="text-slate-500 text-sm">{item.tahun}</span>
                  </td>
                  <td class="py-5 px-6">
                    <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-[10px] font-bold uppercase tracking-wide">
                      {item.tingkat}
                    </span>
                  </td>
                  <td class="py-5 px-6">
                    <span class={`px-18 py-1.5 rounded-lg text-xs font-black border ${getPrestasiColor(item.prestasi)}`}>
                      {item.prestasi}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        
        <div class="bg-slate-50/50 p-6 border-t border-slate-100 flex justify-between items-center">
          <p class="text-xs text-slate-400 font-medium font-mono uppercase tracking-tighter">
            Total {prestasiData.length} Records found
          </p>
          <div class="flex gap-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">
            Source: Database Akademik Informatika
          </div>
        </div>
      </div>
    </div>
  </section>
