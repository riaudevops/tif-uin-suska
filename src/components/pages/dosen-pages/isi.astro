---
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8055";
const ASSET_URL = `${API_URL}/items/dosen`;

let dosenData = [];

try {
  const response = await fetch(`${API_URL}/items/dosen`);
  
  if (!response.ok) throw new Error("Gagal mengambil data dosen");
  
  const dataDirectus = await response.json();
  dosenData = dataDirectus.data;
} catch (error) {
  console.error("Error fetching dosen:", error.message);
}
---

<section class="py-20 bg-slate-50 min-h-screen">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <div>
        <h3 class="text-3xl font-black text-slate-900 uppercase tracking-tight">Profil <span class="text-[#004d2c]">Dosen</span></h3>
        <p class="text-slate-500 mt-2 font-medium">Mengenal lebih dekat para tenaga pendidik Program Studi Teknik Informatika.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="px-4 py-2 bg-emerald-50 text-emerald-700 rounded-full text-xs font-bold border border-emerald-100 cursor-pointer hover:bg-emerald-100 transition">Semua Bidang</span>
        <span class="px-4 py-2 bg-white text-slate-600 rounded-full text-xs font-bold border border-slate-200 cursor-pointer hover:bg-slate-50 transition">Data Science</span>
        <span class="px-4 py-2 bg-white text-slate-600 rounded-full text-xs font-bold border border-slate-200 cursor-pointer hover:bg-slate-50 transition">Software Engineering</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      
      {dosenData.length === 0 ? (
        <div class="col-span-full text-center py-10">
          <p class="text-slate-500">Data dosen belum tersedia.</p>
        </div>
      ) : (
        dosenData.map((dosen) => (
          <div class="group bg-white border border-slate-200 p-6 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col sm:flex-row gap-6">
            
            <div class="relative w-full sm:w-40 flex-shrink-0 mx-auto sm:mx-0">
              <div class="absolute inset-0 bg-slate-200 translate-x-3 translate-y-3 rounded-xl group-hover:translate-x-4 group-hover:translate-y-4 transition-transform duration-300"></div>
              <img 
                src={`${import.meta.env.PUBLIC_API_URL}/assets/${dosen.foto}`}
                alt={dosen.nama} 
                class="relative z-10 w-full h-full object-cover rounded-xl aspect-[3/4] grayscale group-hover:grayscale-0 transition-all duration-500"
              />
            </div>

            <div class="flex flex-col flex-1 justify-between">
              <div>
                <h4 class="text-xl font-bold text-slate-900 group-hover:text-[#004d2c] transition-colors">
                  {dosen.nama}
                </h4>
                <p class="text-sm font-semibold text-slate-500 mb-4">
                  {dosen.jabatan || 'Dosen Pengajar'}
                </p>

                <ul class="space-y-2.5 text-sm text-slate-600 mb-6">
                  <li class="flex items-start gap-3">
                    <span class="text-slate-400">🎓</span> 
                    <span class="leading-snug" set:html={dosen.pendidikan?.replace(/\n/g, '<br/>') || '-'}></span>
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-slate-400">📍</span> 
                    <span>Fakultas Sains dan Teknologi</span>
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-slate-400">✉️</span> 
                    <a href={`mailto:${dosen.email}`} class="text-blue-600 hover:underline">{dosen.email || '-'}</a>
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-slate-400">💳</span> 
                    <span>NIP: {dosen.nip || '-'}</span>
                  </li>
                </ul>
              </div>

              <a 
                href={`/dosen/${dosen.slug}`} 
                class="block w-full text-center py-2.5 bg-slate-100 hover:bg-[#004d2c] hover:text-white text-slate-600 font-bold rounded-xl transition-colors duration-300"
              >
                Lihat Detail
              </a>
            </div>

          </div>
        ))
      )}

    </div>
  </div>
</section>