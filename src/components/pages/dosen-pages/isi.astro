---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import { fetchWithCache } from '@/lib/cachedFetch.js';
import { API_URL, ASSET_URL, getAssetUrl } from '@/lib/cms.js';
import { ArrowUpRight, BriefcaseBusiness, Building2, GraduationCap, Mail, UserRound } from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

let dosenData = [];

try {
  const dataDirectus = await fetchWithCache(`${API_URL}/items/dosen_tif?sort=id`, {}, 60000);
  dosenData = dataDirectus.data || [];
  const getJabatanRank = (jabatan?: string): number => {
    if (!jabatan) return 99;
    const j = jabatan.toLowerCase();
    if (j.includes('kepala prodi') || j.includes('kepala program')) return 1;
    if (j.includes('sekretaris prodi') || j.includes('sekretaris')) return 2;
    if (j.includes('koord. tugas akhir') || j.includes('koordinator ta')) return 3;
    if (j.includes('koord. kerja praktek') || j.includes('koordinator kp')) return 4;
    if (j.includes('kepala lab')) return 5;
    return 99;
  };
  dosenData.sort((a, b) => getJabatanRank(a.jabatan) - getJabatanRank(b.jabatan));
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching dosen:", message);
}
---

<section data-aos="fade-up" class="min-h-screen bg-[#f6f7f3] py-14 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-7 shadow-[0_28px_90px_-35px_rgba(0,61,42,0.72)] sm:p-9 lg:p-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.12),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.04),_transparent_35%)]"></div>

      <div class="relative z-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
            <UserRound class="h-3.5 w-3.5 text-secondary" />
            {isEn ? 'Academic Team' : 'Tim Akademik'}
          </span>
          <h3 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl">
            {isEn ? 'Lecturer' : 'Profil'} <span class="text-secondary">{isEn ? 'Profile' : 'Dosen'}</span>
          </h3>
        </div>

        <p class="max-w-2xl text-sm leading-relaxed text-gray-100 sm:text-base">
          {isEn ? 'Get to know the educators of the Informatics Engineering Study Program.' : 'Mengenal lebih dekat para tenaga pendidik Program Studi Teknik Informatika.'}
        </p>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2 xl:gap-8">
      {dosenData.length === 0 ? (
        <div class="col-span-full rounded-[26px] border border-dashed border-gray-300 bg-white p-10 text-center shadow-sm">
          <p class="text-base text-gray-600">{isEn ? 'Lecturer data is not yet available.' : 'Data dosen belum tersedia.'}</p>
        </div>
      ) : (
        dosenData.map((dosen: any) => (
          <article class="group overflow-hidden rounded-[26px] border border-gray-200 bg-white p-4 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.4)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_22px_55px_-28px_rgba(0,61,42,0.35)] sm:p-5">
            <div class="flex flex-col gap-5 sm:flex-row">
              <div class="relative w-full sm:w-40">
                <div class="absolute -inset-2 rounded-[22px] bg-primary/5 blur-xl"></div>
                <img
                  src={getAssetUrl(dosen.foto, '/images/default-avatar.jpg')}
                  alt={dosen.nama}
                  class="relative z-10 aspect-[3/4] w-full rounded-[22px] object-cover object-center shadow-[0_18px_35px_-25px_rgba(0,0,0,0.55)] grayscale transition-all duration-500 group-hover:grayscale-0"
                />
              </div>

              <div class="flex flex-1 flex-col justify-between">
                <div>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div>
                      <h4 class="text-xl font-black text-gray-900">{dosen.nama}</h4>
                      <p class="mt-1 text-sm font-semibold uppercase tracking-[0.12em] text-gray-500">
                        {dosen.jabatan || 'Dosen Pengajar'}
                      </p>
                    </div>
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <BriefcaseBusiness class="h-4 w-4" />
                    </span>
                  </div>

                  <ul class="space-y-2.5 text-sm text-gray-600">
                    <li class="flex items-start gap-3">
                      <GraduationCap class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      <span class="leading-relaxed">
                        {Array.isArray(dosen.pendidikan) && dosen.pendidikan.length > 0
                          ? dosen.pendidikan.map((p: string, i: number) => (
                              <>
                                {p}
                                {i < dosen.pendidikan.length - 1 && <br />}
                              </>
                            ))
                          : '-'}
                      </span>
                    </li>
                    <li class="flex items-center gap-3">
                      <Building2 class="h-4 w-4 shrink-0 text-primary" />
                      <span>{dosen.fakultas || (isEn ? 'Faculty of Science and Technology' : 'Fakultas Sains dan Teknologi')}</span>
                    </li>
                    <li class="flex items-center gap-3">
                      <Mail class="h-4 w-4 shrink-0 text-primary" />
                      <a href={`mailto:${dosen.email}`} class="text-primary transition-colors hover:text-primary/80 hover:underline">
                        {dosen.email || '-'}
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="mt-5 flex items-center justify-between gap-3 border-t border-gray-100 pt-4">
                  <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
                    NIP: {dosen.nip || '-'}
                  </span>

                  <a
                    href={localizePath(`/dosen/${dosen.slug || dosen.id}`, lang)}
                    class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-primary/90"
                  >
                    {isEn ? 'View Details' : 'Lihat Detail'}
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      )}
    </div>
  </div>
</section>
