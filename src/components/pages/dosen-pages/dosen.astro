---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Home,
  ChevronRight,
  GraduationCap,
  BookOpenText,
  Users,
  Sparkles
} from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const highlights = [
  { icon: GraduationCap, label: 'Academic Guidance' },
  { icon: BookOpenText, label: 'Teaching Excellence' },
  { icon: Users, label: 'Student Mentoring' }
];
---

<nav class="max-w-7xl mx-auto px-4 pt-32 text-sm sm:px-6 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex items-center flex-wrap gap-2 border-b border-gray-100 py-3 text-sm text-gray-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-primary">
        <Home class="h-4 w-4 text-gray-400" />
        <span>{t('bread.home')}</span>
      </a>
    </li>
    <li class="text-gray-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li>
      <a href={localizePath('/profil', lang)} class="transition-colors duration-200 hover:text-primary">
        {t('bread.profil')}
      </a>
    </li>
    <li class="text-gray-300">
      <ChevronRight class="h-4 w-4" />
    </li>
    <li class="font-semibold text-primary">
      {t('bread.dosen')}
    </li>
  </ol>
</nav>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
  <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#f3efe4] p-7 shadow-[0_28px_90px_-35px_rgba(0,61,42,0.85)] sm:p-9 lg:p-12">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(246,176,0,0.18),_transparent_25%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.14),_transparent_35%)]"></div>

    <div class="relative z-10 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
          <Sparkles class="h-3.5 w-3.5 text-secondary" />
          {t('page.dosen.badge')}
        </span>

        <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
          {t('page.dosen.title')}
        </h1>

        <p class="mt-5 max-w-xl text-base leading-relaxed text-gray-100 sm:text-lg">
          {t('page.dosen.desc')}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {highlights.map(({ icon: Icon, label }) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-medium text-white/90">
              <Icon class="h-3.5 w-3.5 text-secondary" />
              {label}
            </span>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-3 rounded-[28px] bg-secondary/20 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-white/10 p-3 shadow-[0_18px_45px_-26px_rgba(0,0,0,0.55)] backdrop-blur-sm">
          <img
            src="/dosen-pages/dosen2.jpg"
            alt="Dosen Teknik Informatika"
            class="h-[420px] w-full rounded-[22px] object-cover object-center shadow-[0_20px_40px_-25px_rgba(0,0,0,0.65)] sm:h-[490px]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
