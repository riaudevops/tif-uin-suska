---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
            <a href={localizePath("/", lang)} class="flex items-center hover:text-green-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <a href={localizePath("/profil", lang)} class="hover:text-green-600 transition-colors">
                {t("bread.profil")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
            {t("bread.dosen")}
        </li>
    </ol>
</nav>

<section data-aos="fade-up" class="bg-gradient-to-b from-gray-50 to-white py-6 overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      
      <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">
        {t("page.dosen.badge")}
      </span>

      <h1 data-aos="fade-up" class="text-4xl md:text-5xl font-black text-green-900 mb-8 leading-tight">
        {t("page.dosen.title")}
      </h1>
      
      <p class="text-lg text-gray-600 mb-12 leading-relaxed">
        {t("page.dosen.desc")}
      </p>

      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-emerald-500 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
        
        <img 
          src="/dosen-pages/dosen.jpg" 
          alt="Dosen Teknik Informatika" 
          class="relative mx-auto rounded-2xl shadow-2xl max-h-[500px] w-full object-cover transform transition-all duration-500 group-hover:scale-[1.01]"
        />
      </div>

    </div>
  </div>
</section>