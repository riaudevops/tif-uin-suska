---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const API_URL = import.meta.env.BASE_API_URL || 'http://localhost:8055';
let aiorcInfo: any = null;

// Try to fetch AIORC info from Directus
try {
  const res = await fetch(`${API_URL}/items/aiorc_info?limit=1`, { cache: 'no-store' });
  if (res.ok) {
    const json = await res.json();
    if (json.data && json.data.length > 0) {
      aiorcInfo = json.data[0];
    }
  }
} catch (e) {
  // Fallback to default data
}

const description = aiorcInfo?.description_en && isEn
  ? aiorcInfo.description_en
  : aiorcInfo?.description
  ?? (isEn
    ? "Artificial Intelligence and Optimization Research Center (AIORC) has been planned since Informatics Engineering was established in 1999. In recent years, many questions have arisen regarding the contribution of Indonesian researchers at the international level. AIORC was founded based on the ideas and spirit of lecturers in the Informatics Engineering department to produce high-quality research that is useful and recognized both nationally and internationally."
    : "Artificial Intelligence and Optimization Research Center (AIORC) telah direncanakan sejak Teknik Informatika didirikan pada tahun 1999. Dalam beberapa tahun terakhir, banyak pertanyaan mengenai kontribusi peneliti Indonesia di tingkat internasional. AIORC lahir berdasarkan ide dan semangat para dosen di departemen Teknik Informatika untuk menghasilkan penelitian yang berkualitas, bermanfaat, dan diakui secara nasional maupun internasional.");
---

<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
            <a href={localizePath("/", lang)} class="flex items-center hover:text-green-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li>
            <span class="text-slate-500">{t("bread.penelitian")}</span>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
            AIORC
        </li>
    </ol>
</nav>

<section data-aos="fade-up" class="relative py-12 overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-50 rounded-full blur-[100px] -z-10 opacity-70"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-amber-50 rounded-full blur-[120px] -z-10 opacity-60"></div>

    <div class="container mx-auto px-6 max-w-7xl">

        <!-- Banner Image -->
        <div class="relative mb-20 animate-fade-in">
            <div class="absolute -top-4 -left-4 w-32 h-32 border-t-4 border-l-4 border-amber-400 rounded-tl-3xl z-0 hidden md:block"></div>
            <div class="absolute -bottom-4 -right-4 w-32 h-32 border-b-4 border-r-4 border-emerald-700 rounded-br-3xl z-0 hidden md:block"></div>

            <div class="relative overflow-hidden rounded-[2rem] shadow-2xl group">
                <img
                    src="/landing-pages/gedung-faste.jpg"
                    alt="AIORC Banner"
                    class="w-full h-[300px] md:h-[500px] object-cover transition-transform duration-1000 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/90 via-emerald-950/30 to-transparent"></div>

                <!-- AI Icon Badge -->
                <div class="absolute top-8 right-8 hidden md:flex">
                    <div class="w-20 h-20 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 flex items-center justify-center">
                        <svg class="w-10 h-10 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                </div>

                <!-- Bottom Info -->
                <div class="absolute bottom-8 left-8 right-8">
                    <span class="inline-flex items-center gap-2 px-5 py-2 bg-amber-400 text-emerald-950 text-[10px] font-black uppercase tracking-[0.3em] rounded-full shadow-xl mb-4">
                        {isEn ? "Research Center" : "Pusat Riset"}
                    </span>
                    <h2 class="text-2xl md:text-4xl font-black text-white leading-tight">
                        {isEn ? "Artificial Intelligence & Optimization" : "Kecerdasan Buatan & Optimasi"}
                    </h2>
                </div>
            </div>
        </div>

        <!-- Title & Description -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:items-start">
            <div class="lg:col-span-5 animate-fade-up delay-1">
                <div class="flex items-center gap-4 mb-4">
                    <div class="h-1 w-12 bg-emerald-600 rounded-full"></div>
                    <span class="text-xs font-bold tracking-[0.4em] text-emerald-700 uppercase">Research Hub</span>
                </div>
                <h1 data-aos="fade-up" class="text-4xl md:text-6xl lg:text-7xl font-black text-slate-900 leading-[0.9] tracking-tighter uppercase mb-6">
                    AIORC
                </h1>
                <p class="text-sm text-slate-400 font-medium tracking-wide mb-4">
                    Artificial Intelligence and <br/>Optimization Research Center
                </p>
                <div class="flex gap-2">
                    <div class="w-16 h-2 bg-amber-400 rounded-full"></div>
                    <div class="w-4 h-2 bg-emerald-100 rounded-full"></div>
                </div>
            </div>

            <div class="lg:col-span-7 animate-fade-up delay-2">
                <p class="text-xl md:text-2xl text-slate-700 leading-relaxed font-light mb-8 italic">
                    {isEn ? '"Advancing ' : '"Memajukan '}<span class="text-emerald-800 font-bold">{isEn ? "artificial intelligence" : "kecerdasan buatan"}</span>{isEn ? " research to solve " : " untuk menyelesaikan "}<span class="text-emerald-800 font-bold">{isEn ? "real-world optimization" : "optimasi dunia nyata"}</span>{isEn ? ' problems at national and international levels."' : ' di tingkat nasional maupun internasional."'}
                </p>
                <p class="text-lg text-slate-600 leading-relaxed text-justify">
                    {description}
                </p>
            </div>
        </div>

    </div>
</section>
