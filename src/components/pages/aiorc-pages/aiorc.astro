---
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import { API_URL } from '@/lib/cms.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

let aiorcInfo = null;

try {
  const res = await fetch(`${API_URL}/items/aiorc_info?limit=1`, { cache: 'no-store' });
  if (res.ok) {
    const json = await res.json();
    if (json.data && json.data.length > 0) {
      aiorcInfo = json.data[0];
    }
  }
} catch (e) {
  // Fallback to default data
}

const description = aiorcInfo?.description_en && isEn
  ? aiorcInfo.description_en
  : aiorcInfo?.description
  ?? (isEn
    ? "Artificial Intelligence and Optimization Research Center (AIORC) has been planned since Informatics Engineering was established in 1999. In recent years, many questions have arisen regarding the contribution of Indonesian researchers at the international level. AIORC was founded based on the ideas and spirit of lecturers in the Informatics Engineering department to produce high-quality research that is useful and recognized both nationally and internationally."
    : "Artificial Intelligence and Optimization Research Center (AIORC) telah direncanakan sejak Teknik Informatika didirikan pada tahun 1999. Dalam beberapa tahun terakhir, banyak pertanyaan mengenai kontribusi peneliti Indonesia di tingkat internasional. AIORC lahir berdasarkan ide dan semangat para dosen di departemen Teknik Informatika untuk menghasilkan penelitian yang berkualitas, bermanfaat, dan diakui secara nasional maupun internasional.");
---

<nav class="mx-auto mt-32 max-w-7xl px-8 text-sm">
  <ol class="flex flex-wrap items-center gap-2 border-b border-gray-100 py-3 text-sm text-gray-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center transition-colors hover:text-[#0b5c3d]">
        <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t("bread.home")}
      </a>
    </li>
    <li class="text-gray-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>
    <li>
      <span class="text-slate-500">{t("bread.penelitian")}</span>
    </li>
    <li class="text-gray-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>
    <li class="font-bold tracking-tight text-[#0b5c3d]">AIORC</li>
  </ol>
</nav>

<section data-aos="fade-up" class="relative overflow-hidden py-12">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#f5d76a]/10 blur-3xl"></div>
      <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
            {isEn ? 'Research Center' : 'Pusat Riset'}
          </span>
          <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
            AIORC
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90 sm:text-lg">
            {isEn ? 'Artificial Intelligence & Optimization' : 'Kecerdasan Buatan & Optimasi'}
          </p>
        </div>

        <div class="rounded-[24px] border border-white/10 bg-[#dcecd1]/10 p-5 backdrop-blur-sm">
          <p class="text-base leading-relaxed text-gray-100 sm:text-lg">
            {isEn ? 'Advancing artificial intelligence research to address optimization challenges in academic and applied settings.' : 'Memajukan riset kecerdasan buatan untuk menjawab tantangan optimasi dalam konteks akademik dan penerapan nyata.'}
          </p>
        </div>
      </div>

      <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Focus</p>
          <p class="mt-2 text-2xl font-black text-white">AI</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Method</p>
          <p class="mt-2 text-2xl font-black text-white">Optimasi</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Scope</p>
          <p class="mt-2 text-2xl font-black text-white">Nasional</p>
        </div>
        <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">Direction</p>
          <p class="mt-2 text-2xl font-black text-white">Global</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-16 md:px-8">
  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
    <div class="rounded-[28px] border border-slate-200 bg-white p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] sm:p-8">
      <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {isEn ? 'Overview' : 'Profil'}
      </span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">AIORC</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        {description}
      </p>
    </div>

    <div class="rounded-[28px] border border-slate-200 bg-[#f8faf3] p-7 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] sm:p-8">
      <span class="mb-3 inline-flex rounded-full bg-[#f4f0dd] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#5a4c18]">
        {isEn ? 'Research Themes' : 'Bidang Fokus'}
      </span>
      <div class="mt-5 flex flex-wrap gap-2">
        {['Machine Learning', 'Data Mining', 'NLP', 'Computer Vision', 'Optimization', 'AI Applications'].map((item) => (
          <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm">{item}</span>
        ))}
      </div>
    </div>
  </div>
</section>
