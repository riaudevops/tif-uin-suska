---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const API_URL = import.meta.env.BASE_API_URL || 'http://localhost:8055';
const COLLECTION = 'aiorc_fields';

let researcherData: any[] = [];
let errorMessage: string | null = null;

function pick(obj: any, keys: string[]) {
  for (const k of keys) {
    if (obj[k] !== undefined && obj[k] !== null && obj[k] !== '') return obj[k];
  }
  return undefined;
}

try {
  const endpoint = `${API_URL}/items/${COLLECTION}?sort=id&limit=-1`;
  const res = await fetch(endpoint, { cache: 'no-store' });

  if (!res.ok) {
    const body = await res.text();
    console.error(`[AIORC Researchers] Fetch gagal - status ${res.status} ${res.statusText}`);
    console.error(`[AIORC Researchers] Endpoint: ${endpoint}`);
    console.error(`[AIORC Researchers] Response body: ${body}`);
    errorMessage = isEn
      ? "Failed to load researcher data. Please try again later."
      : "Gagal memuat data peneliti. Silakan coba lagi nanti.";
  } else {
    const json = await res.json();

    if (!json.data || json.data.length === 0) {
      console.warn(`[AIORC Researchers] Collection "${COLLECTION}" kosong.`);
      errorMessage = isEn
        ? "No researcher data is available yet."
        : "Belum ada data peneliti yang tersedia.";
    } else {
      researcherData = json.data.map((item: any) => ({
        name: pick(item, ['name', 'nama', 'nama_peneliti', 'full_name']),
        research: isEn
          ? pick(item, ['research_interest_en', 'research_en', 'research_interest', 'research', 'bidang_riset'])
          : pick(item, ['research_interest', 'research', 'bidang_riset', 'keahlian']),
        photo: pick(item, ['photo', 'foto', 'image', 'avatar']),
      }));
    }
  }
} catch (e) {
  const message = e instanceof Error ? e.message : String(e);
  console.error(`[AIORC Researchers] Fetch error: ${message}`);
  console.error(`[AIORC Researchers] API_URL yang dipakai: ${API_URL}`);
  errorMessage = isEn
    ? "Could not connect to the data server."
    : "Tidak dapat terhubung ke server data.";
}
---

<section data-aos="fade-up" class="relative overflow-hidden py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-8">
      <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
        {isEn ? "Research Team" : "Tim Peneliti"}
      </span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 sm:text-5xl">
        {isEn ? "Researcher" : "Peneliti"}
      </h2>
      <p class="mt-3 max-w-2xl text-base text-slate-600">
        {isEn
          ? "Meet the researchers and their areas of expertise in Artificial Intelligence and Optimization."
          : "Kenali para peneliti dan bidang keahlian mereka dalam Kecerdasan Buatan dan Optimasi."}
      </p>
    </div>

    {errorMessage ? (
      <div class="rounded-[28px] border border-slate-200 bg-white p-16 text-center shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)]">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#f4f0dd] text-[#5a4c18]">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <p class="text-slate-600 font-medium">{errorMessage}</p>
      </div>
    ) : (
      <div class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)]">
        <div class="overflow-x-auto">
          <table class="w-full border-separate border-spacing-0 text-left">
            <thead>
              <tr class="bg-[#003d2a] text-white">
                <th class="w-16 border-b border-white/10 px-5 py-4 text-center text-[10px] font-bold uppercase tracking-[0.2em]">No</th>
                <th class="border-b border-white/10 px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{isEn ? "Researcher" : "Peneliti"}</th>
                <th class="border-b border-white/10 px-5 py-4 text-[10px] font-bold uppercase tracking-[0.2em]">{isEn ? "Research Interest" : "Bidang Riset"}</th>
              </tr>
            </thead>

            <tbody>
              {researcherData.map((item: any, index: number) => {
                const researchItems = item.research ? item.research.split(/[,;]/).map((r: string) => r.trim()).filter(Boolean) : [];
                return (
                  <tr class="transition-colors duration-200 hover:bg-[#f7faf4]">
                    <td class="border-b border-slate-100 px-5 py-5 text-center text-xs font-mono text-slate-400">{index + 1}</td>
                    <td class="border-b border-slate-100 px-5 py-5">
                      <div class="flex items-center gap-4">
                        {item.photo ? (
                          <img
                            src={`${API_URL}/assets/${item.photo}`}
                            alt={item.name}
                            class="h-10 w-10 shrink-0 rounded-xl border border-[#dfeee1] object-cover"
                          />
                        ) : (
                          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-[#dfeee1] bg-[#edf4e8] text-xs font-black uppercase text-[#0b5c3d]">
                            {item.name?.charAt(0) || "?"}
                          </div>
                        )}
                        <p class="text-sm font-bold text-slate-800">{item.name}</p>
                      </div>
                    </td>
                    <td class="border-b border-slate-100 px-5 py-5">
                      <div class="flex flex-wrap gap-2">
                        {researchItems.length > 0 ? (
                          researchItems.map((r: string) => (
                            <span class="rounded-full border border-slate-200 bg-[#f8fafc] px-3 py-1 text-[11px] font-medium text-slate-600">{r}</span>
                          ))
                        ) : (
                          <span class="rounded-full border border-slate-200 bg-[#f8fafc] px-3 py-1 text-[11px] font-medium text-slate-600">{item.research || "—"}</span>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="flex items-center justify-between border-t border-slate-100 bg-[#f8faf3] px-5 py-4">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">
            Total <span class="text-[#0b5c3d]">{researcherData.length}</span> {isEn ? "Researchers" : "Peneliti"}
          </p>
          <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z"/></svg>
            AIORC Research DB
          </div>
        </div>
      </div>
    )}
  </div>
</section>