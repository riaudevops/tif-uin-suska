---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
import { API_URL } from "../../../lib/cms";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

let agendaKegiatan = [];
let categories: string[] = [];

try {
  const fetchUrl = `${API_URL}/items/agenda?fields=id,title,status,lokasi,deskripsi,link_pendaftaran,kategori.*,tanggal_pelaksanaan`;
  const response = await fetch(fetchUrl);
  
  if (!response.ok) {
    const errorDetails = await response.json(); 
    console.error("ALASAN ERROR DIRECTUS:", JSON.stringify(errorDetails, null, 2));
    throw new Error(`Gagal (Status: ${response.status})`);
  }
  
  const dataDirectus = await response.json();

  agendaKegiatan = dataDirectus.data.map((item: any) => {
    const dateObj = item.tanggal_pelaksanaan ? new Date(item.tanggal_pelaksanaan) : new Date();
    const jam = dateObj.getHours().toString().padStart(2, '0');
    const menit = dateObj.getMinutes().toString().padStart(2, '0');
    const waktuFormat = `${jam}:${menit} WIB`;

    return {
      id: item.id,
      judul: item.title || 'Tanpa Judul',
      tanggal: dateObj.getDate().toString().padStart(2, '0'),
      bulan: dateObj.toLocaleString(lang === 'en' ? 'en-US' : 'id-ID', { month: 'short' }),
      tahun: dateObj.getFullYear().toString(),
      waktu: waktuFormat, 
      lokasi: item.lokasi || '-',
      kategori: item.kategori?.nama_kategori || item.kategori?.nama || 'Umum', 
      deskripsi: item.deskripsi || '-',
      status: item.status,
      linkPendaftaran: item.link_pendaftaran 
    };
  });
  // Extract unique categories for filter buttons
  categories = ['All', ...new Set(agendaKegiatan.map((item: any) => item.kategori))];
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error dari Astro:", message);
}

const getKategoriClass = (kat: string) => {
  if (!kat) return 'bg-slate-100 text-slate-700 border-slate-200';
  const hash = kat.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const colors = [
    'bg-red-100 text-red-700 border-red-200',
    'bg-blue-100 text-blue-700 border-blue-200',
    'bg-purple-100 text-purple-700 border-purple-200',
    'bg-amber-100 text-amber-700 border-amber-200',
    'bg-indigo-100 text-indigo-700 border-indigo-200',
    'bg-pink-100 text-pink-700 border-pink-200',
    'bg-teal-100 text-teal-700 border-teal-200',
    'bg-green-100 text-green-700 border-green-200',
  ];
  return colors[hash % colors.length];
};
---

<nav class="mx-auto mt-32 max-w-7xl px-4 text-sm sm:px-6 lg:px-8">
  <ol class="flex items-center gap-2 text-slate-500">
    <li class="flex items-center">
      <a href={localizePath("/", lang)} class="flex items-center gap-1 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        {t("bread.home")}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">
      {t("bread.agenda")}
    </li>
  </ol>
</nav>

<section class="py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 overflow-hidden rounded-[30px] border border-[#dfeadf] bg-gradient-to-br from-[#f4faf4] via-white to-[#f7f0df] p-6 shadow-[0_26px_80px_-32px_rgba(0,61,42,0.5)] sm:p-8 lg:p-10">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <span class="inline-flex items-center rounded-full border border-[#dfeadf] bg-[#edf7ee] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-[#0b5c3d]">
            {t("page.agenda.badge")}
          </span>
          <h1 class="mt-5 text-3xl font-black tracking-tight text-[#003d2a] sm:text-4xl lg:text-5xl">
            {t("page.agenda.title")}
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
            {t("page.agenda.desc")}
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
          <div class="rounded-[24px] border border-slate-200 bg-white p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Agenda</p>
            <p class="mt-3 text-2xl font-black text-[#003d2a]">{agendaKegiatan.length}</p>
          </div>
          <div class="rounded-[24px] border border-slate-200 bg-white p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Kategori</p>
            <p class="mt-3 text-2xl font-black text-[#003d2a]">{categories.length - 1}</p>
          </div>
          <div class="rounded-[24px] border border-slate-200 bg-[#fffaf0] p-4 shadow-[0_16px_35px_-28px_rgba(15,23,42,0.25)]">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8a6a1d]">Aktivitas</p>
            <p class="mt-3 text-2xl font-black text-[#8a6a1d]">{t("page.agenda.calendar")}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8 rounded-[28px] border border-slate-200 bg-white p-4 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-5">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#edf5ee] text-[#0b5c3d]">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-[#003d2a]">{t("page.agenda.calendar")}</h3>
            <p class="text-sm text-slate-500">{t("page.agenda.calendar.desc")}</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {categories.map((kat: string, idx: number) => (
            <button
              class={`filter-btn rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] transition-all ${idx === 0 ? 'border-[#003d2a] bg-[#003d2a] text-white' : 'border-slate-200 bg-white text-slate-600 hover:border-[#bfd8c6] hover:text-[#0b5c3d]'}`}
              data-filter={kat === 'All' ? 'All' : kat}
            >
              {kat === 'All' ? t("page.agenda.filter.all") : kat}
            </button>
          ))}
        </div>
      </div>
    </div>

    {agendaKegiatan.length === 0 ? (
      <div class="rounded-[28px] border border-slate-200 bg-slate-50 py-20 text-center">
        <p class="text-slate-500 font-medium">{t("page.agenda.empty")}</p>
      </div>
    ) : (
      <div class="grid gap-6 lg:grid-cols-2">
        {agendaKegiatan.map((item: any, index: number) => (
          <div
            class="agenda-card group cursor-pointer overflow-hidden rounded-[30px] border border-slate-200 bg-white p-1 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:border-[#bfd8c6] hover:shadow-[0_28px_65px_-32px_rgba(11,92,61,0.3)]"
            data-index={index}
            data-kategori={item.kategori}
          >
            <div class="flex flex-col md:flex-row">
              <div class="flex min-h-[150px] w-full items-center justify-center bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#8a6a1d] p-6 text-white md:w-36 md:min-w-[144px]">
                <div class="text-center">
                  <div class="text-3xl font-black leading-none">{item.tanggal}</div>
                  <div class="mt-2 text-sm font-bold uppercase tracking-[0.2em]">{item.bulan}</div>
                  <div class="mt-1 text-[10px] uppercase tracking-[0.18em] text-emerald-100">{item.tahun}</div>
                </div>
              </div>

              <div class="flex-1 p-6 sm:p-7">
                <div class="mb-4 flex items-center justify-between gap-3">
                  <span class={`inline-flex rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] ${getKategoriClass(item.kategori)}`}>
                    {item.kategori}
                  </span>
                  {item.status === 'Penting' && (
                    <span class="inline-flex h-2.5 w-2.5 rounded-full bg-red-500 shadow-[0_0_0_6px_rgba(239,68,68,0.12)]" title="Penting"></span>
                  )}
                </div>

                <h3 class="text-xl font-black leading-snug text-slate-900 group-hover:text-[#004d2c]">
                  {item.judul}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-2">
                  {item.deskripsi}
                </p>

                <div class="mt-5 flex flex-wrap gap-4 border-t border-slate-100 pt-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                  <span class="inline-flex items-center gap-2">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {item.waktu}
                  </span>
                  <span class="inline-flex items-center gap-2">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    {item.lokasi}
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="mt-16 overflow-hidden rounded-[30px] bg-gradient-to-r from-[#003d2a] via-[#0b5c3d] to-[#0d6f4a] p-8 text-center text-white shadow-[0_28px_80px_-28px_rgba(0,61,42,0.75)] sm:p-10">
      <h2 class="text-2xl font-black tracking-tight sm:text-3xl">{t("page.agenda.collab.title")}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-emerald-100">{t("page.agenda.collab.desc")}</p>
      <a href="mailto:tif@uin-suska.ac.id" class="mt-6 inline-flex items-center justify-center rounded-full bg-[#f5d77a] px-7 py-3 text-xs font-black uppercase tracking-[0.18em] text-[#003d2a] transition-transform hover:scale-[1.02]">
        {t("common.contact")}
      </a>
    </div>
  </div>
</section>

<div id="agenda-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity" role="dialog" aria-modal="true" aria-labelledby="modal-judul">
  
  <div class="close-modal absolute inset-0 cursor-pointer" aria-label="Tutup modal"></div>

  <div class="relative bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden">
    
    <div class="bg-[#004d2c] px-6 py-4 flex justify-between items-center text-white">
      <h3 class="font-bold text-lg">{t("page.agenda.modal.title")}</h3>
      <button class="close-modal text-white/70 hover:text-white transition-colors bg-white/10 hover:bg-white/20 rounded-full p-2" aria-label="Tutup">
        ✕
      </button>
    </div>

    <div class="p-8">
      <div class="mb-2">
        <span id="modal-kategori" class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border"></span>
      </div>
      
      <h2 id="modal-judul" class="text-2xl font-black text-slate-800 mb-2"></h2>
      <p id="modal-deskripsi" class="text-slate-600 mb-6 leading-relaxed"></p>

      <div class="bg-slate-50 p-4 rounded-2xl space-y-3 mb-8 border border-slate-100">
        <div class="flex items-center gap-3 text-sm text-slate-600 font-medium">
          📅 <span id="modal-tanggal"></span>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-600 font-medium">
          ⏱ <span id="modal-waktu"></span>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-600 font-medium">
          📍 <span id="modal-lokasi"></span>
        </div>
      </div>

      <div id="modal-action-area"></div>
    </div>
  </div>
</div>

<script define:vars={{ agendaData: agendaKegiatan, modalI18n: { register: t("common.register"), noReg: t("page.agenda.modal.noreg") } }}>
  const cards = document.querySelectorAll('.agenda-card');
  const modal = document.getElementById('agenda-modal');
  const closeModalElements = document.querySelectorAll('.close-modal');

  const mKategori = document.getElementById('modal-kategori');
  const mJudul = document.getElementById('modal-judul');
  const mDeskripsi = document.getElementById('modal-deskripsi');
  const mTanggal = document.getElementById('modal-tanggal');
  const mWaktu = document.getElementById('modal-waktu');
  const mLokasi = document.getElementById('modal-lokasi');
  const mActionArea = document.getElementById('modal-action-area');

  const getClientKategoriClass = (kat) => {
    if (!kat) return 'bg-slate-100 text-slate-700 border-slate-200';
    const hash = kat.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
    const colors = [
      'bg-red-100 text-red-700 border-red-200',
      'bg-blue-100 text-blue-700 border-blue-200',
      'bg-purple-100 text-purple-700 border-purple-200',
      'bg-amber-100 text-amber-700 border-amber-200',
      'bg-indigo-100 text-indigo-700 border-indigo-200',
      'bg-pink-100 text-pink-700 border-pink-200',
      'bg-teal-100 text-teal-700 border-teal-200',
      'bg-green-100 text-green-700 border-green-200',
    ];
    return colors[hash % colors.length];
  };

  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Reset all buttons to inactive state
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#004d2c]', 'text-white', 'border-[#004d2c]');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      });
      
      // Set active state for clicked button
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.classList.add('bg-[#004d2c]', 'text-white', 'border-[#004d2c]');

      const filterValue = btn.getAttribute('data-filter');
      
      cards.forEach(card => {
        const kat = card.getAttribute('data-kategori');
        if (filterValue === 'All' || kat === filterValue) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  const openModal = (index) => {
    const data = agendaData[index];
    if (!data) return;

    mKategori.className = `px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border ${getClientKategoriClass(data.kategori)}`;
    mKategori.textContent = data.kategori;
    
    mJudul.textContent = data.judul;
    mDeskripsi.textContent = data.deskripsi;
    mTanggal.textContent = `${data.tanggal} ${data.bulan} ${data.tahun}`;
    mWaktu.textContent = data.waktu;
    mLokasi.textContent = data.lokasi;

    if (data.linkPendaftaran) {
      mActionArea.innerHTML = `
        <a href="${data.linkPendaftaran}" target="_blank" rel="noopener noreferrer" 
           class="w-full block text-center py-3 px-4 bg-[#004d2c] hover:bg-[#00361f] text-white font-bold rounded-xl transition-colors shadow-lg shadow-green-900/20 focus:ring-4 focus:ring-green-300">
          ${modalI18n.register}
        </a>
      `;
    } else {
      mActionArea.innerHTML = `
        <div class="text-center p-3 bg-slate-50 text-slate-400 rounded-xl text-sm border border-slate-100 border-dashed">
          ${modalI18n.noReg}
        </div>
      `;
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden'; 
  };

  const closeModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = ''; 
  };

  cards.forEach(card => {
    card.addEventListener('click', () => {
      openModal(card.getAttribute('data-index'));
    });
  });

  closeModalElements.forEach(el => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Auto-open modal if 'id' parameter is present in URL
  const urlParams = new URLSearchParams(window.location.search);
  const targetId = urlParams.get('id');
  if (targetId) {
    const targetIdx = agendaData.findIndex(item => String(item.id) === String(targetId));
    if (targetIdx !== -1) {
      openModal(targetIdx);
    }
  }
</script>