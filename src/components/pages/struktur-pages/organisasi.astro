---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t('nav.home')}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li>
      <a href={localizePath('/profil/sejarah', lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
        {t('nav.profil')}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">
      {translateInline((isEn) ? "en" : "id", "inline.organizational-structure")}
    </li>
  </ol>
</nav>

<section class="relative overflow-hidden bg-[#f6faf3] px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 overflow-hidden rounded-[30px] border border-[#dfeadf] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#d9b65d] p-6 shadow-[0_28px_80px_-32px_rgba(0,61,42,0.8)] sm:p-8 lg:p-10">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-white/90">
            {translateInline((isEn) ? "en" : "id", "inline.governance")}
          </span>
          <h1 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
            {translateInline((isEn) ? "en" : "id", "inline.organizational")} <span class="text-[#f4d77d]">{translateInline((isEn) ? "en" : "id", "inline.structure-organisasi")}</span>
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
            {translateInline((isEn) ? "en" : "id", "inline.leadership-academic-staff-and-supporting-units-w")}
          </p>
        </div>
      </div>
    </div>

    <div class="mb-8 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-8">
      <div class="mb-6 flex items-center justify-between gap-3">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">{translateInline((isEn) ? "en" : "id", "inline.structure-struktur")}</p>
          <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
            {translateInline((isEn) ? "en" : "id", "inline.leadership-and-operational-support")}
          </h2>
        </div>
        <div class="hidden h-12 w-12 items-center justify-center rounded-full bg-[#edf5ee] text-[#0b5c3d] sm:flex">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="flex flex-col justify-between rounded-[28px] border border-[#dfeadf] bg-gradient-to-br from-[#edf7ee] to-white p-6 shadow-[0_18px_45px_-30px_rgba(11,92,61,0.5)] lg:col-span-3">
          <div class="mb-4 flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#0b5c3d] text-white">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </span>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">{translateInline((isEn) ? "en" : "id", "inline.leadership")}</p>
              <h3 class="mt-1 text-xl font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.head-of-study-program")}</h3>
            </div>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.responsible-for-academic-leadership-strategic-pl")}
          </p>
        </div>

        <div class="rounded-[26px] border border-slate-200 bg-slate-50 p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-[#dfeadf] hover:shadow-[0_18px_40px_-30px_rgba(11,92,61,0.5)]">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#edf5ee] text-[#0b5c3d]">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0H3m2 0h2m10 0h2M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1" />
            </svg>
          </div>
          <h3 class="text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.academic-affairs")}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.supports-curriculum-implementation-teaching-proc")}
          </p>
        </div>

        <div class="rounded-[26px] border border-slate-200 bg-slate-50 p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-[#dfeadf] hover:shadow-[0_18px_40px_-30px_rgba(11,92,61,0.5)]">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#fff4d6] text-[#8a6a1d]">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.administration")}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.coordinates-students-services-documentation-and")}
          </p>
        </div>

        <div class="rounded-[26px] border border-slate-200 bg-slate-50 p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-[#dfeadf] hover:shadow-[0_18px_40px_-30px_rgba(11,92,61,0.5)]">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#ebf2ff] text-[#314d8d]">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.628.288a2 2 0 01-1.18.208l-2.35-.448a2 2 0 01-1.18-.208l-.628-.288a6 6 0 00-3.86-.517l-2.387.477a2 2 0 00-1.022.547V18.318a5 5 0 001.13 2.541l2.35 2.35a2 2 0 002.828 0l2.35-2.35a5 5 0 001.13-2.541V15.428z" />
            </svg>
          </div>
          <h3 class="text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.laboratory-and-research")}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.supports-research-development-facility-managemen")}
          </p>
        </div>
      </div>
    </div>

    <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-35px_rgba(15,23,42,0.25)] sm:p-8">
      <div class="mb-5">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">{translateInline((isEn) ? "en" : "id", "inline.overview-ikhtisar")}</p>
        <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
          {translateInline((isEn) ? "en" : "id", "inline.organizational-function")}
        </h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">{isEn ? '1' : '1'}</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.academic-governance")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.ensuring-teaching-quality-curriculum-alignment-a")}
          </p>
        </div>

        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">{isEn ? '2' : '2'}</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.research-support")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.developing-learning-activities-and-research-capa")}
          </p>
        </div>

        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">{isEn ? '3' : '3'}</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">{translateInline((isEn) ? "en" : "id", "inline.administrative-service")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.providing-orderly-service-to-students-lecturers")}
          </p>
        </div>
      </div>
    </div>
    <div>
      <img src="/struktur-pages/Company.jpg" alt="Struktur Organisasi" class="mt-8 w-full rounded-lg border border-slate-200 shadow-sm" />
    </div>
  </div>
</section>