---
import { translateInline } from "../../../lib/translations.js";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import { fetchWithCache } from '@/lib/cachedFetch.js';
import { API_BASE_URL, getImageUrl } from '@/lib/cms.js';
import { DOSEN_FIELDS, normalizeDosen } from '@/lib/dosen.js';
import { buildOrganizationStructure } from '@/lib/organisasi.js';
import { ArrowUpRight, Building2, GraduationCap, Users } from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

let dosenData: any[] = [];

try {
  const result = await fetchWithCache(
    `${API_BASE_URL}/dosen_tif?fields=${DOSEN_FIELDS}&sort=id`,
    {},
    60000,
  );

  dosenData = (Array.isArray(result.data) ? result.data : [])
    .map((item: any) => normalizeDosen(item, lang))
    .filter(Boolean);
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error("Error fetching dosen for organization page:", message);
}

const structureGroups = buildOrganizationStructure(dosenData, lang);
const totalOfficials = structureGroups.reduce(
  (total, group) => total + group.members.length,
  0,
);

const cardGridClass = (group: any) =>
  group.featured
    ? "grid gap-5 md:grid-cols-2"
    : group.id === "coordinators"
      ? "grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
      : "grid gap-5 sm:grid-cols-2";
---

<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t('nav.home')}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li>
      <a href={localizePath('/profile/history', lang)} class="transition-colors duration-200 hover:text-[#0b5c3d]">
        {t('nav.profil')}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">
      {translateInline((isEn) ? "en" : "id", "inline.organizational-structure")}
    </li>
  </ol>
</nav>

<section class="relative overflow-hidden bg-[#f6faf3] px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <div class="mx-auto max-w-7xl">

    {/* ── Hero ── */}
    <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#7ca25c] p-7 shadow-[0_30px_90px_-38px_rgba(0,61,42,0.8)] sm:p-9 lg:p-12">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.16),_transparent_32%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.08),_transparent_38%)]"></div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-white/90 backdrop-blur-sm">
            <Users class="h-3.5 w-3.5 text-[#f4d77d]" />
            {translateInline((isEn) ? "en" : "id", "inline.governance")}
          </span>

          <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
            {translateInline((isEn) ? "en" : "id", "inline.organizational")} <span class="text-[#f4d77d]">{translateInline((isEn) ? "en" : "id", "inline.structure-organisasi")}</span>
          </h1>

          <p class="mt-4 max-w-xl text-sm leading-relaxed text-emerald-50/90 sm:text-base">
            {translateInline((isEn) ? "en" : "id", "inline.leadership-academic-staff-and-supporting-units-w")}
          </p>
        </div>

        <div class="rounded-[26px] border border-white/15 bg-white/10 p-5 backdrop-blur-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/70">
            {translateInline((isEn) ? "en" : "id", "inline.structural-officials")}
          </p>
          <p class="mt-2 flex items-end gap-2 text-white">
            <span class="text-4xl font-black leading-none">{totalOfficials}</span>
            <span class="pb-1 text-sm font-semibold text-white/80">
              {isEn ? "people" : "orang"}
            </span>
          </p>

          <ul class="mt-4 space-y-2 border-t border-white/15 pt-4 text-sm text-white/85">
            {structureGroups.map((group) => (
              <li class="flex items-center justify-between gap-3">
                <span>{translateInline((isEn) ? "en" : "id", group.labelKey)}</span>
                <span class="rounded-full bg-white/15 px-2 py-0.5 text-xs font-bold">{group.members.length}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    {/* ── Struktur Inti ── */}
    <div class="mt-10 rounded-[30px] border border-[#dfeadf] bg-white p-6 shadow-[0_24px_70px_-45px_rgba(15,23,42,0.35)] sm:p-8 lg:p-10">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">
            {translateInline((isEn) ? "en" : "id", "inline.structure-struktur")}
          </p>
          <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
            {translateInline((isEn) ? "en" : "id", "inline.leadership-and-operational-support")}
          </h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-600">
          {translateInline((isEn) ? "en" : "id", "inline.organizational-structure-summary")}
        </p>
      </div>

      {structureGroups.map((group, groupIndex) => (
        <div class={groupIndex === 0 ? "" : "mt-10 border-t border-slate-100 pt-10"}>
          <div class="mb-5 flex items-center gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-[#edf5ee] text-[#0b5c3d]">
              {group.id === "leadership" ? (
                <GraduationCap class="h-4.5 w-4.5" />
              ) : group.id === "coordinators" ? (
                <Users class="h-4.5 w-4.5" />
              ) : (
                <Building2 class="h-4.5 w-4.5" />
              )}
            </span>
            <h3 class="text-lg font-black text-slate-900 sm:text-xl">
              {translateInline((isEn) ? "en" : "id", group.labelKey)}
            </h3>
          </div>

          <div class={cardGridClass(group)}>
            {group.members.map((member) => (
              <article
                class={
                  group.featured
                    ? "group relative flex flex-col gap-5 overflow-hidden rounded-[26px] border border-[#dfeadf] bg-gradient-to-br from-[#f7fbf7] to-white p-5 shadow-[0_20px_50px_-38px_rgba(0,61,42,0.6)] transition-all duration-300 hover:-translate-y-1 hover:border-[#c7e0cd] hover:shadow-[0_26px_60px_-34px_rgba(0,61,42,0.45)] sm:flex-row sm:items-center sm:p-6"
                    : "group flex flex-col overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-[0_18px_45px_-35px_rgba(15,23,42,0.45)] transition-all duration-300 hover:-translate-y-1 hover:border-[#c7e0cd] hover:shadow-[0_24px_55px_-32px_rgba(0,61,42,0.4)]"
                }
              >
                <div
                  class={
                    group.featured
                      ? "relative w-full shrink-0 overflow-hidden rounded-[20px] bg-slate-100 sm:w-40"
                      : "relative aspect-[4/3] w-full overflow-hidden bg-slate-100 sm:aspect-[4/5]"
                  }
                >
                  <img
                    src={getImageUrl(member.photo, { width: 640, height: 800, fit: 'cover' }, '/logo/uin.png')}
                    alt={member.name}
                    width="640"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class={
                      group.featured
                        ? "aspect-[3/2] w-full rounded-[20px] object-cover object-top transition-transform duration-500 group-hover:scale-[1.03] sm:aspect-[4/5]"
                        : "h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
                    }
                  />
                  {!group.featured && (
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/45 to-transparent"></div>
                  )}
                </div>

                <div class={group.featured ? "flex min-w-0 flex-1 flex-col" : "flex flex-1 flex-col p-5"}>
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#0b5c3d]">
                    {member.role}
                  </p>
                  <h4
                    class={
                      group.featured
                        ? "mt-2 text-lg font-black leading-snug text-slate-900 sm:text-xl"
                        : "mt-2 text-base font-black leading-snug text-slate-900"
                    }
                  >
                    {member.name}
                  </h4>

                  {group.featured && member.email && (
                    <p class="mt-2 truncate text-sm text-slate-500">{member.email}</p>
                  )}

                  <div class={group.featured ? "mt-4" : "mt-auto pt-4"}>
                    {member.href ? (
                      <a
                        href={localizePath(member.href, lang)}
                        class="inline-flex items-center gap-1.5 text-sm font-bold text-[#0b5c3d] transition-colors duration-200 hover:text-[#084229] hover:underline"
                      >
                        {translateInline((isEn) ? "en" : "id", "inline.view-profile")}
                        <ArrowUpRight class="h-4 w-4" />
                      </a>
                    ) : (
                      <span class="text-sm font-semibold text-slate-400">
                        {isEn ? "Profile unavailable" : "Profil belum tersedia"}
                      </span>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* ── Fungsi Organisasi ── */}
    <div class="mt-8 rounded-[30px] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.3)] sm:p-8 lg:p-10">
      <div class="mb-6">
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">
          {translateInline((isEn) ? "en" : "id", "inline.overview-ikhtisar")}
        </p>
        <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
          {translateInline((isEn) ? "en" : "id", "inline.organizational-function")}
        </h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">01</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">
            {translateInline((isEn) ? "en" : "id", "inline.academic-governance")}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.ensuring-teaching-quality-curriculum-alignment-a")}
          </p>
        </div>

        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">02</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">
            {translateInline((isEn) ? "en" : "id", "inline.research-support")}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.developing-learning-activities-and-research-capa")}
          </p>
        </div>

        <div class="rounded-[24px] border border-slate-200 bg-[#f9fbf9] p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">03</p>
          <h3 class="mt-3 text-lg font-black text-slate-900">
            {translateInline((isEn) ? "en" : "id", "inline.administrative-service")}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {translateInline((isEn) ? "en" : "id", "inline.providing-orderly-service-to-students-lecturers")}
          </p>
        </div>
      </div>
    </div>

    {/* ── Bagan Organisasi ── */}
    <div class="mt-8">
      <div class="mb-4">
        <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#0b5c3d]">
          {translateInline((isEn) ? "en" : "id", "inline.structure-struktur")}
        </p>
        <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
          {translateInline((isEn) ? "en" : "id", "inline.official-structure-chart")}
        </h2>
      </div>
      <img height="1664" width="2564" decoding="async" loading="lazy" src="/struktur-pages/struktur-organisasi-2026.webp" alt="Struktur Organisasi" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white shadow-sm" />
    </div>

  </div>
</section>
