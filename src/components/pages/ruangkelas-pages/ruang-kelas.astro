---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const classrooms = [
  {
    id: "fst",
    code: "GB·01",
    name: "Gedung Fakultas Sains dan Teknologi (FST)",
    description: "Ruang kelas di gedung utama FST yang dirancang untuk kenyamanan proses perkuliahan harian dengan sarana yang representatif.",
    facilities: [
      {
        title: "Kursi Mahasiswa",
        description: "Kursi mahasiswa pada kelas prodi teknik informatika memiliki desain ergonomis dan nyaman untuk mendukung konsentrasi dan kenyamanan belajar mahasiswa sepanjang perkuliahan.",
        image: "/ruang-kelas/fst_kursimahasiswa.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090527-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen di kelas Prodi Teknik Informatika memiliki desain modern dan fungsional, memudahkan dosen dalam mengelola media ajar dan mengajar dengan efektif.",
        image: "/ruang-kelas/fst_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090550-scaled.jpg"
      },
      {
        title: "Papan Tulis",
        description: "Papan tulis berukuran besar sangat penting sebagai alat bantu visual bagi dosen untuk menyampaikan materi, menuliskan rumus, dan melakukan diskusi interaktif saat perkuliahan.",
        image: "/ruang-kelas/fst_papantulis.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090557-scaled.jpg"
      },
      {
        title: "Pendingin Ruangan",
        description: "Sistem pendingin ruangan di kelas memastikan suhu yang ideal dan nyaman dengan menggunakan kombinasi kipas angin dan AC selama kegiatan belajar mengajar berlangsung.",
        image: "/ruang-kelas/fst_pendinginruangan.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090606-scaled.jpg"
      }
    ]
  },
  {
    id: "fstgb",
    code: "GB·02",
    name: "Gedung Baru Fakultas Sains dan Teknologi (FST.GB)",
    description: "Ruang kelas di Gedung Baru (GB) yang modern dengan tata ruang yang dinamis untuk mendukung perkuliahan berbasis teknologi.",
    facilities: [
      {
        title: "Kursi Mahasiswa",
        description: "Kursi mahasiswa di Gedung Baru memiliki desain ergonomis terkini, memberikan kenyamanan ekstra untuk interaksi kelompok dan pembelajaran aktif.",
        image: "/ruang-kelas/fstgb_kursimahasiswa.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/IMG20230317092730-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen modern di Gedung Baru dilengkapi dengan kemudahan akses kelistrikan dan penataan perangkat presentasi digital.",
        image: "/ruang-kelas/fstgb_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/WhatsApp-Image-2023-03-17-at-09.49.02.jpeg"
      },
      {
        title: "Papan Tulis",
        description: "Papan tulis berkualitas tinggi di Gedung Baru untuk menunjang pencatatan manual di samping penggunaan proyektor utama.",
        image: "/ruang-kelas/fstgb_papantulis.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/IMG20230317092855-1-scaled.jpg"
      },
      {
        title: "Pendingin Ruangan",
        description: "Suhu ruangan kelas di Gedung Baru selalu terjaga sejuk berkat AC berkapasitas besar untuk menunjang kenyamanan belajar mahasiswa secara optimal.",
        image: "/ruang-kelas/fstgb_pendinginruangan.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/WhatsApp-Image-2023-03-17-at-09.46.00.jpeg"
      }
    ]
  }
];
---

<!-- Breadcrumbs -->
<nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
    <li class="flex items-center">
      <a href={localizePath("/", lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        {t("bread.home")}
      </a>
    </li>
    <li class="text-slate-300">/</li>
    <li class="font-medium text-slate-600">{t("bread.profil")}</li>
    <li class="text-slate-300">/</li>
    <li class="font-semibold text-[#0b5c3d]">{t("bread.ruangkelas")}</li>
  </ol>
</nav>

<section class="relative overflow-hidden py-12 sm:py-14">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(217,182,93,0.18),_transparent_30%),linear-gradient(180deg,#f5faf4_0%,#ffffff_100%)]"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[30px] border border-[#dfeadf] bg-gradient-to-br from-[#003d2a] via-[#0b5c3d] to-[#d9b65d] p-6 shadow-[0_28px_80px_-32px_rgba(0,61,42,0.8)] sm:p-8 lg:p-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.24em] text-white/90">
          {t("page.ruangkelas.badge")}
        </span>
        <h1 class="mt-5 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
          {t("page.ruangkelas.title")}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
          {t("page.ruangkelas.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Content Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
  <div class="space-y-8 md:space-y-10">
    {classrooms.map((room) => (
      <div class="rounded-[30px] border border-gray-200 bg-white p-5 shadow-[0_20px_50px_-30px_rgba(15,23,42,0.25)] sm:p-6 lg:p-8">
        <div class="mb-6 flex flex-col gap-3 border-b border-gray-200 pb-5 md:flex-row md:items-end md:justify-between">
          <div>
            <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.25em] text-[#1E3A5F]/70">
              Ref. {room.code}
            </span>
            <h2 class="mt-2 text-2xl font-black tracking-tight text-[#004d2c] sm:text-3xl lg:text-4xl">
              {room.name}
            </h2>
          </div>
          <p class="max-w-xl text-sm leading-relaxed text-slate-600 md:text-right">
            {room.description}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {room.facilities.map((fac, idx) => (
            <div class="group overflow-hidden rounded-[26px] border border-[#dfe7d7] bg-[#f8faf3] transition-all duration-300 hover:-translate-y-1 hover:border-[#bfd2a9] hover:shadow-[0_22px_50px_-28px_rgba(0,61,42,0.35)]">
              <div class="flex h-full flex-col sm:flex-row">
                <div class="relative w-full sm:w-2/5 shrink-0 overflow-hidden bg-[#123b2c]">
                  <img
                    src={fac.image}
                    alt={fac.title}
                    class="h-48 w-full object-cover transition-all duration-500 group-hover:scale-[1.02] sm:h-full"
                    onerror={`this.onerror=null; this.src='${fac.fallbackImage}';`}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#123b2c]/20 to-transparent"></div>
                </div>

                <div class="flex w-full flex-1 flex-col justify-center p-5 sm:p-6">
                  <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.25em] text-[#1E3A5F]/70">
                    Spec {String(idx + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-2 text-lg font-black tracking-tight text-[#004d2c] sm:text-xl">
                    {fac.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">
                    {fac.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>