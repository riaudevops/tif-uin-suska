---
import { getLocaleFromUrl, useTranslations, localizePath } from "../../../lib/translations";
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);

const classrooms = [
  {
    id: "fst",
    code: "GB·01",
    name: "Gedung Fakultas Sains dan Teknologi (FST)",
    description: "Ruang kelas di gedung utama FST yang dirancang untuk kenyamanan proses perkuliahan harian dengan sarana yang representatif.",
    facilities: [
      {
        title: "Kursi Mahasiswa",
        description: "Kursi mahasiswa pada kelas prodi teknik informatika memiliki desain ergonomis dan nyaman untuk mendukung konsentrasi dan kenyamanan belajar mahasiswa sepanjang perkuliahan.",
        image: "/ruang-kelas/fst_kursimahasiswa.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090527-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen di kelas Prodi Teknik Informatika memiliki desain modern dan fungsional, memudahkan dosen dalam mengelola media ajar dan mengajar dengan efektif.",
        image: "/ruang-kelas/fst_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090550-scaled.jpg"
      },
      {
        title: "Papan Tulis",
        description: "Papan tulis berukuran besar sangat penting sebagai alat bantu visual bagi dosen untuk menyampaikan materi, menuliskan rumus, dan melakukan diskusi interaktif saat perkuliahan.",
        image: "/ruang-kelas/fst_papantulis.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090557-scaled.jpg"
      },
      {
        title: "Pendingin Ruangan",
        description: "Sistem pendingin ruangan di kelas memastikan suhu yang ideal dan nyaman dengan menggunakan kombinasi kipas angin dan AC selama kegiatan belajar mengajar berlangsung.",
        image: "/ruang-kelas/fst_pendinginruangan.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/02/IMG20230120090606-scaled.jpg"
      }
    ]
  },
  {
    id: "fstgb",
    code: "GB·02",
    name: "Gedung Baru Fakultas Sains dan Teknologi (FST.GB)",
    description: "Ruang kelas di Gedung Baru (GB) yang modern dengan tata ruang yang dinamis untuk mendukung perkuliahan berbasis teknologi.",
    facilities: [
      {
        title: "Kursi Mahasiswa",
        description: "Kursi mahasiswa di Gedung Baru memiliki desain ergonomis terkini, memberikan kenyamanan ekstra untuk interaksi kelompok dan pembelajaran aktif.",
        image: "/ruang-kelas/fstgb_kursimahasiswa.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/IMG20230317092730-scaled.jpg"
      },
      {
        title: "Meja Dosen",
        description: "Meja dosen modern di Gedung Baru dilengkapi dengan kemudahan akses kelistrikan dan penataan perangkat presentasi digital.",
        image: "/ruang-kelas/fstgb_mejadosen.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/WhatsApp-Image-2023-03-17-at-09.49.02.jpeg"
      },
      {
        title: "Papan Tulis",
        description: "Papan tulis berkualitas tinggi di Gedung Baru untuk menunjang pencatatan manual di samping penggunaan proyektor utama.",
        image: "/ruang-kelas/fstgb_papantulis.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/IMG20230317092855-1-scaled.jpg"
      },
      {
        title: "Pendingin Ruangan",
        description: "Suhu ruangan kelas di Gedung Baru selalu terjaga sejuk berkat AC berkapasitas besar untuk menunjang kenyamanan belajar mahasiswa secara optimal.",
        image: "/ruang-kelas/fstgb_pendinginruangan.jpg",
        fallbackImage: "https://tif.uin-suska.ac.id/wp-content/uploads/2023/03/WhatsApp-Image-2023-03-17-at-09.46.00.jpeg"
      }
    ]
  }
];
---

<!-- Breadcrumbs -->
<nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100 font-sans">
        <li class="flex items-center">
            <a href={localizePath("/", lang)} class="flex items-center hover:text-[#004d2c] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {t("bread.home")}
            </a>
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="hover:text-[#004d2c] cursor-pointer transition-colors">
            {t("bread.profil")}
        </li>
        <li class="text-gray-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </li>
        <li class="text-[#004d2c] font-bold tracking-tight">
            {t("bread.ruangkelas")}
        </li>
    </ol>
</nav>

<!-- Page Header -->
<section data-aos="fade-up" class="relative py-16 overflow-hidden font-sans bg-[#F7F5EF]">
  <!-- Blueprint grid backdrop -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
       style="background-image: linear-gradient(#1E3A5F 1px, transparent 1px), linear-gradient(90deg, #1E3A5F 1px, transparent 1px); background-size: 32px 32px;">
  </div>

  <div class="container mx-auto px-6 relative">
    <div class="max-w-3xl mx-auto text-center animate-fade-in">

      <span class="inline-flex items-center gap-2 px-4 py-1.5 border border-[#004d2c]/20 text-[#004d2c] rounded-full text-[11px] font-bold uppercase tracking-[0.25em] mb-6 font-mono">
        {t("page.ruangkelas.badge")}
      </span>

      <h1 data-aos="fade-up" class="text-4xl md:text-6xl font-black text-[#004d2c] mb-6 leading-[0.95] tracking-tight font-heading uppercase">
        {t("page.ruangkelas.title")}
      </h1>

      <p class="text-base md:text-lg text-slate-600 leading-relaxed font-sans max-w-xl mx-auto">
        {t("page.ruangkelas.desc")}
      </p>

    </div>
  </div>
</section>

<!-- Content Section -->
<section class="py-16 md:py-24 bg-white font-sans">
  <div class="container mx-auto px-6 max-w-6xl space-y-20 md:space-y-28">

    {classrooms.map((room) => (
      <div class="space-y-10">

        <!-- Building Header: blueprint-style title block -->
        <div class="border-b-2 border-[#004d2c]/10 pb-6">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
            <div>
              <span class="font-mono text-xs tracking-[0.3em] text-[#1E3A5F]/70 uppercase">
                Ref. {room.code}
              </span>
              <h2 class="text-2xl md:text-4xl font-black text-[#004d2c] font-heading tracking-tight leading-snug uppercase mt-1">
                {room.name}
              </h2>
            </div>
            <p class="text-sm text-slate-500 font-sans max-w-md md:text-right leading-relaxed">
              {room.description}
            </p>
          </div>
        </div>

        <!-- Facility Plaque Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {room.facilities.map((fac, idx) => (
            <div class="group relative bg-[#F7F5EF] border border-[#004d2c]/10 rounded-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                 style="clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);">

              <!-- Notched corner accent -->
              <div class="absolute top-0 right-0 w-5 h-5 bg-[#D4A017]"></div>

              <div class="flex flex-col sm:flex-row">
                <!-- Image -->
                <div class="relative w-full sm:w-2/5 h-44 sm:h-auto shrink-0 overflow-hidden bg-[#0e2954]">
                  <img
                    src={fac.image}
                    alt={fac.title}
                    class="w-full h-full object-cover grayscale-[15%] group-hover:grayscale-0 transition-all duration-500"
                    onerror={`this.onerror=null; this.src='${fac.fallbackImage}';`}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0e2954]/30 to-transparent sm:hidden"></div>
                </div>

                <!-- Spec content -->
                <div class="w-full sm:w-3/5 p-6 flex flex-col justify-center relative">
                  <span class="font-mono text-[10px] tracking-[0.25em] text-[#1E3A5F] uppercase mb-2">
                    Spec {String(idx + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-black text-[#004d2c] font-heading tracking-tight mb-2 leading-tight">
                    {fac.title}
                  </h3>
                  <p class="text-xs md:text-sm text-slate-600 leading-relaxed">
                    {fac.description}
                  </p>

                  <!-- Dashed measurement line decoration -->
                  <div class="absolute bottom-3 right-4 w-10 border-t border-dashed border-[#1E3A5F]/25 hidden md:block"></div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    ))}

  </div>
</section>