---
/**
 * Honest empty / error state for CMS-driven pages.
 *
 * Replaces the old behaviour of rendering invented ("dummy") articles with a
 * 200 status when the CMS had no data or denied access.
 */
interface Props {
  variant?: "not-found" | "unavailable";
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
}

const {
  variant = "not-found",
  title,
  description,
  backHref,
  backLabel,
} = Astro.props;

const isUnavailable = variant === "unavailable";
---

<section class="mx-auto max-w-3xl px-4 pb-20 pt-32 sm:px-6 sm:pt-36">
  <div class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_24px_70px_-45px_rgba(15,23,42,0.45)]">
    <div class="h-1.5 w-full bg-gradient-to-r from-[#0b5c3d] via-[#d4a537] to-[#0b5c3d]"></div>

    <div class="p-7 sm:p-10">
      <span
        class:list={[
          "inline-flex items-center rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em]",
          isUnavailable
            ? "bg-amber-50 text-amber-800 ring-1 ring-amber-200"
            : "bg-emerald-50 text-[#0b5c3d] ring-1 ring-emerald-200",
        ]}
      >
        {isUnavailable ? "Layanan tidak tersedia" : "Halaman tidak ditemukan"}
      </span>

      <h1 class="mt-5 text-2xl font-black leading-tight tracking-tight text-slate-900 sm:text-3xl">
        {title}
      </h1>

      <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
        {description}
      </p>

      <a
        href={backHref}
        class="mt-7 inline-flex items-center gap-2 rounded-xl bg-[#0b5c3d] px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-[#094b31] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0b5c3d]"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {backLabel}
      </a>
    </div>
  </div>
</section>
