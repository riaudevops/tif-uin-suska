---
import { getLocaleFromUrl, useTranslations } from '@/lib/translations.js';

interface Props {
	class?: string;
	showLabel?: boolean;
}

const { class: className = "", showLabel = false } = Astro.props;
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<button
	type="button"
	data-search-trigger
	class:list={[
		"flex items-center justify-center gap-2 rounded-full border border-slate-200 text-slate-600 hover:text-[#004d2c] hover:border-[#004d2c]/30 hover:bg-green-50 transition shrink-0",
		showLabel ? "w-full py-3 px-4 text-sm font-bold" : "w-10 h-10",
		className,
	]}
	aria-label={t("search.title")}
	title={`${t("search.title")} (Ctrl+K)`}
>
	<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
	</svg>
	{showLabel && <span>{t("search.title")}</span>}
</button>
