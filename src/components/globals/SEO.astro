---
import { getLocaleFromUrl, useTranslations } from "../../lib/translations";
import {
  DEFAULT_SITE,
  FALLBACK_OG_IMAGE,
  localeUrl,
  resolveImageUrl,
  splitLocale,
  stripTrackingParams,
} from "../../lib/seo.js";

interface ArticleData {
  headline?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
  image?: string;
  description?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  keywords?: string;
  author?: string;
  articleData?: ArticleData;
  /** Locale-less path (may include a query) used as the canonical target. */
  canonicalPath?: string;
  /** Locale-less paths that differ per language, e.g. translated article slugs. */
  alternatePaths?: { en?: string; id?: string };
  /** Set to true for pages that must not be indexed (e.g. search results). */
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  keywords,
  author = "Program Studi Teknik Informatika UIN Suska Riau",
  articleData,
  canonicalPath,
  alternatePaths,
  noindex = false,
} = Astro.props;

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === "en";

const siteUrl = (Astro.site ? Astro.site.toString() : DEFAULT_SITE).replace(/\/+$/, "");

/**
 * `Astro.url` points at the rewritten route (the middleware strips the `/id`
 * prefix), so the requested path is recovered from `Astro.locals.originalUrl`.
 */
const locals = Astro.locals as any;
let originalTarget: string;
try {
  const original = new URL(String(locals?.originalUrl || Astro.url.href));
  originalTarget = `${original.pathname}${original.search}`;
} catch {
  originalTarget = `${Astro.url.pathname}${Astro.url.search}`;
}

const { path: basePath, query: baseQuery } = splitLocale(originalTarget);
const canonicalTarget =
  canonicalPath || `${basePath}${stripTrackingParams(baseQuery)}`;
const enTarget = alternatePaths?.en || canonicalTarget;
const idTarget = alternatePaths?.id || canonicalTarget;

const canonicalUrl = localeUrl(isEn ? enTarget : idTarget, lang, siteUrl);
const enUrl = localeUrl(enTarget, "en", siteUrl);
const idUrl = localeUrl(idTarget, "id", siteUrl);

// `x-default` points at the default locale (English) version.
const xDefaultUrl = enUrl;

const departmentName = t("nav.title");
const siteName = `${departmentName} UIN Suska Riau`;

const fullTitle = title
  ? `${title} | ${siteName}`
  : `${siteName} - Universitas Islam Negeri Sultan Syarif Kasim Riau`;

const defaultDescription = isEn
  ? (title
      ? `${title} - Department of Informatics Engineering, Faculty of Science and Technology, UIN Sultan Syarif Kasim Riau.`
      : "Official Website of the Department of Informatics Engineering, Faculty of Science and Technology, UIN Sultan Syarif Kasim Riau. Center of excellence in Islamic-integrated IT education and research.")
  : (title
      ? `${title} - Program Studi Teknik Informatika, Fakultas Sains dan Teknologi, UIN Sultan Syarif Kasim Riau.`
      : "Website resmi Program Studi Teknik Informatika, Fakultas Sains dan Teknologi, UIN Sultan Syarif Kasim Riau. Pusat keunggulan pendidikan dan riset bidang teknologi informasi yang terintegrasi nilai-nilai keislaman.");

const metaDescription = description || defaultDescription;

const ogImage = resolveImageUrl(image, siteUrl, FALLBACK_OG_IMAGE);

const defaultKeywords = isEn
  ? "Informatics Engineering, Computer Science, UIN Suska Riau, Faculty of Science and Technology, Sultan Syarif Kasim Islamic University, Pekanbaru, Riau, IT Higher Education"
  : "Teknik Informatika, UIN Suska Riau, Fakultas Sains dan Teknologi, UIN Sultan Syarif Kasim, Pekanbaru, Riau, Kuliah Informatika, Ilmu Komputer, Kampus Islam Negeri";

const metaKeywords = keywords || defaultKeywords;

const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Generate Schema.org JSON-LD
const organizationSchema = {
  "@type": "EducationalOrganization",
  "@id": `${siteUrl}/#organization`,
  "name": "Teknik Informatika UIN Sultan Syarif Kasim Riau",
  "alternateName": "Department of Informatics Engineering UIN Suska Riau",
  "url": siteUrl,
  "logo": `${siteUrl}/logo/uin.png`,
  "image": `${siteUrl}${FALLBACK_OG_IMAGE}`,
  "email": "tif@uin-suska.ac.id",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. H.R. Soebrantas Km. 15 No. 155, Simpang Baru, Tampan",
    "addressLocality": "Pekanbaru",
    "addressRegion": "Riau",
    "postalCode": "28293",
    "addressCountry": "ID"
  },
  "parentOrganization": {
    "@type": "CollegeOrUniversity",
    "name": "Universitas Islam Negeri Sultan Syarif Kasim Riau",
    "url": "https://uin-suska.ac.id"
  }
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": siteName,
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": isEn ? "en-US" : "id-ID"
};

let jsonLdGraph: any[] = [organizationSchema, websiteSchema];

// If page is an article/news, inject NewsArticle schema
if (type === "article" && articleData) {
  const articleImage = resolveImageUrl(
    articleData.image || image,
    siteUrl,
    FALLBACK_OG_IMAGE,
  );

  const newsArticleSchema = {
    "@type": "NewsArticle",
    "@id": `${canonicalUrl}#article`,
    "isPartOf": {
      "@id": `${siteUrl}/#website`
    },
    "headline": articleData.headline || title,
    "description": articleData.description || metaDescription,
    "image": [articleImage],
    "datePublished": articleData.datePublished || new Date().toISOString(),
    "dateModified": articleData.dateModified || articleData.datePublished || new Date().toISOString(),
    "mainEntityOfPage": canonicalUrl,
    "author": {
      "@type": "Organization",
      "name": articleData.author || "Program Studi Teknik Informatika UIN Suska Riau",
      "url": siteUrl
    },
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": isEn ? "en-US" : "id-ID"
  };
  jsonLdGraph.push(newsArticleSchema);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": jsonLdGraph
};

/**
 * JSON.stringify alone can terminate a `<script>` block when CMS content
 * contains `</script>`. Escaping `<`, `>` and `&` keeps the JSON valid while
 * preventing the browser's HTML parser from closing the element early.
 */
const jsonLdString = JSON.stringify(jsonLd)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026");
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDescription} />
<meta name="keywords" content={metaKeywords} />
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<meta name="theme-color" content="#004d2c" />
<meta name="color-scheme" content="light" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<!-- Canonical & Language Alternates -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="id" href={idUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={isEn ? "en_US" : "id_ID"} />
<meta property="og:locale:alternate" content={isEn ? "id_ID" : "en_US"} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={jsonLdString} />
