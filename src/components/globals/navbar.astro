                        class="flex items-center gap-1 px-3 py-2 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                        data-menu-btn="penelitian"
                    >
                        {t("nav.penelitian")} <svg
                            class="w-3 h-3 opacity-50"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 24 24"
                            ><path d="m6 9 6 6 6-6"></path></svg
