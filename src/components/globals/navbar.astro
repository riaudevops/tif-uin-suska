---
import SiteSearch from "./SiteSearch.astro";
import SearchTrigger from "./SearchTrigger.astro";
import { getLocaleFromUrl, useTranslations, localizePath } from "../../lib/translations";

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<nav
    class="w-full fixed top-0 left-0 right-0 z-50 transition-all duration-300 shadow-sm"
>
    <div
        data-topbar
        class="w-full bg-[#004d2c] text-white/90 text-[10px] py-1 md:text-xs uppercase tracking-widest font-medium"
    >
        <div
            class="container w-full mx-auto px-4 sm:px-6 py-1 flex justify-end items-center gap-3 sm:gap-6"
        >
            <a href={localizePath("/international-office", lang)} class="hover:text-yellow-400 transition-colors whitespace-nowrap hidden sm:inline">{t("top.io")}</a>
            <a href={localizePath("/akreditasi", lang)} class="hover:text-yellow-400 transition-colors whitespace-nowrap">{t("top.akreditasi")}</a>
            <a href={localizePath("/mitra", lang)} class="hover:text-yellow-400 transition-colors whitespace-nowrap">{t("top.mitra")}</a>
            <div class="h-3 w-[1px] bg-white/20"></div>
            <div class="flex items-center gap-1.5 font-bold">
                <a href={localizePath(Astro.url.pathname, 'id')} class={`px-1.5 py-0.5 rounded transition duration-200 ${lang === 'id' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-white/80 hover:text-white hover:bg-white/10'}`}>ID</a>
                <span class="text-white/30">|</span>
                <a href={localizePath(Astro.url.pathname, 'en')} class={`px-1.5 py-0.5 rounded transition duration-200 ${lang === 'en' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-white/80 hover:text-white hover:bg-white/10'}`}>EN</a>
            </div>
        </div>
    </div>

    <div class="bg-white/95 backdrop-blur-md border-b border-gray-100">
        <div
            class="container w-full mx-auto flex items-center justify-between py-2 sm:py-3 px-4 sm:px-6"
        >
            <div class="flex items-center gap-5 shrink-0">
                <div
                    class="flex flex-col items-center border-r-2 border-slate-100 pr-3 sm:pr-5 group cursor-pointer"
                >
                    <img
                        src="/logo/uin.png"
                        alt="Logo UIN Suska"
                        class="h-8 sm:h-10 w-auto transform group-hover:scale-105 transition-transform duration-300"
                    />
                    <span
                        class="text-[8px] sm:text-[9px] font-black text-blue-400 mt-1 sm:mt-1.5 uppercase tracking-tighter text-center leading-none"
                    >
                        UIN Suska Riau
                    </span>
                </div>
                <div class="flex flex-col">
                    <h1
                        class="text-sm sm:text-lg md:text-xl font-black tracking-tight text-slate-800 leading-none uppercase"
                    >
                        {lang === 'en' ? <>Informatics <span class="text-[#004d2c]">Engineering</span></> : <>Teknik <span class="text-[#004d2c]">Informatika</span></>}
                    </h1>
                    <h2
                        class="text-[9px] sm:text-[11px] md:text-xs font-bold text-slate-500 mt-0.5 sm:mt-1 uppercase tracking-wider"
                    >
                        {t("nav.sub")}
                    </h2>
                </div>

                <div class="hidden xl:flex items-center">
                    <img
                        src="/logo/unggul.png"
                        alt="Logo Unggul"
                        class="w-8 h-10 2xl:w-10 2xl:h-12 object-contain ml-2.5 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                    <img
                        src="/logo/blu.png"
                        alt="Logo Blu"
                        class="w-8 h-10 2xl:w-10 2xl:h-12 object-contain ml-2.5 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                    <img
                        src="/logo/kemenag.png"
                        alt="Logo Kemenag"
                        class="w-8 h-10 2xl:w-10 2xl:h-12 object-contain ml-2.5 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                </div>
            </div>

            <div
                class="hidden lg:flex items-center gap-1 text-[13px] font-bold text-slate-700 uppercase shrink-0"
            >
                <a
                    href={localizePath("/", lang)}
                    class="px-3 py-1 hover:text-[#004d2c] transition rounded-lg hover:bg-slate-50"
                    >{t("nav.home")}</a
                >

                <div class="relative group">
                    <button
                        aria-expanded="false"
                        type="button"
                        class="flex items-center gap-1 px-3 py-2 text-slate-700 hover:text-[#004d2c] transition-colors rounded-lg hover:bg-slate-50 font-bold focus:outline-none"
                    >
                        {t("nav.profil")} <svg
                            class="w-3 h-3 opacity-50 transition-transform duration-200 group-hover:rotate-180 group-hover:opacity-100"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 24 24"
                            ><path d="m6 9 6 6 6-6"></path></svg
                        >
                    </button>

                    <!-- Safe hover bridge area -->
                    <div
                        class="absolute left-0 top-full pt-1 w-72 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
                    >
                        <div class="bg-white shadow-2xl rounded-xl p-2 border border-gray-100">
                        <a
                            href={localizePath("/profil/sejarah", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.sejarah")}</a
                        >
                        <a
                            href={localizePath("/visi-misi/visimisi", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.visimisi")}</a
                        >
                        <a
                            href={localizePath("/rencana/rencana", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.rencana")}</a
                        >
                        <a
                            href={localizePath("/panduan/panduan", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.panduan")}</a
                        >
                        <a
                            href={localizePath("/struktur/struktur", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.struktur")}</a
                        >
                        <a
                            href={localizePath("/dosen/dosen", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.dosen")}</a
                        >
                        <a
                            href={localizePath("/laboratorium/laboratorium", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.laboratorium")}</a
                        >
                        <a
                            href={localizePath("/ruangkelas/ruangkelas", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.ruangkelas")}</a
                        >
                        <a
                            href={localizePath("/prestasi/prestasi", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.prestasi")}</a
                        >
                        </div>
                    </div>
                </div>

                <div class="relative group">
                    <button
                        aria-expanded="false"
                        type="button"
                        class="flex items-center gap-1 px-3 py-2 text-slate-700 hover:text-[#004d2c] transition-colors rounded-md hover:bg-slate-50 font-bold focus:outline-none"
                    >
                        {t("nav.akademik")} <svg
                            class="w-3 h-3 opacity-50 transition-transform duration-200 group-hover:rotate-180 group-hover:opacity-100"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 24 24"
                            ><path d="m6 9 6 6 6-6"></path></svg
                        >
                    </button>
                    <div
                        class="absolute left-0 top-full pt-1 w-72 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
                    >
                        <div class="bg-white shadow-2xl rounded-xl p-2 border border-gray-100">
                        <a
                            href="https://pmb.uin-suska.ac.id/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.penerimaan")}</a
                        >
                        <a
                            href="https://linktr.ee/administrasi_prodi_tif"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.administrasi")}</a
                        >
                        <a
                            href={localizePath("/kurikulum/kurikulum", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.kurikulum")}</a
                        >
                        <a
                            href="https://pmt.uin-suska.ac.id/wp-content/uploads/2025/08/Kalender-Akademik-UIN-Suska-Riau-Tahun-2025-2026.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.kalender")}</a
                        >
                        <a
                            href={localizePath("/beasiswa/beasiswa", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.beasiswa")}</a
                        >
                        <a
                            href={localizePath("/tugas-akhir/tugas-akhir", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.ta")}</a
                        >
                        <a
                            href={localizePath("/kerja-praktik/kerja-praktik", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.kp")}</a
                        >
                        <a
                            href={localizePath("/labssquad/labssquad", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.labssquad")}</a
                        >
                        </div>
                    </div>
                </div>

                <div class="relative group">
                    <button
                        aria-expanded="false"
                        type="button"
                        class="flex items-center gap-1 px-3 py-2 text-slate-700 hover:text-[#004d2c] transition-colors rounded-md hover:bg-slate-50 font-bold focus:outline-none"
                    >
                        {t("nav.penelitian")} <svg
                            class="w-3 h-3 opacity-50 transition-transform duration-200 group-hover:rotate-180 group-hover:opacity-100"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 24 24"
                            ><path d="m6 9 6 6 6-6"></path></svg
                        >
                    </button>
                    <div
                        class="absolute left-0 top-full pt-1 w-72 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
                    >
                        <div class="bg-white shadow-2xl rounded-xl p-2 border border-gray-100">
                        <a
                            href="https://ejournal.uin-suska.ac.id/index.php/coreit"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.jurnal")}</a
                        >
                        <a
                            href={localizePath("/aiorc/aiorc", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.aiorc")}</a
                        >
                        <a
                            href={localizePath("/software/software", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.se")}</a
                        >
                        <a
                            href={localizePath("/information/information", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.it")}</a
                        >
                        </div>
                    </div>
                </div>

                <a
                    href={localizePath("/berita", lang)}
                    class="px-3 py-2 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                    >{t("nav.berita")}</a
                >
                <a
                    href={localizePath("/agenda/agenda", lang)}
                    class="px-3 py-2 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                    >{t("nav.agenda")}</a
                >
                <a
                    href={localizePath("/alumni/alumni", lang)}
                    class="px-3 py-2 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                    >{t("nav.alumni")}</a
                >

                <div class="ml-2 flex items-center gap-2">
                <a
                    href="https://hima.tif.uin-suska.ac.id/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-2 bg-[#004d2c] text-white rounded-lg hover:bg-yellow-600 transition shadow-md shadow-green-100 flex items-center gap-2"
                >
                    {t("nav.himatif")}
                    <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                    >
                </a>
                    <SearchTrigger />
                </div>
            </div>

            <div class="lg:hidden flex items-center gap-1.5 sm:gap-2">
                <SearchTrigger />
                <button
                    aria-expanded="false"
                    aria-label="Toggle navigation menu"
                    aria-controls="mobile-menu"
                    type="button"
                    class="p-2 sm:p-2.5 rounded-xl text-slate-800 hover:text-[#004d2c] hover:bg-slate-100/80 active:bg-slate-200 transition-colors focus:outline-none focus:ring-2 focus:ring-[#004d2c]/20"
                    id="mobile-menu-btn"
                >
                    <svg
                        id="mobile-icon-open"
                        class="w-6 h-6 sm:w-7 sm:h-7 transition-transform duration-200"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"
                        ></path>
                    </svg>
                    <svg
                        id="mobile-icon-close"
                        class="w-6 h-6 sm:w-7 sm:h-7 hidden transition-transform duration-200"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div class="w-full h-[2px] bg-[#0d3c2f] opacity-90"></div>

    <div id="mobile-menu"
        class="lg:hidden absolute top-full left-0 right-0 bg-white shadow-2xl hidden border-t border-gray-100 transition-all duration-300">
        <div class="flex flex-col py-3 px-3 sm:px-5 max-h-[calc(100vh-110px)] overflow-y-auto overscroll-contain">
            <a href={localizePath("/", lang)} class="py-2.5 px-4 text-sm font-semibold text-slate-800 hover:text-[#004d2c] hover:bg-emerald-50/60 rounded-xl transition-colors">
                {t("nav.home")}
            </a>

            <div class="flex flex-col">
                <button 
                    type="button" 
                    aria-expanded="false"
                    class="group flex items-center justify-between py-2.5 px-4 text-sm font-semibold text-slate-800 hover:text-[#004d2c] hover:bg-emerald-50/60 rounded-xl transition-colors text-left w-full"
                    data-menu-btn="profil-mobile"
                >
                    <span>{t("nav.profil")}</span>
                    <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                
                <div id="menu-profil-mobile" class="hidden flex-col pb-2 pt-1 pl-2 space-y-0.5 border-l-2 border-emerald-100 ml-4 my-1" data-menu="profil-mobile">
                    <a href={localizePath("/profil/sejarah", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.sejarah")}</a>
                    <a href={localizePath("/visi-misi/visimisi", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.visimisi")}</a>
                    <a href={localizePath("/rencana/rencana", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.rencana")}</a>
                    <a href={localizePath("/panduan/panduan", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.panduan")}</a>
                    <a href={localizePath("/struktur/struktur", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.struktur")}</a>
                    <a href={localizePath("/dosen/dosen", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.dosen")}</a>
                    <a href={localizePath("/laboratorium/laboratorium", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.laboratorium")}</a>
                    <a href={localizePath("/ruangkelas/ruangkelas", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.ruangkelas")}</a>
                    <a href={localizePath("/prestasi/prestasi", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.prestasi")}</a>
                </div>
            </div>

            <div class="flex flex-col">
                <button 
                    type="button" 
                    aria-expanded="false"
                    class="group flex items-center justify-between py-2.5 px-4 text-sm font-semibold text-slate-800 hover:text-[#004d2c] hover:bg-emerald-50/60 rounded-xl transition-colors text-left w-full"
                    data-menu-btn="akademik-mobile"
                >
                    <span>{t("nav.akademik")}</span>
                    <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                
                <div id="menu-akademik-mobile" class="hidden flex-col pb-2 pt-1 pl-2 space-y-0.5 border-l-2 border-emerald-100 ml-4 my-1" data-menu="akademik-mobile">
                    <a href="https://pmb.uin-suska.ac.id/" target="_blank" rel="noopener noreferrer" class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.penerimaan")}</a>
                    <a href="https://linktr.ee/administrasi_prodi_tif" target="_blank" rel="noopener noreferrer" class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.administrasi")}</a>
                    <a href={localizePath("/kurikulum/kurikulum", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.kurikulum")}</a>
                    <a href="https://pmt.uin-suska.ac.id/wp-content/uploads/2025/08/Kalender-Akademik-UIN-Suska-Riau-Tahun-2025-2026.pdf" target="_blank" rel="noopener noreferrer" class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.kalender")}</a>
                    <a href={localizePath("/beasiswa/beasiswa", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.beasiswa")}</a>
                    <a href={localizePath("/tugas-akhir/tugas-akhir", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.ta")}</a>
                    <a href={localizePath("/kerja-praktik/kerja-praktik", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.kp")}</a>
                    <a href={localizePath("/labssquad/labssquad", lang)} class="block py-2 px-3 text-[13px] font-medium text-slate-600 hover:text-[#004d2c] hover:bg-emerald-50/80 rounded-lg transition-colors">{t("menu.labssquad")}</a>
                </div>
            </div>

            <div class="flex flex-col">
                <button 
                    type="button" 
                    aria-expanded="false"
                    class="group flex items-center justify-between py-2.5 px-4 text-sm font-semibold text-slate-800 hover:text-[#004d2c] hover:bg-emerald-50/60 rounded-xl transition-colors text-left w-full"
