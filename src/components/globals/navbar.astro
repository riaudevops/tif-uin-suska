                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                    >
                </a>
                    <SearchTrigger />
                </div>
            </div>

            <div class="lg:hidden flex items-center gap-2">
                <SearchTrigger />
            <button
                aria-expanded="false"
                type="button"
                class="p-2 text-slate-800"
                id="mobile-menu-btn"
            >
                <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
