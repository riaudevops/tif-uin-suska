                    <a href={localizePath("/tugas/tugas-akhir", lang)} class="block py-2.5 pl-10 pr-4 text-sm text-slate-500 hover:text-[#004d2c] hover:bg-green-50 rounded-lg transition-colors">{t("menu.ta")}</a>
