---
import SiteSearch from "./SiteSearch.astro";
import SearchTrigger from "./SearchTrigger.astro";
import { getLocaleFromUrl, useTranslations, localizePath } from "../../lib/translations";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav
    class="w-full fixed top-0 left-0 right-0 z-50 transition-all duration-300 shadow-sm"
>
    <div
        data-topbar
        class="w-full bg-[#004d2c] text-white/90 text-[10px] py-1 md:text-xs uppercase tracking-widest font-medium"
    >
        <div
            class="container w-full mx-auto px-6 py-1 flex justify-end items-center gap-6"
        >
            <a href={localizePath("/international-office", lang)} class="hover:text-yellow-400 transition-colors">{t("top.io")}</a>
            <a href={localizePath("/akreditasi", lang)} class="hover:text-yellow-400 transition-colors">{t("top.akreditasi")}</a>
            <a href={localizePath("/mitra", lang)} class="hover:text-yellow-400 transition-colors">{t("top.mitra")}</a>
            <div class="h-3 w-[1px] bg-white/20"></div>
            <div class="flex items-center gap-1.5 font-bold">
                <a href={localizePath(Astro.url.pathname, 'id')} class={`px-1.5 py-0.5 rounded transition duration-200 ${lang === 'id' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-white/80 hover:text-white hover:bg-white/10'}`}>ID</a>
                <span class="text-white/30">|</span>
                <a href={localizePath(Astro.url.pathname, 'en')} class={`px-1.5 py-0.5 rounded transition duration-200 ${lang === 'en' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-white/80 hover:text-white hover:bg-white/10'}`}>EN</a>
            </div>
        </div>
    </div>

    <div class="bg-white/95 backdrop-blur-md border-b border-gray-100">
        <div
            class="container w-full mx-auto flex items-center justify-between py-3 px-6"
        >
            <div class="flex items-center gap-5 shrink-0">
                <div
                    class="flex flex-col items-center border-r-2 border-slate-100 pr-5 group cursor-pointer"
                >
                    <img
                        src="/logo/uin.png"
                        alt="Logo UIN Suska"
                        class="h-10 w-auto transform group-hover:scale-105 transition-transform duration-300"
                    />
                    <span
                        class="text-[9px] font-black text-blue-400 mt-1.5 uppercase tracking-tighter text-center leading-none"
                    >
                        UIN Suska Riau
                    </span>
                </div>
                <div class="flex flex-col">
                    <h1
                        class="text-lg md:text-xl font-black tracking-tight text-slate-800 leading-none uppercase"
                    >
                        {lang === 'en' ? <>Informatics <span class="text-[#004d2c]">Engineering</span></> : <>Teknik <span class="text-[#004d2c]">Informatika</span></>}
                    </h1>
                    <h2
                        class="text-[11px] md:text-xs font-bold text-slate-500 mt-1 uppercase tracking-wider"
                    >
                        {t("nav.sub")}
                    </h2>
                </div>

                <div class="hidden sm:flex items-center">
                    <img
                        src="/logo/unggul.png"
                        alt="Logo Unggul"
                        class="w-10 h-12 object-contain ml-3 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                    <img
                        src="/logo/blu.png"
                        alt="Logo Blu"
                        class="w-10 h-12 object-contain ml-3 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                    <img
                        src="/logo/kemenag.png"
                        alt="Logo Kemenag"
                        class="w-10 h-12 object-contain ml-3 opacity-90 hover:opacity-100 transition-opacity drop-shadow-sm"
                    />
                </div>
            </div>

            <div
                class="hidden lg:flex items-center gap-1 text-[13px] font-bold text-slate-700 uppercase shrink-0"
            >
                <a
                    href={localizePath("/", lang)}
                    class="px-3 py-1 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                    >{t("nav.home")}</a
                >

                <div class="relative" data-dropdown>
                    <button
                        aria-expanded="false"
                        type="button"
                        class="flex items-center gap-1 px-3 py-2 hover:text-[#004d2c] transition rounded-md hover:bg-slate-50"
                        data-menu-btn="profil"
                    >
                        {t("nav.profil")} <svg
                            class="w-3 h-3 opacity-50"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            viewBox="0 0 24 24"
                            ><path d="m6 9 6 6 6-6"></path></svg
                        >
                    </button>

                    <div
                        id="menu-profil"
                        class="absolute left-0 bg-white shadow-2xl rounded-xl p-2 w-72 mt-2 hidden border border-gray-100 z-50"
