<script is:inline>
    function initNavbar() {
        const nav = document.querySelector("nav");
        const buttons = document.querySelectorAll("[data-menu-btn]");
        const menus = document.querySelectorAll("[data-menu]");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const topBar = nav?.querySelector("[data-topbar]");

        if (!nav) return;

        function closeAll() {
            menus.forEach((menu) => menu.classList.add("hidden"));
            buttons.forEach((btn) =>
                btn.setAttribute("aria-expanded", "false"),
            );
        }

        buttons.forEach((btn) => {
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);

            newBtn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();

                const key = newBtn.dataset.menuBtn;
                const menu = document.getElementById(`menu-${key}`);
                if (!menu) return;

                const isCurrentlyOpen = !menu.classList.contains("hidden");

                closeAll();

                if (!isCurrentlyOpen) {
                    menu.classList.remove("hidden");
                    newBtn.setAttribute("aria-expanded", "true");
                }
            });
        });

        mobileBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileMenu?.classList.toggle("hidden");
        });

        window.addEventListener("scroll", () => {
            if (topBar) {
                topBar.classList.toggle("hidden", window.scrollY > 50);
            }
            nav.classList.toggle("shadow-lg", window.scrollY > 50);
        });

        document.addEventListener("click", (e) => {
            if (!nav.contains(e.target)) {
                closeAll();
                mobileMenu?.classList.add("hidden");
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeAll();
                mobileMenu?.classList.add("hidden");
            }
        });
    }

    const langSelect = document.getElementById("lang-switch");

    if (langSelect) {
        const newLangSelect = langSelect.cloneNode(true);
        langSelect.parentNode.replaceChild(newLangSelect, langSelect);

        newLangSelect.addEventListener("change", (e) => {
            const selectedLang = e.target.value;
            let currentPath = window.location.pathname;

            let newPath = currentPath;

            if (selectedLang === "en") {
                if (!currentPath.startsWith("/en")) {
                    newPath = `/en${currentPath === "/" ? "" : currentPath}`;
                }
            } else if (selectedLang === "id") {
                if (currentPath.startsWith("/en")) {
                    newPath = currentPath.replace(/^\/en/, "") || "/";
                }
            }

            window.location.href = newPath;
        });
    }

    function initLangSwitcher() {
        const langSwitch = document.getElementById("lang-switch");

        if (!langSwitch) return;

        const newLangSwitch = langSwitch.cloneNode(true);
        langSwitch.parentNode.replaceChild(newLangSwitch, langSwitch);

        newLangSwitch.addEventListener("change", (e) => {
            const selectedLang = e.target.value;
            const currentPath = window.location.pathname; 

            let newPath = currentPath;

            if (selectedLang === "en") {
                if (!currentPath.startsWith("/en")) {
                    newPath = `/en${currentPath === "/" ? "" : currentPath}`;
                }
            } else if (selectedLang === "id") {
                if (currentPath.startsWith("/en")) {
                    newPath = currentPath.replace(/^\/en/, "") || "/";
                }
            }

            if (newPath !== currentPath) {
                window.location.href = newPath;
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initNavbar);
    document.addEventListener("astro:page-load", initNavbar);
</script>
