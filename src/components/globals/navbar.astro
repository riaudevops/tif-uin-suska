                    >
                        <a
                            href={localizePath("/profil-pages/sejarah", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.sejarah")}</a
                        >
                        <a
                            href={localizePath("/visimisi-pages/visimisi", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.visimisi")}</a
                        >
                        <a
                            href={localizePath("/rencana-pages/rencana", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.rencana")}</a
                        >
                        <a
                            href={localizePath("/panduan-pages/panduan", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.panduan")}</a
                        >
                        <a
                            href={localizePath("/struktur-pages/struktur", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.struktur")}</a
                        >
                        <a
                            href={localizePath("/dosen-pages/dosen", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.dosen")}</a
                        >
                        <a
                            href={localizePath("/laboratorium-pages/laboratorium", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.laboratorium")}</a
                        >
                        <a
                            href={localizePath("/ruangkelas/ruangkelas", lang)}
                            class="block py-2.5 px-4 hover:bg-green-50 hover:text-[#004d2c] rounded-lg transition text-sm normal-case font-medium"
                            >{t("menu.ruangkelas")}</a
                        >
                        <a
                            href={localizePath("/prestasi-pages/prestasi", lang)}
