                <div class="flex items-center justify-center gap-4 py-2 border border-slate-200 rounded-xl bg-slate-50 font-bold text-sm">
                    <span class="text-slate-500 uppercase tracking-wider text-xs">Bahasa / Language:</span>
                    <a href={localizePath(Astro.url.pathname, 'id')} class={`px-3 py-1 rounded-lg transition duration-200 ${lang === 'id' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-slate-600 hover:text-slate-900'}`}>ID</a>
                    <span class="text-slate-300">|</span>
                    <a href={localizePath(Astro.url.pathname, 'en')} class={`px-3 py-1 rounded-lg transition duration-200 ${lang === 'en' ? 'bg-yellow-500 text-[#004d2c] font-black' : 'text-slate-600 hover:text-slate-900'}`}>EN</a>
                </div>

                <SearchTrigger showLabel class="!rounded-xl border-slate-200" />
            </div>
        </div>
    </div>

    <SiteSearch />
</nav>

<script is:inline>
    function initNavbar() {
        const nav = document.querySelector("nav");
        const buttons = document.querySelectorAll("[data-menu-btn]");
        const menus = document.querySelectorAll("[data-menu]");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const topBar = nav?.querySelector("[data-topbar]");

        if (!nav) return;

        function closeAll() {
            menus.forEach((menu) => menu.classList.add("hidden"));
            buttons.forEach((btn) =>
                btn.setAttribute("aria-expanded", "false"),
            );
        }

        buttons.forEach((btn) => {
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);

            newBtn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();

                const key = newBtn.dataset.menuBtn;
                const menu = document.getElementById(`menu-${key}`);
                if (!menu) return;

                const isCurrentlyOpen = !menu.classList.contains("hidden");

                closeAll();

                if (!isCurrentlyOpen) {
                    menu.classList.remove("hidden");
                    newBtn.setAttribute("aria-expanded", "true");
                }
            });
        });

        mobileBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileMenu?.classList.toggle("hidden");
        });

        window.addEventListener("scroll", () => {
            if (topBar) {
                topBar.classList.toggle("hidden", window.scrollY > 50);
            }
            nav.classList.toggle("shadow-lg", window.scrollY > 50);
        });

        document.addEventListener("click", (e) => {
            if (!nav.contains(e.target)) {
                closeAll();
                mobileMenu?.classList.add("hidden");
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeAll();
                mobileMenu?.classList.add("hidden");
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initNavbar);
    document.addEventListener("astro:page-load", initNavbar);
</script>
