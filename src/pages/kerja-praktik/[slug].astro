---
import Layout from "@/layouts/Layout.astro";
import sanitizeHtml from "sanitize-html";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Calendar,
  User,
  Tag,
  ArrowLeft,
  Share2,
  Download,
  Briefcase,
  FileText,
  Clock,
  Sparkles
} from '@lucide/astro';

export const prerender = false;

import { API_URL, ASSET_URL, getAssetUrl } from '@/lib/cms.js';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const { slug } = Astro.params;

let article: any = null;
let related: any[] = [];
let fetchError = false;

try {
  const isId = /^\d+$/.test(slug || '');
  const filterParam = isId ? `filter[id][_eq]=${slug}` : `filter[slug][_eq]=${slug}`;

  const [res, relatedRes] = await Promise.all([
    fetch(`${API_URL}/items/kerja_praktik?${filterParam}`),
    fetch(`${API_URL}/items/kerja_praktik?limit=4&sort=-published_at`)
  ]);

  if (res.ok) {
    const json = await res.json();
    article = json.data?.[0];
  }

  if (relatedRes.ok) {
    const jsonRel = await relatedRes.json();
    related = (jsonRel.data || []).filter((item: any) => item.slug !== slug && String(item.id) !== slug);
  }
} catch (error) {
  console.error("Gagal mengambil detail Kerja Praktik:", error);
  fetchError = true;
}

// Fallback dummy article if not in Directus
if (!article) {
  article = {
    title: slug === 'prosedur-pendaftaran-kp-2026' 
      ? 'Prosedur Pendaftaran & Verifikasi Berkas Kerja Praktik Semester Ganjil 2026'
      : (isEn ? 'Internship Announcement Detail' : 'Pengumuman Kerja Praktik'),
    published_at: new Date().toISOString(),
    category: isEn ? 'Registration' : 'Pendaftaran',
    excerpt: isEn 
      ? 'Complete guidelines for registering Kerja Praktik for students who have completed a minimum of 90 SKS.'
      : 'Panduan lengkap alur pendaftaran dan pengajuan surat pengantar KP bagi mahasiswa yang telah menempuh minimal 90 SKS.',
    content: isEn ? `
      <h3>General Terms & Requirements</h3>
      <p>Students eligible for Kerja Praktik must meet the following criteria:</p>
      <ul>
        <li>Completed a minimum of 90 academic credit units (SKS).</li>
        <li>Registered active student status in the current semester.</li>
        <li>Approved internship proposal signed by academic advisor.</li>
      </ul>
      <h3>Registration Workflow</h3>
      <p>1. Submit company cover letter request via student iRaise portal.<br>2. Submit verified approval letter to the Department Coordinator.<br>3. Report to target company supervisor upon arrival.</p>
    ` : `
      <h3 class="text-xl font-bold text-slate-900 mt-4 mb-2">Persyaratan Umum Kerja Praktik</h3>
      <p class="text-slate-700 leading-relaxed mb-4">Mahasiswa yang mengajukan Kerja Praktik (KP) wajib memenuhi ketentuan akademik berikut:</p>
      <ul class="list-disc pl-5 text-slate-700 space-y-2 mb-6">
        <li>Telah menempuh dan lulus minimal <strong>90 SKS</strong> mata kuliah.</li>
        <li>Tercatat sebagai mahasiswa aktif pada semester berjalan.</li>
        <li>Memiliki proposal KP yang telah disetujui Dosen Pembimbing Akademik.</li>
      </ul>
      <h3 class="text-xl font-bold text-slate-900 mt-6 mb-2">Alur Pendaftaran & Pengajuan Surat Pengantar</h3>
      <p class="text-slate-700 leading-relaxed mb-4">Pengajuan surat pengantar ke instansi/perusahaan dilakukan secara daring melalui sistem integratif universitas (iRaise) dengan melampirkan draf proposal dan transkrip nilai terbaru.</p>
    `
  };
}

const formattedDate = article.published_at 
  ? new Date(article.published_at).toLocaleDateString(isEn ? 'en-US' : 'id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    })
  : '-';
---

<Layout title={article.title}>
  
  {/* Breadcrumb Navigation */}
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center hover:text-emerald-700 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/kerja-praktik/kerja-praktik', lang)} class="hover:text-emerald-700 transition-colors font-medium">
          {t("page.kp.title")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="text-emerald-700 font-bold tracking-tight truncate max-w-xs sm:max-w-md">
        {article.title}
      </li>
    </ol>
  </nav>

  <article class="max-w-5xl mx-auto px-4 sm:px-6 py-10 font-sans">
    
    {/* Back Button */}
    <a 
      href={localizePath('/kerja-praktik/kerja-praktik', lang)}
      class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 text-xs sm:text-sm font-bold rounded-xl transition-all mb-6 border border-slate-200"
    >
      <ArrowLeft class="w-4 h-4" />
      {isEn ? 'Back to KP Info' : 'Kembali ke Info KP'}
    </a>

    {/* Header & Meta */}
    <div class="mb-8">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-4">
        <Briefcase class="w-3.5 h-3.5" />
        {article.category || (isEn ? 'Internship Info' : 'Info Kerja Praktik')}
      </span>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
        {article.title}
      </h1>

      <div class="flex items-center flex-wrap gap-4 text-xs sm:text-sm text-slate-500 border-y border-slate-100 py-4">
        <div class="flex items-center gap-2">
          <Calendar class="w-4 h-4 text-emerald-600" />
          <span>{formattedDate}</span>
        </div>
        <span class="text-slate-300">•</span>
        <div class="flex items-center gap-2">
          <User class="w-4 h-4 text-emerald-600" />
          <span>{isEn ? 'Informatics Academic Office' : 'Prodi Teknik Informatika'}</span>
        </div>
      </div>
    </div>

    {/* Cover Image */}
    {article.thumbnail && (
      <div class="rounded-3xl overflow-hidden shadow-xl mb-10 max-h-[460px] bg-slate-100">
        <img 
          src={getAssetUrl(article.thumbnail)} 
          alt={article.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    {/* Main Article Content */}
    <div class="bg-white p-6 sm:p-10 rounded-3xl shadow-sm border border-slate-100 mb-12">
      {article.excerpt && (
        <p class="text-slate-700 text-lg font-medium leading-relaxed mb-6 italic border-l-4 border-emerald-500 pl-4 bg-emerald-50/50 py-3 rounded-r-xl">
          {article.excerpt}
        </p>
      )}

      <div 
        class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-emerald-700 text-slate-700 leading-relaxed"
        set:html={sanitizeHtml(String(article.content || article.fulltext || article.excerpt || ""))}
      />
    </div>

    {/* Related Announcements */}
    {related.length > 0 && (
      <div class="pt-10 border-t border-slate-200">
        <h3 class="text-2xl font-black text-slate-900 mb-6">
          {isEn ? 'Other Internship Announcements' : 'Pengumuman KP Lainnya'}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {related.map((item: any) => (
            <a 
              href={localizePath(`/kerja-praktik/${item.slug || item.id}`, lang)}
              class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-emerald-200 transition-all flex flex-col justify-between group"
            >
              <div>
                <span class="text-xs font-bold text-emerald-700 mb-1 block">
                  {item.category || 'Info KP'}
                </span>
                <h4 class="font-bold text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2 text-base">
                  {item.title}
                </h4>
              </div>
              <span class="text-xs font-semibold text-emerald-700 mt-4 block">
                {t("common.detail")} &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

  </article>

</Layout>
