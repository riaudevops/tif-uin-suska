---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="International Office">
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100">
      <h1 class="text-3xl font-black text-[#004d2c]">International Office</h1>
      <p class="text-slate-600 mt-4">International Office mendukung kerja sama internasional, pertukaran mahasiswa dan dosen, serta inisiasi proyek riset lintas-negara untuk memperluas jaringan dan pengalaman internasional bagi civitas akademika Teknik Informatika.</p>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-yellow-400 text-[#004d2c] font-bold rounded-lg hover:bg-yellow-300 transition">Kontak & Program</a>
      </div>
    </div>
  </section>
</Layout>
