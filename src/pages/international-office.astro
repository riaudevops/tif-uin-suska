---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl } from '../lib/translations';

const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<Layout title="International Office">
  <section data-aos="fade-up" class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100">
      <h1 data-aos="fade-up" class="text-3xl font-black text-[#004d2c]">International Office</h1>
      <p class="text-slate-600 mt-4">
        {isEn 
          ? "The International Office supports international collaborations, student and lecturer exchanges, and initiates cross-border research projects to expand international networks and experiences for the Informatics Engineering academic community."
          : "International Office mendukung kerja sama internasional, pertukaran mahasiswa dan dosen, serta inisiasi proyek riset lintas-negara untuk memperluas jaringan dan pengalaman internasional bagi civitas akademika Teknik Informatika."
        }
      </p>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-yellow-400 text-[#004d2c] font-bold rounded-lg hover:bg-yellow-300 transition">
          {isEn ? 'Contact & Programs' : 'Kontak & Program'}
        </a>
      </div>
    </div>
  </section>
</Layout>
