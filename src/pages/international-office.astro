---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '../lib/translations';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<Layout title="International Office">
  
  <section data-aos="fade-up" class="max-w-7xl mx-auto px-6 py-20">
    <nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
      <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
          <a href={localizePath("/", lang)} class="flex items-center hover:text-green-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            {t("bread.home")}
          </a>
        </li>
        <li class="text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
          International Office
        </li>
      </ol>
    </nav>

    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100 mt-6">
      <h1 data-aos="fade-up" class="text-3xl font-black text-[#004d2c]">International Office</h1>
      <p class="text-slate-600 mt-4">
        {isEn 
          ? "The International Office supports international collaborations, student and lecturer exchanges, and initiates cross-border research projects to expand international networks and experiences for the Informatics Engineering academic community."
          : "International Office mendukung kerja sama internasional, pertukaran mahasiswa dan dosen, serta inisiasi proyek riset lintas-negara untuk memperluas jaringan dan pengalaman internasional bagi civitas akademika Teknik Informatika."
        }
      </p>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-yellow-400 text-[#004d2c] font-bold rounded-lg hover:bg-yellow-300 transition">
          {isEn ? 'Contact & Programs' : 'Kontak & Program'}
        </a>
      </div>
    </div>
  </section>
</Layout>