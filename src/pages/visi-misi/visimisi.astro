---
import { translateInline } from "../../lib/translations.js";
import Layout from "@/layouts/Layout.astro";
import Visi from "../../components/pages/visimisi-pages/visi.astro";
import Misi from "../../components/pages/visimisi-pages/misi.astro";
import Tujuan from "../../components/pages/visimisi-pages/tujuan.astro";
