import Profesional from "../../components/pages/visimisi-pages/profesional.astro";
import { getLocaleFromUrl } from "@/lib/translations";

const isEn = getLocaleFromUrl(Astro) === "en";

---

<Layout title={translateInline((isEn) ? "en" : "id", "inline.scientific-vision-visi-misi-tujuan-dan-str")}>
  <Visi />
  <Misi />
  <Tujuan />
  <Strategi />
  <Profesional />
</Layout>