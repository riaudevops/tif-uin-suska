---
import { translateInline } from "../../lib/translations.js";
import Layout from "@/layouts/Layout.astro";
import Panduan from "../../components/pages/panduan-pages/panduan.astro";
import { getLocaleFromUrl } from "@/lib/translations.js";

const lang = getLocaleFromUrl(Astro);
const isEn = lang === "en";
---

<Layout title={translateInline((isEn) ? "en" : "id", "inline.education-management-guide")}>
  <Panduan />
</Layout>
