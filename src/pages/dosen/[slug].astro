---
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  GraduationCap,
  Mail,
  CreditCard,
  Building2,
  BookOpen,
  ExternalLink,
  ArrowLeft,
  Award,
  UserCheck,
  FileText,
  Sparkles,
  School,
  BookmarkCheck
} from '@lucide/astro';

import { API_URL, getAssetUrl } from '@/lib/cms.js';
import { DOSEN_FIELDS, normalizeDosen, sortDosenByPosition } from '@/lib/dosen.js';

export const prerender = false;

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const { slug } = Astro.params;

let dosen: any = null;
let otherDosen: any[] = [];
let fetchError = false;

try {
  const cleanSlug = String(slug || '').trim();
  const isId = /^\d+$/.test(cleanSlug);

  // Ambil seluruh data dosen tanpa filter ketat di awal agar fungsi pencarian di Astro yang menangani pencocokannya secara akurat
  const res = await fetch(`${API_URL}/items/dosen_tif?fields=${DOSEN_FIELDS}&limit=-1&sort=id`);

  if (res.ok) {
    const json = await res.json();
    const allDosenData = (Array.isArray(json.data) ? json.data : [])
      .map((item: any) => normalizeDosen(item, lang))
      .filter(Boolean);

    if (allDosenData.length > 0) {
      // Cari dosen berdasarkan ID, slug, atau nama yang di-slug-kan
      dosen = allDosenData.find((d: any) => {
        const dId = String(d.id);
        const dSlug = String(d.slug || '').trim();
        const dNamaSlug = d.nama ? d.nama.toLowerCase().replace(/[^a-z0-9]+/g, '-') : '';
        
        return dId === cleanSlug || dSlug === cleanSlug || dNamaSlug === cleanSlug.toLowerCase();
      });

     // 1. Urutkan seluruh dosen berdasarkan prioritas jabatan terlebih dahulu
      const sortedDosen = sortDosenByPosition(allDosenData);

      // 2. Filter agar dosen yang sedang dibuka tidak muncul di daftar "Dosen Lainnya", lalu ambil 4 teratas
      otherDosen = sortedDosen
        .filter((d: any) => String(d.id) !== String(dosen?.id))
        .slice(0, 4);
    }
  }
} catch (error) {
  console.error("Gagal mengambil detail dosen:", error);
  fetchError = true;
}

// Parse data pendidikan secara bersih
const parsePendidikan = (pendidikanData: any): string[] => {
  if (!pendidikanData) return [];
  if (Array.isArray(pendidikanData)) return pendidikanData.filter(Boolean);
  if (typeof pendidikanData === 'string') {
    return pendidikanData.split(/[\n,;]+/).map(s => s.trim()).filter(Boolean);
  }
  return [];
};

const pendidikanList = dosen ? parsePendidikan(dosen.pendidikan) : [];

// Mengambil data bidang keahlian langsung dari Directus
const keahlianList = dosen?.bidang_keahlian 
  ? (Array.isArray(dosen.bidang_keahlian) ? dosen.bidang_keahlian : String(dosen.bidang_keahlian).split(/[\n,;]+/))
  : [];
---

<Layout title={dosen?.nama ? `${dosen.nama} - ${isEn ? 'Lecturer Profile' : 'Profil Dosen'}` : (isEn ? 'Lecturer Profile' : 'Detail Dosen')}>
  
  {/* Breadcrumb Navigation */}
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center flex-wrap gap-2 text-sm text-slate-500 py-3 border-b border-slate-100">
      <li class="flex items-center">
        <a href={localizePath("/", lang)} class="flex items-center hover:text-emerald-700 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath("/profil/sejarah", lang)} class="hover:text-emerald-700 transition-colors">
          {t("bread.profil")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath("/dosen/dosen", lang)} class="hover:text-emerald-700 transition-colors font-medium">
          {t("bread.dosen")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="text-emerald-700 font-bold tracking-tight truncate max-w-xs sm:max-w-md">
        {dosen?.nama || (isEn ? 'Lecturer Profile' : 'Detail Dosen')}
      </li>
    </ol>
  </nav>

  {!dosen ? (
    <div class="max-w-4xl mx-auto px-4 py-20 text-center">
      <div class="w-20 h-20 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6">
        <UserCheck class="w-10 h-10" />
      </div>
      <h1 class="text-3xl font-black text-slate-900 mb-3">
        {isEn ? 'Lecturer Data Not Found' : 'Data Dosen Tidak Ditemukan'}
      </h1>
      <p class="text-slate-600 max-w-md mx-auto mb-8">
        {isEn 
          ? 'The lecturer profile you are looking for is unavailable or may have been moved.'
          : 'Profil dosen yang Anda cari tidak tersedia atau telah dipindahkan.'}
      </p>
      <a 
        href={localizePath("/dosen/dosen", lang)}
        class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-xl shadow-lg hover:shadow-emerald-900/20 transition-all duration-300"
      >
        <ArrowLeft class="w-4 h-4" />
        {isEn ? 'Back to Lecturers List' : 'Kembali ke Daftar Dosen'}
      </a>
    </div>
  ) : (
    <section class="pb-24 font-sans bg-slate-50/60 min-h-screen">
      
      {/* Cover / Header Banner */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] h-56 sm:h-72 p-6 sm:p-8 flex flex-col justify-between shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)]">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.04),_transparent_35%)]"></div>
          <div class="absolute inset-0 bg-[url('/landing-pages/gedung-faste.jpg')] bg-cover bg-center opacity-10 mix-blend-overlay"></div>
          
          <div class="relative z-10">
            <a 
              href={localizePath("/dosen/dosen", lang)}
              class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-semibold rounded-xl transition-all"
            >
              <ArrowLeft class="w-4 h-4" />
              {isEn ? 'Back to Lecturers' : 'Kembali ke Daftar Dosen'}
            </a>
          </div>

          <div class="relative z-10 flex items-center justify-between text-white/80 text-xs sm:text-sm">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#f1d880]/15 backdrop-blur-md border border-[#f1d880]/30 rounded-full text-[#f7e7b0] font-bold uppercase tracking-wider">
              <Sparkles class="w-3.5 h-3.5 text-[#f1d880]" />
              {isEn ? 'Informatics Academic Faculty' : 'Tenaga Pendidik Teknik Informatika'}
            </span>
            <span class="hidden sm:inline-block text-white/60">
              UIN Sultan Syarif Kasim Riau
            </span>
          </div>
        </div>
      </div>

      {/* Main Content Container */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 -mt-20 sm:-mt-24">
        
        {/* Profile Card Header */}
        <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-6 sm:p-8 md:p-10 transition-all duration-300">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
            
            <div class="relative group flex-shrink-0">
              <div class="w-36 h-48 sm:w-48 sm:h-64 rounded-2xl overflow-hidden bg-slate-100 shadow-xl border-4 border-white relative z-10 transition-transform duration-500 group-hover:scale-[1.02]">
                <img 
                  src={getAssetUrl(dosen.foto, '/images/default-avatar.jpg')} 
                  alt={dosen.nama}
                  class="w-full h-full object-cover"
                  onError="this.onerror=null; this.src='/images/default-avatar.jpg';"
                />
              </div>
              <div class="absolute -inset-2 bg-gradient-to-tr from-emerald-600 to-teal-400 rounded-3xl blur-lg opacity-25 group-hover:opacity-40 transition duration-500"></div>
            </div>

            <div class="flex-1 w-full text-center md:text-left flex flex-col justify-between">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#f4f0dd] text-[#4f5f2d] rounded-full text-xs font-bold mb-3 border border-[#e8dca0]">
                  <UserCheck class="w-3.5 h-3.5 text-[#b58d18]" />
                  {dosen.fakultas || (isEn ? 'Faculty of Science and Technology' : 'Fakultas Sains dan Teknologi')}
                </div>

                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight leading-snug">
                  {dosen.nama}
                </h1>

                <p class="text-[#3f5f3d] font-bold text-base sm:text-lg mt-1 flex items-center justify-center md:justify-start gap-2">
                  <Award class="w-5 h-5 text-[#b58d18] inline-block" />
                  {dosen.jabatan || (isEn ? 'Teaching Lecturer' : 'Dosen Pengajar')}
                </p>
              </div>

              {/* Contact & Links Quick Strip */}
              <div class="mt-6 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center md:justify-start gap-3">
                {dosen.email && (
                  <a 
                    href={`mailto:${dosen.email}`}
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0b5c3d] hover:bg-[#0a4d35] text-white font-bold text-xs sm:text-sm rounded-xl shadow-md hover:shadow-[#0a4d35]/25 transition-all duration-300"
                  >
                    <Mail class="w-4 h-4" />
                    {isEn ? 'Send Email' : 'Kirim Email'}
                  </a>
                )}

                {dosen.google_scholar && (
                  <a 
                    href={dosen.google_scholar} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#edf4e8] hover:bg-[#e2f0d9] text-[#274d39] border border-[#cfe2c6] font-bold text-xs sm:text-sm rounded-xl transition-colors"
                  >
                    <BookOpen class="w-4 h-4 text-[#0b5c3d]" />
                    Google Scholar
                    <ExternalLink class="w-3.5 h-3.5 opacity-70" />
                  </a>
                )}

                {dosen.sinta && (
                  <a 
                    href={dosen.sinta} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#f4f0dd] hover:bg-[#efe4b5] text-[#5a4c18] border border-[#e8dca0] font-bold text-xs sm:text-sm rounded-xl transition-colors"
                  >
                    <BookmarkCheck class="w-4 h-4 text-[#5a4c18]" />
                    Sinta Profile
                    <ExternalLink class="w-3.5 h-3.5 opacity-70" />
                  </a>
                )}
              </div>

            </div>

          </div>
        </div>

        {/* Detailed Grid Section */}
        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[340px_minmax(0,1fr)]">
          <div class="space-y-8">
            <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4 text-lg font-black text-slate-900 sm:text-xl">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#edf4e8] text-[#0b5c3d]">
                  <CreditCard class="h-5 w-5" />
                </span>
                {isEn ? 'Academic Information' : 'Informasi Akademik'}
              </h3>

              <div class="space-y-4">
                <div>
                  <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">NIP</span>
                  <p class="rounded-2xl border border-slate-100 bg-slate-50 px-3 py-2 font-mono text-sm font-bold text-slate-800">
                    {dosen.nip || '-'}
                  </p>
                </div>

                {dosen.nidn && (
                  <div>
                    <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">NIDN</span>
                    <p class="rounded-2xl border border-slate-100 bg-slate-50 px-3 py-2 font-mono text-sm font-bold text-slate-800">
                      {dosen.nidn}
                    </p>
                  </div>
                )}

                <div>
                  <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Email Resmi</span>
                  <a
                    href={dosen.email ? `mailto:${dosen.email}` : '#'}
                    class="flex items-center gap-2 break-all text-sm font-semibold text-[#0b5c3d] hover:underline"
                  >
                    <Mail class="h-4 w-4 shrink-0" />
                    {dosen.email || '-'}
                  </a>
                </div>

                <div>
                  <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Program Studi</span>
                  <p class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                    <School class="h-4 w-4 shrink-0 text-[#0b5c3d]" />
                    Teknik Informatika (S1)
                  </p>
                </div>

                <div>
                  <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Fakultas / Instansi</span>
                  <p class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                    <Building2 class="h-4 w-4 shrink-0 text-[#0b5c3d]" />
                    {dosen.fakultas || 'Fakultas Sains dan Teknologi'}
                  </p>
                </div>
              </div>
            </div>

            <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4 text-lg font-black text-slate-900 sm:text-xl">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#edf4e8] text-[#0b5c3d]">
                  <BookOpen class="h-5 w-5" />
                </span>
                {isEn ? 'Publications & Portals' : 'Publikasi & Portal Riset'}
              </h3>

              <div class="space-y-3">
                <a
                  href={dosen.google_scholar || '#'}
                  target={dosen.google_scholar ? "_blank" : "_self"}
                  rel="noopener noreferrer"
                  class={`flex items-center justify-between rounded-2xl border p-4 transition-all ${
                    dosen.google_scholar
                      ? 'border-[#d3e5c8] bg-[#edf4e8] text-[#1f4b3a] hover:bg-[#e2f0d9]'
                      : 'cursor-not-allowed border-slate-100 bg-slate-50 text-slate-400'
                  }`}
                >
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🎓</span>
                    <div>
                      <p class="text-sm font-bold">Google Scholar</p>
                      <p class="text-xs font-normal text-slate-500">
                        {dosen.google_scholar ? (isEn ? 'View articles & citations' : 'Lihat sitasi & artikel') : (isEn ? 'Not linked' : 'Belum ditautkan')}
                      </p>
                    </div>
                  </div>
                  {dosen.google_scholar && <ExternalLink class="h-4 w-4 text-[#0b5c3d]" />}
                </a>

                <a
                  href={dosen.sinta || '#'}
                  target={dosen.sinta ? "_blank" : "_self"}
                  rel="noopener noreferrer"
                  class={`flex items-center justify-between rounded-2xl border p-4 transition-all ${
                    dosen.sinta
                      ? 'border-[#e8dca0] bg-[#f4f0dd] text-[#4d4218] hover:bg-[#efe4b5]'
                      : 'cursor-not-allowed border-slate-100 bg-slate-50 text-slate-400'
                  }`}
                >
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🪪</span>
                    <div>
                      <p class="text-sm font-bold">Sinta Kemdikbud</p>
                      <p class="text-xs font-normal text-slate-500">
                        {dosen.sinta ? (isEn ? 'View Sinta metrics' : 'Lihat skor & portofolio') : (isEn ? 'Not linked' : 'Belum ditautkan')}
                      </p>
                    </div>
                  </div>
                  {dosen.sinta && <ExternalLink class="h-4 w-4 text-[#5a4c18]" />}
                </a>
              </div>
            </div>
          </div>

          <div class="space-y-8">
            <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4 text-xl font-black text-slate-900">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#edf4e8] text-[#0b5c3d]">
                  <GraduationCap class="h-5 w-5" />
                </span>
                {isEn ? 'Educational Background' : 'Riwayat Pendidikan'}
              </h3>

              {pendidikanList.length > 0 ? (
                <div class="relative space-y-4 pl-6 before:absolute before:left-2 before:top-1 before:bottom-1 before:w-0.5 before:bg-[#dfe8d2]">
                  {pendidikanList.map((item, idx) => (
                    <div class="relative">
                      <span class="absolute -left-[26px] top-1.5 h-4 w-4 rounded-full border-4 border-white bg-[#0b5c3d] shadow-sm"></span>
                      <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 transition-colors hover:bg-[#edf4e8]">
                        <span class="mb-2 inline-block rounded-md bg-[#edf4e8] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">
                          {isEn ? 'Education' : 'Pendidikan'} #{idx + 1}
                        </span>
                        <p class="text-base font-bold text-slate-800">{item}</p>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-center text-sm text-slate-500">
                  {isEn ? 'Educational background data is not specified.' : 'Informasi riwayat pendidikan belum tersedia.'}
                </div>
              )}
            </div>

            <div class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4 text-xl font-black text-slate-900">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#f4f0dd] text-[#5a4c18]">
                  <FileText class="h-5 w-5" />
                </span>
                {isEn ? 'Research Interests & Expertise' : 'Bidang Keahlian & Riset'}
              </h3>

              {keahlianList.length > 0 ? (
                <div class="flex flex-wrap gap-2.5">
                  {keahlianList.map((item: string) => (
                    <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-[#d3e5c8] hover:bg-[#edf4e8] hover:text-[#0b5c3d]">
                      <Sparkles class="h-3.5 w-3.5 text-[#b58d18]" />
                      {item}
                    </span>
                  ))}
                </div>
              ) : (
                <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-sm italic text-slate-400">
                  {isEn ? 'No expertise tags provided.' : 'Belum ada bidang keahlian yang ditambahkan.'}
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Other Lecturers Section */}
        {otherDosen.length > 0 && (
          <div class="mt-16 pt-12 border-t border-slate-200">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8 gap-4">
              <div>
                <h3 class="text-2xl font-black text-slate-900">
                  {isEn ? 'Other Faculty Members' : 'Dosen Pengajar Lainnya'}
                </h3>
                <p class="text-slate-500 text-sm mt-1">
                  {isEn ? 'Explore other academic educators in Informatics Engineering.' : 'Mengenal lebih dekat para dosen Program Studi Teknik Informatika.'}
                </p>
              </div>

              <a 
                href={localizePath("/dosen/dosen", lang)}
                class="inline-flex items-center gap-2 text-[#0b5c3d] hover:text-[#0a4d35] font-bold text-sm hover:underline"
              >
                {isEn ? 'View All Lecturers' : 'Lihat Semua Dosen'} &rarr;
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {otherDosen.map((item: any) => (
                <a 
                  href={localizePath(`/dosen/${item.slug || item.id}`, lang)}
                  class="group bg-white rounded-2xl p-5 border border-slate-200 shadow-sm hover:shadow-xl hover:border-[#d3e5c8] transition-all duration-300 flex flex-col justify-between"
                >
                  <div>
                    <div class="w-full aspect-[3/4] rounded-xl overflow-hidden bg-slate-100 mb-4 relative">
                      <img 
                        src={getAssetUrl(item.foto, '/images/default-avatar.jpg')} 
                        alt={item.nama}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        onError="this.onerror=null; this.src='/images/default-avatar.jpg';"
                      />
                    </div>

                    <h4 class="font-bold text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2 text-base">
                      {item.nama}
                    </h4>

                    <p class="text-xs font-semibold text-slate-500 mt-1 line-clamp-1">
                      {item.jabatan || 'Dosen Pengajar'}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-[#0b5c3d] font-bold">
                    <span>{isEn ? 'View Profile' : 'Lihat Detail'}</span>
                    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </section>
  )}

</Layout>