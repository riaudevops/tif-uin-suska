---
export const prerender = true; 

type DosenPagePath = {
  params: { slug: string };
  props: { dosen: any };
};

const API_URL = import.meta.env.BASE_API_URL || "http://localhost:8055";

export async function getStaticPaths(): Promise<DosenPagePath[]> {
  

  try {
    const response = await fetch(`${API_URL}/items/dosen`);

    if (!response.ok) {
      throw new Error(`Gagal mengambil dosen (status: ${response.status})`);
    }

    const { data } = await response.json();

    return (data || []).map((dosen: any) => ({
      params: { slug: dosen.slug },
      props: { dosen },
    }));
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    console.warn("Gagal generate halaman dosen:", message);
    return [];
  }
}

const dosen = (Astro.props?.dosen ?? {}) as any;
const ASSET_URL = `${API_URL}/assets/`;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{dosen.nama} | Teknik Informatika</title>
  <link rel="stylesheet" href="/src/styles/global.css"> 
</head>
<body class="bg-slate-50 min-h-screen">

  <section class="pb-20 font-sans">
    <div class="w-full h-72 relative overflow-hidden">
      <img 
        src="/landing-pages/gedung-faste.jpg" 
        alt="Fakultas Sains dan Teknologi" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-emerald-950/60 mix-blend-multiply"></div>
    </div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 -mt-24">
      
      <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8 md:p-12 flex flex-col md:flex-row items-center md:items-start gap-8">
        
        <div class="w-40 h-40 md:w-56 md:h-56 rounded-2xl shadow-2xl overflow-hidden bg-slate-200 flex-shrink-0 -mt-24 md:-mt-32 border-4 border-white">
          <img 
            src={dosen?.foto ? `${ASSET_URL}${dosen.foto}` : '/aidil.png'} 
            alt={dosen?.nama}
            class="w-full h-full object-cover"
          />
        </div>

        <div class="flex-1 w-full text-center md:text-left">
          <h1 class="text-4xl font-black text-slate-900">{dosen.nama}</h1>
          <p class="text-emerald-700 font-bold text-lg mt-1">{dosen.jabatan || 'Dosen Pengajar'}</p>
          
          <div class="mt-6 p-4 bg-emerald-50 rounded-xl">
            <p class="font-bold text-emerald-800 text-sm mb-2">Pendidikan:</p>
            <div class="text-slate-600 text-base" set:html={dosen.pendidikan?.replace(/\n/g, '<br/>') || '-'}></div>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mt-12">
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
          <h3 class="font-black text-slate-800 text-xl mb-6">Informasi Akademik</h3>
          <div class="space-y-6">
             <div>
               <span class="block text-xs font-bold text-slate-400 uppercase tracking-widest">NIP</span>
               <p class="text-slate-800 font-semibold">{dosen.nip || '-'}</p>
             </div>
             <div>
               <span class="block text-xs font-bold text-slate-400 uppercase tracking-widest">Email</span>
               <p class="text-slate-800 font-semibold">{dosen.email || '-'}</p>
             </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
          <h3 class="font-black text-slate-800 text-xl mb-6">Publikasi & Profil</h3>
          <div class="space-y-4">
            <a href={dosen.link_scholar || '#'} target="_blank" class="block p-4 rounded-xl bg-slate-50 hover:bg-emerald-50 transition border border-slate-100 text-slate-700 font-bold text-sm">
               🎓 Google Scholar
            </a>
            <a href={dosen.link_sinta || '#'} target="_blank" class="block p-4 rounded-xl bg-slate-50 hover:bg-emerald-50 transition border border-slate-100 text-slate-700 font-bold text-sm">
               🪪 Sinta ID
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</body>
</html>