import Dosen from "../../components/pages/dosen-pages/dosen.astro";
import Isi from "../../components/pages/dosen-pages/isi.astro";
import { getLocaleFromUrl } from "@/lib/translations";

const isEn = getLocaleFromUrl(Astro) === "en";
---

