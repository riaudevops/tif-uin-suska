---
import { translateInline } from "@/lib/translations.js";
import Layout from "@/layouts/Layout.astro";
import { sanitizeArticleHtml } from "@/lib/sanitize.js";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import {
  Calendar,
  User,
  Tag,
  ArrowLeft,
  Share2,
  Award,
  FileText,
  Clock,
  Sparkles,
  ExternalLink,
  CheckCircle2
} from '@lucide/astro';

export const prerender = false;

import { getImageUrl } from '@/lib/cms.js';
import { getCollection, isAccessError, isTransportError } from '@/lib/directus.js';
import ContentState from '@/components/globals/ContentState.astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const { slug } = Astro.params;
const cleanSlug = String(slug ?? "").trim();

let article: any = null;
let related: any[] = [];
let loadState: "ok" | "not-found" | "unavailable" = "not-found";

const isNumericId = /^\d+$/.test(cleanSlug);
const identifierFilter = isNumericId
  ? `&filter[id][_eq]=${encodeURIComponent(cleanSlug)}`
  : `&filter[slug][_eq]=${encodeURIComponent(cleanSlug)}`;

const detailResult = await getCollection("beasiswa", {
  query: `?limit=1${identifierFilter}`,
  ttlMs: 60000,
});

if (!detailResult.ok) {
  // Distinguish "we cannot read the collection" from "the entry does not exist"
  // so the page never renders invented content with a 200 status.
  loadState =
    isAccessError(detailResult) || isTransportError(detailResult)
      ? "unavailable"
      : "not-found";
} else if (detailResult.data.length > 0) {
  article = detailResult.data[0];
  loadState = "ok";

  const relatedResult = await getCollection("beasiswa", {
    query: "?limit=4&sort=-published_at",
    ttlMs: 60000,
  });

  if (relatedResult.ok) {
    related = relatedResult.data.filter(
      (item: any) => item?.slug !== cleanSlug && String(item?.id) !== cleanSlug,
    );
  }
}

if (loadState === "not-found") {
  Astro.response.status = 404;
} else if (loadState === "unavailable") {
  Astro.response.status = 503;
  Astro.response.statusText = "Service Unavailable";
  Astro.response.headers.set("Retry-After", "300");
}

const pageTitle = article?.title || t("inline.scholarship-program");
const listHref = localizePath("/academics/scholarships", lang);
const backLabel = translateInline(isEn ? "en" : "id", "inline.back-to-scholarships");

const stateTitle =
  loadState === "unavailable"
    ? isEn
      ? "This information is temporarily unavailable"
      : "Informasi ini sedang tidak dapat ditampilkan"
    : isEn
      ? "Announcement not found"
      : "Pengumuman tidak ditemukan";

const stateDescription =
  loadState === "unavailable"
    ? isEn
      ? "We could not load this page from the content system. Please try again later or contact the department for the latest information."
      : "Halaman ini gagal dimuat dari sistem konten. Silakan coba beberapa saat lagi atau hubungi program studi untuk informasi terbaru."
    : isEn
      ? "The announcement you are looking for does not exist or may have been moved."
      : "Pengumuman yang Anda cari tidak tersedia atau mungkin sudah dipindahkan.";

const formattedDate = article?.published_at
  ? new Date(article.published_at).toLocaleDateString(isEn ? 'en-US' : 'id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    })
  : '-';
---

<Layout title={pageTitle}>
  {loadState === "ok" ? (
    <>


  {/* Breadcrumb Navigation */}
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center hover:text-teal-700 transition-colors">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/academics/scholarships', lang)} class="hover:text-teal-700 transition-colors font-medium">
          {t("page.beasiswa.title")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="text-teal-700 font-bold tracking-tight truncate max-w-xs sm:max-w-md">
        {article.title}
      </li>
    </ol>
  </nav>

  <article class="max-w-5xl mx-auto px-4 sm:px-6 py-10 font-sans">

    {/* Back Button */}
    <a
      href={localizePath('/academics/scholarships', lang)}
      class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-teal-50 text-slate-700 hover:text-teal-800 text-xs sm:text-sm font-bold rounded-xl transition-all mb-6 border border-slate-200"
    >
      <ArrowLeft class="w-4 h-4" />
      {translateInline((isEn) ? "en" : "id", "inline.back-to-scholarships")}
    </a>

    {/* Header & Meta */}
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-teal-100 text-teal-800 text-xs font-bold rounded-full">
          <Award class="w-3.5 h-3.5" />
          {article.category || (translateInline((isEn) ? "en" : "id", "inline.scholarship-program"))}
        </span>

        {article.deadline && (
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-full border border-amber-200">
            <Clock class="w-3.5 h-3.5" />
            Deadline: {article.deadline}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
        {article.title}
      </h1>

      <div class="flex items-center flex-wrap gap-4 text-xs sm:text-sm text-slate-500 border-y border-slate-100 py-4">
        <div class="flex items-center gap-2">
          <Calendar class="w-4 h-4 text-teal-600" />
          <span>{formattedDate}</span>
        </div>
        <span class="text-slate-300">•</span>
        <div class="flex items-center gap-2">
          <User class="w-4 h-4 text-teal-600" />
          <span>{translateInline((isEn) ? "en" : "id", "inline.academic-and-student-affairs")}</span>
        </div>
      </div>
    </div>

    {/* Cover Image */}
    {article.thumbnail && (
      <div class="rounded-3xl overflow-hidden shadow-xl mb-10 max-h-[460px] bg-slate-100">
        <img decoding="async" loading="lazy"
          src={getImageUrl(article.thumbnail, { width: 1200 })}
          alt={article.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    {/* Main Article Content */}
    <div class="bg-white p-6 sm:p-10 rounded-3xl shadow-sm border border-slate-100 mb-12">
      {article.excerpt && (
        <p class="text-slate-700 text-lg font-medium leading-relaxed mb-6 italic border-l-4 border-teal-500 pl-4 bg-teal-50/50 py-3 rounded-r-xl">
          {article.excerpt}
        </p>
      )}

      <div
        class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-teal-700 text-slate-700 leading-relaxed"
        set:html={sanitizeArticleHtml(String(article.content || article.fulltext || article.excerpt || ""))}
      />

      {/* External Registration Action Card */}
      <div class="mt-10 p-6 bg-slate-900 text-white rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="font-bold text-base">{translateInline((isEn) ? "en" : "id", "inline.ready-to-apply")}</h4>
          <p class="text-xs text-slate-300 mt-1">{translateInline((isEn) ? "en" : "id", "inline.prepare-your-documents-and-click-the-portal-link")}</p>
        </div>
        <a
          href="https://iraisenew.uin-suska.ac.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-3 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs rounded-xl transition-colors inline-flex items-center gap-2 flex-shrink-0"
        >
          {translateInline((isEn) ? "en" : "id", "inline.open-application-portal")}
          <ExternalLink class="w-4 h-4" />
        </a>
      </div>
    </div>

    {/* Related Announcements */}
    {related.length > 0 && (
      <div class="pt-10 border-t border-slate-200">
        <h3 class="text-2xl font-black text-slate-900 mb-6">
          {translateInline((isEn) ? "en" : "id", "inline.other-scholarship-programs")}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {related.map((item: any) => (
            <a
              href={localizePath(`/academics/scholarships/${item.slug || item.id}`, lang)}
              class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-teal-200 transition-all flex flex-col justify-between group"
            >
              <div>
                <span class="text-xs font-bold text-teal-700 mb-1 block">
                  {item.category || 'Beasiswa'}
                </span>
                <h4 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors line-clamp-2 text-base">
                  {item.title}
                </h4>
              </div>
              <span class="text-xs font-semibold text-teal-700 mt-4 block">
                {t("common.detail")} &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

  </article>


    </>
  ) : (
    <ContentState
      variant={loadState === "unavailable" ? "unavailable" : "not-found"}
      title={stateTitle}
      description={stateDescription}
      backHref={listHref}
      backLabel={backLabel}
    />
  )}
</Layout>
