---
import Layout from "@/layouts/Layout.astro";

const res = await fetch("http://localhost:8055/items/article?fields=title,slug,thumbnail,publish");
const { data: posts } = await res.json();

const ASSET_URL = "http://localhost:8055/assets/";
---

<Layout title="Berita | Teknik Informatika UIN Suska">
  <section class="py-16 bg-slate-50 min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="mb-12 border-l-8 border-[#004d2c] pl-6">
        <h1 class="text-4xl font-black text-slate-800 uppercase tracking-tight">
          Warta <span class="text-[#004d2c]">Informatika</span>
        </h1>
        <p class="text-slate-500 mt-2 font-medium">Informasi terbaru seputar kegiatan dan prestasi akademik.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {posts.map(post => (
          <a href={`/berita/${post.slug}`} class="group bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-2xl hover:border-yellow-400 transition-all duration-300 flex flex-col">
            
            <div class="relative overflow-hidden">
              <img 
                src={`${ASSET_URL}${post.thumbnail}`} 
                alt={post.title}
                class="h-56 w-full object-cover transform group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4">
                <span class="bg-[#004d2c] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-lg">
                  News
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center gap-2 mb-3">
                <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">
                  {new Date(post.publish).toLocaleDateString("id-ID", { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
              </div>

              <h2 class="font-extrabold text-xl text-slate-800 leading-snug group-hover:text-[#004d2c] transition-colors line-clamp-2">
                {post.title}
              </h2>

              <div class="mt-auto pt-6 flex items-center text-sm font-bold text-[#004d2c] group-hover:text-yellow-600">
                Baca Selengkapnya
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>