---
import { translateInline } from "@/lib/translations.js";
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
import { fetchWithCache } from '@/lib/cachedFetch.js';
import { marked } from 'marked';
import { sanitizeArticleHtml } from '@/lib/sanitize.js';
import {
  ArrowLeft,
  Calendar,
  Clock3,
  Newspaper,
  User
} from '@lucide/astro';

import { API_BASE_URL, getImageUrl } from '@/lib/cms.js';
import { BERITA_DETAIL_FIELDS, normalizeBerita, normalizeBeritaList, getBeritaSlugMap } from '@/lib/berita.js';
import ContentState from '@/components/globals/ContentState.astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

export const prerender = false;

const { slug } = Astro.params;

const API_TOKEN = import.meta.env.DIRECTUS_TOKEN;
const fetchOptions = {
  headers: {
    "Content-Type": "application/json",
    ...(API_TOKEN ? { Authorization: `Bearer ${API_TOKEN}` } : {})
  }
};

let article: any = null;
let related: any[] = [];
let parsedBody = "";
let loadState: "ok" | "not-found" | "unavailable" = "ok";

function normalizeBuilderMarkdown(content: string) {
  return content
    .replace(
      /(!\[[^\]]*\]\()([^)]+)(\))/g,
      (_match, prefix: string, destination: string, suffix: string) =>
        `${prefix}${destination.replace(/\.\s+(?=(?:jpe?g|png|gif|webp|avif|svg)(?:[?#]|$))/i, '.')}${suffix}`
    )
    .replace(/(^|\n)[ \t]*#{1,6}[ \t]+(?=\[!\[)/g, '$1')
    .replace(/(\[!\[[^\]]*\]\([^)]+\)\]\([^)]+\))/g, '\n\n$1\n\n');
}

try {
  const cleanSlug = String(slug ?? '').trim();
  const isId = /^\d+$/.test(cleanSlug);
  const filterParam = isId
    ? `filter[id][_eq]=${encodeURIComponent(cleanSlug)}`
    : `filter[translations][slug_translate][_eq]=${encodeURIComponent(cleanSlug)}`;

  const json = await fetchWithCache(
    `${API_BASE_URL}/berita?${filterParam}` +
      `&fields=${BERITA_DETAIL_FIELDS}` +
      `&filter[status][_in]=publish,Publish,published,Published` +
      `&sort=-date,-modified`,
    fetchOptions,
    60000
  );

  const matches = Array.isArray(json?.data) ? json.data : [];
  if (matches.length > 1) {
    // Directus contains rows sharing a translated slug; picking deterministically
    // keeps the canonical URL and the sitemap entry in sync.
    console.warn(
      `[news] ${matches.length} entries share the slug "${cleanSlug}"; using the newest (id ${matches[0]?.id}).`,
    );
  }

  const rawArticle = matches[0] || null;
  if (rawArticle) {
    article = normalizeBerita(rawArticle, lang);

    if (article?.body) {
      parsedBody = await marked.parse(normalizeBuilderMarkdown(article.body), {
        breaks: true,
      });
      parsedBody = parsedBody.replace(
        /<h([1-6])>\s*(<a\b[^>]*>\s*<img decoding="async" loading="lazy"\b[^>]*>\s*<\/a>|<img decoding="async" loading="lazy"\b[^>]*>)\s*<\/h\1>/gi,
        '<figure>$2</figure>'
      );
      parsedBody = parsedBody.replace(
        /<p>\s*(<a\b[^>]*>\s*<img decoding="async" loading="lazy"\b[^>]*>\s*<\/a>|<img decoding="async" loading="lazy"\b[^>]*>)\s*<\/p>/gi,
        '<figure>$1</figure>'
      );
    }

    const relatedParams = new URLSearchParams({
      fields: BERITA_DETAIL_FIELDS,
      sort: '-date,-modified',
      limit: '3',
      'filter[status][_in]': 'publish,Publish,published,Published',
      'filter[id][_neq]': String(article.id),
    });

    const relatedJson = await fetchWithCache(
      `${API_BASE_URL}/berita?${relatedParams.toString()}`,
      fetchOptions,
      60000
    );

    related = normalizeBeritaList(relatedJson?.data || [], lang);
  }
} catch (error) {
  const status = Number((error as any)?.status ?? 0);

  // Forbidden / server / network problems are not "not found".
  if (status === 0 || status === 401 || status === 403 || status >= 500) {
    loadState = "unavailable";
  }

  console.warn("Gagal mengambil detail berita:", error instanceof Error ? error.message : String(error));
}

if (!article) {
  if (loadState === "unavailable") {
    Astro.response.status = 503;
    Astro.response.statusText = "Service Unavailable";
    Astro.response.headers.set("Retry-After", "300");
  } else {
    Astro.response.status = 404;
  }
}

const slugMap = getBeritaSlugMap(article);
const localeSlugs = slugMap.id && slugMap.en
  ? {
      en: `/news/${slugMap.en}`,
      id: `/news/${slugMap.id}`,
    }
  : undefined;
const canonicalTarget = localeSlugs
  ? (lang === "id" ? localeSlugs.id : localeSlugs.en)
  : `/news/${article?.slug || article?.id || String(slug ?? '')}`;

const formattedDate = article?.date
  ? new Date(article.date).toLocaleDateString(lang === 'en' ? "en-US" : "id-ID", {
      day: "numeric",
      month: "long",
      year: "numeric"
    })
  : '-';

const pageTitle = article?.title || t("nav.berita");
const plainText = (value: unknown) =>
  typeof value === "string" ? value.replace(/<[^>]*>/g, "").trim() : "";
const pageDescription = article
  ? (plainText(article.excerpt) || plainText(article.content).slice(0, 160) || undefined)
  : undefined;
const pageImage = article
  ? getImageUrl(article.featured_image || article.image, { width: 1200 })
  : undefined;
const articleData = article
  ? {
      headline: article.title,
      description: pageDescription,
      image: pageImage,
      datePublished: article.date,
      dateModified: article.modified || article.date,
      author: "Program Studi Teknik Informatika UIN Suska Riau",
    }
  : undefined;

---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
  canonicalPath={canonicalTarget}
  alternatePaths={localeSlugs}
  noindex={!article}
>

  {article ? (
    <>
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center gap-1.5 transition-colors duration-200 hover:text-[#0b5c3d]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t("bread.home")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li>
        <a href={localizePath('/news', lang)} class="font-medium transition-colors duration-200 hover:text-[#0b5c3d]">
          {t("nav.berita")}
        </a>
      </li>
      <li class="text-slate-300">/</li>
      <li class="max-w-xs truncate font-bold tracking-tight text-[#0b5c3d] sm:max-w-md">
        {article.title}
      </li>
    </ol>
  </nav>

  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <a
      href={localizePath('/news', lang)}
      class="mb-6 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-bold text-slate-700 transition-all duration-200 hover:border-[#cfe4d6] hover:bg-[#edf8f1] hover:text-[#0b5c3d] sm:text-sm"
    >
      <ArrowLeft class="h-4 w-4" />
      {translateInline((isEn) ? "en" : "id", "inline.back-to-news")}
    </a>

    <div class="mb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#edf8f1] px-3.5 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0b5c3d]">
          <Newspaper class="h-3.5 w-3.5" />
          {t("nav.berita")}
        </span>
      </div>

      <h1 class="mb-6 text-3xl font-black leading-tight tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        {article.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 border-y border-slate-200 py-4 text-xs text-slate-500 sm:text-sm">
        <div class="flex items-center gap-2">
          <Calendar class="h-4 w-4 text-[#0b5c3d]" />
          <span>{formattedDate}</span>
        </div>
        <span class="text-slate-300">•</span>
        <div class="flex items-center gap-2">
          <User class="h-4 w-4 text-[#0b5c3d]" />
          <span>{translateInline((isEn) ? "en" : "id", "inline.academic-information-unit")}</span>
        </div>
      </div>
    </div>

    {article.image && (
      <figure class="mb-8 overflow-hidden rounded-[28px] border border-slate-200 bg-slate-100 shadow-sm">
        <img
          src={getImageUrl(article.image, { width: 1200 }, '/landing-pages/gedung.webp')}
          alt={article.title}
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-fallback-src="/landing-pages/gedung.webp"
          class="h-auto w-full object-cover"
        />
      </figure>
    )}

    <div class="mb-12 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
      {article.excerpt && (
        <p class="mb-6 rounded-r-2xl border-l-4 border-[#d4a537] bg-[#f9f6ed] py-3 pl-4 text-base font-medium leading-relaxed text-slate-700 italic sm:text-lg">
          {article.excerpt}
        </p>
      )}

      <div
        class="prose prose-lg max-w-none prose-headings:font-black prose-headings:text-slate-900 prose-a:text-[#0b5c3d] prose-strong:text-slate-900 prose-li:text-slate-700 prose-figure:mx-0 prose-figure:my-6 prose-img:mx-auto prose-img:h-auto prose-img:max-w-full prose-img:rounded-xl text-slate-700 leading-relaxed"
        set:html={sanitizeArticleHtml(parsedBody || article.excerpt || "")}
      />
    </div>

    {related.length > 0 && (
      <div class="border-t border-slate-200 pt-10">
        <div class="mb-6 flex items-center gap-2 text-slate-900">
          <Clock3 class="h-5 w-5 text-[#0b5c3d]" />
          <h3 class="text-2xl font-black tracking-tight">
            {translateInline((isEn) ? "en" : "id", "inline.latest-news")}
          </h3>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <a
              href={localizePath(`/news/${item.slug || item.id}`, lang)}
              class="group flex h-full flex-col rounded-[24px] border border-slate-200 bg-white p-4 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-[#d9e8de] hover:shadow-[0_18px_45px_-35px_rgba(11,92,61,0.38)]"
            >
              <div class="mb-4 overflow-hidden rounded-2xl bg-slate-100">
                {/*
                  Always render the <img>: `getImageUrl()` already swaps a
                  missing/`default` value for the fallback. Guarding the whole
                  element on the CMS field made cards without a thumbnail
                  render an empty grey box with no placeholder at all.
                */}
                <img
                  src={getImageUrl(item.image || item.featured_image || item.images, { width: 480 }, '/landing-pages/gedung.webp')}
                  alt={item.title}
                  width="400"
                  height="160"
                  loading="lazy"
                  decoding="async"
                  data-fallback-src="/landing-pages/gedung.webp"
                  class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              </div>

              <span class="mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#8a6a1d]">
                {item.category || (translateInline((isEn) ? "en" : "id", "inline.news"))}
              </span>
              <h4 class="line-clamp-2 text-base font-bold leading-snug text-slate-900 group-hover:text-[#0b5c3d]">
                {item.title}
              </h4>
              <span class="mt-4 inline-flex items-center text-xs font-semibold text-[#0b5c3d]">
                {translateInline((isEn) ? "en" : "id", "inline.read-article")} &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

    </>
  ) : (
    <ContentState
      variant={loadState === "unavailable" ? "unavailable" : "not-found"}
      title={loadState === "unavailable"
        ? (isEn ? "News is temporarily unavailable" : "Berita sedang tidak dapat ditampilkan")
        : (isEn ? "Article not found" : "Berita tidak ditemukan")}
      description={loadState === "unavailable"
        ? (isEn
            ? "We could not load this article from the content system. Please try again later."
            : "Artikel ini gagal dimuat dari sistem konten. Silakan coba beberapa saat lagi.")
        : (isEn
            ? "The article you are looking for does not exist or may have been removed."
            : "Berita yang Anda cari tidak tersedia atau sudah dihapus.")}
      backHref={localizePath("/news", lang)}
      backLabel={translateInline(isEn ? "en" : "id", "inline.back-to-news")}
    />
  )}
</Layout>
