---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '../lib/translations';
import {
  Handshake,
  Building2,
  GraduationCap,
  Briefcase,
  FlaskConical,
  HeartHandshake,
  ArrowRight,
  Award,
} from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const collaborationAreas = isEn
  ? [
      {
        title: 'Curriculum & Learning',
        desc: 'Industry input and practitioner involvement to keep learning materials relevant to workplace needs.',
        icon: GraduationCap,
        badge: 'Academic',
      },
      {
        title: 'Internship Placement',
        desc: 'Internship placement opportunities with institutions and companies across Riau and nationally.',
        icon: Briefcase,
        badge: 'Internship',
      },
      {
        title: 'Research Collaboration',
        desc: 'Joint research and applied technology development with academic and institutional partners.',
        icon: FlaskConical,
        badge: 'Research',
      },
      {
        title: 'Community & Service',
        desc: 'Sustained community service collaborations that connect academic expertise with public needs.',
        icon: HeartHandshake,
        badge: 'Service',
      },
    ]
  : [
      {
        title: 'Kurikulum & Pembelajaran',
        desc: 'Masukan industri dan keterlibatan praktisi agar materi pembelajaran tetap relevan dengan kebutuhan dunia kerja.',
        icon: GraduationCap,
        badge: 'Akademik',
      },
      {
        title: 'Penempatan Magang',
        desc: 'Peluang penempatan Kerja Praktik di instansi dan perusahaan di Riau maupun skala nasional.',
        icon: Briefcase,
        badge: 'Magang',
      },
      {
        title: 'Kolaborasi Riset',
        desc: 'Riset bersama dan pengembangan teknologi terapan dengan mitra akademik serta kelembagaan.',
        icon: FlaskConical,
        badge: 'Riset',
      },
      {
        title: 'Pengabdian Masyarakat',
        desc: 'Kerja sama pengabdian yang menghubungkan keahlian akademik dengan kebutuhan masyarakat.',
        icon: HeartHandshake,
        badge: 'Pengabdian',
      },
    ];

const partnerGroups = isEn
  ? [
      {
        title: 'Institutional & Regulatory',
        desc: 'Ministry of Religious Affairs, university governance, and public service institution frameworks that support program delivery.',
        logos: [
          { src: '/logo/kemenag.png', alt: 'Kemenag' },
          { src: '/logo/uin.png', alt: 'UIN Suska' },
          { src: '/logo/blu.png', alt: 'BLU' },
        ],
      },
      {
        title: 'Quality Recognition',
        desc: 'Independent accreditation recognition affirming the study program quality ranking.',
        logos: [{ src: '/logo/unggul.png', alt: 'Akreditasi Unggul' }],
      },
    ]
  : [
      {
        title: 'Kelembagaan & Regulasi',
        desc: 'Kementerian Agama, tata kelola universitas, dan kerangka layanan publik yang menopang penyelenggaraan program studi.',
        logos: [
          { src: '/logo/kemenag.png', alt: 'Kemenag' },
          { src: '/logo/uin.png', alt: 'UIN Suska' },
          { src: '/logo/blu.png', alt: 'BLU' },
        ],
      },
      {
        title: 'Pengakuan Mutu',
        desc: 'Pengakuan akreditasi mandiri yang menegaskan peringkat mutu program studi.',
        logos: [{ src: '/logo/unggul.png', alt: 'Akreditasi Unggul' }],
      },
    ];

const fundingPartners = isEn
  ? [
      { name: 'Bank Indonesia (GenBI)', desc: 'Scholarship stipends and leadership development for eligible students.' },
      { name: 'Djarum Beasiswa Plus', desc: 'Merit-based scholarship and soft-skills training programs.' },
      { name: 'BRI & Corporate Partners', desc: 'Corporate scholarship schemes coordinated with university channels.' },
    ]
  : [
      { name: 'Bank Indonesia (GenBI)', desc: 'Beasiswa uang saku dan pengembangan kepemimpinan bagi mahasiswa yang memenuhi syarat.' },
      { name: 'Djarum Beasiswa Plus', desc: 'Program beasiswa berbasis prestasi dan pelatihan soft skills.' },
      { name: 'BRI & Mitra Korporasi', desc: 'Skema beasiswa korporasi yang dikoordinasikan melalui kanal universitas.' },
    ];
---

<Layout title={isEn ? 'Partners & Collaboration' : 'Mitra & Kerjasama'}>
  <div class="min-h-screen bg-slate-50/60 font-sans">
    <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
        <li class="flex items-center">
          <a href={localizePath('/', lang)} class="flex items-center transition-colors hover:text-emerald-700">
            <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            {t('bread.home')}
          </a>
        </li>
        <li class="text-slate-300">/</li>
        <li class="font-bold tracking-tight text-emerald-700">
          {isEn ? 'Partners' : 'Mitra'}
        </li>
      </ol>
    </nav>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 md:py-8 lg:px-8">
      <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-secondary/10 blur-3xl"></div>
        <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

        <div class="relative z-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
              <Handshake class="h-4 w-4 text-[#f7de8a]" />
              {isEn ? 'Strategic Partnership' : 'Kemitraan Strategis'}
            </span>
            <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
              {isEn ? 'Partners & Collaboration' : 'Mitra & Kerjasama'}
            </h1>
          </div>
          <div class="rounded-[24px] border border-white/10 bg-[#dcecd1]/10 p-5 backdrop-blur-sm">
            <p class="text-base leading-relaxed text-gray-100 sm:text-lg">
              {isEn
                ? 'Partners supporting curriculum development, research, scholarships, and internship collaboration for Informatics Engineering.'
                : 'Mitra yang mendukung pengembangan kurikulum, riset, beasiswa, dan kolaborasi magang bagi Teknik Informatika.'}
            </p>
          </div>
        </div>

        <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { label: isEn ? 'Curriculum' : 'Kurikulum', value: isEn ? 'Industry Input' : 'Masukan Industri' },
            { label: isEn ? 'Internship' : 'Magang', value: isEn ? 'KP Partners' : 'Mitra KP' },
            { label: isEn ? 'Research' : 'Riset', value: isEn ? 'Joint Projects' : 'Proyek Bersama' },
            { label: isEn ? 'Support' : 'Dukungan', value: isEn ? 'Scholarships' : 'Beasiswa' },
          ].map((item) => (
            <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
              <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">{item.label}</p>
              <p class="mt-2 text-xl font-black text-white">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-14 lg:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? 'Collaboration Areas' : 'Area Kolaborasi'}
        </span>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          {isEn ? 'How partnerships support the program' : 'Bagaimana kemitraan mendukung program studi'}
        </h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {collaborationAreas.map((item) => {
          const Icon = item.icon;
          return (
            <div class="flex flex-col justify-between rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
              <div>
                <div class="mb-6 flex items-center justify-between">
                  <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
                    <Icon class="h-6 w-6" />
                  </div>
                  <span class="rounded-lg bg-[#f4f0dd] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#5a4c18]">
                    {item.badge}
                  </span>
                </div>
                <h3 class="mb-2 text-lg font-bold text-slate-900">{item.title}</h3>
                <p class="text-sm leading-relaxed text-slate-500">{item.desc}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="rounded-[30px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] sm:p-8 lg:p-10">
        <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
              {isEn ? 'Institutional Partners' : 'Mitra Kelembagaan'}
            </span>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
              {isEn ? 'Supporting institutions' : 'Lembaga pendukung'}
            </h2>
          </div>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          {partnerGroups.map((group) => (
            <div class="rounded-[24px] border border-slate-200 bg-[#f8faf3] p-6">
              <div class="mb-4 flex items-center gap-2">
                <Building2 class="h-5 w-5 text-primary" />
                <h3 class="text-lg font-bold text-slate-900">{group.title}</h3>
              </div>
              <p class="mb-6 text-sm leading-relaxed text-slate-500">{group.desc}</p>
              <div class="flex flex-wrap items-center gap-6">
                {group.logos.map((logo) => (
                  <div class="flex h-16 items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3">
                    <img src={logo.src} alt={logo.alt} class="max-h-10 w-auto object-contain" />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="rounded-[30px] border border-slate-200 bg-[#f8faf3] p-6 shadow-[0_18px_45px_-35px_rgba(15,23,42,0.25)] sm:p-8 lg:p-10">
        <div class="mb-8">
          <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
            <Award class="h-3.5 w-3.5" />
            {isEn ? 'Scholarship Partners' : 'Mitra Beasiswa'}
          </span>
          <h2 class="mt-3 text-2xl font-black tracking-tight text-[#004d2c] sm:text-3xl">
            {isEn ? 'Funding collaborators' : 'Kolaborator pendanaan'}
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-slate-500">
            {isEn
              ? 'Scholarship partners listed on the Beasiswa page that support Informatics Engineering students.'
              : 'Mitra beasiswa yang tercantum pada halaman Beasiswa dan mendukung mahasiswa Teknik Informatika.'}
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {fundingPartners.map((partner) => (
            <div class="rounded-[24px] border border-[#dfe7d7] bg-white p-5">
              <h3 class="text-base font-bold text-slate-900">{partner.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{partner.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <a
            href={localizePath('/beasiswa/beasiswa', lang)}
            class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary/90"
          >
            {isEn ? 'Open Scholarship Info' : 'Buka Info Beasiswa'}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
              {isEn ? 'Looking for internship partners?' : 'Mencari mitra Kerja Praktik?'}
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base">
              {isEn
                ? 'See internship announcements and recommended partner listings on the Internship page.'
                : 'Lihat pengumuman magang dan daftar mitra yang direkomendasikan pada halaman Kerja Praktik.'}
            </p>
          </div>
          <a
            href={localizePath('/kerja-praktik/kerja-praktik', lang)}
            class="inline-flex items-center justify-center gap-2 rounded-md border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
          >
            {isEn ? 'Internship Page' : 'Halaman Kerja Praktik'}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
