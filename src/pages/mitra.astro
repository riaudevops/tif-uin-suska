---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl } from '../lib/translations';

const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<Layout title={isEn ? "Partners & Collaboration" : "Mitra & Kerjasama"}>
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100">
      <h1 class="text-3xl font-black text-[#004d2c]">{isEn ? "Partners & Collaboration" : "Mitra & Kerjasama"}</h1>
      <p class="text-slate-600 mt-4">
        {isEn 
          ? "Several partners collaborating in curriculum development, research, and internship/collaboration programs."
          : "Beberapa mitra yang bekerja sama dalam pengembangan kurikulum, riset, dan program magang/kolaborasi."
        }
      </p>

      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 items-center">
        <img src="/logo/blu.png" alt="Mitra BLU" class="max-h-12 object-contain" />
        <img src="/logo/kemenag.png" alt="Kemenag" class="max-h-12 object-contain" />
        <img src="/logo/uin.png" alt="UIN" class="max-h-12 object-contain" />
        <img src="/logo/unggul.png" alt="Unggul" class="max-h-12 object-contain" />
      </div>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-semibold hover:bg-slate-50">
          {isEn ? "List of Partners & Collaborations" : "Daftar Mitra & Kerjasama"}
        </a>
      </div>
    </div>
  </section>
</Layout>
