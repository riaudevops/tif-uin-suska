---
import Layout from '@/layouts/Layout.astro';
// Impor useTranslations dan localizePath ditambahkan untuk breadcrumb
import { getLocaleFromUrl, useTranslations, localizePath } from '../lib/translations';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<Layout title={isEn ? "Partners & Collaboration" : "Mitra & Kerjasama"}>
  <section data-aos="fade-up" class="max-w-7xl mx-auto px-6 py-20">
    
    {/* Navigasi Breadcrumb */}
    <nav class="max-w-7xl mx-auto px-8 mt-32 text-sm">
      <ol class="flex items-center flex-wrap gap-2 text-sm text-gray-500 py-3 border-b border-gray-100">
        <li class="flex items-center">
          <a href={localizePath("/", lang)} class="flex items-center hover:text-green-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            {t("bread.home")}
          </a>
        </li>
        <li class="text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li class="text-green-700 font-bold tracking-tight">
          {isEn ? "Partners" : "Mitra"}
        </li>
      </ol>
    </nav>

    {/* Margin top (mt-6) ditambahkan agar berjarak dari breadcrumb */}
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100 mt-6">
      <h1 data-aos="fade-up" class="text-3xl font-black text-[#004d2c]">{isEn ? "Partners & Collaboration" : "Mitra & Kerjasama"}</h1>
      <p class="text-slate-600 mt-4">
        {isEn 
          ? "Several partners collaborating in curriculum development, research, and internship/collaboration programs."
          : "Beberapa mitra yang bekerja sama dalam pengembangan kurikulum, riset, dan program magang/kolaborasi."
        }
      </p>

      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 items-center">
        <img src="/logo/blu.png" alt="Mitra BLU" class="max-h-12 object-contain" />
        <img src="/logo/kemenag.png" alt="Kemenag" class="max-h-12 object-contain" />
        <img src="/logo/uin.png" alt="UIN" class="max-h-12 object-contain" />
        <img src="/logo/unggul.png" alt="Unggul" class="max-h-12 object-contain" />
      </div>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-semibold hover:bg-slate-50">
          {isEn ? "List of Partners & Collaborations" : "Daftar Mitra & Kerjasama"}
        </a>
      </div>
    </div>
  </section>
</Layout>