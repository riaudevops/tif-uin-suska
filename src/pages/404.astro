---
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl, useTranslations, localizePath } from '@/lib/translations.js';
const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
---

<Layout title={t('page.404.title')}>
  <!-- Breadcrumbs -->
  <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
      <li class="flex items-center">
        <a href={localizePath('/', lang)} class="flex items-center hover:text-[#004d2c] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {t('nav.home')}
        </a>
      </li>
      <li class="text-gray-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li class="text-[#004d2c] font-bold tracking-tight">
        {t('page.404.notFound')}
      </li>
    </ol>
  </nav>

  <!-- 404 Hero Section -->
  <section data-aos="fade-up" class="bg-gradient-to-b from-gray-50 to-white py-12 overflow-hidden font-sans">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <span class="px-4 py-1.5 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block font-sans">
          {t('page.404.error')}
        </span>
        <h1 data-aos="fade-up" class="text-4xl md:text-5xl font-black text-[#004d2c] mb-6 leading-tight font-heading">
          {t('page.404.heading')}
        </h1>
        <p class="text-lg text-gray-600 mb-8 leading-relaxed font-sans max-w-2xl mx-auto">
          {t('page.404.description')}
        </p>
      </div>
    </div>
  </section>

  <!-- 404 Card Section -->
  <section class="py-16 bg-slate-50 min-h-[60vh] font-sans flex items-center">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="overflow-hidden rounded-2xl shadow-2xl relative w-full flex flex-col md:flex-row bg-[#081730]">

        <!-- Left: Animated 404 Visual -->
        <div class="relative w-full md:w-[45%] h-64 md:h-auto p-8 md:p-12 flex items-center justify-center shrink-0 z-10">
          <!-- Decorative offset background box -->
          <div class="absolute inset-0 m-6 md:m-8 translate-x-[-10px] translate-y-[-10px] bg-[#008dc7] rounded-xl z-0 shadow-inner"></div>

          <!-- 404 Number Display -->
          <div class="relative z-10 flex flex-col items-center justify-center w-full h-full">
            <div class="text-center select-none" id="not-found-display">
              <p class="text-[7rem] md:text-[9rem] font-black leading-none font-heading text-white drop-shadow-2xl" id="code-404">
                404
              </p>
              <!-- Animated dots decoration -->
              <div class="flex justify-center gap-3 mt-4">
                <span class="w-3 h-3 rounded-full bg-yellow-400 animate-bounce" style="animation-delay: 0ms;"></span>
                <span class="w-3 h-3 rounded-full bg-[#008dc7] animate-bounce" style="animation-delay: 150ms;"></span>
                <span class="w-3 h-3 rounded-full bg-white/60 animate-bounce" style="animation-delay: 300ms;"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="w-full md:w-[55%] p-8 md:p-12 flex flex-col justify-center text-white bg-gradient-to-br from-[#081730] via-[#0b2042] to-[#0e2954] relative overflow-hidden">
          <!-- Subtle background decoration -->
          <div class="absolute inset-0 opacity-[0.03] pointer-events-none">
            <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
              <path d="M0,80 Q100,20 200,80 T400,80 T600,80" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M0,160 Q100,100 200,160 T400,160 T600,160" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>

          <h2 data-aos="fade-up" class="text-2xl md:text-3xl font-black mb-3 font-heading tracking-tight leading-tight text-white drop-shadow-sm">
            {t('page.404.oops')}
          </h2>
          <div class="w-12 h-1 bg-yellow-400 rounded-full mb-5"></div>
          <p class="text-sm md:text-base text-blue-100/80 leading-relaxed font-sans font-medium mb-8">
            {t('page.404.unavailable')}
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={localizePath('/', lang)}
              id="btn-back-home"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#004d2c] hover:bg-[#006b3c] text-white font-bold rounded-xl transition-all duration-300 hover:scale-105 shadow-lg font-sans text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              {t('page.404.backHome')}
            </a>
            <button
              onclick="history.back()"
              id="btn-go-back"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl transition-all duration-300 hover:scale-105 border border-white/20 font-sans text-sm cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              {t('page.404.previous')}
            </button>
          </div>
        </div>

      </div>

      <!-- Quick Links -->
      <div class="mt-12 text-center">
        <p class="text-sm text-gray-500 font-sans mb-6 font-medium">{t('page.404.popular')}</p>
        <div class="flex flex-wrap justify-center gap-3">
          {[
            { href: localizePath('/profil/sejarah', lang), label: t('page.404.profile') },
            { href: localizePath('/kurikulum/kurikulum', lang), label: t('menu.kurikulum') },
            { href: localizePath('/dosen/dosen', lang), label: t('bread.dosen') },
            { href: localizePath('/laboratorium/laboratorium', lang), label: t('page.404.laboratory') },
            { href: localizePath('/berita', lang), label: t('nav.berita') },
          ].map((link) => (
            <a
              href={link.href}
              class="px-4 py-2 bg-white border border-slate-200 hover:bg-[#004d2c] hover:text-white hover:border-[#004d2c] text-slate-700 rounded-xl transition-all duration-300 shadow-sm font-bold text-xs font-sans"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  @keyframes pulse-glow {
    0%, 100% { text-shadow: 0 0 20px rgba(0, 141, 199, 0.3); }
    50% { text-shadow: 0 0 40px rgba(0, 141, 199, 0.7), 0 0 80px rgba(0, 77, 44, 0.3); }
  }

  #code-404 {
    animation: pulse-glow 3s ease-in-out infinite;
  }
</style>
