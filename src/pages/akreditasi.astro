---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '../lib/translations';
import {
  Award,
  ShieldCheck,
  FileCheck,
  Calendar,
  Building2,
  CheckCircle2,
  BadgeCheck,
  ArrowRight,
} from '@lucide/astro';

const lang = getLocaleFromUrl(Astro);
const t = useTranslations(lang);
const isEn = lang === 'en';

const statusItems = isEn
  ? [
      { label: 'Rating', value: 'Unggul' },
      { label: 'Agency', value: 'LAM-INFOKOM' },
      { label: 'Validity', value: '2025–2030' },
      { label: 'Decree', value: '086/SK/LAM-INFOKOM/2025' },
    ]
  : [
      { label: 'Peringkat', value: 'Unggul' },
      { label: 'Lembaga', value: 'LAM-INFOKOM' },
      { label: 'Masa Berlaku', value: '2025–2030' },
      { label: 'Nomor SK', value: '086/SK/LAM-INFOKOM/2025' },
    ];

const pillars = isEn
  ? [
      {
        title: 'Academic Quality',
        desc: 'Curriculum, learning outcomes, and graduate competencies aligned with national standards and industry needs.',
        icon: BadgeCheck,
      },
      {
        title: 'Governance & Legality',
        desc: 'Study program operations based on formal decrees, clear institutional structure, and accountable academic services.',
        icon: ShieldCheck,
      },
      {
        title: 'Continuous Improvement',
        desc: 'Periodic evaluation of teaching quality, research, community service, and supporting facilities.',
        icon: CheckCircle2,
      },
    ]
  : [
      {
        title: 'Mutu Akademik',
        desc: 'Kurikulum, capaian pembelajaran, dan kompetensi lulusan yang selaras dengan standar nasional serta kebutuhan industri.',
        icon: BadgeCheck,
      },
      {
        title: 'Tata Kelola & Legalitas',
        desc: 'Penyelenggaraan prodi berdasarkan SK formal, struktur kelembagaan yang jelas, dan layanan akademik yang akuntabel.',
        icon: ShieldCheck,
      },
      {
        title: 'Perbaikan Berkelanjutan',
        desc: 'Evaluasi berkala terhadap kualitas pembelajaran, riset, pengabdian, serta fasilitas pendukung.',
        icon: CheckCircle2,
      },
    ];

const documents = isEn
  ? [
      {
        no: 'SK No. 4469/D/T/2004',
        date: '14 May 1999',
        title: 'Establishment Decree',
        issuer: 'Directorate General of Islamic Guidance',
        status: 'Founding Document',
      },
      {
        no: 'SK No. 4469/D/T/2004',
        date: '12 November 2004',
        title: 'Higher Education Operational Permit',
        issuer: 'Directorate General of Higher Education',
        status: 'Operational License',
      },
      {
        no: 'SK No. DJ.II/26/2006',
        date: '2006',
        title: 'Institutional Adjustment Decree',
        issuer: 'Directorate General of Islamic Guidance',
        status: 'Institutional Legality',
      },
      {
        no: 'SK No. 086/SK/LAM-INFOKOM/2025',
        date: '2025–2030',
        title: "Accreditation Ranking: 'Unggul'",
        issuer: 'LAM-INFOKOM',
        status: 'Highest National Rating',
      },
    ]
  : [
      {
        no: 'SK No. 4469/D/T/2004',
        date: '14 Mei 1999',
        title: 'Surat Keputusan Izin Pendirian',
        issuer: 'Dirjen Binbaga Islam Departemen Agama RI',
        status: 'SK Pendirian',
      },
      {
        no: 'SK No. 4469/D/T/2004',
        date: '12 November 2004',
        title: 'Izin Penyelenggaraan Program Studi',
        issuer: 'Dirjen Dikti Departemen Pendidikan Nasional RI',
        status: 'SK Izin Dikti',
      },
      {
        no: 'SK No. DJ.II/26/2006',
        date: '2006',
        title: 'Penetapan Integrasi Kelembagaan',
        issuer: 'Dirjen Binbaga Islam Departemen Agama RI',
        status: 'SK Kelembagaan',
      },
      {
        no: 'SK No. 086/SK/LAM-INFOKOM/2025',
        date: '2025–2030',
        title: 'Peringkat Akreditasi Unggul',
        issuer: 'LAM-INFOKOM (Lembaga Akreditasi Mandiri)',
        status: 'Akreditasi Unggul',
      },
    ];
---

<Layout title={isEn ? 'Accreditation' : 'Akreditasi'}>
  <div class="min-h-screen bg-slate-50/60 font-sans">
    <nav class="mx-auto max-w-7xl px-4 pt-28 pb-4 text-sm sm:px-6 sm:pt-32 lg:px-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 border-b border-slate-100 py-3 text-sm text-slate-500">
        <li class="flex items-center">
          <a href={localizePath('/', lang)} class="flex items-center transition-colors hover:text-emerald-700">
            <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            {t('bread.home')}
          </a>
        </li>
        <li class="text-slate-300">/</li>
        <li class="font-bold tracking-tight text-emerald-700">
          {isEn ? 'Accreditation' : 'Akreditasi'}
        </li>
      </ol>
    </nav>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 md:py-8 lg:px-8">
      <div class="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-[#003d2a] via-[#0a5d3d] to-[#7ca25c] p-8 shadow-[0_28px_80px_-30px_rgba(0,61,42,0.8)] sm:p-10 lg:p-14">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(245,201,86,0.18),_transparent_30%),radial-gradient(circle_at_bottom_left,_rgba(255,255,255,0.05),_transparent_35%)]"></div>
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-secondary/10 blur-3xl"></div>
        <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-white/5 blur-3xl"></div>

        <div class="relative z-10 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur-sm">
              <Award class="h-4 w-4 text-[#f7de8a]" />
              {isEn ? 'Quality Assurance' : 'Penjaminan Mutu'}
            </span>
            <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
              {isEn ? 'Study Program Accreditation' : 'Akreditasi Program Studi'}
            </h1>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-emerald-50/90">
              {isEn
                ? 'Official accreditation status, supporting documents, and quality recognition of the Informatics Engineering Study Program at UIN Sultan Syarif Kasim Riau.'
                : 'Status akreditasi resmi, dokumen pendukung, dan pengakuan mutu Program Studi Teknik Informatika UIN Sultan Syarif Kasim Riau.'}
            </p>
          </div>

          <div class="flex flex-col items-center justify-center rounded-[24px] border border-white/10 bg-white/10 p-6 backdrop-blur-sm sm:flex-row sm:gap-6">
            <img src="/logo/unggul.png" alt="Akreditasi Unggul" class="h-24 w-auto object-contain sm:h-28" />
            <div class="mt-4 text-center sm:mt-0 sm:text-left">
              <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">
                {isEn ? 'Current Status' : 'Status Saat Ini'}
              </p>
              <p class="mt-1 text-2xl font-black text-white">Unggul</p>
              <p class="mt-1 text-sm text-emerald-50/80">LAM-INFOKOM · 2025–2030</p>
            </div>
          </div>
        </div>

        <div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {statusItems.map((item) => (
            <div class="rounded-[22px] border border-white/10 bg-[#dcecd1]/10 p-4 backdrop-blur-sm">
              <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">{item.label}</p>
              <p class="mt-2 text-lg font-black text-white sm:text-xl">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-14 lg:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <span class="mb-3 inline-flex rounded-full bg-[#edf4e8] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#0b5c3d]">
          {isEn ? 'Quality Pillars' : 'Pilar Mutu'}
        </span>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          {isEn ? 'What the Unggul rating affirms' : 'Yang ditegaskan oleh peringkat Unggul'}
        </h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {pillars.map((item) => {
          const Icon = item.icon;
          return (
            <div class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_18px_45px_-30px_rgba(15,23,42,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_55px_-30px_rgba(0,61,42,0.35)]">
              <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf4e8] text-[#0b5c3d]">
                <Icon class="h-6 w-6" />
              </div>
              <h3 class="mb-2 text-lg font-bold text-slate-900">{item.title}</h3>
              <p class="text-sm leading-relaxed text-slate-500">{item.desc}</p>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_24px_80px_-40px_rgba(15,23,42,0.35)]">
        <div class="grid grid-cols-1 lg:grid-cols-12">
          <div class="bg-gradient-to-br from-[#0b352c] via-[#0f4f3d] to-[#1a684d] p-8 text-white sm:p-10 lg:col-span-4">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-white/90">
              <FileCheck class="h-3.5 w-3.5 text-secondary" />
              {isEn ? 'Legal Archive' : 'Arsip Legalitas'}
            </span>
            <h2 class="mt-5 text-2xl font-black leading-tight sm:text-3xl">
              {isEn ? 'Supporting Documents' : 'Dokumen Pendukung'}
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-gray-200">
              {isEn
                ? 'Key decrees that establish legality, operational permit, and the current accreditation ranking of the study program.'
                : 'SK utama yang menetapkan legalitas, izin operasional, dan peringkat akreditasi program studi saat ini.'}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-white/12 pt-6">
              <img src="/logo/uin.png" alt="UIN Suska" class="h-10 w-auto object-contain" />
              <img src="/logo/kemenag.png" alt="Kemenag" class="h-10 w-auto object-contain" />
              <img src="/logo/blu.png" alt="BLU" class="h-10 w-auto object-contain" />
            </div>
          </div>

          <div class="bg-slate-50/70 p-6 sm:p-8 lg:col-span-8 lg:p-10">
            <div class="mb-5 flex items-center gap-2">
              <Building2 class="h-5 w-5 text-primary" />
              <h3 class="text-lg font-bold text-gray-900">
                {isEn ? 'Decrees & Accreditation Record' : 'SK & Riwayat Akreditasi'}
              </h3>
            </div>

            <div class="space-y-3">
              {documents.map((item) => (
                <div class="flex flex-col justify-between gap-3 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition-all duration-200 hover:border-primary/40 hover:shadow-md sm:flex-row sm:items-center sm:p-5">
                  <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-bold text-gray-900">{item.no}</span>
                      <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">
                        {item.status}
                      </span>
                    </div>
                    <h4 class="text-sm font-semibold text-gray-800">{item.title}</h4>
                    <p class="text-xs text-gray-500">{item.issuer}</p>
                  </div>
                  <div class="flex-shrink-0">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 text-[11px] font-medium text-gray-600">
                      <Calendar class="h-3 w-3 text-gray-400" />
                      {item.date}
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-8">
              <a
                href={localizePath('/profil/sejarah', lang)}
                class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary/90"
              >
                {isEn ? 'View Program Profile' : 'Lihat Profil Prodi'}
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
