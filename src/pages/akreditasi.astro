---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Akreditasi">
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100">
      <h1 class="text-3xl font-black text-[#004d2c]">Akreditasi</h1>
      <p class="text-slate-600 mt-4">Informasi terkait status akreditasi, dokumen pendukung, dan capaian kualitas Program Studi Teknik Informatika. Untuk dokumen resmi dan riwayat akreditasi, silakan kunjungi halaman ini.</p>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-[#004d2c] text-white font-bold rounded-lg hover:bg-[#053a2a] transition">Lihat Dokumen Akreditasi</a>
      </div>
    </div>
  </section>
</Layout>
