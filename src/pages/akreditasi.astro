---
import Layout from '@/layouts/Layout.astro';
import { getLocaleFromUrl } from '../lib/translations';

const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<Layout title={isEn ? "Accreditation" : "Akreditasi"}>
  <section data-aos="fade-up" class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-100">
      <h1 data-aos="fade-up" class="text-3xl font-black text-[#004d2c]">{isEn ? "Accreditation" : "Akreditasi"}</h1>
      <p class="text-slate-600 mt-4">
        {isEn 
          ? "Information related to accreditation status, supporting documents, and quality achievements of the Informatics Engineering Study Program. For official documents and accreditation history, please visit this page."
          : "Informasi terkait status akreditasi, dokumen pendukung, dan capaian kualitas Program Studi Teknik Informatika. Untuk dokumen resmi dan riwayat akreditasi, silakan kunjungi halaman ini."
        }
      </p>

      <div class="mt-6">
        <a href="#" class="inline-flex items-center px-4 py-2 bg-[#004d2c] text-white font-bold rounded-lg hover:bg-[#053a2a] transition">
          {isEn ? "View Accreditation Documents" : "Lihat Dokumen Akreditasi"}
        </a>
      </div>
    </div>
  </section>
</Layout>
