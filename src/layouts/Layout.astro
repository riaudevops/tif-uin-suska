---
import "../styles/global.css";
import Navbar from "../components/globals/navbar.astro";
import Footer from "../components/pages/landing-pages/footer.astro";
import Search from "../components/globals/search.astro";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/en/" || pathname === "/en";
const lang = Astro.currentLocale || "id";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="../styles/global.css" />
	</head>
	<body class="bg-white">
		<Navbar />
		<Search />
		<main class={isHome ? "" : "pt-25 md:pt-32"}>
				<slot />
		</main>
			<Footer />
	</body>
</html>