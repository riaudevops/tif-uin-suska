---
import "../styles/global.css";
import "aos/dist/aos.css";
import Navbar from "../components/globals/navbar.astro";
import Footer from "../components/pages/landing-pages/footer.astro";
import { getLocaleFromUrl } from "../lib/translations";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="icon" type="image/svg+xml" href="/logo/uin.png" />
        <title>{title ? `${title} - ${isEn ? 'Informatics Engineering' : 'Teknik Informatika'} UIN Suska Riau` : `${isEn ? 'Informatics Engineering' : 'Teknik Informatika'} UIN Suska Riau`}</title>
        <ClientRouter />
    </head>
    <body class="bg-white">
        <Navbar />
        <main class="animate-fade-in-up">
            <slot />
        </main>
        <Footer />
        <script>
            import AOS from 'aos';
            AOS.init({
                duration: 700,
                easing: 'ease-out-cubic',
                once: true,
                offset: 50,
                delay: 0,
            });

            // Re-init AOS on view transitions
            document.addEventListener('astro:page-load', () => {
                AOS.refresh();
            });
        </script>
    </body>
</html>

