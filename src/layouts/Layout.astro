---
import "../styles/global.css";
import "aos/dist/aos.css";
import Navbar from "../components/globals/navbar.astro";
import Footer from "../components/pages/landing-pages/footer.astro";
import { getLocaleFromUrl } from "../lib/translations";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const lang = getLocaleFromUrl(Astro);
const isEn = lang === 'en';
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" />
        <link rel="icon" type="image/svg+xml" href="/logo/uin.png" />
        <title>{title ? `${title} - ${isEn ? 'Informatics Engineering' : 'Teknik Informatika'} UIN Suska Riau` : `${isEn ? 'Informatics Engineering' : 'Teknik Informatika'} UIN Suska Riau`}</title>
        <ClientRouter />
    </head>
    <body class="bg-white">
        <Navbar />
        <main>
            <slot />
        </main>
        <Footer />
        <script>
            import AOS from 'aos';

            function initAos() {
                AOS.init({
                    duration: 300,
                    easing: 'ease-out-cubic',
                    once: true,
                    offset: 16,
                    delay: 0,
                    mirror: false,
                });
            }

            initAos();

            function loadNearbyEmbeds() {
                const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-deferred-src]');

                if (!('IntersectionObserver' in window)) {
                    frames.forEach((frame) => {
                        frame.src = frame.dataset.deferredSrc || '';
                        frame.removeAttribute('data-deferred-src');
                    });
                    return;
                }

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;

                        if (!(entry.target instanceof HTMLIFrameElement)) return;
                        const frame = entry.target;
                        const source = frame.dataset.deferredSrc;
                        if (!source) return;

                        frame.src = source;
                        frame.removeAttribute('data-deferred-src');
                        observer.unobserve(frame);
                    });
                });

                frames.forEach((frame) => observer.observe(frame));
            }

            loadNearbyEmbeds();

            // Re-bind and refresh AOS when page changes via ClientRouter
            document.addEventListener('astro:page-load', () => {
                AOS.refreshHard();
                loadNearbyEmbeds();
            });

            // Mobile touchstart prefetch for zero-delay tap navigation
            document.addEventListener('touchstart', (e) => {
                const target = e.target as HTMLElement | null;
                const anchor = target?.closest('a');
                if (anchor && anchor.href && anchor.origin === location.origin && !anchor.hash) {
                    const existing = document.querySelector(`link[rel="prefetch"][href="${anchor.href}"]`);
                    if (!existing) {
                        const link = document.createElement('link');
                        link.rel = 'prefetch';
                        link.href = anchor.href;
                        document.head.appendChild(link);
                    }
                }
            }, { passive: true });
        </script>
    </body>
</html>
