# Environment example for TIF_UIN_SUSKA_RIAU landing-pages
# Copy this to .env (or set as build args / GitHub Actions secrets)

# API base URL used during build and runtime (Directus or proxy)
BASE_API_URL=http://localhost:8055

# Runtime host and port for SSR server
HOST=0.0.0.0
PORT=3000
# Note: asset URLs are derived from BASE_API_URL as BASE_API_URL/assets

# Node environment
NODE_ENV=production

# Notes:
# - In CI (GitHub Actions) set these as repository secrets or organization variables and
#   pass them to docker build using `--build-arg` (deploy.yml already configured).
# - Do NOT commit secrets. This file is only an example and safe to commit.
