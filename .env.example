# Environment example for TIF_UIN_SUSKA_RIAU landing-pages
# Copy this to .env (or set as build args / GitHub Actions secrets)

# API base URL used during build and runtime (Directus or proxy)
# Keep the base URL without /items; the app adds it automatically when needed.
BASE_API_URL=http://localhost:8055
PUBLIC_BASE_ASSETS_URL=http://localhost:8055/assets

# Server-side Directus token (NEVER expose this as PUBLIC_*).
# Required for collections whose public role is not readable, e.g.:
#   beasiswa, tugas_akhir, kerja_praktik, aiorc_info
# The token is only used during SSR/SSG; it is never sent to the browser.
DIRECTUS_TOKEN=

# Runtime host and port for SSR server
HOST=0.0.0.0
PORT=3000

# --- Security / hardening -------------------------------------------------
# HSTS max-age in seconds. Only sent when the request arrived over HTTPS.
# Set to 0 to disable (e.g. while still serving plain HTTP).
HSTS_MAX_AGE=31536000

# Trust X-Forwarded-For / X-Real-IP / X-Forwarded-Proto from the reverse proxy.
# Set to false when the container is exposed directly (otherwise clients can
# spoof their IP and bypass rate limiting).
TRUST_PROXY=true

# How many trusted proxies sit in front of the app. With one reverse proxy
# (nginx/Traefik appending the peer address) the rightmost X-Forwarded-For entry
# is the real client. Increase to 2 when Cloudflare also proxies the traffic.
TRUST_PROXY_HOPS=1

# Extra image origins for the CSP, comma separated (e.g. a CDN). The CMS origin
# and *.uin-suska.ac.id are always allowed.
# CSP_IMG_SRC_EXTRA=https://cdn.example.com

# Largest accepted request body in bytes. The site has no upload endpoints.
MAX_BODY_BYTES=262144

# In-process rate limiting (see rate-limit.mjs)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_API_MAX=30

# Node environment
NODE_ENV=production
