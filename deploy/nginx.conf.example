# Contoh konfigurasi nginx untuk TIF UIN Suska.
#
# Tujuan:
#   - Browser hanya boleh mengambil GAMBAR dari Directus lewat /media/.
#   - API Directus (/items, /users, /server, /admin, ...) tidak diekspos publik.
#   - Aplikasi Astro tetap mengambil data lewat jaringan internal
#     (BASE_API_URL=http://cms-tif-uin-suska:8055).
#
# Sesuaikan alamat upstream dengan kondisi server:
#   - Jika nginx berada di Docker network yang sama dengan Directus:
#       proxy_pass http://cms-tif-uin-suska:8055/assets/;
#   - Jika nginx di host dan port Directus dipublish ke localhost:
#       proxy_pass http://127.0.0.1:8055/assets/;
#
# Letakkan blok `map` di dalam konteks `http { ... }`, dan blok `location`
# di dalam `server { ... }` untuk tif.uin-suska.ac.id.

# Tolak parameter yang bisa dipakai untuk mengunduh file mentah / memakai token.
map $args $asset_args_blocked {
    default 0;
    "~*(^|&)(download|access_token|key|export)(=|&|$)" 1;
}

server {
    listen 443 ssl;
    http2 on;
    server_name tif.uin-suska.ac.id;

    # ... ssl_certificate, root, dan konfigurasi lain yang sudah ada ...

    # ---------------------------------------------------------------------
    # 1) Proxy gambar publik. Hanya GET/HEAD dan hanya endpoint /assets.
    # ---------------------------------------------------------------------
    location ^~ /media/ {
        if ($asset_args_blocked) {
            return 403;
        }
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://cms-tif-uin-suska:8055/assets/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Jangan bocorkan cookie/header Directus ke browser.
        proxy_hide_header Set-Cookie;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;

        # Nama file berupa UUID + parameter transformasi -> aman di-cache lama.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ---------------------------------------------------------------------
    # 2) Tutup jalur Directus yang lama dari internet.
    #    Aplikasi tetap bisa mengakses Directus lewat URL internal.
    # ---------------------------------------------------------------------
    location ^~ /9545b1b23ab81781c22942d7214b150b/ {
        return 404;
    }

    # ---------------------------------------------------------------------
    # 3) Aplikasi Astro (sesuaikan upstream-nya).
    # ---------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -------------------------------------------------------------------------
# Opsional: akses admin/API Directus lewat hostname terpisah, hanya dari
# jaringan tepercaya (VPN/kantor). Jangan buka ke publik.
# -------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name cms.tif.uin-suska.ac.id;

    allow 10.0.0.0/8;
    allow 127.0.0.1;
    deny all;

    location / {
        proxy_pass http://cms-tif-uin-suska:8055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
